{
    "schemes": [
        "https"
    ],
    "swagger": "2.0",
    "info": {
        "description": "REST API for monitoring and managing HAProxy instances. Provides endpoints for system metrics, HAProxy stats, log streaming, security monitoring, and real-time WebSocket events.",
        "title": "Gearbox Agent API",
        "termsOfService": "https://github.com/sarg3nt/gearbox-agent",
        "contact": {
            "name": "Gearbox Agent Support",
            "url": "https://github.com/sarg3nt/gearbox-agent/issues"
        },
        "license": {
            "name": "MIT",
            "url": "https://opensource.org/licenses/MIT"
        },
        "version": "1.0"
    },
    "host": "localhost:8405",
    "basePath": "/",
    "paths": {
        "/api/v1/events": {
            "get": {
                "description": "Upgrades to WebSocket connection for real-time event streaming. First obtain a token via POST /api/v1/events/token, then connect with ?token=\u003ctoken\u003e. Events: sync.started, sync.completed, sync.failed, config.changed, webhook.received.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "WebSocket"
                ],
                "summary": "WebSocket events stream",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Short-lived WebSocket token from /api/v1/events/token",
                        "name": "token",
                        "in": "query",
                        "required": true
                    }
                ],
                "responses": {
                    "101": {
                        "description": "Switching Protocols - WebSocket connection established"
                    },
                    "401": {
                        "description": "Unauthorized",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "/api/v1/events/info": {
            "get": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "Returns information about the WebSocket endpoint including available event types and current subscriber count.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "WebSocket"
                ],
                "summary": "WebSocket info",
                "responses": {
                    "200": {
                        "description": "WebSocket endpoint info",
                        "schema": {
                            "$ref": "#/definitions/internal_api.WSInfoResponse"
                        }
                    },
                    "401": {
                        "description": "Unauthorized",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "/api/v1/events/token": {
            "post": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "Exchanges an API key for a short-lived (60 second) single-use token for WebSocket authentication. Use the returned token in the WebSocket connection query parameter.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "WebSocket"
                ],
                "summary": "Exchange API key for WebSocket token",
                "responses": {
                    "200": {
                        "description": "WebSocket token",
                        "schema": {
                            "$ref": "#/definitions/internal_api.WSTokenResponse"
                        }
                    },
                    "401": {
                        "description": "Unauthorized",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "405": {
                        "description": "Method not allowed",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "500": {
                        "description": "Failed to generate token",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "/api/v1/metadata": {
            "get": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "Returns HAProxy configuration metadata including frontends, backends, and their settings from the last sync.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Sync"
                ],
                "summary": "HAProxy metadata",
                "responses": {
                    "200": {
                        "description": "HAProxy metadata",
                        "schema": {
                            "$ref": "#/definitions/internal_api.MetadataResponse"
                        }
                    },
                    "401": {
                        "description": "Unauthorized",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "503": {
                        "description": "Sync service not configured or pending",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "/api/v1/sync/status": {
            "get": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "Returns the status of the Git sync service including last sync time, error status, and backend count.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Sync"
                ],
                "summary": "Sync status",
                "responses": {
                    "200": {
                        "description": "Sync status",
                        "schema": {
                            "$ref": "#/definitions/internal_api.SyncStatusResponse"
                        }
                    },
                    "401": {
                        "description": "Unauthorized",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "503": {
                        "description": "Sync service not configured",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "/api/v1/traffic": {
            "get": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "Returns traffic analysis data including per-IP statistics from stick tables and backend aggregations.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Traffic"
                ],
                "summary": "Traffic analysis",
                "parameters": [
                    {
                        "type": "integer",
                        "default": 100,
                        "description": "Limit number of sources returned",
                        "name": "limit",
                        "in": "query"
                    },
                    {
                        "type": "integer",
                        "default": 10,
                        "description": "Number of top sources to return",
                        "name": "top_n",
                        "in": "query"
                    },
                    {
                        "type": "boolean",
                        "default": false,
                        "description": "Include all IPs, not just those with data",
                        "name": "include_all",
                        "in": "query"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Traffic analysis data",
                        "schema": {
                            "$ref": "#/definitions/internal_gears_traffic.TrafficResponse"
                        }
                    },
                    "401": {
                        "description": "Unauthorized",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "500": {
                        "description": "Failed to fetch traffic data",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "503": {
                        "description": "HAProxy stats not configured",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "/api/v1/traffic/summary": {
            "get": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "Returns a summary of traffic statistics without individual IP details.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Traffic"
                ],
                "summary": "Traffic summary",
                "responses": {
                    "200": {
                        "description": "Traffic summary",
                        "schema": {
                            "$ref": "#/definitions/internal_gears_traffic.TrafficSummary"
                        }
                    },
                    "401": {
                        "description": "Unauthorized",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "500": {
                        "description": "Failed to fetch traffic data",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "/api/v1/webhook/github": {
            "post": {
                "description": "Receives GitHub push events and triggers a sync. Authenticated via HMAC-SHA256 signature in X-Hub-Signature-256 header.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Webhook"
                ],
                "summary": "GitHub webhook",
                "parameters": [
                    {
                        "type": "string",
                        "description": "GitHub HMAC signature",
                        "name": "X-Hub-Signature-256",
                        "in": "header",
                        "required": true
                    },
                    {
                        "type": "string",
                        "description": "GitHub event type",
                        "name": "X-GitHub-Event",
                        "in": "header",
                        "required": true
                    },
                    {
                        "description": "GitHub push payload",
                        "name": "body",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/internal_api.GitHubPushPayload"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Webhook processed successfully",
                        "schema": {
                            "$ref": "#/definitions/internal_api.WebhookSuccessResponse"
                        }
                    },
                    "400": {
                        "description": "Bad request",
                        "schema": {
                            "$ref": "#/definitions/internal_api.WebhookErrorResponse"
                        }
                    },
                    "401": {
                        "description": "Invalid or missing signature",
                        "schema": {
                            "$ref": "#/definitions/internal_api.WebhookErrorResponse"
                        }
                    }
                }
            }
        },
        "/api/v1/webhook/info": {
            "get": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "Returns webhook configuration information including the URL to configure in GitHub.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Webhook"
                ],
                "summary": "Webhook info",
                "responses": {
                    "200": {
                        "description": "Webhook configuration info",
                        "schema": {
                            "$ref": "#/definitions/internal_api.WebhookInfoResponse"
                        }
                    },
                    "401": {
                        "description": "Unauthorized",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "/health": {
            "get": {
                "description": "Returns the health status of the gearbox-agent service. No authentication required. Only \"status\" is exposed; version and uptime are intentionally omitted from this unauthenticated endpoint to avoid fingerprinting by remote scanners.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Health"
                ],
                "summary": "Health check",
                "responses": {
                    "200": {
                        "description": "Service is healthy",
                        "schema": {
                            "$ref": "#/definitions/internal_api.HealthResponse"
                        }
                    }
                }
            }
        }
    },
