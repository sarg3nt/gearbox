// AlertRulesCardWidget renders the alert rules card widget.
// Uses HTMX to load the content dynamically from the alert rules API.
templ AlertRulesCardWidget(serverID string) {
	<div class="bg-white dark:bg-slate-800 rounded-lg shadow p-4 h-full">
		<div class="flex items-center justify-between">
			<span class="text-sm text-gray-500 dark:text-gray-400">Alert Rules</span>
			<svg class="w-5 h-5 text-purple-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
				<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6V4m0 2a2 2 0 100 4m0-4a2 2 0 110 4m-6 8a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4m6 6v10m6-2a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4"></path>
			</svg>
		</div>
		<div
			hx-get={ "/api/" + serverID + "/alert-rules?count_only=true" }
			hx-trigger="load, every 30s"
			hx-swap="innerHTML"
			class="mt-2"
		>
			<p class="text-2xl font-bold text-gray-800 dark:text-gray-100">-</p>
		</div>
		<a href="/settings/alerts" class="text-xs text-blue-500 hover:text-blue-600 mt-1 inline-block">
			Configure rules →
		</a>
	</div>
}

// AlertsGridWidget renders the full alerts grid with filtering and actions.
// Uses HTMX to load the alert list dynamically.
templ AlertsGridWidget(serverID string, showFilters bool, defaultStatus string) {
	<div class="bg-white dark:bg-slate-800 rounded-lg shadow h-full flex flex-col">
		if showFilters {
			<!-- In-widget filters -->
			<div class="p-4 border-b border-gray-200 dark:border-slate-700">
				<div class="flex items-center space-x-3">
					<input
						type="text"
						id="alert-search-widget"
						placeholder="Search alerts..."
						class="flex-1 px-3 py-1.5 text-sm border border-gray-300 dark:border-slate-600 rounded-lg bg-white dark:bg-slate-800 text-gray-700 dark:text-gray-300 focus:outline-none focus:ring-2 focus:ring-blue-500"
					/>
					<select
						id="status-filter-widget"
						class="px-3 py-1.5 text-sm border border-gray-300 dark:border-slate-600 rounded-lg bg-white dark:bg-slate-800 text-gray-700 dark:text-gray-300 focus:outline-none focus:ring-2 focus:ring-blue-500"
					>
						<option value="all" selected?={ defaultStatus == "all" }>All Alerts</option>
						<option value="active" selected?={ defaultStatus == "active" }>Active Only</option>
						<option value="acknowledged" selected?={ defaultStatus == "acknowledged" }>Acknowledged</option>
						<option value="resolved" selected?={ defaultStatus == "resolved" }>Resolved</option>
					</select>
				</div>
			</div>
		}
		<!-- Alerts list -->
		<div
			class="flex-1 overflow-auto"
			hx-get={ "/api/" + serverID + "/alerts?status=" + defaultStatus }
			hx-trigger="load, every 30s"
			hx-swap="innerHTML"
		>
			<div class="p-4 text-center text-gray-500 dark:text-gray-400">
				Loading alerts...
			</div>
		</div>
	</div>
}

// GetAlertsGridTopBarControls returns the top bar controls for the alerts grid widget.
// These appear in the dashboard's top bar when the widget is active.
func GetAlertsGridTopBarControls(ctx *widget.WidgetRenderContext, config map[string]any) []widget.TopBarControl {
	defaultStatus := getStringFromConfig(config, "default_status", "active")

	return []widget.TopBarControl{
		{
			ID:       "alert-search",
			Priority: 10,
			Component: AlertSearchControl(),
			Group:    "filters",
		},
		{
			ID:       "alert-status-filter",
			Priority: 20,
			Component: AlertStatusFilterControl(defaultStatus),
			Group:    "filters",
		},
		{
			ID:       "alert-refresh",
			Priority: 30,
			Component: AlertRefreshControl(),
			Group:    "actions",
		},
	}
}

// AlertSearchControl renders the search input for the top bar.
templ AlertSearchControl() {
	<input
		type="text"
		id="alert-search"
		placeholder="Search alerts..."
		class="w-48 h-[38px] px-3 py-1.5 text-sm border border-gray-300 dark:border-slate-600 rounded-lg bg-white dark:bg-slate-800 text-gray-700 dark:text-gray-300 focus:outline-none focus:ring-2 focus:ring-blue-500"
	/>
}

// AlertStatusFilterControl renders the status filter dropdown for the top bar.
templ AlertStatusFilterControl(defaultStatus string) {
	<select
		id="status-filter"
		class="h-[38px] px-3 py-1.5 text-sm border border-gray-300 dark:border-slate-600 rounded-lg bg-white dark:bg-slate-800 text-gray-700 dark:text-gray-300 focus:outline-none focus:ring-2 focus:ring-blue-500"
	>
		<option value="all" selected?={ defaultStatus == "all" }>All Alerts</option>
		<option value="active" selected?={ defaultStatus == "active" }>Active Only</option>
		<option value="acknowledged" selected?={ defaultStatus == "acknowledged" }>Acknowledged</option>
		<option value="resolved" selected?={ defaultStatus == "resolved" }>Resolved</option>
	</select>
}

// AlertRefreshControl renders the refresh button for the top bar.
templ AlertRefreshControl() {
	<button
		id="refresh-btn"
		class="p-2 rounded-lg transition-colors text-gray-400 hover:text-gray-600 dark:hover:text-gray-300"
		title="Refresh"
	>
		<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
			<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path>
		</svg>
	</button>
}
