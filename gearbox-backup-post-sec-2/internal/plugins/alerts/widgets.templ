package alerts

import "github.com/sarg3nt/gearbox/internal/framework/widget"

// ActiveAlertsCardWidget renders the active alerts card widget.
// Uses HTMX to load the content dynamically from the alerts API.
templ ActiveAlertsCardWidget(serverID string) {
	<div class="bg-white dark:bg-slate-800 rounded-lg shadow p-4 h-full">
		<div class="flex items-center justify-between">
			<span class="text-sm text-gray-500 dark:text-gray-400">Active Alerts</span>
			<svg class="w-5 h-5 text-red-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
				<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path>
			</svg>
		</div>
		<div
			hx-get={ "/api/" + serverID + "/alerts?status=active&count_only=true" }
			hx-trigger="load, every 30s"
			hx-swap="innerHTML"
			class="mt-2"
		>
			<p class="text-2xl font-bold text-gray-800 dark:text-gray-100">-</p>
		</div>
		<p class="text-xs text-gray-400 mt-1">Requires attention</p>
	</div>
}

