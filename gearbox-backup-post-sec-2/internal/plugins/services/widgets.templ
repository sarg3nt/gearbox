package services

import "fmt"

// ServicesOverviewCardWidget renders the services overview summary card.
templ ServicesOverviewCardWidget(serverID string, refreshSeconds int) {
	<div class="bg-white dark:bg-slate-800 rounded-lg shadow p-6">
		<h3 class="text-lg font-semibold text-gray-900 dark:text-white mb-4">Services Overview</h3>
		<div
			hx-get={ fmt.Sprintf("/api/%s/services/overview", serverID) }
			hx-trigger={ fmt.Sprintf("load, every %ds", refreshSeconds) }
			hx-swap="innerHTML"
			class="min-h-[100px] flex items-center justify-center"
		>
			<div class="animate-pulse text-gray-400">Loading services overview...</div>
		</div>
	</div>
}

// ServicesListWidget renders the full services list with controls.
templ ServicesListWidget(serverID string, refreshSeconds int, showFilters bool) {
	<div class="bg-white dark:bg-slate-800 rounded-lg shadow">
		<div class="p-6">
			<div class="flex justify-between items-center mb-4">
				<h3 class="text-lg font-semibold text-gray-900 dark:text-white">System Services</h3>
				if showFilters {
					<div class="flex items-center space-x-3">
						<select id="service-status-filter-inline" class="px-3 py-1.5 bg-slate-700 text-white border border-slate-600 rounded-md text-sm">
							<option value="all">All Services</option>
							<option value="running">Running</option>
							<option value="stopped">Stopped</option>
							<option value="failed">Failed</option>
						</select>
						<input
							type="text"
							id="service-search-inline"
							placeholder="Search services..."
							class="px-3 py-1.5 bg-slate-700 text-white border border-slate-600 rounded-md text-sm"
						/>
					</div>
				}
			</div>
			<div
				hx-get={ fmt.Sprintf("/api/%s/services", serverID) }
				hx-trigger={ fmt.Sprintf("load, every %ds", refreshSeconds) }
				hx-swap="innerHTML"
				class="min-h-[300px]"
			>
				<div class="animate-pulse text-gray-400 text-center py-8">Loading services list...</div>
			</div>
		</div>
	</div>
}

// FailedServicesAlertWidget renders an alert for failed services.
templ FailedServicesAlertWidget(serverID string, refreshSeconds int, hideWhenEmpty bool) {
	<div class="bg-white dark:bg-slate-800 rounded-lg shadow">
		<div class="p-6">
			<div class="flex items-center mb-4">
				<svg class="w-6 h-6 text-red-500 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path>
				</svg>
				<h3 class="text-lg font-semibold text-gray-900 dark:text-white">Failed Services</h3>
			</div>
			<div
				hx-get={ fmt.Sprintf("/api/%s/services/failed?hide_when_empty=%t", serverID, hideWhenEmpty) }
				hx-trigger={ fmt.Sprintf("load, every %ds", refreshSeconds) }
				hx-swap="innerHTML"
				class="min-h-[120px]"
			>
				<div class="animate-pulse text-gray-400 text-center py-8">Checking for failed services...</div>
			</div>
		</div>
	</div>
}
