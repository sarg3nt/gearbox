package os_updates

import "fmt"


// UpdateSummaryCardWidget shows summary of available updates
templ UpdateSummaryCardWidget(serverID string, refreshSeconds int) {
	<div
		class="grid grid-cols-1 md:grid-cols-2 gap-4"
		hx-get={ "/api/widgets/os-updates/summary?server_id=" + serverID }
		hx-trigger={ "load, every " + fmt.Sprintf("%d", refreshSeconds) + "s" }
		hx-swap="innerHTML"
	>
		<!-- Summary cards will be loaded via HTMX -->
		<div class="col-span-2 flex items-center justify-center py-8">
			<div class="animate-spin rounded-full h-8 w-8 border-2 border-blue-500 border-t-transparent"></div>
		</div>
	</div>
}

// AvailableUpdatesListWidget shows list of available package updates
templ AvailableUpdatesListWidget(serverID string, refreshSeconds int, showControls bool) {
	<div class="bg-white dark:bg-slate-800 rounded-lg shadow">
		<div class="p-4 border-b border-gray-200 dark:border-slate-700">
			<div class="flex items-center justify-between">
				<div>
					<h3 class="text-lg font-semibold text-gray-800 dark:text-gray-100">Available Updates</h3>
					<p class="text-sm text-gray-500 dark:text-gray-400">Packages with available updates</p>
				</div>
				if showControls {
					<div class="flex items-center gap-2">
						<select
							id="update-type-filter"
							class="h-[38px] px-3 py-1.5 text-sm border border-gray-300 dark:border-slate-600 rounded-lg bg-white dark:bg-slate-800 text-gray-700 dark:text-gray-300 focus:outline-none focus:ring-2 focus:ring-blue-500"
							onchange="filterUpdates()"
						>
							<option value="all">All Updates</option>
							<option value="security">Security Only</option>
							<option value="regular">Regular Only</option>
						</select>
						<button
							id="select-all-btn"
							onclick="toggleSelectAll()"
							class="px-3 py-2 text-sm bg-gray-100 dark:bg-slate-700 hover:bg-gray-200 dark:hover:bg-slate-600 text-gray-700 dark:text-gray-300 rounded-lg transition-colors"
						>
							Select All
						</button>
						<button
							id="install-selected-btn"
							onclick="installSelectedUpdates()"
							class="px-3 py-2 text-sm bg-blue-600 hover:bg-blue-700 text-white rounded-lg transition-colors"
							disabled
						>
							Install Selected
						</button>
					</div>
				}
			</div>
		</div>
		<div class="overflow-x-auto">
			<table class="w-full text-sm">
				<thead class="bg-gray-50 dark:bg-slate-700">
					<tr>
						<th class="px-4 py-3 text-left">
							<input type="checkbox" id="select-all-checkbox" class="rounded border-gray-300 text-blue-600 focus:ring-blue-500" onchange="toggleSelectAll()"/>
						</th>
						<th class="px-4 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-400 uppercase">Package</th>
						<th class="px-4 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-400 uppercase">Current</th>
						<th class="px-4 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-400 uppercase">Available</th>
						<th class="px-4 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-400 uppercase">Type</th>
						<th class="px-4 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-400 uppercase">Size</th>
					</tr>
				</thead>
				<tbody
					id="available-updates-table"
					class="divide-y divide-gray-200 dark:divide-slate-600"
					hx-get={ "/api/widgets/os-updates/available?server_id=" + serverID }
					hx-trigger={ "load, every " + fmt.Sprintf("%d", refreshSeconds) + "s" }
					hx-swap="innerHTML"
				>
					<tr>
						<td colspan="6" class="px-4 py-8 text-center text-gray-500 dark:text-gray-400">
							Loading updates...
						</td>
					</tr>
				</tbody>
			</table>
		</div>
	</div>
}

// UpdateHistoryWidget shows history of installed updates
templ UpdateHistoryWidget(serverID string, maxEntries int) {
	<div class="bg-white dark:bg-slate-800 rounded-lg shadow">
		<div class="p-4 border-b border-gray-200 dark:border-slate-700">
			<h3 class="text-lg font-semibold text-gray-800 dark:text-gray-100">Update History</h3>
			<p class="text-sm text-gray-500 dark:text-gray-400">Recently installed updates</p>
		</div>
		<div class="overflow-x-auto">
			<table class="w-full text-sm">
				<thead class="bg-gray-50 dark:bg-slate-700">
					<tr>
						<th class="px-4 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-400 uppercase">Date</th>
						<th class="px-4 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-400 uppercase">Package</th>
						<th class="px-4 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-400 uppercase">From Version</th>
						<th class="px-4 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-400 uppercase">To Version</th>
						<th class="px-4 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-400 uppercase">Type</th>
						<th class="px-4 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-400 uppercase">Status</th>
					</tr>
				</thead>
				<tbody
					id="update-history-table"
					class="divide-y divide-gray-200 dark:divide-slate-600"
					hx-get={ "/api/widgets/os-updates/history?server_id=" + serverID + "&max=" + fmt.Sprintf("%d", maxEntries) }
					hx-trigger="load"
					hx-swap="innerHTML"
				>
					<tr>
						<td colspan="6" class="px-4 py-8 text-center text-gray-500 dark:text-gray-400">
							Loading update history...
						</td>
					</tr>
				</tbody>
			</table>
		</div>
	</div>
	<script>
	// Placeholder JavaScript for update management
	function filterUpdates() {
		console.log('Filter updates by type');
		// TODO: Implement filtering logic
	}

	function toggleSelectAll() {
		const checkbox = document.getElementById('select-all-checkbox');
		const checkboxes = document.querySelectorAll('#available-updates-table input[type="checkbox"]');
		checkboxes.forEach(cb => cb.checked = checkbox.checked);
		updateInstallButton();
	}

	function updateInstallButton() {
		const checkboxes = document.querySelectorAll('#available-updates-table input[type="checkbox"]:checked');
		const btn = document.getElementById('install-selected-btn');
		if (btn) {
			btn.disabled = checkboxes.length === 0;
		}
	}

	function installSelectedUpdates() {
		const checkboxes = document.querySelectorAll('#available-updates-table input[type="checkbox"]:checked');
		const packages = Array.from(checkboxes).map(cb => cb.value);
		console.log('Installing packages:', packages);
		// TODO: Implement install functionality
		if (window.showToast) {
			window.showToast('Installing ' + packages.length + ' updates...', 'info', 3000);
		}
	}
	</script>
}
