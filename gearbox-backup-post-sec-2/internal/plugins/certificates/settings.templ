package certificates

import "github.com/sarg3nt/gearbox/internal/framework/templates/components"

// certificatesSettingsComponent renders the certificates plugin settings page.
templ certificatesSettingsComponent(config map[string]any) {
	{{ warningDays := getConfigInt(config, "warning_days", 30) }}
	{{ criticalDays := getConfigInt(config, "critical_days", 7) }}
	@components.SettingsSection("Certificate Settings", "Configure certificate expiration warning thresholds.") {
		@components.SettingsSelect(
			"warning_days",
			"Warning Threshold (days)",
			"Show warning status for certificates expiring within this many days.",
			[]components.SelectOption{
				{Value: "14", Label: "14 days", Selected: warningDays == 14},
				{Value: "30", Label: "30 days", Selected: warningDays == 30},
				{Value: "60", Label: "60 days", Selected: warningDays == 60},
				{Value: "90", Label: "90 days", Selected: warningDays == 90},
			},
		)
		@components.SettingsSelect(
			"critical_days",
			"Critical Threshold (days)",
			"Show critical status for certificates expiring within this many days.",
			[]components.SelectOption{
				{Value: "3", Label: "3 days", Selected: criticalDays == 3},
				{Value: "7", Label: "7 days", Selected: criticalDays == 7},
				{Value: "14", Label: "14 days", Selected: criticalDays == 14},
			},
		)
	}
}
