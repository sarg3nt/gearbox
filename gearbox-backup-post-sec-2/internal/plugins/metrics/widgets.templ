package metrics

import "fmt"

// CPUUsageGraphWidget renders the CPU usage time-series graph.
templ CPUUsageGraphWidget(serverID string, refreshSeconds int, showTitle bool) {
	<div class="bg-white dark:bg-slate-800 rounded-lg shadow p-6">
		if showTitle {
			<h3 class="text-lg font-semibold text-gray-900 dark:text-white mb-4">CPU Usage</h3>
		}
		<div
			hx-get={ fmt.Sprintf("/api/%s/metrics/cpu", serverID) }
			hx-trigger={ fmt.Sprintf("load, every %ds", refreshSeconds) }
			hx-swap="innerHTML"
			class="min-h-[200px] flex items-center justify-center"
		>
			<div class="animate-pulse text-gray-400">Loading CPU metrics...</div>
		</div>
	</div>
}

