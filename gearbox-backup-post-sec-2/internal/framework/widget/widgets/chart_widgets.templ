package widgets

import "fmt"

// LineChartWidget renders a line chart using Chart.js
templ LineChartWidget(id string, config map[string]any, data any) {
	<div class="bg-white dark:bg-slate-900 border border-gray-300 dark:border-slate-600 rounded-lg p-4">
		if title := getStringConfig(config, "title", ""); title != "" {
			<h3 class="text-lg font-semibold text-gray-800 dark:text-gray-100 mb-4">{ title }</h3>
		}
		<canvas id={ id } class="w-full" style={ fmt.Sprintf("height: %dpx", getIntConfig(config, "height", 300)) }></canvas>
		@lineChartScript(id, config, data)
	</div>
}

script lineChartScript(id string, config map[string]any, data any) {
	(function() {
		const ctx = document.getElementById(id);
		if (!ctx) return;

		const chartData = prepareChartData(data);

		new Chart(ctx, {
			type: 'line',
			data: chartData,
			options: {
				responsive: true,
				maintainAspectRatio: false,
				plugins: {
					legend: {
						display: config.legend !== false
					}
				},
				scales: {
					y: {
						beginAtZero: true,
						min: config.y_axis?.min,
						max: config.y_axis?.max
					}
				}
			}
		});
	})();
}

// BarChartWidget renders a bar chart
templ BarChartWidget(id string, config map[string]any, data any) {
	<div class="bg-white dark:bg-slate-900 border border-gray-300 dark:border-slate-600 rounded-lg p-4">
		if title := getStringConfig(config, "title", ""); title != "" {
			<h3 class="text-lg font-semibold text-gray-800 dark:text-gray-100 mb-4">{ title }</h3>
		}
		<canvas id={ id } class="w-full" style={ fmt.Sprintf("height: %dpx", getIntConfig(config, "height", 300)) }></canvas>
		@barChartScript(id, config, data)
	</div>
}

script barChartScript(id string, config map[string]any, data any) {
	(function() {
		const ctx = document.getElementById(id);
		if (!ctx) return;

		const chartData = prepareChartData(data);
		const orientation = config.orientation || 'vertical';

		new Chart(ctx, {
			type: 'bar',
			data: chartData,
			options: {
				indexAxis: orientation === 'horizontal' ? 'y' : 'x',
				responsive: true,
				maintainAspectRatio: false,
				plugins: {
					legend: { display: config.legend !== false }
				}
			}
		});
	})();
}

// DoughnutChartWidget renders a doughnut chart
templ DoughnutChartWidget(id string, config map[string]any, data any) {
	<div class="bg-white dark:bg-slate-900 border border-gray-300 dark:border-slate-600 rounded-lg p-4">
		if title := getStringConfig(config, "title", ""); title != "" {
			<h3 class="text-lg font-semibold text-gray-800 dark:text-gray-100 mb-4">{ title }</h3>
		}
		<div class="flex items-center justify-center">
			<canvas id={ id } style="max-width: 400px; max-height: 400px;"></canvas>
		</div>
		@doughnutChartScript(id, config, data)
	</div>
}

script doughnutChartScript(id string, config map[string]any, data any) {
	(function() {
		const ctx = document.getElementById(id);
		if (!ctx) return;

		const chartData = prepareChartData(data);

		new Chart(ctx, {
			type: 'doughnut',
			data: chartData,
			options: {
				responsive: true,
				maintainAspectRatio: true,
				plugins: {
					legend: {
						display: config.show_legend !== false,
						position: 'bottom'
					}
				}
			}
		});
	})();
}

// DataTableWidget renders a sortable/filterable table
templ DataTableWidget(id string, config map[string]any, data any) {
	<div class="bg-white dark:bg-slate-900 border border-gray-300 dark:border-slate-600 rounded-lg overflow-hidden">
		if title := getStringConfig(config, "title", ""); title != "" {
			<div class="px-4 py-3 border-b border-gray-300 dark:border-slate-600">
				<h3 class="text-lg font-semibold text-gray-800 dark:text-gray-100">{ title }</h3>
			</div>
		}

		<!-- Search bar -->
		if getBoolConfig(config, "search", false) {
			<div class="px-4 py-2 border-b border-gray-200 dark:border-slate-700">
				<input
					type="text"
					id={ fmt.Sprintf("%s-search", id) }
					placeholder={ getStringConfig(config, "search_placeholder", "Search...") }
					class="w-full px-3 py-2 border border-gray-300 dark:border-slate-600 rounded bg-white dark:bg-slate-900 text-gray-900 dark:text-gray-100"
					oninput={ searchTable(id) }
				/>
			</div>
		}

		<!-- Table -->
		<div class="overflow-x-auto">
			<table id={ id } class="w-full">
				<thead class="bg-gray-50 dark:bg-slate-800">
					<tr>
						if columns, ok := config["columns"].([]any); ok {
							for _, col := range columns {
								if colMap, ok := col.(map[string]any); ok {
									<th class="px-4 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-400 uppercase tracking-wider">
										{ getStringConfig(colMap, "label", "") }
									</th>
								}
							}
						}
					</tr>
				</thead>
				<tbody class="divide-y divide-gray-200 dark:divide-slate-700">
					@renderTableRows(data, config)
				</tbody>
			</table>
		</div>

		<!-- Pagination -->
		if getBoolConfig(config, "pagination", false) {
			<div class="px-4 py-3 bg-gray-50 dark:bg-slate-800 border-t border-gray-200 dark:border-slate-700">
				<div class="flex items-center justify-between">
					<div class="text-sm text-gray-700 dark:text-gray-300">
						Showing <span class="font-medium">1</span> to <span class="font-medium">10</span> of <span class="font-medium">100</span> results
					</div>
					<div class="flex gap-2">
						<button class="px-3 py-1 border border-gray-300 dark:border-slate-600 rounded hover:bg-gray-100 dark:hover:bg-slate-700">Previous</button>
						<button class="px-3 py-1 border border-gray-300 dark:border-slate-600 rounded hover:bg-gray-100 dark:hover:bg-slate-700">Next</button>
					</div>
				</div>
			</div>
		}
	</div>
}

templ renderTableRows(data any, config map[string]any) {
	if dataSlice, ok := data.([]map[string]any); ok {
		for _, row := range dataSlice {
			<tr class="hover:bg-gray-50 dark:hover:bg-slate-800">
				if columns, ok := config["columns"].([]any); ok {
					for _, col := range columns {
						if colMap, ok := col.(map[string]any); ok {
							if field := getStringConfig(colMap, "field", ""); field != "" {
								<td class="px-4 py-3 text-sm text-gray-900 dark:text-gray-100">
									if val, ok := row[field]; ok {
										{ fmt.Sprintf("%v", val) }
									}
								</td>
							}
						}
					}
				}
			</tr>
		}
	}
}

script searchTable(tableId string) {
	const searchInput = document.getElementById(`${tableId}-search`);
	const table = document.getElementById(tableId);
	const filter = searchInput.value.toUpperCase();
	const rows = table.getElementsByTagName('tr');

	for (let i = 1; i < rows.length; i++) {
		const row = rows[i];
		const text = row.textContent || row.innerText;
		row.style.display = text.toUpperCase().indexOf(filter) > -1 ? '' : 'none';
	}
}

// Helper function for chart data preparation (would be in JS)
templ ChartJSHelpers() {
	<script>
	function prepareChartData(data) {
		if (!data) return { labels: [], datasets: [] };

		// Handle different data formats
		if (Array.isArray(data)) {
			return {
				labels: data.map((d, i) => d.label || `Item ${i+1}`),
				datasets: [{
					data: data.map(d => d.value || d),
					backgroundColor: data.map((d, i) => d.color || getChartColor(i)),
					borderColor: data.map((d, i) => d.borderColor || getChartColor(i)),
					borderWidth: 2
				}]
			};
		}

		return data;
	}

	function getChartColor(index) {
		const colors = [
			'#3b82f6', '#10b981', '#f59e0b', '#ef4444',
			'#8b5cf6', '#ec4899', '#06b6d4', '#84cc16'
		];
		return colors[index % colors.length];
	}
	</script>
}
