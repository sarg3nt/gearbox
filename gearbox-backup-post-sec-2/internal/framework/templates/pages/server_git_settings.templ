package pages

import (
	"github.com/sarg3nt/gearbox/internal/framework/database"
	"github.com/sarg3nt/gearbox/internal/framework/models"
	"github.com/sarg3nt/gearbox/internal/framework/templates/layouts"
)

// ServerGitSettingsPage renders the git settings page for a server.
templ ServerGitSettingsPage(user *models.User, server *database.ServerDB, haproxyGit *database.ServerGitConfig, firewallGit *database.ServerGitConfig, successMsg, errorMsg string) {
	@layouts.Base("Git Settings", user, "/settings") {
		<!-- Hidden container for page header content -->
		<div id="page-header-source" class="hidden">
			<div class="flex items-center">
				<h2 class="text-xl font-bold text-gray-800 dark:text-gray-100">Git Settings</h2>
				<span class="ml-3 text-sm text-gray-500 dark:text-gray-400">{ server.Name }</span>
			</div>
			<div class="flex-1"></div>
			<a href="/settings/servers" class="text-sm text-blue-600 dark:text-blue-400 hover:underline flex items-center">
				<svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
				</svg>
				Back to Servers
			</a>
		</div>

		<div class="max-w-4xl mx-auto px-4 py-8">
			<!-- Info -->
			<div class="bg-blue-50 dark:bg-blue-900/20 border border-blue-200 dark:border-blue-800 rounded-lg p-4 mb-6">
				<div class="flex items-start gap-3">
					<svg class="w-5 h-5 text-blue-500 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
					</svg>
					<div class="text-sm text-blue-700 dark:text-blue-300">
						<p class="font-medium mb-1">Git-Based Configuration Management</p>
						<p class="text-xs">
							Configure git repositories to pull HAProxy and firewall configurations.
							When auto-apply is enabled, changes from git will be automatically applied after validation.
							When disabled, changes will be available for manual review before applying.
						</p>
					</div>
				</div>
			</div>

			<form method="POST" action={ templ.SafeURL("/settings/servers/" + server.ServerID + "/git") } class="space-y-8" autocomplete="off">
				<!-- HAProxy Config Section -->
				<div class="bg-white dark:bg-slate-800 rounded-lg shadow p-6">
					<h3 class="text-lg font-semibold text-gray-900 dark:text-gray-100 mb-4 flex items-center gap-2">
						<svg class="w-5 h-5 text-blue-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"></path>
						</svg>
						HAProxy Configuration
					</h3>

					<div class="space-y-4">
						<div>
							<label for="haproxy_git_repo" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">
								Git Repository URL
							</label>
							<input
								type="url"
								id="haproxy_git_repo"
								name="haproxy_git_repo"
								value={ getGitRepoURL(haproxyGit) }
								placeholder="https://github.com/user/repo.git"
								autocomplete="off"
								class="w-full px-4 py-2 border border-gray-300 dark:border-slate-600 rounded-lg bg-white dark:bg-slate-700 text-gray-900 dark:text-gray-100 focus:ring-2 focus:ring-blue-500 focus:border-transparent"
							/>
							<p class="mt-1 text-xs text-gray-500 dark:text-gray-400">
								Leave empty to disable git-based config management for HAProxy
							</p>
						</div>

						<div class="grid grid-cols-2 gap-4">
							<div>
								<label for="haproxy_git_branch" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">
									Branch
								</label>
								<input
									type="text"
									id="haproxy_git_branch"
									name="haproxy_git_branch"
									value={ getGitBranch(haproxyGit) }
									placeholder="main"
									autocomplete="off"
									class="w-full px-4 py-2 border border-gray-300 dark:border-slate-600 rounded-lg bg-white dark:bg-slate-700 text-gray-900 dark:text-gray-100 focus:ring-2 focus:ring-blue-500 focus:border-transparent"
								/>
							</div>
							<div>
								<label for="haproxy_git_path" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">
									File Path in Repository
								</label>
								<input
									type="text"
									id="haproxy_git_path"
									name="haproxy_git_path"
									value={ getGitFilePath(haproxyGit) }
									placeholder="haproxy/haproxy.cfg"
									autocomplete="off"
									class="w-full px-4 py-2 border border-gray-300 dark:border-slate-600 rounded-lg bg-white dark:bg-slate-700 text-gray-900 dark:text-gray-100 focus:ring-2 focus:ring-blue-500 focus:border-transparent"
								/>
							</div>
						</div>

						<div>
							<label for="haproxy_git_pat" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">
								Personal Access Token (for private repos)
							</label>
							<input
								type="password"
								id="haproxy_git_pat"
								name="haproxy_git_pat"
								placeholder={ getPatPlaceholder(haproxyGit) }
								autocomplete="new-password"
								class="w-full px-4 py-2 border border-gray-300 dark:border-slate-600 rounded-lg bg-white dark:bg-slate-700 text-gray-900 dark:text-gray-100 focus:ring-2 focus:ring-blue-500 focus:border-transparent"
							/>
							<p class="mt-1 text-xs text-gray-500 dark:text-gray-400">
								Leave empty to keep existing token or for public repositories
							</p>
						</div>

						<div class="flex items-center gap-3">
							<input
								type="checkbox"
								id="haproxy_auto_apply"
								name="haproxy_auto_apply"
								if haproxyGit != nil && haproxyGit.AutoApplyEnabled {
									checked
								}
								class="w-4 h-4 text-blue-600 border-gray-300 rounded focus:ring-blue-500"
							/>
							<label for="haproxy_auto_apply" class="text-sm text-gray-700 dark:text-gray-300">
								Auto-apply valid configurations from git
							</label>
						</div>

						if haproxyGit != nil && haproxyGit.LastSyncAt != nil {
							<div class="pt-4 border-t border-gray-200 dark:border-slate-700">
								<p class="text-sm text-gray-600 dark:text-gray-400">
									<span class="font-medium">Last sync:</span> { haproxyGit.LastSyncAt.Format("2006-01-02 15:04:05") }
									if haproxyGit.LastSyncStatus != "" {
										<span class={ "ml-2 px-2 py-0.5 rounded text-xs",
											templ.KV("bg-green-100 text-green-700 dark:bg-green-900 dark:text-green-300", haproxyGit.LastSyncStatus == "success"),
											templ.KV("bg-yellow-100 text-yellow-700 dark:bg-yellow-900 dark:text-yellow-300", haproxyGit.LastSyncStatus == "pending_review"),
											templ.KV("bg-red-100 text-red-700 dark:bg-red-900 dark:text-red-300", haproxyGit.LastSyncStatus == "failed") }>
											{ haproxyGit.LastSyncStatus }
										</span>
									}
								</p>
								if haproxyGit.LastSyncError != "" {
									<p class="mt-1 text-xs text-red-600 dark:text-red-400">{ haproxyGit.LastSyncError }</p>
								}
							</div>
						}
					</div>
				</div>

				<!-- Firewall Config Section -->
				<div class="bg-white dark:bg-slate-800 rounded-lg shadow p-6">
					<h3 class="text-lg font-semibold text-gray-900 dark:text-gray-100 mb-4 flex items-center gap-2">
						<svg class="w-5 h-5 text-orange-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"></path>
						</svg>
						Firewall Configuration (nftables)
					</h3>

					<div class="space-y-4">
						<div>
							<label for="firewall_git_repo" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">
								Git Repository URL
							</label>
							<input
								type="url"
								id="firewall_git_repo"
								name="firewall_git_repo"
								value={ getGitRepoURL(firewallGit) }
								placeholder="https://github.com/user/repo.git"
								autocomplete="off"
								class="w-full px-4 py-2 border border-gray-300 dark:border-slate-600 rounded-lg bg-white dark:bg-slate-700 text-gray-900 dark:text-gray-100 focus:ring-2 focus:ring-blue-500 focus:border-transparent"
							/>
						</div>

						<div class="grid grid-cols-2 gap-4">
							<div>
								<label for="firewall_git_branch" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">
									Branch
								</label>
								<input
									type="text"
									id="firewall_git_branch"
									name="firewall_git_branch"
									value={ getGitBranch(firewallGit) }
									placeholder="main"
									autocomplete="off"
									class="w-full px-4 py-2 border border-gray-300 dark:border-slate-600 rounded-lg bg-white dark:bg-slate-700 text-gray-900 dark:text-gray-100 focus:ring-2 focus:ring-blue-500 focus:border-transparent"
								/>
							</div>
							<div>
								<label for="firewall_git_path" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">
									File Path in Repository
								</label>
								<input
									type="text"
									id="firewall_git_path"
									name="firewall_git_path"
									value={ getGitFilePath(firewallGit) }
									placeholder="nftables/nftables.conf"
									autocomplete="off"
									class="w-full px-4 py-2 border border-gray-300 dark:border-slate-600 rounded-lg bg-white dark:bg-slate-700 text-gray-900 dark:text-gray-100 focus:ring-2 focus:ring-blue-500 focus:border-transparent"
								/>
							</div>
						</div>

						<div>
							<label for="firewall_git_pat" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">
								Personal Access Token (for private repos)
							</label>
							<input
								type="password"
								id="firewall_git_pat"
								name="firewall_git_pat"
								placeholder={ getPatPlaceholder(firewallGit) }
								autocomplete="new-password"
								class="w-full px-4 py-2 border border-gray-300 dark:border-slate-600 rounded-lg bg-white dark:bg-slate-700 text-gray-900 dark:text-gray-100 focus:ring-2 focus:ring-blue-500 focus:border-transparent"
							/>
						</div>

						<div class="flex items-center gap-3">
							<input
								type="checkbox"
								id="firewall_auto_apply"
								name="firewall_auto_apply"
								if firewallGit != nil && firewallGit.AutoApplyEnabled {
									checked
								}
								class="w-4 h-4 text-blue-600 border-gray-300 rounded focus:ring-blue-500"
							/>
							<label for="firewall_auto_apply" class="text-sm text-gray-700 dark:text-gray-300">
								Auto-apply valid configurations from git
							</label>
						</div>

						if firewallGit != nil && firewallGit.LastSyncAt != nil {
							<div class="pt-4 border-t border-gray-200 dark:border-slate-700">
								<p class="text-sm text-gray-600 dark:text-gray-400">
									<span class="font-medium">Last sync:</span> { firewallGit.LastSyncAt.Format("2006-01-02 15:04:05") }
									if firewallGit.LastSyncStatus != "" {
										<span class={ "ml-2 px-2 py-0.5 rounded text-xs",
											templ.KV("bg-green-100 text-green-700 dark:bg-green-900 dark:text-green-300", firewallGit.LastSyncStatus == "success"),
											templ.KV("bg-yellow-100 text-yellow-700 dark:bg-yellow-900 dark:text-yellow-300", firewallGit.LastSyncStatus == "pending_review"),
											templ.KV("bg-red-100 text-red-700 dark:bg-red-900 dark:text-red-300", firewallGit.LastSyncStatus == "failed") }>
											{ firewallGit.LastSyncStatus }
										</span>
									}
								</p>
							</div>
						}
					</div>
				</div>

				<!-- Submit Button -->
				<div class="flex justify-end gap-4">
					<a
						href="/settings/servers"
						class="px-6 py-2 border border-gray-300 dark:border-slate-600 text-gray-700 dark:text-gray-300 rounded-lg hover:bg-gray-50 dark:hover:bg-slate-700"
					>
						Cancel
					</a>
					<button
						type="submit"
						class="px-6 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700"
					>
						Save Settings
					</button>
				</div>
			</form>
		</div>

		<script>
		function setupPageHeader() {
			const source = document.getElementById('page-header-source');
			const target = document.getElementById('header-page-content');
			if (source && target) {
				while (source.firstChild) {
					target.appendChild(source.firstChild);
				}
				source.remove();
			}
		}
		document.addEventListener('DOMContentLoaded', setupPageHeader);
		</script>
	}
}

// Helper functions
func getGitRepoURL(config *database.ServerGitConfig) string {
	if config == nil {
		return ""
	}
	return config.GitRepoURL
}

func getGitBranch(config *database.ServerGitConfig) string {
	if config == nil {
		return "main"
	}
	if config.GitBranch == "" {
		return "main"
	}
	return config.GitBranch
}

func getGitFilePath(config *database.ServerGitConfig) string {
	if config == nil {
		return ""
	}
	return config.GitFilePath
}

func getPatPlaceholder(config *database.ServerGitConfig) string {
	if config != nil && len(config.GitPATEncrypted) > 0 {
		return "(configured - leave empty to keep)"
	}
	return "ghp_xxxx..."
}
