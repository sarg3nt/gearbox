package pages

import (
	"fmt"
	"github.com/sarg3nt/gearbox/internal/framework/agent"
	"github.com/sarg3nt/gearbox/internal/framework/database"
	"github.com/sarg3nt/gearbox/internal/framework/models"
	"github.com/sarg3nt/gearbox/internal/framework/ui"
	"github.com/sarg3nt/gearbox/internal/framework/templates/layouts"
)

// LogSourceInfo combines agent log source with enabled status.
type LogSourceInfo struct {
	Name        string
	DisplayName string
	Type        string
	Unit        string // Systemd unit name - if set, this is a service log
	Enabled     bool
}

// IsServiceLog returns true if this log source is for a systemd service.
func (l LogSourceInfo) IsServiceLog() bool {
	return l.Unit != ""
}

// LogSettingsPage renders the log source settings page.
templ LogSettingsPage(user *models.User, server *database.ServerDB, sources []LogSourceInfo, errorMsg string, successMsg string) {
	@layouts.Base("Logs Settings", user, "/settings") {
		<div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
			<div class="mb-6">
				<div class="flex items-center justify-between">
					<div>
						<h1 class="text-3xl font-bold text-gray-900 dark:text-white">Logs Settings</h1>
						<p class="mt-2 text-sm text-gray-600 dark:text-gray-400">
							Configure which log sources are available in the log viewer for <span class="font-medium">{ server.Name }</span>
						</p>
					</div>
					<a
						href="/settings/servers"
						class="text-sm text-gray-500 dark:text-gray-400 hover:text-gray-700 dark:hover:text-gray-300"
					>
						&larr; Back to Servers
					</a>
				</div>
			</div>

			if errorMsg != "" {
				@ui.ToastOnLoad(errorMsg, "error")
			}

			if successMsg != "" {
				@ui.ToastOnLoad(successMsg, "success")
			}

			<form method="POST" action={ templ.SafeURL(fmt.Sprintf("/settings/servers/%d/logs", server.ID)) }>
				<div class="bg-white dark:bg-slate-800 rounded-lg shadow overflow-hidden">
					<div class="px-6 py-4 border-b border-gray-200 dark:border-gray-700">
						<h2 class="text-lg font-medium text-gray-900 dark:text-white">Available Log Sources</h2>
						<p class="mt-1 text-sm text-gray-500 dark:text-gray-400">
							Select which log sources should be available in the log viewer dropdown.
						</p>
					</div>

					if len(sources) == 0 {
						<div class="px-6 py-8 text-center">
							<svg class="mx-auto h-12 w-12 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
							</svg>
							<p class="mt-4 text-sm text-gray-500 dark:text-gray-400">
								Unable to fetch log sources from the agent. Make sure the server is enabled and the agent is running.
							</p>
						</div>
					} else {
						<div class="divide-y divide-gray-200 dark:divide-gray-700">
							for _, source := range sources {
								<label class="flex items-center px-6 py-4 hover:bg-gray-50 dark:hover:bg-slate-700 cursor-pointer">
									<input
										type="checkbox"
										name="log_sources"
										value={ source.Name }
										if source.Enabled {
											checked
										}
										class="h-4 w-4 rounded border-gray-300 dark:border-gray-600 text-blue-600 focus:ring-blue-500 dark:bg-slate-700"
									/>
									<div class="ml-3 flex-1">
										<div class="text-sm font-medium text-gray-900 dark:text-white">
											{ source.DisplayName }
										</div>
										<div class="text-sm text-gray-500 dark:text-gray-400">
											{ source.Name }
											if source.Type != "" {
												<span class="ml-2 text-xs bg-gray-100 dark:bg-slate-600 px-2 py-0.5 rounded">
													{ source.Type }
												</span>
											}
										</div>
									</div>
								</label>
							}
						</div>
					}
				</div>

				if len(sources) > 0 {
					<div class="mt-6 flex items-center justify-between">
						<div class="flex items-center space-x-4">
							<button
								type="button"
								onclick="selectAll()"
								class="text-sm text-blue-600 dark:text-blue-400 hover:text-blue-800 dark:hover:text-blue-300"
							>
								Select All
							</button>
							<button
								type="button"
								onclick="selectNone()"
								class="text-sm text-blue-600 dark:text-blue-400 hover:text-blue-800 dark:hover:text-blue-300"
							>
								Select None
							</button>
						</div>
						<button
							type="submit"
							class="inline-flex items-center px-4 py-2 border border-transparent text-sm font-medium rounded-md shadow-sm text-white bg-blue-600 hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500"
						>
							Save Settings
						</button>
					</div>
				}
			</form>
		</div>

		<script>
			function selectAll() {
				document.querySelectorAll('input[name="log_sources"]').forEach(cb => cb.checked = true);
			}
			function selectNone() {
				document.querySelectorAll('input[name="log_sources"]').forEach(cb => cb.checked = false);
			}
		</script>
	}
}

// FormatLogSourceName creates a display name from log source name.
func FormatLogSourceName(name string) string {
	// Convert common log source names to friendly display names
	switch name {
	case "haproxy":
		return "HAProxy"
	case "gearbox-agent":
		return "Gearbox Agent"
	case "system":
		return "System"
	case "fail2ban":
		return "Fail2ban"
	case "fail2ban-log":
		return "Fail2ban Log"
	case "nftables":
		return "NFTables"
	case "firewall":
		return "Firewall"
	case "auth":
		return "Authentication"
	case "ssh":
		return "SSH"
	case "kernel":
		return "Kernel"
	case "boot":
		return "Boot"
	default:
		return name
	}
}

// BuildLogSourceInfoList creates a list of LogSourceInfo from agent sources and enabled settings.
func BuildLogSourceInfoList(agentSources []agent.LogSource, enabledSources []database.LogSourceSetting) []LogSourceInfo {
	enabledMap := make(map[string]string)
	for _, s := range enabledSources {
		enabledMap[s.LogName] = s.DisplayName
	}

	hasSettings := len(enabledSources) > 0

	var result []LogSourceInfo
	for _, src := range agentSources {
		displayName := FormatLogSourceName(src.Name)
		if dn, ok := enabledMap[src.Name]; ok {
			displayName = dn
		}

		// If no settings exist, enable haproxy and system by default
		enabled := false
		if hasSettings {
			_, enabled = enabledMap[src.Name]
		} else {
			enabled = src.Name == "haproxy" || src.Name == "system"
		}

		result = append(result, LogSourceInfo{
			Name:        src.Name,
			DisplayName: displayName,
			Type:        src.Type,
			Unit:        src.Unit,
			Enabled:     enabled,
		})
	}
	return result
}
