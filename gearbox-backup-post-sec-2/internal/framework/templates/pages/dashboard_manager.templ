package pages

import (
	"fmt"
	"github.com/sarg3nt/gearbox/internal/framework/dashboard"
	"github.com/sarg3nt/gearbox/internal/framework/models"
	"github.com/sarg3nt/gearbox/internal/framework/templates/layouts"
)

// DashboardManagerPage renders the dashboard management interface in Settings
templ DashboardManagerPage(data dashboard.DashboardManagerData, user *models.User, currentPath string) {
	@layouts.Base("Dashboard Manager", user, currentPath) {
		<div class="max-w-6xl mx-auto">
			<!-- Header -->
			<div class="mb-8">
				<h1 class="text-3xl font-bold text-gray-900 dark:text-gray-100">Dashboard Manager</h1>
				<p class="text-gray-600 dark:text-gray-400 mt-2">Create custom dashboards or enable plugin-provided dashboards</p>
			</div>

			<!-- Quick Actions -->
			<div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-8">
				<a
					href="/dashboards/create?redirect=settings"
					class="p-6 bg-gradient-to-br from-blue-500 to-blue-600 hover:from-blue-600 hover:to-blue-700 text-white rounded-lg shadow-lg transition-all hover:shadow-xl"
				>
					<div class="flex items-center gap-4">
						<svg class="w-12 h-12" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
						</svg>
						<div>
							<h3 class="text-xl font-semibold">Create New Dashboard</h3>
							<p class="text-blue-100 text-sm mt-1">Start with a blank canvas and build your custom view</p>
						</div>
					</div>
				</a>

				<a
					href="/dashboards/templates"
					class="p-6 bg-gradient-to-br from-purple-500 to-purple-600 hover:from-purple-600 hover:to-purple-700 text-white rounded-lg shadow-lg transition-all hover:shadow-xl"
				>
					<div class="flex items-center gap-4">
						<svg class="w-12 h-12" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 5a1 1 0 011-1h14a1 1 0 011 1v2a1 1 0 01-1 1H5a1 1 0 01-1-1V5zM4 13a1 1 0 011-1h6a1 1 0 011 1v6a1 1 0 01-1 1H5a1 1 0 01-1-1v-6zM16 13a1 1 0 011-1h2a1 1 0 011 1v6a1 1 0 01-1 1h-2a1 1 0 01-1-1v-6z"></path>
						</svg>
						<div>
							<h3 class="text-xl font-semibold">Browse Templates</h3>
							<p class="text-purple-100 text-sm mt-1">Choose from pre-built dashboard templates</p>
						</div>
					</div>
				</a>
			</div>

			<!-- Tabs -->
			<div class="mb-6 border-b border-gray-200 dark:border-slate-700">
				<nav class="-mb-px flex gap-6">
					<button
						onclick="switchTab('custom')"
						id="tab-custom"
						class="tab-button active py-4 px-1 border-b-2 border-blue-500 font-medium text-sm text-blue-600 dark:text-blue-400"
					>
						My Dashboards ({ fmt.Sprintf("%d", len(data.UserDashboards)) })
					</button>
					<button
						onclick="switchTab('plugins')"
						id="tab-plugins"
						class="tab-button py-4 px-1 border-b-2 border-transparent font-medium text-sm text-gray-500 hover:text-gray-700 hover:border-gray-300 dark:text-gray-400 dark:hover:text-gray-300"
					>
						Plugin Dashboards ({ fmt.Sprintf("%d", len(data.PluginDashboards)) })
					</button>
				</nav>
			</div>

			<!-- Custom Dashboards Tab -->
			<div id="tab-content-custom" class="tab-content">
				@CustomDashboardsList(data.UserDashboards)
			</div>

			<!-- Plugin Dashboards Tab -->
			<div id="tab-content-plugins" class="tab-content hidden">
				@PluginDashboardsList(data.PluginDashboards)
			</div>
		</div>

		@DashboardManagerScript()
	}
}

// CustomDashboardsList renders the list of user-created dashboards
templ CustomDashboardsList(dashboards []dashboard.DashboardMetadata) {
	<div class="space-y-4">
		if len(dashboards) == 0 {
			<div class="text-center py-12 bg-gray-50 dark:bg-slate-900 rounded-lg border-2 border-dashed border-gray-300 dark:border-slate-600">
				<svg class="w-16 h-16 mx-auto text-gray-400 mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 5a1 1 0 011-1h14a1 1 0 011 1v2a1 1 0 01-1 1H5a1 1 0 01-1-1V5zM4 13a1 1 0 011-1h6a1 1 0 011 1v6a1 1 0 01-1 1H5a1 1 0 01-1-1v-6zM16 13a1 1 0 011-1h2a1 1 0 011 1v6a1 1 0 01-1 1h-2a1 1 0 01-1-1v-6z"></path>
				</svg>
				<h3 class="text-lg font-semibold text-gray-700 dark:text-gray-300 mb-2">No Custom Dashboards</h3>
				<p class="text-gray-600 dark:text-gray-400 mb-4">Create your first dashboard to get started</p>
				<a href="/dashboards/create?redirect=settings" class="inline-block px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white rounded-lg">
					Create Dashboard
				</a>
			</div>
		} else {
			<div id="dashboard-sortable" class="space-y-3">
				for _, dash := range dashboards {
					@DraggableDashboardCard(dash, true)
				}
			</div>
			<p class="text-sm text-gray-500 dark:text-gray-400 mt-4">
				💡 Drag dashboards to reorder them in the navigation
			</p>
		}
	</div>
}

// PluginDashboardsList renders plugin-provided dashboards
templ PluginDashboardsList(dashboards []dashboard.PluginDashboardInfo) {
	<div class="space-y-4">
		if len(dashboards) == 0 {
			<div class="text-center py-12 bg-gray-50 dark:bg-slate-900 rounded-lg border border-gray-300 dark:border-slate-600">
				<svg class="w-16 h-16 mx-auto text-gray-400 mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"></path>
				</svg>
				<h3 class="text-lg font-semibold text-gray-700 dark:text-gray-300 mb-2">No Plugin Dashboards Available</h3>
				<p class="text-gray-600 dark:text-gray-400">Install plugins that provide dashboards to see them here</p>
			</div>
		} else {
			<div class="grid grid-cols-1 md:grid-cols-2 gap-4">
				for _, dash := range dashboards {
					@PluginDashboardCard(dash)
				}
			</div>
		}
	</div>
}

// DraggableDashboardCard renders a single dashboard card with optional drag handle
templ DraggableDashboardCard(dash dashboard.DashboardMetadata, draggable bool) {
	<div
		class="dashboard-item bg-white dark:bg-slate-900 border border-gray-300 dark:border-slate-600 rounded-lg p-4 hover:shadow-md transition-shadow"
		data-slug={ dash.Slug }
		if draggable {
			draggable="true"
		}
	>
		<div class="flex items-center gap-4">
			<!-- Drag Handle -->
			if draggable {
				<div class="cursor-move text-gray-400 hover:text-gray-600">
					<svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
						<path d="M9 3h2v2H9V3zm0 4h2v2H9V7zm0 4h2v2H9v-2zm0 4h2v2H9v-2zm0 4h2v2H9v-2zm4-16h2v2h-2V3zm0 4h2v2h-2V7zm0 4h2v2h-2v-2zm0 4h2v2h-2v-2zm0 4h2v2h-2v-2z"></path>
					</svg>
				</div>
			}

			<!-- Dashboard Info -->
			<div class="flex-1 min-w-0">
				<h3 class="text-lg font-semibold text-gray-900 dark:text-gray-100 truncate">{ dash.Name }</h3>
				if dash.Description != "" {
					<p class="text-sm text-gray-600 dark:text-gray-400 mt-1">{ dash.Description }</p>
				}
				<div class="flex items-center gap-2 mt-2 text-xs text-gray-500 dark:text-gray-400">
					<span>{ dash.CreatedBy }</span>
					<span>•</span>
					<span>Updated { dash.UpdatedAt.Format("Jan 2, 2006") }</span>
				</div>
			</div>

			<!-- Actions -->
			<div class="flex gap-2">
				<a
					href={ templ.SafeURL("/dashboards/" + dash.Slug) }
					class="p-2 hover:bg-gray-100 dark:hover:bg-slate-800 rounded-lg"
					title="View"
				>
					<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path>
					</svg>
				</a>
				<a
					href={ templ.SafeURL("/dashboards/" + dash.Slug + "/edit") }
					class="p-2 hover:bg-blue-100 dark:hover:bg-blue-900/20 text-blue-600 dark:text-blue-400 rounded-lg"
					title="Edit"
				>
					<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
					</svg>
				</a>
				if dash.Editable {
					<button
						onclick={ deleteDashboardFromManager(dash.Slug) }
						class="p-2 hover:bg-red-100 dark:hover:bg-red-900/20 text-red-600 dark:text-red-400 rounded-lg"
						title="Delete"
					>
						<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
						</svg>
					</button>
				}
			</div>
		</div>
	</div>
}

// PluginDashboardCard renders a plugin dashboard card
templ PluginDashboardCard(dash dashboard.PluginDashboardInfo) {
	<div class="bg-white dark:bg-slate-900 border border-gray-300 dark:border-slate-600 rounded-lg p-4">
		<div class="flex items-start justify-between mb-3">
			<div class="flex-1">
				<div class="flex items-center gap-2 mb-1">
					<h3 class="text-lg font-semibold text-gray-900 dark:text-gray-100">{ dash.Name }</h3>
					<span class="px-2 py-0.5 text-xs font-semibold bg-purple-100 dark:bg-purple-900/30 text-purple-600 dark:text-purple-400 rounded">
						{ dash.PluginName }
					</span>
				</div>
				<p class="text-sm text-gray-600 dark:text-gray-400">{ dash.Description }</p>
			</div>
			<!-- Enable Toggle -->
			<label class="relative inline-flex items-center cursor-pointer">
				<input
					type="checkbox"
					class="sr-only peer"
					checked?={ dash.Enabled }
					onchange={ togglePluginDashboard(dash.Slug) }
				/>
				<div class="w-11 h-6 bg-gray-200 peer-focus:outline-none peer-focus:ring-4 peer-focus:ring-blue-300 dark:peer-focus:ring-blue-800 rounded-full peer dark:bg-gray-700 peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all dark:border-gray-600 peer-checked:bg-blue-600"></div>
			</label>
		</div>

		if dash.Enabled {
			<div class="flex gap-2 pt-3 border-t border-gray-200 dark:border-slate-700">
				<a
					href={ templ.SafeURL("/dashboards/" + dash.Slug) }
					class="flex-1 px-3 py-2 text-sm text-center bg-blue-50 dark:bg-blue-900/20 text-blue-600 dark:text-blue-400 hover:bg-blue-100 dark:hover:bg-blue-900/30 rounded-lg"
				>
					View Dashboard
				</a>
			</div>
		}
	</div>
}

// DashboardManagerScript provides the manager JavaScript
templ DashboardManagerScript() {
	<script src="https://cdn.jsdelivr.net/npm/sortablejs@1.15.0/Sortable.min.js"></script>
	<script>
	// Tab switching
	function switchTab(tab) {
		// Update buttons
		document.querySelectorAll('.tab-button').forEach(btn => {
			btn.classList.remove('border-blue-500', 'text-blue-600', 'dark:text-blue-400', 'active');
			btn.classList.add('border-transparent', 'text-gray-500', 'dark:text-gray-400');
		});
		document.getElementById(`tab-${tab}`).classList.add('border-blue-500', 'text-blue-600', 'dark:text-blue-400', 'active');
		document.getElementById(`tab-${tab}`).classList.remove('border-transparent', 'text-gray-500', 'dark:text-gray-400');

		// Update content
		document.querySelectorAll('.tab-content').forEach(content => {
			content.classList.add('hidden');
		});
		document.getElementById(`tab-content-${tab}`).classList.remove('hidden');
	}

	// Initialize Sortable for dashboard reordering
	document.addEventListener('DOMContentLoaded', function() {
		const sortable = document.getElementById('dashboard-sortable');
		if (sortable) {
			Sortable.create(sortable, {
				animation: 150,
				handle: '.cursor-move',
				onEnd: function(evt) {
					saveDashboardOrder();
				}
			});
		}
	});

	// Save dashboard order
	function saveDashboardOrder() {
		const items = document.querySelectorAll('.dashboard-item');
		const order = Array.from(items).map(item => item.dataset.slug);

		fetch('/api/dashboards/order', {
			method: 'POST',
			headers: { 'Content-Type': 'application/json' },
			body: JSON.stringify({ order: order })
		})
		.then(response => {
			if (!response.ok) {
				console.error('Failed to save dashboard order');
			}
		});
	}

	// Toggle plugin dashboard
	function togglePluginDashboard(slug) {
		const checkbox = event.target;
		const enabled = checkbox.checked;

		fetch(`/api/dashboards/${slug}/toggle`, {
			method: 'POST',
			headers: { 'Content-Type': 'application/json' },
			body: JSON.stringify({ enabled: enabled })
		})
		.then(response => {
			if (response.ok) {
				window.location.reload();
			} else {
				checkbox.checked = !enabled;
				showAlertDialog({
					title: 'Error',
					message: 'Failed to toggle dashboard',
					type: 'error'
				});
			}
		});
	}

	// Delete dashboard
	async function deleteDashboard(slug) {
		const confirmed = await showConfirmDialog({
			title: 'Delete Dashboard',
			message: 'Are you sure you want to delete this dashboard? This action cannot be undone.',
			confirmText: 'Delete',
			type: 'danger'
		});

		if (confirmed) {
			fetch(`/api/dashboards/${slug}`, {
				method: 'DELETE',
			})
			.then(response => {
				if (response.ok) {
					window.location.reload();
				} else {
					showAlertDialog({
						title: 'Error',
						message: 'Failed to delete dashboard',
						type: 'error'
					});
				}
			});
		}
	}
	</script>
}

script deleteDashboardFromManager(slug string) {
	deleteDashboard(slug);
}

script togglePluginDashboard(slug string) {
	togglePluginDashboard(slug);
}
