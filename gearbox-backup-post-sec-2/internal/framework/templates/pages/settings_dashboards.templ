package pages

import (
	"fmt"
	"github.com/sarg3nt/gearbox/internal/framework/dashboard"
	"github.com/sarg3nt/gearbox/internal/framework/models"
	"github.com/sarg3nt/gearbox/internal/framework/templates/layouts"
)

// DashboardsSettings renders the dashboards settings page.
templ DashboardsSettings(dashboards map[string]*dashboard.Dashboard, user *models.User) {
	@layouts.Base("Dashboards", user, "/settings/dashboards") {
		<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
			<div class="space-y-6">
				<!-- Create New Dashboard -->
				<div class="bg-white dark:bg-slate-800 rounded-lg shadow">
					<div class="p-4 border-b border-gray-200 dark:border-slate-700">
						<h2 class="text-lg font-semibold text-gray-800 dark:text-gray-100">Create New Dashboard</h2>
						<p class="text-sm text-gray-600 dark:text-gray-400">Start with a blank dashboard or use a template</p>
					</div>
					<div class="p-4">
						<div class="flex gap-4">
							<a
								href="/dashboards/new"
								class="flex-1 p-4 border-2 border-dashed border-gray-300 dark:border-slate-600 rounded-lg hover:border-blue-500 dark:hover:border-blue-400 hover:bg-blue-50 dark:hover:bg-blue-900/10 transition-colors cursor-pointer text-center"
							>
								<svg class="w-8 h-8 mx-auto mb-2 text-gray-400 dark:text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
								</svg>
								<span class="block font-medium text-gray-700 dark:text-gray-300">Blank Dashboard</span>
								<span class="block text-sm text-gray-500 dark:text-gray-400">Start from scratch</span>
							</a>
						</div>
					</div>
				</div>
				<!-- Plugin Dashboards -->
				<div class="bg-white dark:bg-slate-800 rounded-lg shadow">
					<div class="p-4 border-b border-gray-200 dark:border-slate-700">
						<h2 class="text-lg font-semibold text-gray-800 dark:text-gray-100">Plugin Dashboards</h2>
						<p class="text-sm text-gray-600 dark:text-gray-400">Dashboards provided by plugins (can be reset to defaults)</p>
					</div>
					<div class="divide-y divide-gray-200 dark:divide-slate-700">
						for slug, dash := range dashboards {
							if !dash.Editable {
								<div class="p-4 flex items-center justify-between">
									<div class="flex items-center gap-4">
										<div class="flex-shrink-0">
											<div class="w-10 h-10 rounded-lg bg-blue-100 dark:bg-blue-900/30 flex items-center justify-center">
												<svg class="w-6 h-6 text-blue-600 dark:text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
													<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path>
												</svg>
											</div>
										</div>
										<div class="flex-1">
											<h3 class="font-medium text-gray-800 dark:text-gray-100">{ dash.Name }</h3>
											<p class="text-sm text-gray-600 dark:text-gray-400">{ dash.Description }</p>
											<div class="flex items-center gap-2 mt-1">
												if dash.PluginName != nil {
													<span class="text-xs px-2 py-0.5 bg-purple-100 dark:bg-purple-900/30 text-purple-700 dark:text-purple-300 rounded">Plugin: { *dash.PluginName }</span>
												}
												<span class="text-xs text-gray-500 dark:text-gray-400">{ templ.JSONString(len(dash.Widgets)) } widgets</span>
											</div>
										</div>
									</div>
									<div class="flex items-center gap-2">
										<a
											href={ templ.URL("/dashboards/" + slug) }
											class="px-3 py-2 text-sm text-gray-600 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-slate-700 rounded-lg transition-colors"
										>
											View
										</a>
										<a
											href={ templ.URL("/dashboards/" + slug + "/edit") }
											class="px-3 py-2 text-sm text-gray-600 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-slate-700 rounded-lg transition-colors"
										>
											Edit
										</a>
										<button
											onclick={ templ.ComponentScript{Call: fmt.Sprintf("exportDashboard('%s')", slug)} }
											class="px-3 py-2 text-sm text-blue-600 dark:text-blue-400 hover:bg-blue-50 dark:hover:bg-blue-900/20 rounded-lg transition-colors"
										>
											Export
										</button>
										<button
											onclick={ templ.ComponentScript{Call: fmt.Sprintf("resetDashboard('%s')", slug)} }
											class="px-3 py-2 text-sm text-amber-600 dark:text-amber-400 hover:bg-amber-50 dark:hover:bg-amber-900/20 rounded-lg transition-colors"
										>
											Reset
										</button>
									</div>
								</div>
							}
						}
					</div>
				</div>
				<!-- User Dashboards -->
				<div class="bg-white dark:bg-slate-800 rounded-lg shadow">
					<div class="p-4 border-b border-gray-200 dark:border-slate-700">
						<h2 class="text-lg font-semibold text-gray-800 dark:text-gray-100">User Dashboards</h2>
						<p class="text-sm text-gray-600 dark:text-gray-400">Custom dashboards you've created</p>
					</div>
					<div class="divide-y divide-gray-200 dark:divide-slate-700">
						for slug, dash := range dashboards {
							if dash.Editable {
								<div class="p-4 flex items-center justify-between">
									<div class="flex items-center gap-4">
										<div class="flex-shrink-0">
											<div class="w-10 h-10 rounded-lg bg-green-100 dark:bg-green-900/30 flex items-center justify-center">
												<svg class="w-6 h-6 text-green-600 dark:text-green-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
													<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 8v8m-4-5v5m-4-2v2m-2 4h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
												</svg>
											</div>
										</div>
										<div class="flex-1">
											<h3 class="font-medium text-gray-800 dark:text-gray-100">{ dash.Name }</h3>
											<p class="text-sm text-gray-600 dark:text-gray-400">{ dash.Description }</p>
											<div class="flex items-center gap-2 mt-1">
												<span class="text-xs px-2 py-0.5 bg-green-100 dark:bg-green-900/30 text-green-700 dark:text-green-300 rounded">Custom</span>
												<span class="text-xs text-gray-500 dark:text-gray-400">{ templ.JSONString(len(dash.Widgets)) } widgets</span>
											</div>
										</div>
									</div>
									<div class="flex items-center gap-2">
										<a
											href={ templ.URL("/dashboards/" + slug) }
											class="px-3 py-2 text-sm text-gray-600 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-slate-700 rounded-lg transition-colors"
										>
											View
										</a>
										<a
											href={ templ.URL("/dashboards/" + slug + "/edit") }
											class="px-3 py-2 text-sm text-gray-600 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-slate-700 rounded-lg transition-colors"
										>
											Edit
										</a>
										<button
											onclick={ templ.ComponentScript{Call: fmt.Sprintf("exportDashboard('%s')", slug)} }
											class="px-3 py-2 text-sm text-blue-600 dark:text-blue-400 hover:bg-blue-50 dark:hover:bg-blue-900/20 rounded-lg transition-colors"
										>
											Export
										</button>
										<button
											onclick={ templ.ComponentScript{Call: fmt.Sprintf("deleteDashboard('%s')", slug)} }
											class="px-3 py-2 text-sm text-red-600 dark:text-red-400 hover:bg-red-50 dark:hover:bg-red-900/20 rounded-lg transition-colors"
										>
											Delete
										</button>
									</div>
								</div>
							}
						}
					</div>
				</div>
				<!-- Import Dashboard -->
				<div class="bg-white dark:bg-slate-800 rounded-lg shadow">
					<div class="p-4 border-b border-gray-200 dark:border-slate-700">
						<h2 class="text-lg font-semibold text-gray-800 dark:text-gray-100">Import Dashboard</h2>
						<p class="text-sm text-gray-600 dark:text-gray-400">Upload a dashboard configuration file</p>
					</div>
					<div class="p-4">
						<form id="import-form" enctype="multipart/form-data" class="space-y-4">
							<div>
								<label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">
									Dashboard File
								</label>
								<input
									type="file"
									name="file"
									accept=".yaml,.yml"
									class="block w-full text-sm text-gray-500 dark:text-gray-400
											file:mr-4 file:py-2 file:px-4
											file:rounded-lg file:border-0
											file:text-sm file:font-semibold
											file:bg-blue-50 file:text-blue-700
											dark:file:bg-blue-900/30 dark:file:text-blue-400
											hover:file:bg-blue-100 dark:hover:file:bg-blue-900/50
											cursor-pointer"
								/>
							</div>
							<div class="flex items-center gap-3">
								<input
									type="checkbox"
									name="overwrite"
									id="overwrite-check"
									class="w-4 h-4 text-blue-600 bg-gray-100 border-gray-300 rounded focus:ring-blue-500 dark:focus:ring-blue-600 dark:ring-offset-slate-800 focus:ring-2 dark:bg-slate-700 dark:border-slate-600"
								/>
								<label for="overwrite-check" class="text-sm text-gray-700 dark:text-gray-300">
									Overwrite if dashboard already exists
								</label>
							</div>
							<button
								type="submit"
								class="px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white rounded-lg font-medium transition-colors"
							>
								Import Dashboard
							</button>
						</form>
						<div id="import-result" class="mt-4 hidden"></div>
					</div>
				</div>
			</div>
			<script type="text/javascript">
			function exportDashboard(slug) {
				window.location.href = `/api/dashboards/${slug}/export`;
			}

			async function resetDashboard(slug) {
				const confirmed = await showConfirmDialog({
					title: 'Reset Dashboard',
					message: `Are you sure you want to reset this dashboard to its default configuration? All customizations will be lost.`,
					confirmText: 'Reset',
					type: 'warning'
				});

				if (confirmed) {
					fetch(`/api/dashboards/${slug}/reset`, { method: 'POST' })
						.then(response => {
							if (response.ok) {
								window.location.reload();
							} else {
								showAlertDialog({
									title: 'Error',
									message: 'Failed to reset dashboard',
									type: 'error'
								});
							}
						})
						.catch(error => {
							showAlertDialog({
								title: 'Error',
								message: 'Error: ' + error.message,
								type: 'error'
							});
						});
				}
			}

			async function deleteDashboard(slug) {
				const confirmed = await showConfirmDialog({
					title: 'Delete Dashboard',
					message: `Are you sure you want to delete this dashboard? This action cannot be undone.`,
					confirmText: 'Delete',
					type: 'danger'
				});

				if (confirmed) {
					fetch(`/api/dashboards/${slug}`, { method: 'DELETE' })
						.then(response => {
							if (response.ok) {
								window.location.reload();
							} else {
								showAlertDialog({
									title: 'Error',
									message: 'Failed to delete dashboard',
									type: 'error'
								});
							}
						})
						.catch(error => {
							showAlertDialog({
								title: 'Error',
								message: 'Error: ' + error.message,
								type: 'error'
							});
						});
				}
			}

			document.getElementById('import-form').addEventListener('submit', async (e) => {
				e.preventDefault();
				const formData = new FormData(e.target);
				const resultDiv = document.getElementById('import-result');

				try {
					const response = await fetch('/api/dashboards/import', {
						method: 'POST',
						body: formData
					});

					const data = await response.json();

					if (response.ok) {
						resultDiv.className = 'mt-4 p-4 bg-green-50 dark:bg-green-900/20 border border-green-200 dark:border-green-800 rounded-lg';
						resultDiv.textContent = data.message || 'Dashboard imported successfully';
						resultDiv.classList.remove('hidden');
						setTimeout(() => window.location.reload(), 1500);
					} else {
						resultDiv.className = 'mt-4 p-4 bg-red-50 dark:bg-red-900/20 border border-red-200 dark:border-red-800 rounded-lg';
						resultDiv.textContent = data.error || 'Failed to import dashboard';
						resultDiv.classList.remove('hidden');
					}
				} catch (error) {
					resultDiv.className = 'mt-4 p-4 bg-red-50 dark:bg-red-900/20 border border-red-200 dark:border-red-800 rounded-lg';
					resultDiv.textContent = 'Error: ' + error.message;
					resultDiv.classList.remove('hidden');
				}
			});
			</script>
		</div>
	}
}
