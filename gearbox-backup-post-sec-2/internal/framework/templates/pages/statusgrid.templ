package pages

import "github.com/sarg3nt/gearbox/internal/framework/models"
import "github.com/sarg3nt/gearbox/internal/framework/templates/layouts"
import "encoding/json"

func serversJSON(servers []models.ServerConfig) string {
	data, _ := json.Marshal(servers)
	return string(data)
}

templ StatusGrid(user *models.User, servers []models.ServerConfig) {
	@layouts.Base("Status Grid", user, "/status-grid") {
		<!-- Hidden container for page header content - will be moved to main header via JS -->
		<div id="page-header-source" class="hidden">
			<!-- Left side: Title -->
			<div class="flex items-center">
				<h2 class="text-xl font-bold text-gray-800 dark:text-gray-100">Status Grid</h2>
			</div>
			<!-- Right side spacer -->
			<div class="flex-1"></div>
			<!-- Controls -->
			<div class="flex items-center space-x-3">
				<!-- Font size slider -->
				<div class="flex items-center gap-2">
					<label class="text-sm font-medium text-gray-700 dark:text-gray-300">Font:</label>
					<input
						type="range"
						id="font-size-slider"
						min="10"
						max="24"
						value="14"
						class="w-20 h-2 bg-gray-200 dark:bg-slate-600 rounded-lg appearance-none cursor-pointer"
						oninput="updateFontSize(this.value)"
					/>
					<span id="font-size-value" class="text-sm text-gray-600 dark:text-gray-400 w-10">14px</span>
				</div>

				<!-- Manual Refresh button with SSE status indicator -->
				<button
					id="refresh-btn"
					onclick="manualRefresh()"
					class="p-2 rounded-lg transition-colors text-gray-400"
					title="Connecting..."
				>
					<svg id="refresh-icon" class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path>
					</svg>
				</button>

				<!-- Copy button (CSV) -->
				<button
					onclick="copyAsCSV()"
					class="p-2 text-gray-600 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-slate-600 rounded transition-colors border border-gray-300 dark:border-slate-600"
					title="Copy as CSV"
				>
					<svg id="copy-icon" class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"></path>
					</svg>
				</button>

				<!-- Download button (CSV) -->
				<button
					onclick="downloadAsCSV()"
					class="p-2 text-gray-600 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-slate-600 rounded transition-colors border border-gray-300 dark:border-slate-600"
					title="Download as CSV"
				>
					<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path>
					</svg>
				</button>

				<!-- Fullscreen button -->
				<button
					onclick="toggleFullscreen()"
					id="fullscreen-button"
					class="p-2 text-gray-600 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-slate-600 rounded transition-colors border border-gray-300 dark:border-slate-600"
					title="Browser Fullscreen"
				>
					<!-- State 0: Normal - expand to browser fullscreen -->
					<svg id="fullscreen-icon-normal" class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 8V4m0 0h4M4 4l5 5m11-1V4m0 0h-4m4 0l-5 5M4 16v4m0 0h4m-4 0l5-5m11 5l-5-5m5 5v-4m0 4h-4"></path>
					</svg>
					<!-- State 1: Browser fullscreen - expand to true fullscreen (double arrows) -->
					<svg id="fullscreen-icon-browser" class="w-5 h-5 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 8V4m0 0h4M4 4l5 5m11-1V4m0 0h-4m4 0l-5 5M4 16v4m0 0h4m-4 0l5-5m11 5l-5-5m5 5v-4m0 4h-4"></path>
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7l2 2m6-2l-2 2m-4 4l-2 2m8-2l2 2" opacity="0.5"></path>
					</svg>
					<!-- State 2: True fullscreen - shrink back to normal (arrows pointing inward) -->
					<svg id="fullscreen-icon-true" class="w-5 h-5 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<!-- Top-left: arrow pointing to center -->
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4l4 4M8 4H4v4"></path>
						<!-- Top-right: arrow pointing to center -->
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 4l-4 4M16 4h4v4"></path>
						<!-- Bottom-left: arrow pointing to center -->
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 20l4-4M8 20H4v-4"></path>
						<!-- Bottom-right: arrow pointing to center -->
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 20l-4-4M16 20h4v-4"></path>
					</svg>
				</button>
			</div>
		</div>

		<div id="grid-page-container">
			<div id="grid-card" class="bg-white dark:bg-slate-800 rounded-lg shadow-lg p-4">
				<!-- Grid container -->
				<div
					id="status-grid"
					data-servers={ serversJSON(servers) }
				></div>
			</div>
		</div>

		<!-- Fullscreen styles -->
		<style>
			.fullscreen-mode {
				position: fixed !important;
				top: 0 !important;
				left: 0 !important;
				width: 100vw !important;
				height: 100vh !important;
				margin: 0 !important;
				border-radius: 0 !important;
				display: flex !important;
				flex-direction: column !important;
				z-index: 9999 !important;
			}
			.fullscreen-mode #status-grid {
				flex: 1 !important;
				height: auto !important;
			}
		</style>

		<script>
		let table = null;
		let eventSource = null;
		let serverDataCache = {}; // Cache data per server for efficient updates
		let fullscreenState = 0; // 0 = normal, 1 = browser fullscreen, 2 = true fullscreen
		let currentFontSize = 14;
		const FONT_SIZE_STORAGE_KEY = 'statusgrid-font-size';

		// Move page header content to main header
		function setupPageHeader() {
			const source = document.getElementById('page-header-source');
			const target = document.getElementById('header-page-content');
			if (source && target) {
				while (source.firstChild) {
					target.appendChild(source.firstChild);
				}
			}
		}

		// Get server list from data attribute
		function getServers() {
			const gridDiv = document.getElementById('status-grid');
			if (!gridDiv) return [];
			try {
				return JSON.parse(gridDiv.dataset.servers || '[]');
			} catch (e) {
				console.error('Error parsing servers:', e);
				return [];
			}
		}

		// Build server name options for dropdown filter
		function getServerFilterValues() {
			const servers = getServers();
			const values = { '': 'All Servers' };
			servers.forEach(s => {
				values[s.name] = s.name;
			});
			return values;
		}

		// Font size functions
		function getStoredFontSize() {
			return parseInt(localStorage.getItem(FONT_SIZE_STORAGE_KEY)) || 14;
		}

		function updateFontSize(size) {
			size = parseInt(size);
			currentFontSize = size;
			localStorage.setItem(FONT_SIZE_STORAGE_KEY, size);
			const valueDisplay = document.getElementById('font-size-value');
			if (valueDisplay) {
				valueDisplay.textContent = size + 'px';
			}

			// Apply font size to Tabulator table
			const gridDiv = document.getElementById('status-grid');
			if (gridDiv) {
				gridDiv.style.fontSize = size + 'px';
			}

			// Update Tabulator row height based on font size
			if (table) {
				table.redraw(true);
			}
		}

		// SSE connection status - update refresh button color
		function updateSSEStatus(status) {
			const btn = document.getElementById('refresh-btn');
			if (!btn) return;

			// Remove all status classes
			btn.classList.remove('text-green-500', 'text-red-500', 'text-yellow-500', 'text-gray-400');

			switch (status) {
				case 'connected':
					btn.classList.add('text-green-500');
					btn.title = 'Live - streaming data';
					break;
				case 'connecting':
					btn.classList.add('text-yellow-500');
					btn.title = 'Connecting...';
					break;
				case 'disconnected':
					btn.classList.add('text-red-500');
					btn.title = 'Disconnected - click to reconnect';
					break;
				default:
					btn.classList.add('text-gray-400');
					btn.title = 'Refresh';
			}
		}

		// SSE connection for real-time updates
		function initSSE() {
			if (eventSource) {
				eventSource.close();
			}

			updateSSEStatus('connecting');
			eventSource = new EventSource('/api/events');

			eventSource.onopen = function() {
				console.log('SSE connected for status grid');
				updateSSEStatus('connected');
			};

			eventSource.addEventListener('connected', function(e) {
				console.log('SSE connected:', JSON.parse(e.data));
				updateSSEStatus('connected');
			});

			// Listen for stats updates (pushed from agent)
			eventSource.addEventListener('stats.updated', function(e) {
				const data = JSON.parse(e.data);
				const serverId = data.server_id;
				if (serverId) {
					// Fetch only the updated server's data and apply surgical update
					updateServerData(serverId);
				}
			});

			// Listen for server connected/disconnected
			eventSource.addEventListener('server.connected', function(e) {
				console.log('Server connected:', JSON.parse(e.data));
				loadAllData();
			});

			eventSource.addEventListener('server.disconnected', function(e) {
				console.log('Server disconnected:', JSON.parse(e.data));
			});

			eventSource.onerror = function(e) {
				console.error('SSE connection error:', e);
				updateSSEStatus('disconnected');
				// Reconnect after a delay
				setTimeout(() => {
					if (eventSource && eventSource.readyState === EventSource.CLOSED) {
						initSSE();
					}
				}, 3000);
			};
		}

		function closeSSE() {
			if (eventSource) {
				eventSource.close();
				eventSource = null;
			}
		}

		// Load data from all servers and initialize/update grid
		function loadAllData() {
			const servers = getServers();
			const promises = servers.map(server =>
				fetch(`/api/${server.id}/stats`)
					.then(response => response.json())
					.then(data => {
						const stats = data.stats || data;
						serverDataCache[server.id] = { stats, name: server.name };
						return { serverId: server.id, serverName: server.name, stats };
					})
					.catch(e => {
						console.error(`Error loading data for ${server.id}:`, e);
						return null;
					})
			);

			Promise.all(promises).then(results => {
				const allRowData = [];
				results.forEach(result => {
					if (result && result.stats) {
						const rows = buildRowData(result.stats, result.serverId, result.serverName);
						allRowData.push(...rows);
					}
				});
				initializeOrUpdateTable(allRowData);
			});
		}

		// Update only one server's data efficiently
		function updateServerData(serverId) {
			const servers = getServers();
			const server = servers.find(s => s.id === serverId);
			if (!server) return;

			fetch(`/api/${serverId}/stats`)
				.then(response => response.json())
				.then(data => {
					const stats = data.stats || data;
					serverDataCache[serverId] = { stats, name: server.name };

					if (!table) {
						// Table not initialized yet, do full load
						loadAllData();
						return;
					}

					// Build new rows for this server
					const newRows = buildRowData(stats, serverId, server.name);

					// Get current data and replace rows for this server
					const currentData = table.getData();
					const otherServerData = currentData.filter(row => row.serverId !== serverId);
					const allData = [...otherServerData, ...newRows];

					// Update table data - Tabulator handles diffing efficiently
					table.replaceData(allData);
				})
				.catch(e => {
					console.error(`Error updating data for ${serverId}:`, e);
				});
		}

		function manualRefresh() {
			const icon = document.getElementById('refresh-icon');
			icon.classList.add('animate-spin');
			loadAllData();
			setTimeout(() => icon.classList.remove('animate-spin'), 1000);
		}

		function buildRowData(stats, serverId, serverName) {
			const rowData = [];
			if (stats.backends) {
				stats.backends.forEach(backend => {
					if (backend.servers) {
						backend.servers.forEach(server => {
							rowData.push({
								// Unique ID includes serverId for cross-server uniqueness
								id: serverId + '-' + backend.name + '-' + server.name,
								serverId: serverId,
								serverName: serverName,
								backend: backend.name,
								server: server.name,
								status: server.status,
								sessions: server.scur,
								sessionsMax: server.smax,
								queue: server.qcur,
								responseTime: server.rtime,
								bytesIn: server.bin,
								bytesOut: server.bout,
								requestRate: server.req_rate,
								weight: server.weight,
								checkStatus: server.check_status,
								lastChange: server.lastchg
							});
						});
					}
				});
			}
			return rowData;
		}

		function formatBytes(bytes) {
			if (!bytes) return '0 B';
			const k = 1024;
			const sizes = ['B', 'KB', 'MB', 'GB'];
			const i = Math.floor(Math.log(bytes) / Math.log(k));
			return (bytes / Math.pow(k, i)).toFixed(2) + ' ' + sizes[i];
		}

		function getStatusFormatter(cell) {
			const value = cell.getValue();
			const isDark = document.documentElement.classList.contains('dark');
			let bgColor, textColor;

			if (value === 'UP') {
				bgColor = isDark ? '#14532d' : '#d4edda';
				textColor = isDark ? '#86efac' : '#155724';
			} else if (value === 'DOWN') {
				bgColor = isDark ? '#7f1d1d' : '#f8d7da';
				textColor = isDark ? '#fca5a5' : '#721c24';
			} else {
				bgColor = isDark ? '#713f12' : '#fff3cd';
				textColor = isDark ? '#fcd34d' : '#856404';
			}

			return `<span style="display:inline-block;width:100%;padding:4px 8px;background-color:${bgColor};color:${textColor};text-align:center;border-radius:4px;">${value}</span>`;
		}

		function initializeOrUpdateTable(rowData) {
			const gridDiv = document.getElementById('status-grid');
			if (!gridDiv) return;

			// If table already exists, just update the data
			if (table) {
				table.replaceData(rowData);
				return;
			}

			// First time: create the table
			table = new Tabulator('#status-grid', {
				data: rowData,
				index: 'id', // Use id field for row identification
				height: '600px',
				layout: 'fitDataFill',
				pagination: true,
				paginationSize: 20,
				paginationSizeSelector: [10, 20, 50, 100],
				movableColumns: true,
				resizableRows: true,
				selectable: true, // Enable row selection (adds tabulator-selectable class for hover)
				columns: [
					{
						title: 'HAProxy Server',
						field: 'serverName',
						frozen: true,
						width: 150,
						headerFilter: 'list',
						headerFilterParams: {
							values: getServerFilterValues(),
							clearable: true
						}
					},
					{
						title: 'Backend',
						field: 'backend',
						frozen: true,
						width: 150,
						headerFilter: 'input'
					},
					{
						title: 'Server',
						field: 'server',
						frozen: true,
						width: 150,
						headerFilter: 'input'
					},
					{
						title: 'Status',
						field: 'status',
						width: 100,
						formatter: getStatusFormatter,
						headerFilter: 'list',
						headerFilterParams: {
							values: {
								'': 'All',
								'UP': 'UP',
								'DOWN': 'DOWN',
								'MAINT': 'MAINT',
								'DRAIN': 'DRAIN'
							},
							clearable: true
						}
					},
					{
						title: 'Sessions',
						field: 'sessions',
						width: 100,
						hozAlign: 'right',
						headerFilter: 'number',
						headerFilterFunc: '>=',
						headerFilterPlaceholder: '>='
					},
					{
						title: 'Max Sessions',
						field: 'sessionsMax',
						width: 120,
						hozAlign: 'right',
						headerFilter: 'number',
						headerFilterFunc: '>=',
						headerFilterPlaceholder: '>='
					},
					{
						title: 'Queue',
						field: 'queue',
						width: 80,
						hozAlign: 'right',
						headerFilter: 'number',
						headerFilterFunc: '>=',
						headerFilterPlaceholder: '>='
					},
					{
						title: 'Response Time',
						field: 'responseTime',
						width: 130,
						hozAlign: 'right',
						formatter: function(cell) {
							const val = cell.getValue();
							return val ? val + ' ms' : '0 ms';
						},
						headerFilter: 'number',
						headerFilterFunc: '>=',
						headerFilterPlaceholder: '>= ms'
					},
					{
						title: 'Bytes In',
						field: 'bytesIn',
						width: 120,
						hozAlign: 'right',
						formatter: function(cell) {
							return formatBytes(cell.getValue());
						},
						headerFilter: 'number',
						headerFilterFunc: '>=',
						headerFilterPlaceholder: '>= bytes'
					},
					{
						title: 'Bytes Out',
						field: 'bytesOut',
						width: 120,
						hozAlign: 'right',
						formatter: function(cell) {
							return formatBytes(cell.getValue());
						},
						headerFilter: 'number',
						headerFilterFunc: '>=',
						headerFilterPlaceholder: '>= bytes'
					},
					{
						title: 'Req/s',
						field: 'requestRate',
						width: 90,
						hozAlign: 'right',
						headerFilter: 'number',
						headerFilterFunc: '>=',
						headerFilterPlaceholder: '>='
					},
					{
						title: 'Weight',
						field: 'weight',
						width: 90,
						hozAlign: 'right',
						headerFilter: 'number',
						headerFilterFunc: '>=',
						headerFilterPlaceholder: '>='
					},
					{
						title: 'Check Status',
						field: 'checkStatus',
						width: 150,
						headerFilter: 'input',
						headerFilterPlaceholder: 'Filter...'
					},
					{
						title: 'Last Change',
						field: 'lastChange',
						width: 120,
						hozAlign: 'right',
						headerFilter: 'number',
						headerFilterFunc: '>=',
						headerFilterPlaceholder: '>='
					}
				]
			});
		}

		// CSV generation - exports currently visible/filtered data
		function generateCSV() {
			if (!table) return '';

			const columns = [
				'serverName', 'backend', 'server', 'status', 'sessions', 'sessionsMax',
				'queue', 'responseTime', 'bytesIn', 'bytesOut', 'requestRate', 'weight',
				'checkStatus', 'lastChange'
			];
			const headers = [
				'HAProxy Server', 'Backend', 'Server', 'Status', 'Sessions', 'Max Sessions',
				'Queue', 'Response Time (ms)', 'Bytes In', 'Bytes Out', 'Req/s', 'Weight',
				'Check Status', 'Last Change'
			];

			// Get filtered/visible data (respects header filters)
			const data = table.getData("active");
			const csvRows = [headers.join(',')];

			data.forEach(row => {
				const values = columns.map(col => {
					let val = row[col];
					if (val === null || val === undefined) val = '';
					// Escape quotes and wrap in quotes if contains comma
					val = String(val);
					if (val.includes(',') || val.includes('"') || val.includes('\n')) {
						val = '"' + val.replace(/"/g, '""') + '"';
					}
					return val;
				});
				csvRows.push(values.join(','));
			});

			return csvRows.join('\n');
		}

		function copyAsCSV() {
			const csv = generateCSV();
			const copyIcon = document.getElementById('copy-icon');

			navigator.clipboard.writeText(csv).then(() => {
				// Show success feedback
				copyIcon.innerHTML = '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>';
				if (window.showToast) {
					window.showToast('CSV copied to clipboard', 'success', 2000);
				}
				setTimeout(() => {
					copyIcon.innerHTML = '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"></path>';
				}, 2000);
			}).catch(err => {
				console.error('Failed to copy CSV:', err);
				if (window.showToast) {
					window.showToast('Failed to copy to clipboard', 'error', 4000);
				}
			});
		}

		function downloadAsCSV() {
			const csv = generateCSV();
			const timestamp = new Date().toISOString().replace(/[:.]/g, '-');
			const filename = `status-grid-${timestamp}.csv`;

			const blob = new Blob([csv], { type: 'text/csv' });
			const url = URL.createObjectURL(blob);
			const a = document.createElement('a');
			a.href = url;
			a.download = filename;
			document.body.appendChild(a);
			a.click();
			document.body.removeChild(a);
			URL.revokeObjectURL(url);
		}

		// Fullscreen functions
		function toggleFullscreen() {
			const gridCard = document.getElementById('grid-card');

			// Cycle through states: 0 (normal) -> 1 (browser) -> 2 (true) -> 0 (normal)
			if (fullscreenState === 0) {
				// Enter browser fullscreen (state 1)
				enterBrowserFullscreen();
			} else if (fullscreenState === 1) {
				// Enter true fullscreen (state 2)
				gridCard.requestFullscreen().catch(err => {
					console.error('Failed to enter fullscreen:', err);
				});
			} else {
				// Exit true fullscreen, go back to normal (state 0)
				document.exitFullscreen().catch(err => {
					console.error('Failed to exit fullscreen:', err);
				});
			}
		}

		function enterBrowserFullscreen() {
			const gridCard = document.getElementById('grid-card');
			const navElement = document.querySelector('nav');
			const mainElement = document.querySelector('main');
			const headerElement = document.querySelector('header');

			fullscreenState = 1;
			gridCard.classList.add('fullscreen-mode');
			if (navElement) navElement.classList.add('hidden');
			if (headerElement) headerElement.classList.add('hidden');
			if (mainElement) {
				mainElement.style.padding = '0';
				mainElement.style.maxWidth = 'none';
			}
			document.body.style.overflow = 'hidden';
			updateFullscreenIcons();

			// Resize table to fit
			if (table) {
				setTimeout(() => table.redraw(true), 100);
			}
		}

		function exitBrowserFullscreen() {
			const gridCard = document.getElementById('grid-card');
			const navElement = document.querySelector('nav');
			const mainElement = document.querySelector('main');
			const headerElement = document.querySelector('header');

			fullscreenState = 0;
			gridCard.classList.remove('fullscreen-mode');
			if (navElement) navElement.classList.remove('hidden');
			if (headerElement) headerElement.classList.remove('hidden');
			if (mainElement) {
				mainElement.style.padding = '';
				mainElement.style.maxWidth = '';
			}
			document.body.style.overflow = '';
			updateFullscreenIcons();

			// Resize table back
			if (table) {
				setTimeout(() => table.redraw(true), 100);
			}
		}

		function updateFullscreenIcons() {
			const iconNormal = document.getElementById('fullscreen-icon-normal');
			const iconBrowser = document.getElementById('fullscreen-icon-browser');
			const iconTrue = document.getElementById('fullscreen-icon-true');
			const button = document.getElementById('fullscreen-button');

			// Hide all icons first
			iconNormal.classList.add('hidden');
			iconBrowser.classList.add('hidden');
			iconTrue.classList.add('hidden');

			// Show the appropriate icon and set tooltip
			if (fullscreenState === 0) {
				iconNormal.classList.remove('hidden');
				button.title = 'Browser Fullscreen';
			} else if (fullscreenState === 1) {
				iconBrowser.classList.remove('hidden');
				button.title = 'True Fullscreen (hide browser)';
			} else {
				iconTrue.classList.remove('hidden');
				button.title = 'Exit Fullscreen';
			}
		}

		// Handle true fullscreen state changes (triggered by API or Escape key)
		document.addEventListener('fullscreenchange', function() {
			const gridCard = document.getElementById('grid-card');
			const headerElement = document.querySelector('header');

			if (document.fullscreenElement) {
				// Entered true fullscreen (state 2)
				fullscreenState = 2;
				gridCard.classList.add('fullscreen-mode');
				if (headerElement) headerElement.classList.add('hidden');
			} else {
				// Exited true fullscreen - go back to normal (state 0)
				fullscreenState = 0;
				gridCard.classList.remove('fullscreen-mode');
				if (headerElement) headerElement.classList.remove('hidden');
				// Also restore nav/main in case we were in browser fullscreen before
				const navElement = document.querySelector('nav');
				const mainElement = document.querySelector('main');
				if (navElement) navElement.classList.remove('hidden');
				if (mainElement) {
					mainElement.style.padding = '';
					mainElement.style.maxWidth = '';
				}
				document.body.style.overflow = '';
			}
			updateFullscreenIcons();

			// Resize table
			if (table) {
				setTimeout(() => table.redraw(true), 100);
			}
		});

		// Handle Escape key for browser fullscreen (state 1)
		document.addEventListener('keydown', function(e) {
			if (e.key === 'Escape' && fullscreenState === 1) {
				exitBrowserFullscreen();
			}
		});

		// Initialize on page load
		document.addEventListener('DOMContentLoaded', function() {
			// Move page header content to main header
			setupPageHeader();

			// Restore font size
			const storedFontSize = getStoredFontSize();
			const fontSlider = document.getElementById('font-size-slider');
			if (fontSlider) {
				fontSlider.value = storedFontSize;
				updateFontSize(storedFontSize);
			}

			// Initial load
			loadAllData();

			// Start SSE for real-time updates
			initSSE();
		});

		// Clean up SSE connection when page unloads
		window.addEventListener('beforeunload', function() {
			closeSSE();
		});
		</script>
	}
}
