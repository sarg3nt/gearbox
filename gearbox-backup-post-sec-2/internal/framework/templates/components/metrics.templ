package components

import "fmt"
import "sort"
import "github.com/sarg3nt/gearbox/internal/framework/models"

// sortedServiceStatuses returns service statuses sorted alphabetically by name
func sortedServiceStatuses(services map[string]models.ServiceStatus) []models.ServiceStatus {
	if services == nil {
		return nil
	}

	// Extract names and sort them
	names := make([]string, 0, len(services))
	for name := range services {
		names = append(names, name)
	}
	sort.Strings(names)

	// Build sorted slice
	result := make([]models.ServiceStatus, 0, len(services))
	for _, name := range names {
		result = append(result, services[name])
	}
	return result
}

templ MetricCard(label string, value string, unit string) {
	<div class="bg-gray-50 dark:bg-slate-700 rounded-lg p-4">
		<div class="text-sm text-gray-600 dark:text-gray-400">{ label }</div>
		<div class="text-2xl font-bold text-gray-800 dark:text-gray-100">
			{ value }
			if unit != "" {
				<span class="text-lg text-gray-500 dark:text-gray-400">{ unit }</span>
			}
		</div>
	</div>
}

templ MetricCardWithSubValue(label string, valueRx string, valueTx string, unit string) {
	<div class="bg-gray-50 dark:bg-slate-700 rounded-lg p-4">
		<div class="text-sm text-gray-600 dark:text-gray-400">{ label }</div>
		<div class="flex items-baseline gap-2">
			<div class="text-2xl font-bold text-green-600 dark:text-green-400">
				{ valueRx }
				if unit != "" {
					<span class="text-lg text-gray-500 dark:text-gray-400">{ unit }</span>
				}
			</div>
			<span class="text-gray-400">/</span>
			<div class="text-2xl font-bold text-blue-600 dark:text-blue-400">
				{ valueTx }
				if unit != "" {
					<span class="text-lg text-gray-500 dark:text-gray-400">{ unit }</span>
				}
			</div>
		</div>
	</div>
}

templ SystemMetrics(metrics *models.SystemMetrics) {
	<div class="grid grid-cols-2 md:grid-cols-4 gap-6 mb-8">
		<!-- CPU Load Doughnut -->
		<div class="flex flex-col items-center">
			<div class="relative inline-block">
				@DoughnutChart(calculateCPUPercentage(metrics.LoadAverage1), 140, 18, getColorForPercentage(calculateCPUPercentage(metrics.LoadAverage1)))
				<div class="absolute inset-0 flex flex-col items-center justify-center">
					<div class="text-center">
						<div class="text-2xl font-bold text-gray-800 dark:text-gray-100">{ fmt.Sprintf("%.1f", metrics.LoadAverage1) }</div>
						<div class="text-xs text-gray-500 dark:text-gray-400">load</div>
					</div>
				</div>
			</div>
			<div class="mt-2 text-sm font-medium text-gray-700 dark:text-gray-300">CPU Load</div>
		</div>

		<!-- Memory Usage Doughnut -->
		<div class="flex flex-col items-center">
			<div class="relative inline-block">
				@DoughnutChart(metrics.MemoryUsagePercent, 140, 18, getColorForPercentage(metrics.MemoryUsagePercent))
				<div class="absolute inset-0 flex flex-col items-center justify-center">
					<div class="text-center">
						<div class="text-2xl font-bold text-gray-800 dark:text-gray-100">{ fmt.Sprintf("%.0f", metrics.MemoryUsagePercent) }</div>
						<div class="text-xs text-gray-500 dark:text-gray-400">%</div>
					</div>
				</div>
			</div>
			<div class="mt-2 text-sm font-medium text-gray-700 dark:text-gray-300">Memory</div>
		</div>

		<!-- Disk Usage Doughnut -->
		<div class="flex flex-col items-center">
			<div class="relative inline-block">
				@DoughnutChart(metrics.DiskUsagePercent, 140, 18, getColorForPercentage(metrics.DiskUsagePercent))
				<div class="absolute inset-0 flex flex-col items-center justify-center">
					<div class="text-center">
						<div class="text-2xl font-bold text-gray-800 dark:text-gray-100">{ fmt.Sprintf("%.0f", metrics.DiskUsagePercent) }</div>
						<div class="text-xs text-gray-500 dark:text-gray-400">%</div>
					</div>
				</div>
			</div>
			<div class="mt-2 text-sm font-medium text-gray-700 dark:text-gray-300">Disk</div>
		</div>

		<!-- Network RX/TX Combined Display -->
		<div class="flex flex-col items-center justify-center">
			<div class="text-center bg-gray-50 dark:bg-slate-700 rounded-lg p-4 w-full h-[140px] flex flex-col justify-center">
				<div class="text-xs text-gray-600 dark:text-gray-400 mb-1">Network</div>
				<div class="flex items-baseline justify-center gap-2 mb-1">
					<div class="flex flex-col items-center">
						<div class="text-sm text-gray-500 dark:text-gray-400">RX</div>
						<div class="text-xl font-bold text-green-600 dark:text-green-400">
							{ formatNumber(metrics.NetworkRxMbps, 1) }
						</div>
					</div>
					<span class="text-gray-400 text-sm">/</span>
					<div class="flex flex-col items-center">
						<div class="text-sm text-gray-500 dark:text-gray-400">TX</div>
						<div class="text-xl font-bold text-blue-600 dark:text-blue-400">
							{ formatNumber(metrics.NetworkTxMbps, 1) }
						</div>
					</div>
				</div>
				<div class="text-xs text-gray-500 dark:text-gray-400">Mbps</div>
			</div>
		</div>
	</div>
}

templ ServiceStatus(service models.ServiceStatus) {
	<div class="flex items-center space-x-2 p-2 bg-gray-50 dark:bg-slate-700 rounded">
		if service.Active {
			<span class="w-3 h-3 bg-green-500 rounded-full"></span>
		} else {
			<span class="w-3 h-3 bg-red-500 rounded-full"></span>
		}
		<span class="font-medium text-gray-800 dark:text-gray-100">{ service.Name }</span>
		<span class="text-sm text-gray-600 dark:text-gray-400">({ service.Status })</span>
	</div>
}

templ ServiceStatusList(services map[string]models.ServiceStatus) {
	<div class="bg-white dark:bg-slate-800 rounded-lg shadow p-6">
		<h3 class="text-lg font-semibold mb-4 text-gray-800 dark:text-gray-100">Service Status</h3>
		<div class="grid grid-cols-1 md:grid-cols-2 gap-2">
			for _, service := range sortedServiceStatuses(services) {
				@ServiceStatus(service)
			}
		</div>
	</div>
}

templ BackendHealthBadge(health float64) {
	if health >= 100 {
		<span class="px-2 py-1 text-xs font-semibold rounded bg-green-100 dark:bg-green-900 text-green-800 dark:text-green-200">
			healthy
		</span>
	} else {
		<span class="px-2 py-1 text-xs font-semibold rounded bg-red-100 dark:bg-red-900 text-red-800 dark:text-red-200">
			critical
		</span>
	}
}

templ LoadingSpinner() {
	<div class="flex justify-center items-center p-8">
		<div class="animate-spin rounded-full h-12 w-12 border-b-2 border-blue-600 dark:border-blue-400"></div>
	</div>
}

templ ErrorAlert(message string) {
	<div class="bg-red-50 dark:bg-red-900/30 border border-red-200 dark:border-red-800 text-red-800 dark:text-red-200 px-4 py-3 rounded mb-4">
		<div class="flex items-center">
			<svg class="w-5 h-5 mr-2" fill="currentColor" viewBox="0 0 20 20">
				<path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd"></path>
			</svg>
			<span>{ message }</span>
		</div>
	</div>
}

templ InfoAlert(message string) {
	<div class="bg-blue-50 dark:bg-blue-900/30 border border-blue-200 dark:border-blue-800 text-blue-800 dark:text-blue-200 px-4 py-3 rounded mb-4">
		<div class="flex items-center">
			<svg class="w-5 h-5 mr-2" fill="currentColor" viewBox="0 0 20 20">
				<path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z" clip-rule="evenodd"></path>
			</svg>
			<span>{ message }</span>
		</div>
	</div>
}
