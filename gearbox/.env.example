# Gearbox - Environment Configuration
# Copy this to .env and customize for your environment

# ==============================================================================
# Required Settings
# ==============================================================================

# Session secret for cookie encryption (minimum 32 characters)
# Generate with: openssl rand -hex 32
SESSION_SECRET=your-64-character-random-hex-string-here

# ==============================================================================
# Optional Settings
# ==============================================================================

# Admin password for initial setup (if not set, a random password is generated and logged)
# ADMIN_PASSWORD=your-admin-password

# Dev-only loopback auto-login (issue #83).
# When the binary is built with `-tags dev` (which `make dev` does via .air.toml)
# AND this var is "1" AND the request originates from a loopback IP, the request
# is auto-authenticated as the seeded `dev` user — no login screen.
# Production builds (`make build`) do NOT include the bypass code, so this var
# is inert even if set. Never enable on shared hosts: any local process can
# reach loopback.
# GEARBOX_DEV_AUTO_LOGIN=1

# Base URL for the application (used for email links and WebAuthn)
# BASE_URL=https://gearbox.example.com

# Database path (default: /data/gearbox.db in Docker, ./data/gearbox.db locally)
# DATABASE_PATH=/data/gearbox.db

# Database backup directory (default: /data/backups in Docker, ./backups locally)
# BACKUP_DIR=/data/backups

# Database retention in hours (default: 168 = 7 days)
# DATABASE_RETENTION_HOURS=168

# History interval in seconds - how often to save metrics snapshots (default: 60)
# HISTORY_INTERVAL_SECONDS=60

# Session timeout in minutes (default: 60)
# SESSION_TIMEOUT_MINUTES=60

# Dashboard refresh interval in seconds (default: 30)
# DASHBOARD_REFRESH_SECONDS=30

# Config/metadata refresh interval in seconds (default: 60)
# CONFIG_REFRESH_SECONDS=60

# HTTP port (default: 3000)
# HTTP_PORT=3000

# Log level: debug, info, warn, error (default: info)
# LOG_LEVEL=info

# TLS Configuration (enables HTTPS)
# TLS_CERT_PATH=/path/to/cert.pem
# TLS_KEY_PATH=/path/to/key.pem

# ==============================================================================
# Security Settings
# ==============================================================================

# Asset Loading Mode
# Set to "true" to use local assets instead of CDNs (CSP-compliant development)
# When enabled:
#   - Strict Content Security Policy (no external CDN sources)
#   - All JS/CSS loaded from /static/js/vendor and /static/css/vendor
#   - Requires running `make dev-assets` first to download assets
# When disabled (default):
#   - Production mode with CDN resources (Tailwind, HTMX, Chart.js, etc.)
#   - CDNs provide automatic updates and edge caching
#   - Best for production deployments
# USE_LOCAL_ASSETS=true

# CSP Report URI (for violation reports)
# CSP_REPORT_URI=https://your-csp-reporting-endpoint.com/reports

# CSP Extra Sources (comma-separated additional sources to allow)
# CSP_EXTRA_SOURCES=https://example.com,https://cdn.example.com

# ==============================================================================
# Notes
# ==============================================================================
#
# Monitored boxes are configured via the web UI at /settings/boxes
# Each box requires:
#   - HAProxy Agent URL (e.g., https://haproxy-host:8405)
#   - Agent API Key (configured in the HAProxy Agent)
#
# User authentication is managed via the web UI at /settings/users
