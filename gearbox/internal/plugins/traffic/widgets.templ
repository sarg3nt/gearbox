package traffic

import (
	"fmt"

	"github.com/sarg3nt/gearbox/internal/framework/middleware"
)


// TrafficSummaryCardWidget shows 5-card summary of traffic metrics
templ TrafficSummaryCardWidget(serverID string, refreshSeconds int) {
	<div
		id="traffic-summary"
		class="grid grid-cols-1 md:grid-cols-3 lg:grid-cols-5 gap-4"
		hx-get={ "/api/widgets/traffic/summary?server_id=" + serverID }
		hx-trigger={ "load, every " + fmt.Sprintf("%d", refreshSeconds) + "s" }
		hx-swap="innerHTML"
	>
		<!-- 5 cards will be loaded via HTMX -->
		<div class="col-span-5 flex items-center justify-center py-8">
			<div class="animate-spin rounded-full h-8 w-8 border-2 border-blue-500 border-t-transparent"></div>
		</div>
	</div>
}

// TrafficFlowVisualizationWidget shows D3.js network visualization
templ TrafficFlowVisualizationWidget(serverID string, height int, showControls bool) {
	<div class="bg-slate-900 rounded-lg shadow-2xl overflow-hidden border border-slate-700">
		if showControls {
			<div class="p-4 border-b border-slate-700 flex items-center justify-between">
				<div>
					<h3 class="text-lg font-semibold text-gray-100">Traffic Flow Visualization</h3>
					<p class="text-sm text-gray-400">Interactive network topology • Scroll to zoom • Drag to pan • Click nodes for details</p>
				</div>
				<div class="flex items-center gap-2">
					<select
						id="viz-filter"
						class="h-[38px] px-3 py-1.5 text-sm border border-slate-600 rounded-lg bg-slate-800 text-gray-300 focus:outline-none focus:ring-2 focus:ring-blue-500"
					>
						<option value="active">Active Only</option>
						<option value="all">All Backends</option>
						<option value="errors">With Errors</option>
						<option value="high-traffic">High Traffic</option>
					</select>
					<button id="reset-viz-btn" class="px-3 py-2 text-sm bg-slate-700 hover:bg-slate-600 text-gray-300 rounded-lg transition-colors">
						Reset View
					</button>
					<button id="physics-toggle" class="px-3 py-2 text-sm bg-blue-600 hover:bg-blue-500 text-white rounded-lg transition-colors">
						Physics: ON
					</button>
				</div>
			</div>
		}
		<div id="network-container" class="relative" style={ "height: " + fmt.Sprintf("%d", height) + "px;" }>
			<svg id="network-svg" class="w-full h-full"></svg>
			<div id="network-loading" class="absolute inset-0 flex items-center justify-center bg-slate-900/80">
				<div class="flex flex-col items-center gap-3">
					<div class="animate-spin rounded-full h-10 w-10 border-2 border-blue-500 border-t-transparent"></div>
					<span class="text-gray-400 text-sm">Loading traffic data...</span>
				</div>
			</div>
			<!-- Node detail tooltip -->
			<div id="node-tooltip" class="absolute hidden bg-slate-800 border border-slate-600 rounded-lg shadow-2xl p-4 z-50 min-w-[280px]">
				<div id="tooltip-content"></div>
				<div id="tooltip-actions" class="hidden mt-3 pt-3 border-t border-slate-600">
					<button id="filter-btn" class="w-full px-3 py-2 bg-blue-600 hover:bg-blue-500 text-white text-sm rounded-lg transition-colors flex items-center justify-center gap-2">
						<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 4a1 1 0 011-1h16a1 1 0 011 1v2.586a1 1 0 01-.293.707l-6.414 6.414a1 1 0 00-.293.707V17l-4 4v-6.586a1 1 0 00-.293-.707L3.293 7.293A1 1 0 013 6.586V4z"></path>
						</svg>
						Filter tables by this node
					</button>
					<button id="close-tooltip-btn" class="w-full mt-2 px-3 py-1.5 text-gray-400 hover:text-gray-200 text-sm transition-colors">
						Close
					</button>
				</div>
			</div>
			<!-- Filter indicator -->
			<div id="filter-indicator" class="absolute top-4 left-4 hidden bg-blue-600 text-white px-3 py-2 rounded-lg text-sm flex items-center gap-2 z-40">
				<span id="filter-text">Filtering by: </span>
				<button id="clear-filter-btn" class="ml-2 hover:bg-blue-500 rounded p-1" title="Clear filter">
					<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
					</svg>
				</button>
			</div>
			<!-- Legend -->
			<div class="absolute bottom-4 left-4 bg-slate-800/90 backdrop-blur-sm rounded-lg p-3 text-xs">
				<div class="text-gray-400 font-medium mb-2">Legend</div>
				<div class="flex flex-col gap-1.5">
					<div class="flex items-center gap-2">
						<div class="w-4 h-3 rounded-sm bg-violet-500"></div>
						<span class="text-gray-300">Source IP</span>
					</div>
					<div class="flex items-center gap-2">
						<div class="w-4 h-4 rounded-full bg-blue-500 border-2 border-blue-600"></div>
						<span class="text-gray-300">HAProxy (server)</span>
					</div>
					<div class="flex items-center gap-2">
						<div class="w-4 h-3 rounded-sm bg-emerald-500"></div>
						<span class="text-gray-300">Backend (hostname)</span>
					</div>
					<div class="flex items-center gap-2 pt-1.5 border-t border-slate-600 mt-1">
						<div class="w-6 h-0.5 bg-gradient-to-r from-violet-500 via-blue-500 to-emerald-500 rounded"></div>
						<span class="text-gray-300">Flow: Source → HAProxy → Backend</span>
					</div>
					<div class="text-gray-500 text-[10px] mt-1">Particle speed indicates traffic volume</div>
				</div>
			</div>
			<!-- Zoom controls -->
			<div class="absolute bottom-4 right-4 flex flex-col gap-1">
				<button id="zoom-in-btn" class="w-8 h-8 bg-slate-700 hover:bg-slate-600 text-gray-300 rounded flex items-center justify-center transition-colors">
					<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
					</svg>
				</button>
				<button id="zoom-out-btn" class="w-8 h-8 bg-slate-700 hover:bg-slate-600 text-gray-300 rounded flex items-center justify-center transition-colors">
					<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 12H4"></path>
					</svg>
				</button>
			</div>
		</div>
	</div>
	<!-- D3.js and visualization script -->
	if middleware.UseLocalAssets(ctx) {
		<script src="/static/js/vendor/d3.v7.min.js"></script>
	} else {
		<script src="https://d3js.org/d3.v7.min.js"></script>
	}
	<script src="/static/js/traffic/traffic-visualization.js"></script>
}

// TopSourcesTableWidget shows top traffic sources table
templ TopSourcesTableWidget(serverID string, refreshSeconds int, maxRows int) {
	<div class="bg-white dark:bg-slate-800 rounded-lg shadow">
		<div class="p-4 border-b border-gray-200 dark:border-slate-700 flex justify-between items-center">
			<div>
				<h3 class="text-lg font-semibold text-gray-800 dark:text-gray-100">Top Traffic Sources</h3>
				<p class="text-sm text-gray-500 dark:text-gray-400">Most active IP addresses</p>
			</div>
		</div>
		<div class="overflow-x-auto">
			<table class="w-full text-sm">
				<thead class="bg-gray-50 dark:bg-slate-700">
					<tr>
						<th class="px-4 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-400 uppercase">IP Address</th>
						<th class="px-4 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-400 uppercase">Requests</th>
						<th class="px-4 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-400 uppercase">Bandwidth</th>
						<th class="px-4 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-400 uppercase">Backend</th>
						<th class="px-4 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-400 uppercase">Status</th>
					</tr>
				</thead>
				<tbody
					id="top-sources-table"
					class="divide-y divide-gray-200 dark:divide-slate-600"
					hx-get={ "/api/widgets/traffic/top-sources?server_id=" + serverID + "&max_rows=" + fmt.Sprintf("%d", maxRows) }
					hx-trigger={ "load, every " + fmt.Sprintf("%d", refreshSeconds) + "s" }
					hx-swap="innerHTML"
				>
					<tr>
						<td colspan="5" class="px-4 py-8 text-center text-gray-500 dark:text-gray-400">
							Loading...
						</td>
					</tr>
				</tbody>
			</table>
		</div>
	</div>
}

// BackendTrafficTableWidget shows backend traffic distribution table
templ BackendTrafficTableWidget(serverID string, refreshSeconds int) {
	<div class="bg-white dark:bg-slate-800 rounded-lg shadow">
		<div class="p-4 border-b border-gray-200 dark:border-slate-700">
			<h3 class="text-lg font-semibold text-gray-800 dark:text-gray-100">Backend Traffic</h3>
			<p class="text-sm text-gray-500 dark:text-gray-400">Traffic distribution across backends</p>
		</div>
		<div class="overflow-x-auto">
			<table class="w-full text-sm">
				<thead class="bg-gray-50 dark:bg-slate-700">
					<tr>
						<th class="px-4 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-400 uppercase">Backend</th>
						<th class="px-4 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-400 uppercase">Requests</th>
						<th class="px-4 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-400 uppercase">Bandwidth</th>
						<th class="px-4 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-400 uppercase">Avg Latency</th>
						<th class="px-4 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-400 uppercase">Error Rate</th>
						<th class="px-4 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-400 uppercase">Status</th>
					</tr>
				</thead>
				<tbody
					id="backend-traffic-table"
					class="divide-y divide-gray-200 dark:divide-slate-600"
					hx-get={ "/api/widgets/traffic/backend-traffic?server_id=" + serverID }
					hx-trigger={ "load, every " + fmt.Sprintf("%d", refreshSeconds) + "s" }
					hx-swap="innerHTML"
				>
					<tr>
						<td colspan="6" class="px-4 py-8 text-center text-gray-500 dark:text-gray-400">
							Loading...
						</td>
					</tr>
				</tbody>
			</table>
		</div>
	</div>
}
