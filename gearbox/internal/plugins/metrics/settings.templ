package metrics

import "github.com/sarg3nt/gearbox/internal/framework/templates/components"

// metricsSettingsComponent renders the metrics plugin settings page.
templ metricsSettingsComponent(config map[string]any) {
	{{ storeHistory := getConfigBool(config, "store_history", true) }}
	{{ retentionDays := getConfigInt(config, "retention_days", 7) }}
	@components.SettingsSection("Metrics Settings", "Configure historical metrics storage and retention.") {
		@components.SettingsCheckbox(
			"store_history",
			"Store historical data",
			"When enabled, metrics will be stored for historical analysis and graphing.",
			storeHistory,
		)
		@components.SettingsSelect(
			"retention_days",
			"Data Retention (days)",
			"How long to keep historical metrics data.",
			[]components.SelectOption{
				{Value: "1", Label: "1 day", Selected: retentionDays == 1},
				{Value: "7", Label: "7 days", Selected: retentionDays == 7},
				{Value: "14", Label: "14 days", Selected: retentionDays == 14},
				{Value: "30", Label: "30 days", Selected: retentionDays == 30},
				{Value: "90", Label: "90 days", Selected: retentionDays == 90},
			},
		)
	}
}
