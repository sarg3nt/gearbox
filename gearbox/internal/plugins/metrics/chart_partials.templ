// ErrorRatesChartPartial renders a Chart.js time-series chart for 5xx error counts.
templ ErrorRatesChartPartial(boxID string, hours int, limit int) {
	<div id={ fmt.Sprintf("card-error-rates-%s", boxID) } class="chart-card bg-gray-50 dark:bg-slate-700 rounded-lg p-4 relative">
		<div class="flex justify-between items-center mb-2">
			<h4 class="text-lg font-medium text-gray-700 dark:text-gray-300">Error Rates (5xx)</h4>
			<button class={ fmt.Sprintf("fullscreen-btn-error-rates-%s", boxID), "p-1 hover:bg-gray-200 dark:hover:bg-slate-600 rounded transition-colors" } title="Toggle fullscreen">
				<svg class="w-5 h-5 text-gray-500 dark:text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 8V4m0 0h4M4 4l5 5m11-1V4m0 0h-4m4 0l-5 5M4 16v4m0 0h4m-4 0l5-5m11 5l-5-5m5 5v-4m0 4h-4"></path>
				</svg>
			</button>
		</div>
		<div class="chart-aspect-container">
			<canvas id={ fmt.Sprintf("chart-error-rates-%s", boxID) }></canvas>
		</div>
	</div>
	<script type="module" data-box-id={ boxID } data-hours={ fmt.Sprintf("%d", hours) } data-limit={ fmt.Sprintf("%d", limit) }>
		const script = document.currentScript;
		const boxID = script.dataset.boxId;
		const hours = parseInt(script.dataset.hours);
		const limit = parseInt(script.dataset.limit);

		import('/static/js/charts/chart-defaults.js').then(defaults => {
			import('/static/js/charts/chart-fullscreen.js').then(fullscreen => {
				const { getChartColors, createIntegerYAxisOptions, createLineDataset, formatTime } = defaults;
				const { toggleFullscreen } = fullscreen;

				const canvasId = 'chart-error-rates-' + boxID;
				const cardId = 'card-error-rates-' + boxID;

				if (!window.chartInstances) window.chartInstances = {};

				const fullscreenBtn = document.querySelector('.fullscreen-btn-error-rates-' + boxID);
				if (fullscreenBtn) {
					fullscreenBtn.addEventListener('click', () => {
						toggleFullscreen(cardId, () => {
							if (window.chartInstances && window.chartInstances[canvasId]) {
								setTimeout(() => window.chartInstances[canvasId].resize(), 100);
							}
						});
					});
				}

				async function loadChart() {
					try {
						const response = await fetch('/api/' + boxID + '/history/stats?hours=' + hours + '&limit=' + limit);
						const json = await response.json();
						const data = json.data || [];

						const colors = getChartColors();
						const ctx = document.getElementById(canvasId);
						if (!ctx) return;

						if (window.chartInstances[canvasId]) {
							window.chartInstances[canvasId].destroy();
						}

						window.chartInstances[canvasId] = new Chart(ctx.getContext('2d'), {
							type: 'line',
							data: {
								labels: data.map(d => formatTime(d.collected_at)),
								datasets: [
									createLineDataset('5xx Errors', data.map(d => d.total_5xx_errors), colors.danger)
								]
							},
							options: createIntegerYAxisOptions()
						});
					} catch (error) {
						console.error('Failed to load error rates chart:', error);
					}
				}

				loadChart();
				document.body.addEventListener('dashboard:settings-changed', loadChart);
				document.body.addEventListener('dashboard:reset-zoom', () => {
					if (window.chartInstances[canvasId] && window.chartInstances[canvasId].resetZoom) {
						window.chartInstances[canvasId].resetZoom();
					}
				});
			});
		});
	</script>
}
