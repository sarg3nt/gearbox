package haproxy

import (
	"fmt"
)

// HAProxyStatusSummaryWidgetHTMX renders a placeholder that loads via HTMX
templ HAProxyStatusSummaryWidgetHTMX(serverID string) {
	<div
		class="haproxy-status-summary-widget"
		hx-get={ fmt.Sprintf("/htmx/%s/status-summary", serverID) }
		hx-trigger="load"
		hx-swap="innerHTML"
	>
		<div class="bg-white dark:bg-slate-800 rounded-lg border border-gray-300 dark:border-slate-600 p-6">
			<div class="animate-pulse">
				<div class="grid grid-cols-1 md:grid-cols-3 gap-8">
					<div class="h-32 bg-gray-300 dark:bg-slate-700 rounded"></div>
					<div class="h-32 bg-gray-300 dark:bg-slate-700 rounded"></div>
					<div class="h-32 bg-gray-300 dark:bg-slate-700 rounded"></div>
				</div>
			</div>
		</div>
	</div>
}

// HAProxyBackendGridWidgetHTMX renders a placeholder that loads via HTMX
templ HAProxyBackendGridWidgetHTMX(serverID string) {
	<div
		class="haproxy-backend-grid-widget"
		hx-get={ fmt.Sprintf("/htmx/%s/backend-grid", serverID) }
		hx-trigger="load"
		hx-swap="innerHTML"
	>
		<div class="bg-white dark:bg-slate-800 rounded-lg border border-gray-300 dark:border-slate-600 p-6">
			<div class="animate-pulse">
				<div class="h-4 bg-gray-300 dark:bg-slate-700 rounded w-1/2 mb-4"></div>
				<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
					<div class="h-48 bg-gray-300 dark:bg-slate-700 rounded"></div>
					<div class="h-48 bg-gray-300 dark:bg-slate-700 rounded"></div>
					<div class="h-48 bg-gray-300 dark:bg-slate-700 rounded"></div>
				</div>
			</div>
		</div>
	</div>
}

// SystemMetricsWidgetHTMX renders a placeholder that loads via HTMX
templ SystemMetricsWidgetHTMX(serverID string) {
	<div
		class="system-metrics-widget"
		hx-get={ fmt.Sprintf("/htmx/%s/metrics", serverID) }
		hx-trigger="load"
		hx-swap="innerHTML"
	>
		<div class="bg-white dark:bg-slate-800 rounded-lg border border-gray-300 dark:border-slate-600 p-6">
			<div class="animate-pulse">
				<div class="h-4 bg-gray-300 dark:bg-slate-700 rounded w-1/3 mb-4"></div>
				<div class="grid grid-cols-1 md:grid-cols-3 gap-4">
					<div class="h-24 bg-gray-300 dark:bg-slate-700 rounded"></div>
					<div class="h-24 bg-gray-300 dark:bg-slate-700 rounded"></div>
					<div class="h-24 bg-gray-300 dark:bg-slate-700 rounded"></div>
				</div>
			</div>
		</div>
	</div>
}
