package widgets

import "fmt"

// StatusCardData represents the data structure for a status card
type StatusCardData struct {
	Name    string
	Status  string // healthy, warning, critical
	Metrics []StatusCardMetric
	Actions []StatusCardAction
}

type StatusCardMetric struct {
	Label  string
	Value  string
	Suffix string
}

type StatusCardAction struct {
	Label string
	Link  string
}

// StatusCardWidget renders a status card from config and data
templ StatusCardWidget(config map[string]any, data any) {
	if cardData, ok := data.(StatusCardData); ok {
		@StatusCard(cardData)
	} else if cardData, ok := data.(map[string]any); ok {
		@StatusCardFromMap(config, cardData)
	}
}

// StatusCard renders a status card with health indicator and metrics
templ StatusCard(data StatusCardData) {
	<div class="bg-white dark:bg-slate-900 border border-gray-300 dark:border-slate-600 rounded-lg p-4 hover:shadow-md transition-shadow">
		<!-- Header with status indicator -->
		<div class="flex items-start justify-between mb-3">
			<div class="flex items-center gap-2 flex-1 min-w-0">
				<!-- Status indicator -->
				<div class={ getStatusIndicatorClass(data.Status) }></div>
				<h3 class="text-lg font-semibold text-gray-800 dark:text-gray-100 truncate">
					{ data.Name }
				</h3>
			</div>
		</div>

		<!-- Metrics -->
		if len(data.Metrics) > 0 {
			<div class="space-y-2 mb-3">
				for _, metric := range data.Metrics {
					<div class="flex justify-between items-center text-sm">
						<span class="text-gray-600 dark:text-gray-400">{ metric.Label }:</span>
						<span class="font-semibold text-gray-800 dark:text-gray-100">
							{ metric.Value }
							if metric.Suffix != "" {
								<span class="text-gray-500 dark:text-gray-500 ml-1">{ metric.Suffix }</span>
							}
						</span>
					</div>
				}
			</div>
		}

		<!-- Actions -->
		if len(data.Actions) > 0 {
			<div class="flex gap-2 mt-3 pt-3 border-t border-gray-200 dark:border-slate-700">
				for _, action := range data.Actions {
					<a
						href={ templ.SafeURL(action.Link) }
						class="text-sm text-blue-600 dark:text-blue-400 hover:text-blue-800 dark:hover:text-blue-300 font-medium"
					>
						{ action.Label }
					</a>
				}
			</div>
		}
	</div>
}

// StatusCardFromMap renders a status card from a map (for dynamic data)
templ StatusCardFromMap(config map[string]any, data map[string]any) {
	<div class="bg-white dark:bg-slate-900 border border-gray-300 dark:border-slate-600 rounded-lg p-4 hover:shadow-md transition-shadow">
		<!-- Header with status indicator -->
		<div class="flex items-start justify-between mb-3">
			<div class="flex items-center gap-2 flex-1 min-w-0">
				<!-- Status indicator -->
				if status, ok := data["status"].(string); ok {
					<div class={ getStatusIndicatorClass(status) }></div>
				}
				<h3 class="text-lg font-semibold text-gray-800 dark:text-gray-100 truncate">
					if name, ok := data["name"].(string); ok {
						{ name }
					}
				</h3>
			</div>
		</div>

		<!-- Metrics from config -->
		if metricsConfig, ok := config["metrics"].([]any); ok && len(metricsConfig) > 0 {
			<div class="space-y-2 mb-3">
				for _, metricConfig := range metricsConfig {
					if mc, ok := metricConfig.(map[string]any); ok {
						@renderMetric(mc, data)
					}
				}
			</div>
		}

		<!-- Actions from config -->
		if actionsConfig, ok := config["actions"].([]any); ok && len(actionsConfig) > 0 {
			<div class="flex gap-2 mt-3 pt-3 border-t border-gray-200 dark:border-slate-700">
				for _, actionConfig := range actionsConfig {
					if ac, ok := actionConfig.(map[string]any); ok {
						@renderAction(ac, data)
					}
				}
			</div>
		}
	</div>
}

templ renderMetric(metricConfig map[string]any, data map[string]any) {
	<div class="flex justify-between items-center text-sm">
		<span class="text-gray-600 dark:text-gray-400">
			if label, ok := metricConfig["label"].(string); ok {
				{ label }:
			}
		</span>
		<span class="font-semibold text-gray-800 dark:text-gray-100">
			if field, ok := metricConfig["field"].(string); ok {
				if value, ok := data[field]; ok {
					{ formatMetricValue(value, metricConfig) }
				}
			}
			if suffix, ok := metricConfig["suffix"].(string); ok && suffix != "" {
				<span class="text-gray-500 dark:text-gray-500 ml-1">{ suffix }</span>
			}
		</span>
	</div>
}

templ renderAction(actionConfig map[string]any, data map[string]any) {
	if label, ok := actionConfig["label"].(string); ok {
		if linkTemplate, ok := actionConfig["link"].(string); ok {
			// Template variables in link (e.g., "/server/{{server_id}}/frontend/{{name}}")
			<a
				href={ templ.SafeURL(processTemplateString(linkTemplate, data)) }
				class="text-sm text-blue-600 dark:text-blue-400 hover:text-blue-800 dark:hover:text-blue-300 font-medium"
			>
				{ label }
			</a>
		}
	}
}

// Helper functions

func getStatusIndicatorClass(status string) string {
	baseClass := "w-3 h-3 rounded-full flex-shrink-0 "
	switch status {
	case "healthy", "up", "active":
		return baseClass + "bg-green-500"
	case "warning", "degraded":
		return baseClass + "bg-yellow-500"
	case "critical", "down", "error":
		return baseClass + "bg-red-500"
	default:
		return baseClass + "bg-gray-400"
	}
}

func formatMetricValue(value any, config map[string]any) string {
	format, _ := config["format"].(string)

	switch v := value.(type) {
	case float64:
		switch format {
		case "number":
			return formatNumber(v)
		case "bytes":
			return formatBytes(v)
		case "percentage":
			return formatPercentage(v)
		case "duration":
			return formatDuration(v)
		default:
			return fmt.Sprintf("%.0f", v)
		}
	case int:
		return formatNumber(float64(v))
	case string:
		return v
	default:
		return fmt.Sprintf("%v", v)
	}
}

func processTemplateString(template string, data map[string]any) string {
	// Simple template variable replacement: {{key}} -> value
	result := template
	for key, value := range data {
		placeholder := fmt.Sprintf("{{%s}}", key)
		replacement := fmt.Sprintf("%v", value)
		result = replaceAll(result, placeholder, replacement)
	}
	return result
}

func replaceAll(s, old, new string) string {
	// Simple string replacement
	for i := 0; i < len(s); i++ {
		if hasPrefix(s[i:], old) {
			s = s[:i] + new + s[i+len(old):]
			i += len(new) - 1
		}
	}
	return s
}

func hasPrefix(s, prefix string) bool {
	if len(s) < len(prefix) {
		return false
	}
	for i := 0; i < len(prefix); i++ {
		if s[i] != prefix[i] {
			return false
		}
	}
	return true
}
