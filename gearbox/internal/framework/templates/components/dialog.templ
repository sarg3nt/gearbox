package components

// Dialog renders a modal dialog overlay
// Use HTMX or Alpine.js to control visibility via CSS classes
templ Dialog(id, title string, showCancel bool) {
	<div
		id={ id }
		class="hidden fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center z-50"
		x-data="{ show: false }"
		x-show="show"
		x-cloak
		@keydown.escape.window="show = false"
	>
		<div
			class="bg-white dark:bg-slate-900 rounded-lg shadow-xl w-full max-w-md mx-4"
			@click.away="show = false"
		>
			<!-- Header -->
			<div class="flex items-center justify-between p-6 border-b border-gray-200 dark:border-slate-700">
				<h3 class="text-lg font-semibold text-gray-900 dark:text-gray-100">{ title }</h3>
				<button
					type="button"
					@click="show = false"
					class="text-gray-400 hover:text-gray-600 dark:hover:text-gray-300"
				>
					<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
					</svg>
				</button>
			</div>
			<!-- Body -->
			<div class="p-6">
				{ children... }
			</div>
			<!-- Footer -->
			<div class="flex justify-end gap-3 p-6 border-t border-gray-200 dark:border-slate-700">
				if showCancel {
					<button
						type="button"
						@click="show = false"
						class="px-4 py-2 border border-gray-300 dark:border-slate-600 rounded-lg hover:bg-gray-50 dark:hover:bg-slate-800 text-gray-700 dark:text-gray-300"
					>
						Cancel
					</button>
				}
				<button
					type="button"
					id={ id + "-confirm" }
					class="px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white rounded-lg"
				>
					OK
				</button>
			</div>
		</div>
	</div>
}

// ConfirmDialog renders a confirmation dialog with custom buttons
templ ConfirmDialog(id, title, message, confirmText, cancelText string, confirmDanger bool) {
	<div
		id={ id }
		class="hidden fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center z-50"
		x-data="{ show: false }"
		x-show="show"
		x-cloak
		@keydown.escape.window="show = false"
	>
		<div
			class="bg-white dark:bg-slate-900 rounded-lg shadow-xl w-full max-w-md mx-4"
			@click.away="show = false"
		>
			<!-- Header -->
			<div class="flex items-center justify-between p-6 border-b border-gray-200 dark:border-slate-700">
				<h3 class="text-lg font-semibold text-gray-900 dark:text-gray-100">{ title }</h3>
				<button
					type="button"
					@click="show = false"
					class="text-gray-400 hover:text-gray-600 dark:hover:text-gray-300"
				>
					<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
					</svg>
				</button>
			</div>
			<!-- Body -->
			<div class="p-6">
				<p class="text-gray-700 dark:text-gray-300">{ message }</p>
			</div>
			<!-- Footer -->
			<div class="flex justify-end gap-3 p-6 border-t border-gray-200 dark:border-slate-700">
				<button
					type="button"
					@click="show = false"
					class="px-4 py-2 border border-gray-300 dark:border-slate-600 rounded-lg hover:bg-gray-50 dark:hover:bg-slate-800 text-gray-700 dark:text-gray-300"
				>
					{ cancelText }
				</button>
				if confirmDanger {
					<button
						type="button"
						id={ id + "-confirm" }
						class="px-4 py-2 bg-red-600 hover:bg-red-700 text-white rounded-lg"
					>
						{ confirmText }
					</button>
				} else {
					<button
						type="button"
						id={ id + "-confirm" }
						class="px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white rounded-lg"
					>
						{ confirmText }
					</button>
				}
			</div>
		</div>
	</div>
}

// AlertDialog renders a simple alert dialog with just an OK button
