package pages

import (
	"github.com/sarg3nt/gearbox/internal/framework/middleware"
	"github.com/sarg3nt/gearbox/internal/framework/models"
	"github.com/sarg3nt/gearbox/internal/framework/templates/layouts"
	"github.com/sarg3nt/gearbox/internal/framework/templates/pages/traffic"
)

templ TrafficPage(user *models.User, servers []models.BoxConfig) {
	@layouts.Base("Traffic Analysis", user, "/traffic") {
		@traffic.PageHeader(servers)
		<!-- Store server ID for JavaScript -->
		if len(servers) > 0 {
			<input type="hidden" id="default-server-id" value={ servers[0].ID }/>
		}
		if len(servers) == 0 {
			<div class="bg-yellow-50 dark:bg-yellow-900/20 border border-yellow-200 dark:border-yellow-800 rounded-lg p-4">
				<p class="text-yellow-700 dark:text-yellow-300">No servers configured. Please add a server in settings.</p>
			</div>
		} else {
			<!-- Main content area -->
			<div class="space-y-6">
				@traffic.SummaryCards()
				@traffic.Visualization()
				@traffic.Tables()
			</div>
		}
		<!-- D3.js for force-directed graph -->
		if middleware.UseLocalAssets(ctx) {
			<script src="/static/js/vendor/d3.v7.min.js"></script>
		} else {
			<script src="https://d3js.org/d3.v7.min.js"></script>
		}
		<script src="/static/js/traffic/traffic-visualization.js"></script>
	}
}
