package pages

import "github.com/sarg3nt/gearbox/internal/framework/models"
import "github.com/sarg3nt/gearbox/internal/framework/database"
import "github.com/sarg3nt/gearbox/internal/framework/templates/layouts"
import "github.com/sarg3nt/gearbox/internal/framework/templates/components"
import "fmt"

templ FrontendDetail(user *models.User, frontendName string, stats *models.HAProxyStats, metadata *models.Metadata, serverID string, serverName string) {
	@layouts.Base(fmt.Sprintf("Frontend: %s", frontendName), user) {
		<div class="mb-6">
			<a href="/" class="text-blue-600 hover:text-blue-800 dark:text-blue-400 dark:hover:text-blue-300 mb-2 inline-block">← Back to Overview</a>
			<!-- Server indicator -->
			<div class="flex items-center gap-2 mb-2">
				<span class="text-sm text-gray-500 dark:text-gray-400">Server:</span>
				<span class="text-sm font-medium text-gray-700 dark:text-gray-300 bg-gray-100 dark:bg-slate-700 px-2 py-0.5 rounded">{ serverName }</span>
			</div>
			<h2 class="text-3xl font-bold text-gray-800 dark:text-gray-100">Frontend: { frontendName }</h2>
		</div>

		if stats == nil {
			@components.ErrorAlert("Failed to load frontend stats")
		} else {
			for _, frontend := range stats.Frontends {
				if frontend.Name == frontendName {
					<div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
						<!-- Status Card -->
						<div class="bg-white dark:bg-slate-800 rounded-lg shadow p-6">
							<h3 class="text-lg font-semibold mb-4 text-gray-800 dark:text-gray-100">Status</h3>
							<div class="space-y-3">
								<div class="flex justify-between">
									<span class="text-gray-600 dark:text-gray-400">Status:</span>
									if frontend.Status == "OPEN" {
										<span class="px-2 py-1 text-xs font-semibold rounded bg-green-100 dark:bg-green-900 text-green-800 dark:text-green-200">
											{ frontend.Status }
										</span>
									} else {
										<span class="px-2 py-1 text-xs font-semibold rounded bg-red-100 dark:bg-red-900 text-red-800 dark:text-red-200">
											{ frontend.Status }
										</span>
									}
								</div>
							</div>
						</div>

						<!-- Sessions Card -->
						<div class="bg-white dark:bg-slate-800 rounded-lg shadow p-6">
							<h3 class="text-lg font-semibold mb-4 text-gray-800 dark:text-gray-100">Sessions</h3>
							<div class="space-y-3">
								<div class="flex justify-between">
									<span class="text-gray-600 dark:text-gray-400">Current:</span>
									<span class="font-medium text-gray-800 dark:text-gray-200">{ fmt.Sprintf("%d", frontend.CurrentSessions) }</span>
								</div>
								<div class="flex justify-between">
									<span class="text-gray-600 dark:text-gray-400">Maximum:</span>
									<span class="font-medium text-gray-800 dark:text-gray-200">{ fmt.Sprintf("%d", frontend.MaxSessions) }</span>
								</div>
								<div class="flex justify-between">
									<span class="text-gray-600 dark:text-gray-400">Total:</span>
									<span class="font-medium text-gray-800 dark:text-gray-200">{ fmt.Sprintf("%d", frontend.TotalSessions) }</span>
								</div>
								<div class="flex justify-between">
									<span class="text-gray-600 dark:text-gray-400">Limit:</span>
									<span class="font-medium text-gray-800 dark:text-gray-200">{ fmt.Sprintf("%d", frontend.SessionLimit) }</span>
								</div>
							</div>
						</div>

						<!-- Traffic Card -->
						<div class="bg-white dark:bg-slate-800 rounded-lg shadow p-6">
							<h3 class="text-lg font-semibold mb-4 text-gray-800 dark:text-gray-100">Traffic</h3>
							<div class="space-y-3">
								<div class="flex justify-between">
									<span class="text-gray-600 dark:text-gray-400">Bytes In:</span>
									<span class="font-medium text-gray-800 dark:text-gray-200">{ fmt.Sprintf("%.2f MB", float64(frontend.BytesIn)/(1024*1024)) }</span>
								</div>
								<div class="flex justify-between">
									<span class="text-gray-600 dark:text-gray-400">Bytes Out:</span>
									<span class="font-medium text-gray-800 dark:text-gray-200">{ fmt.Sprintf("%.2f MB", float64(frontend.BytesOut)/(1024*1024)) }</span>
								</div>
								<div class="flex justify-between">
									<span class="text-gray-600 dark:text-gray-400">Requests Total:</span>
									<span class="font-medium text-gray-800 dark:text-gray-200">{ fmt.Sprintf("%d", frontend.RequestTotal) }</span>
								</div>
								<div class="flex justify-between">
									<span class="text-gray-600 dark:text-gray-400">Request Rate:</span>
									<span class="font-medium text-gray-800 dark:text-gray-200">{ fmt.Sprintf("%d/s", frontend.RequestRate) }</span>
								</div>
							</div>
						</div>

						<!-- HTTP Stats Card -->
						<div class="bg-white dark:bg-slate-800 rounded-lg shadow p-6">
							<h3 class="text-lg font-semibold mb-4 text-gray-800 dark:text-gray-100">HTTP Responses</h3>
							<div class="space-y-3">
								<div class="flex justify-between">
									<span class="text-gray-600 dark:text-gray-400">2xx (Success):</span>
									<span class="font-medium text-green-600 dark:text-green-400">{ fmt.Sprintf("%d", frontend.Response2xx) }</span>
								</div>
								<div class="flex justify-between">
									<span class="text-gray-600 dark:text-gray-400">3xx (Redirect):</span>
									<span class="font-medium text-gray-800 dark:text-gray-200">{ fmt.Sprintf("%d", frontend.Response3xx) }</span>
								</div>
								<div class="flex justify-between">
									<span class="text-gray-600 dark:text-gray-400">4xx (Client Error):</span>
									<span class="font-medium text-yellow-600 dark:text-yellow-400">{ fmt.Sprintf("%d", frontend.Response4xx) }</span>
								</div>
								<div class="flex justify-between">
									<span class="text-gray-600 dark:text-gray-400">5xx (Server Error):</span>
									<span class="font-medium text-red-600 dark:text-red-400">{ fmt.Sprintf("%d", frontend.Response5xx) }</span>
								</div>
							</div>
						</div>
					</div>

					<!-- Routes to Backends -->
					if metadata != nil {
						if fm := metadata.GetMetadataForFrontend(frontendName); fm != nil && len(fm.Backends) > 0 {
							<div class="bg-white dark:bg-slate-800 rounded-lg shadow p-6 mt-6">
								<h3 class="text-lg font-semibold mb-4 text-gray-800 dark:text-gray-100">Routes to Backends</h3>
								<div class="flex flex-wrap gap-2">
									for _, backendName := range fm.Backends {
										<a
											href={ templ.SafeURL(fmt.Sprintf("/box/%s/backend/%s", serverID, backendName)) }
											class="inline-flex items-center px-3 py-2 bg-gray-100 dark:bg-slate-700 hover:bg-gray-200 dark:hover:bg-slate-600 rounded-lg text-sm font-medium text-gray-700 dark:text-gray-300 transition"
										>
											<svg class="w-4 h-4 mr-2 text-gray-500 dark:text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
												<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"></path>
											</svg>
											{ backendName }
										</a>
									}
								</div>
							</div>
						}
					}
				}
			}
		}
	}
}

templ BackendDetail(user *models.User, backendName string, stats *models.HAProxyStats, metadata *models.Metadata, serverID string, serverName string, disabledEntity *database.DisabledEntity) {
	@layouts.Base(fmt.Sprintf("Backend: %s", GetBackendDisplayName(backendName)), user) {
		<div class="mb-6">
			<a href="/" class="text-blue-600 hover:text-blue-800 dark:text-blue-400 dark:hover:text-blue-300 mb-2 inline-block">← Back to Overview</a>
			<!-- Server indicator -->
			<div class="flex items-center gap-2 mb-2">
				<span class="text-sm text-gray-500 dark:text-gray-400">Server:</span>
				<span class="text-sm font-medium text-gray-700 dark:text-gray-300 bg-gray-100 dark:bg-slate-700 px-2 py-0.5 rounded">{ serverName }</span>
			</div>
			<div class="flex items-center justify-between">
				<h2 class="text-3xl font-bold text-gray-800 dark:text-gray-100">Backend: { GetBackendDisplayName(backendName) }</h2>
				<!-- Enable/Disable Toggle -->
				<div class="flex items-center gap-3">
					if disabledEntity != nil {
						<span class="px-3 py-1.5 text-sm font-semibold rounded bg-gray-500 dark:bg-gray-600 text-white">
							DISABLED
						</span>
						<button
							type="button"
							id="enable-backend-btn"
							class="px-4 py-2 bg-green-600 hover:bg-green-700 text-white font-medium rounded-lg transition flex items-center gap-2"
							data-server-id={ serverID }
							data-backend-name={ backendName }
							title="Enable monitoring for this backend"
						>
							<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
							</svg>
							Enable Monitoring
						</button>
					} else {
						<button
							type="button"
							id="disable-backend-btn"
							class="px-4 py-2 bg-gray-500 hover:bg-gray-600 text-white font-medium rounded-lg transition flex items-center gap-2"
							data-server-id={ serverID }
							data-backend-name={ backendName }
							title="Disable monitoring for this backend"
						>
							<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18.364 18.364A9 9 0 005.636 5.636m12.728 12.728A9 9 0 015.636 5.636m12.728 12.728L5.636 5.636"></path>
							</svg>
							Disable Monitoring
						</button>
					}
				</div>
			</div>
			<!-- Disabled info banner -->
			if disabledEntity != nil {
				<div class="mt-4 p-4 bg-gray-100 dark:bg-slate-700 border border-gray-300 dark:border-slate-600 rounded-lg">
					<div class="flex items-start gap-3">
						<svg class="w-5 h-5 text-gray-500 dark:text-gray-400 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
						</svg>
						<div>
							<p class="text-sm text-gray-700 dark:text-gray-300">
								<span class="font-medium">Monitoring disabled</span> since { formatDisabledTime(disabledEntity.DisabledAt) }
							</p>
							if disabledEntity.Notes != "" {
								<p class="text-sm text-gray-600 dark:text-gray-400 mt-1">
									Notes: { disabledEntity.Notes }
								</p>
							}
							<p class="text-xs text-gray-500 dark:text-gray-500 mt-2">
								This backend is excluded from health checks and status counts on the dashboard.
							</p>
						</div>
					</div>
				</div>
			}
		</div>

		if stats == nil {
			@components.ErrorAlert("Failed to load backend stats")
		} else {
			for _, backend := range stats.Backends {
				if backend.Name == backendName {
					<!-- Backend Overview -->
					<div class="bg-white dark:bg-slate-800 rounded-lg shadow p-6 mb-6">
						<div class="flex justify-between items-start mb-4">
							<div>
								<h3 class="text-xl font-semibold text-gray-800 dark:text-gray-100">Backend Overview</h3>
							</div>
							@components.BackendHealthBadge(backend.HealthPercent)
						</div>

						<div class="grid grid-cols-2 md:grid-cols-4 gap-4">
							@components.MetricCard("Active Servers", fmt.Sprintf("%d", backend.ActiveServers), fmt.Sprintf("/ %d", backend.TotalServers))
							@components.MetricCard("Current Sessions", fmt.Sprintf("%d", backend.CurrentSessions), "")
							@components.MetricCard("Queue Time", fmt.Sprintf("%d", backend.QueueTime), "ms")
							@components.MetricCard("Response Time", fmt.Sprintf("%d", backend.ResponseTime), "ms")
						</div>
					</div>

					<!-- Historical Charts -->
					<div
						id="backend-history-container"
						class="bg-white dark:bg-slate-800 rounded-lg shadow p-6 mb-6"
						data-server-id={ serverID }
						data-backend-name={ backendName }
					>
						<div class="mb-4 flex flex-wrap gap-4 items-end">
							<div>
								<label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Time Range</label>
								<select
									id="hours-select"
									class="h-[42px] px-4 py-2 border border-gray-300 dark:border-slate-600 rounded bg-white dark:bg-slate-700 text-gray-800 dark:text-gray-200 focus:outline-none focus:ring-2 focus:ring-blue-500"
									onchange="loadBackendHistory()"
								>
									<option value="0.083">Last 5 minutes</option>
									<option value="0.5">Last 30 minutes</option>
									<option value="1">Last 1 hour</option>
									<option value="6">Last 6 hours</option>
									<option value="24" selected>Last 24 hours</option>
									<option value="72">Last 3 days</option>
									<option value="168">Last 7 days</option>
								</select>
							</div>

							<div class="flex items-center gap-3">
								<label class="text-sm font-medium text-gray-700 dark:text-gray-300">Resolution</label>
								<input
									type="range"
									id="resolution-slider"
									min="1"
									max="10"
									value="5"
									class="w-24 h-2 bg-gray-200 dark:bg-slate-600 rounded-lg appearance-none cursor-pointer"
									onchange="loadBackendHistory()"
								/>
								<span id="resolution-label" class="text-sm text-gray-500 dark:text-gray-400 w-16">Medium</span>
							</div>

							<button
								id="reset-zoom-btn"
								onclick="resetAllZoom()"
								class="hidden h-[42px] px-4 py-2 bg-gray-200 dark:bg-slate-600 text-gray-700 dark:text-gray-200 rounded hover:bg-gray-300 dark:hover:bg-slate-500 transition-colors text-sm font-medium"
							>
								Reset Zoom
							</button>

							<div id="connection-status" class="flex items-center gap-2">
								<span class="w-2 h-2 rounded-full bg-green-500 animate-pulse"></span>
								<span class="text-sm text-gray-500 dark:text-gray-400">Live</span>
							</div>
						</div>

						<!-- Charts and Info Grid - 4 columns on 2xl -->
						<div id="charts-grid" class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 2xl:grid-cols-4 gap-4">
							<!-- Sessions Chart -->
							<div id="card-sessions" class="chart-card bg-gray-50 dark:bg-slate-700 rounded-lg p-4 relative">
								<div class="flex justify-between items-center mb-2">
									<h4 class="text-sm font-medium text-gray-700 dark:text-gray-300">Sessions Over Time</h4>
									<button onclick="toggleFullscreen('card-sessions')" class="fullscreen-btn p-1 hover:bg-gray-200 dark:hover:bg-slate-600 rounded transition-colors" title="Toggle fullscreen">
										<svg class="w-4 h-4 text-gray-500 dark:text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
											<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 8V4m0 0h4M4 4l5 5m11-1V4m0 0h-4m4 0l-5 5M4 16v4m0 0h4m-4 0l5-5m11 5l-5-5m5 5v-4m0 4h-4"></path>
										</svg>
									</button>
								</div>
								<div class="chart-aspect-container">
									<canvas id="sessions-chart"></canvas>
								</div>
							</div>

							<!-- Response Time Chart -->
							<div id="card-response-time" class="chart-card bg-gray-50 dark:bg-slate-700 rounded-lg p-4 relative">
								<div class="flex justify-between items-center mb-2">
									<h4 class="text-sm font-medium text-gray-700 dark:text-gray-300">Response Time</h4>
									<button onclick="toggleFullscreen('card-response-time')" class="fullscreen-btn p-1 hover:bg-gray-200 dark:hover:bg-slate-600 rounded transition-colors" title="Toggle fullscreen">
										<svg class="w-4 h-4 text-gray-500 dark:text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
											<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 8V4m0 0h4M4 4l5 5m11-1V4m0 0h-4m4 0l-5 5M4 16v4m0 0h4m-4 0l5-5m11 5l-5-5m5 5v-4m0 4h-4"></path>
										</svg>
									</button>
								</div>
								<div class="chart-aspect-container">
									<canvas id="response-time-chart"></canvas>
								</div>
							</div>

							<!-- Network Bandwidth Chart -->
							<div id="card-network" class="chart-card bg-gray-50 dark:bg-slate-700 rounded-lg p-4 relative">
								<div class="flex justify-between items-center mb-2">
									<h4 class="text-sm font-medium text-gray-700 dark:text-gray-300">Network Throughput</h4>
									<button onclick="toggleFullscreen('card-network')" class="fullscreen-btn p-1 hover:bg-gray-200 dark:hover:bg-slate-600 rounded transition-colors" title="Toggle fullscreen">
										<svg class="w-4 h-4 text-gray-500 dark:text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
											<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 8V4m0 0h4M4 4l5 5m11-1V4m0 0h-4m4 0l-5 5M4 16v4m0 0h4m-4 0l5-5m11 5l-5-5m5 5v-4m0 4h-4"></path>
										</svg>
									</button>
								</div>
								<div class="chart-aspect-container">
									<canvas id="network-chart"></canvas>
								</div>
							</div>

							<!-- Backend Info (merged Traffic From + Configuration) -->
							if metadata != nil {
								<div class="bg-gray-50 dark:bg-slate-700 rounded-lg p-4">
									<h4 class="text-sm font-medium text-gray-700 dark:text-gray-300 mb-3">Backend Info</h4>
									<div class="space-y-3 text-sm">
										if frontendName := metadata.GetFrontendForBackend(backendName); frontendName != "" {
											<div class="flex justify-between items-center">
												<span class="text-gray-600 dark:text-gray-400">Traffic From:</span>
												<a
													href={ templ.SafeURL(fmt.Sprintf("/box/%s/frontend/%s", serverID, frontendName)) }
													class="inline-flex items-center px-2 py-1 bg-blue-100 dark:bg-blue-900 hover:bg-blue-200 dark:hover:bg-blue-800 rounded text-xs font-medium text-blue-700 dark:text-blue-300 transition"
												>
													<svg class="w-3 h-3 mr-1 text-blue-500 dark:text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
														<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 17l-5-5m0 0l5-5m-5 5h12"></path>
													</svg>
													{ frontendName }
												</a>
											</div>
										}
										for _, backendMeta := range metadata.Backends {
											if backendMeta.Name == backendName {
												if backendMeta.Hostname != "" {
													<div class="flex justify-between">
														<span class="text-gray-600 dark:text-gray-400">Hostname:</span>
														<span class="font-medium text-gray-800 dark:text-gray-200">{ backendMeta.Hostname }</span>
													</div>
												}
												if backendMeta.Public {
													<div class="flex justify-between">
														<span class="text-gray-600 dark:text-gray-400">Access:</span>
														<span class="px-2 py-0.5 text-xs font-semibold rounded bg-blue-100 dark:bg-blue-900 text-blue-800 dark:text-blue-200">Public</span>
													</div>
												} else {
													<div class="flex justify-between">
														<span class="text-gray-600 dark:text-gray-400">Access:</span>
														<span class="px-2 py-0.5 text-xs font-semibold rounded bg-gray-100 dark:bg-slate-600 text-gray-800 dark:text-gray-300">Private</span>
													</div>
												}
												if backendMeta.RateLimit > 0 {
													<div class="flex justify-between">
														<span class="text-gray-600 dark:text-gray-400">Rate Limit:</span>
														<span class="font-medium text-gray-800 dark:text-gray-200">{ fmt.Sprintf("%d req/10s", backendMeta.RateLimit) }</span>
													</div>
												}
											}
										}
									</div>
								</div>
							}
						</div>
					</div>

					<style>
					.chart-aspect-container {
						position: relative;
						width: 100%;
						height: 0;
						padding-bottom: 60%; /* ~5:3 aspect ratio */
					}
					.chart-aspect-container canvas {
						position: absolute;
						top: 0;
						left: 0;
						width: 100% !important;
						height: 100% !important;
					}
					.chart-card.fullscreen {
						position: fixed !important;
						top: 0 !important;
						left: 0 !important;
						right: 0 !important;
						bottom: 0 !important;
						width: 100vw !important;
						height: 100vh !important;
						z-index: 9999 !important;
						border-radius: 0 !important;
						margin: 0 !important;
						padding: 2rem !important;
						display: flex !important;
						flex-direction: column !important;
					}
					.chart-card.fullscreen .chart-aspect-container {
						padding-bottom: 0 !important;
						height: 100% !important;
						flex: 1 !important;
					}
					</style>

					<script>
					var backendCharts = {};
					var cachedBackendData = [];
					var currentFullscreenCard = null;
					var eventSource = null;
					var backendContainer = document.getElementById('backend-history-container');
					var backendServerID = backendContainer.dataset.serverId;
					var backendNameVar = backendContainer.dataset.backendName;

					function getBackendChartColors() {
						var isDark = document.documentElement.classList.contains('dark');
						return {
							text: isDark ? '#e2e8f0' : '#374151',
							grid: isDark ? '#475569' : '#e5e7eb',
							primary: '#3b82f6',
							secondary: '#10b981'
						};
					}

					function getZoomOptions() {
						return {
							zoom: {
								drag: {
									enabled: true,
									backgroundColor: 'rgba(59, 130, 246, 0.1)',
									borderColor: 'rgba(59, 130, 246, 0.5)',
									borderWidth: 1
								},
								mode: 'x',
								onZoomComplete: function() {
									showResetZoomButton();
								}
							},
							pan: {
								enabled: true,
								mode: 'x',
								modifierKey: 'shift'
							}
						};
					}

					function createBackendChartOptions(integerTicks) {
						var colors = getBackendChartColors();
						var yConfig = {
							ticks: { color: colors.text },
							grid: { color: colors.grid },
							min: 0
						};
						if (integerTicks) {
							// precision: 0 alone gives integer-only ticks
							// while letting Chart.js auto-pick the step.
							// stepSize: 1 here would force a 1-tick-per-
							// unit grid on series whose range can climb
							// into the thousands, triggering the
							// "limiting to 1000 ticks" console warning.
							yConfig.ticks.precision = 0;
						}
						return {
							responsive: true,
							maintainAspectRatio: false,
							plugins: {
								legend: {
									labels: { color: colors.text }
								},
								zoom: getZoomOptions()
							},
							scales: {
								x: {
									ticks: {
										color: colors.text,
										maxTicksLimit: 8
									},
									grid: { color: colors.grid }
								},
								y: yConfig
							}
						};
					}

					function formatBackendTime(timestamp) {
						var date = new Date(timestamp);
						return date.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
					}

					function destroyBackendCharts() {
						Object.values(backendCharts).forEach(function(chart) { chart.destroy(); });
						backendCharts = {};
					}

					function getResolutionLabel(value) {
						var labels = {
							1: 'Lowest', 2: 'Lowest', 3: 'Low', 4: 'Low', 5: 'Medium',
							6: 'Medium', 7: 'High', 8: 'High', 9: 'Highest', 10: 'Highest'
						};
						return labels[value] || 'Medium';
					}

					function updateResolutionLabel() {
						var slider = document.getElementById('resolution-slider');
						var label = document.getElementById('resolution-label');
						if (slider && label) {
							label.textContent = getResolutionLabel(parseInt(slider.value));
						}
					}

					function getDownsampleFactor() {
						var slider = document.getElementById('resolution-slider');
						var sliderValue = slider ? parseInt(slider.value) : 5;
						return 11 - sliderValue;
					}

					function downsampleData(data, factor) {
						if (factor <= 1 || data.length <= 20) return data;
						var result = [];
						for (var i = 0; i < data.length; i += factor) {
							result.push(data[i]);
						}
						if (result[result.length - 1] !== data[data.length - 1]) {
							result.push(data[data.length - 1]);
						}
						return result;
					}

					function calculateNetworkRates(data) {
						var labels = [];
						var bytesIn = [];
						var bytesOut = [];

						for (var i = 1; i < data.length; i++) {
							var prev = data[i - 1];
							var curr = data[i];

							var prevTime = new Date(prev.collected_at).getTime();
							var currTime = new Date(curr.collected_at).getTime();
							var timeDiffSec = (currTime - prevTime) / 1000;

							if (timeDiffSec > 0) {
								var inDiff = (curr.bytes_in || 0) - (prev.bytes_in || 0);
								var outDiff = (curr.bytes_out || 0) - (prev.bytes_out || 0);

								// Handle counter resets
								if (inDiff < 0) inDiff = curr.bytes_in || 0;
								if (outDiff < 0) outDiff = curr.bytes_out || 0;

								// Convert to Mbps
								var inMbps = (inDiff * 8) / timeDiffSec / 1000000;
								var outMbps = (outDiff * 8) / timeDiffSec / 1000000;

								labels.push(formatBackendTime(curr.collected_at));
								bytesIn.push(inMbps);
								bytesOut.push(outMbps);
							}
						}

						return { labels: labels, bytesIn: bytesIn, bytesOut: bytesOut };
					}

					function showResetZoomButton() {
						var btn = document.getElementById('reset-zoom-btn');
						if (btn) btn.classList.remove('hidden');
					}

					function hideResetZoomButton() {
						var btn = document.getElementById('reset-zoom-btn');
						if (btn) btn.classList.add('hidden');
					}

					function resetAllZoom() {
						Object.values(backendCharts).forEach(function(chart) {
							if (chart.resetZoom) chart.resetZoom();
						});
						hideResetZoomButton();
					}

					function toggleFullscreen(cardId) {
						var card = document.getElementById(cardId);
						var chartsGrid = document.getElementById('charts-grid');
						var chartKeyMap = {
							'card-sessions': 'sessions',
							'card-response-time': 'responseTime',
							'card-network': 'network'
						};
						var chartKey = chartKeyMap[cardId] || 'sessions';

						if (card.classList.contains('fullscreen')) {
							card.classList.remove('fullscreen');
							chartsGrid.querySelectorAll('.chart-card').forEach(function(c) {
								if (c.id !== cardId) c.classList.remove('hidden');
							});
							currentFullscreenCard = null;
							setTimeout(function() {
								destroyBackendCharts();
								renderBackendCharts(cachedBackendData);
							}, 50);
						} else {
							card.classList.add('fullscreen');
							chartsGrid.querySelectorAll('.chart-card').forEach(function(c) {
								if (c.id !== cardId) c.classList.add('hidden');
							});
							currentFullscreenCard = cardId;
							if (backendCharts[chartKey]) {
								setTimeout(function() { backendCharts[chartKey].resize(); }, 100);
							}
						}
					}

					document.addEventListener('keydown', function(e) {
						if (e.key === 'Escape' && currentFullscreenCard) {
							toggleFullscreen(currentFullscreenCard);
						}
					});

					function updateConnectionStatus(connected) {
						var status = document.getElementById('connection-status');
						if (status) {
							if (connected) {
								status.innerHTML = '<span class="w-2 h-2 rounded-full bg-green-500 animate-pulse"></span><span class="text-sm text-gray-500 dark:text-gray-400">Live</span>';
							} else {
								status.innerHTML = '<span class="w-2 h-2 rounded-full bg-red-500"></span><span class="text-sm text-gray-500 dark:text-gray-400">Disconnected</span>';
							}
						}
					}

					function setupSSE() {
						if (eventSource) eventSource.close();

						eventSource = new EventSource('/api/events?server=' + backendServerID);

						eventSource.onopen = function() {
							updateConnectionStatus(true);
						};

						eventSource.onerror = function() {
							updateConnectionStatus(false);
						};

						eventSource.addEventListener('stats.updated', function(e) {
							try {
								var data = JSON.parse(e.data);
								if (data.server_id === backendServerID) {
									appendBackendData(data);
								}
							} catch (err) {
								console.error('Failed to parse stats event:', err);
							}
						});
					}

					function appendBackendData(newData) {
						var eventData = newData.data || {};
						var stats = eventData.stats || {};
						var backends = stats.backends || [];

						var backendStats = backends.find(function(b) { return b.pxname === backendNameVar; });
						if (!backendStats) return;

						var point = {
							collected_at: new Date().toISOString(),
							current_sessions: backendStats.scur || 0,
							response_time: backendStats.rtime || 0,
							bytes_in: backendStats.bin || 0,
							bytes_out: backendStats.bout || 0
						};

						cachedBackendData.push(point);

						var hours = parseFloat(document.getElementById('hours-select').value);
						var cutoff = new Date(Date.now() - hours * 60 * 60 * 1000);
						cachedBackendData = cachedBackendData.filter(function(d) {
							return new Date(d.collected_at) > cutoff;
						});

						var factor = getDownsampleFactor();
						var sampledData = downsampleData(cachedBackendData, factor);

						if (backendCharts.sessions) {
							backendCharts.sessions.data.labels = sampledData.map(function(d) { return formatBackendTime(d.collected_at); });
							backendCharts.sessions.data.datasets[0].data = sampledData.map(function(d) { return d.current_sessions; });
							backendCharts.sessions.update('none');
						}
						if (backendCharts.responseTime) {
							backendCharts.responseTime.data.labels = sampledData.map(function(d) { return formatBackendTime(d.collected_at); });
							backendCharts.responseTime.data.datasets[0].data = sampledData.map(function(d) { return d.response_time; });
							backendCharts.responseTime.update('none');
						}
						if (backendCharts.network) {
							var networkData = calculateNetworkRates(sampledData);
							backendCharts.network.data.labels = networkData.labels;
							backendCharts.network.data.datasets[0].data = networkData.bytesIn;
							backendCharts.network.data.datasets[1].data = networkData.bytesOut;
							backendCharts.network.update('none');
						}
					}

					function loadBackendHistory() {
						updateResolutionLabel();
						var hours = document.getElementById('hours-select').value;
						fetch('/api/' + backendServerID + '/metrics/backend/' + encodeURIComponent(backendNameVar) + '?hours=' + hours)
							.then(function(response) { return response.json(); })
							.then(function(result) {
								cachedBackendData = result.data || [];
								destroyBackendCharts();
								renderBackendCharts(cachedBackendData);
								setupSSE();
							})
							.catch(function(error) {
								console.error('Failed to load backend history:', error);
							});
					}

					function renderBackendCharts(data) {
						hideResetZoomButton();
						var colors = getBackendChartColors();
						var factor = getDownsampleFactor();
						var sampledData = downsampleData(data, factor);

						// Sessions chart
						var sessionsCtx = document.getElementById('sessions-chart');
						if (sessionsCtx) {
							backendCharts.sessions = new Chart(sessionsCtx.getContext('2d'), {
								type: 'line',
								data: {
									labels: sampledData.map(function(d) { return formatBackendTime(d.collected_at); }),
									datasets: [{
										label: 'Current Sessions',
										data: sampledData.map(function(d) { return d.current_sessions; }),
										borderColor: colors.primary,
										backgroundColor: 'transparent',
										borderWidth: 1.5,
										pointRadius: 0,
										pointHoverRadius: 3,
										tension: 0.4
									}]
								},
								options: createBackendChartOptions(true)
							});
						}

						// Response time chart
						var responseCtx = document.getElementById('response-time-chart');
						if (responseCtx) {
							backendCharts.responseTime = new Chart(responseCtx.getContext('2d'), {
								type: 'line',
								data: {
									labels: sampledData.map(function(d) { return formatBackendTime(d.collected_at); }),
									datasets: [{
										label: 'Response Time (ms)',
										data: sampledData.map(function(d) { return d.response_time; }),
										borderColor: colors.secondary,
										backgroundColor: 'transparent',
										borderWidth: 1.5,
										pointRadius: 0,
										pointHoverRadius: 3,
										tension: 0.4
									}]
								},
								options: createBackendChartOptions(false)
							});
						}

						// Network throughput chart
						var networkCtx = document.getElementById('network-chart');
						if (networkCtx) {
							var networkData = calculateNetworkRates(sampledData);
							backendCharts.network = new Chart(networkCtx.getContext('2d'), {
								type: 'line',
								data: {
									labels: networkData.labels,
									datasets: [{
										label: 'In (Mbps)',
										data: networkData.bytesIn,
										borderColor: colors.primary,
										backgroundColor: 'transparent',
										borderWidth: 1.5,
										pointRadius: 0,
										pointHoverRadius: 3,
										tension: 0.4
									}, {
										label: 'Out (Mbps)',
										data: networkData.bytesOut,
										borderColor: '#f59e0b',
										backgroundColor: 'transparent',
										borderWidth: 1.5,
										pointRadius: 0,
										pointHoverRadius: 3,
										tension: 0.4
									}]
								},
								options: createBackendChartOptions(false)
							});
						}
					}

					document.addEventListener('DOMContentLoaded', function() {
						updateResolutionLabel();
						loadBackendHistory();

						var slider = document.getElementById('resolution-slider');
						if (slider) {
							slider.addEventListener('input', updateResolutionLabel);
						}
					});

					window.addEventListener('beforeunload', function() {
						if (eventSource) eventSource.close();
					});

					// Re-render on theme change
					var backendObserver = new MutationObserver(function(mutations) {
						mutations.forEach(function(mutation) {
							if (mutation.attributeName === 'class') {
								destroyBackendCharts();
								renderBackendCharts(cachedBackendData);
							}
						});
					});
					backendObserver.observe(document.documentElement, { attributes: true });
					</script>

					<!-- Enable/Disable backend handler -->
					<script>
					document.addEventListener('DOMContentLoaded', function() {
						var enableBtn = document.getElementById('enable-backend-btn');
						var disableBtn = document.getElementById('disable-backend-btn');

						if (enableBtn) {
							enableBtn.addEventListener('click', function() {
								var serverID = this.dataset.serverId;
								var backendName = this.dataset.backendName;

								this.disabled = true;
								this.textContent = 'Enabling...';

								fetch('/api/' + serverID + '/enable-entity', {
									method: 'POST',
									headers: { 'Content-Type': 'application/json' },
									body: JSON.stringify({
										entity_type: 'backend',
										entity_name: backendName
									})
								})
								.then(function(response) {
									if (!response.ok) throw new Error('Failed to enable backend');
									return response.json();
								})
								.then(function(data) {
									window.location.reload();
								})
								.catch(function(error) {
									if (window.showToast) {
										window.showToast('Failed to enable backend: ' + error.message, 'error', 5000);
									}
									enableBtn.disabled = false;
									enableBtn.innerHTML = '<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg> Enable Monitoring';
								});
							});
						}

						if (disableBtn) {
							disableBtn.addEventListener('click', async function() {
								var serverID = this.dataset.serverId;
								var backendName = this.dataset.backendName;

								const confirmed = await showConfirmDialog({
									title: 'Disable Monitoring',
									message: 'Disable monitoring for this backend?\n\nThis will exclude it from health checks and status counts on the dashboard.',
									confirmText: 'Disable',
									type: 'warning'
								});
								if (!confirmed) return;

								this.disabled = true;
								this.textContent = 'Disabling...';

								fetch('/api/' + serverID + '/disable-entity', {
									method: 'POST',
									headers: { 'Content-Type': 'application/json' },
									body: JSON.stringify({
										entity_type: 'backend',
										entity_name: backendName,
										notes: 'Disabled via backend detail page'
									})
								})
								.then(function(response) {
									if (!response.ok) throw new Error('Failed to disable backend');
									return response.json();
								})
								.then(function(data) {
									window.location.reload();
								})
								.catch(function(error) {
									if (window.showToast) {
										window.showToast('Failed to disable backend: ' + error.message, 'error', 5000);
									}
									disableBtn.disabled = false;
									disableBtn.innerHTML = '<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18.364 18.364A9 9 0 005.636 5.636m12.728 12.728A9 9 0 015.636 5.636m12.728 12.728L5.636 5.636"></path></svg> Disable Monitoring';
								});
							});
						}
					});
					</script>

					<!-- Servers Table -->
					<div class="bg-white dark:bg-slate-800 rounded-lg shadow p-6 mb-6">
						<h3 class="text-lg font-semibold mb-4 text-gray-800 dark:text-gray-100">Backend Servers</h3>

						if len(backend.Servers) == 0 {
							@components.InfoAlert("No servers configured for this backend")
						} else {
							<div class="overflow-x-auto">
								<table class="min-w-full divide-y divide-gray-200 dark:divide-slate-700">
									<thead class="bg-gray-50 dark:bg-slate-700">
										<tr>
											<th class="px-6 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-400 uppercase tracking-wider">Server</th>
											<th class="px-6 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-400 uppercase tracking-wider">Status</th>
											<th class="px-6 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-400 uppercase tracking-wider">Sessions</th>
											<th class="px-6 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-400 uppercase tracking-wider">Weight</th>
											<th class="px-6 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-400 uppercase tracking-wider">Check</th>
										</tr>
									</thead>
									<tbody class="bg-white dark:bg-slate-800 divide-y divide-gray-200 dark:divide-slate-700">
										for _, server := range backend.Servers {
											<tr>
												<td class="px-6 py-4 whitespace-nowrap font-medium text-gray-800 dark:text-gray-200">{ server.Name }</td>
												<td class="px-6 py-4 whitespace-nowrap">
													switch server.Status {
														case "UP":
															<span class="px-2 py-1 text-xs font-semibold rounded bg-green-100 dark:bg-green-900 text-green-800 dark:text-green-200">
																{ server.Status }
															</span>
														case "DOWN":
															<span class="px-2 py-1 text-xs font-semibold rounded bg-red-100 dark:bg-red-900 text-red-800 dark:text-red-200">
																{ server.Status }
															</span>
														default:
															<span class="px-2 py-1 text-xs font-semibold rounded bg-yellow-100 dark:bg-yellow-900 text-yellow-800 dark:text-yellow-200">
																{ server.Status }
															</span>
													}
												</td>
												<td class="px-6 py-4 whitespace-nowrap text-gray-800 dark:text-gray-200">{ fmt.Sprintf("%d / %d", server.CurrentSessions, server.MaxSessions) }</td>
												<td class="px-6 py-4 whitespace-nowrap text-gray-800 dark:text-gray-200">{ fmt.Sprintf("%d", server.Weight) }</td>
												<td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500 dark:text-gray-400">{ server.CheckStatus }</td>
											</tr>
										}
									</tbody>
								</table>
							</div>
						}
					</div>
				}
			}
		}
	}
}