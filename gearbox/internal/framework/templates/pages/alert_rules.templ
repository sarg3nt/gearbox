package pages

import (
	"github.com/sarg3nt/gearbox/internal/framework/models"
	ui "github.com/sarg3nt/webcore/ui/components"
	"github.com/sarg3nt/gearbox/internal/framework/templates/layouts"
)

// AlertRulesPage renders the alert rules configuration page.
templ AlertRulesPage(user *models.User, serverID string, serverName string, servers []models.BoxConfig, successMsg, errorMsg string) {
	@layouts.Base("Alert Rules", user, "/settings") {
		<!-- Hidden container for page header content. Title + box selector
		     live in the global header breadcrumb + chip. -->
		<div id="page-header-source" class="hidden">
			<div class="flex-1"></div>
			<a href={ templ.SafeURL("/settings/gears/alerts?server=" + serverID) } class="text-sm text-blue-600 dark:text-blue-400 hover:underline flex items-center">
				<svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
				</svg>
				Back to Alerts Settings
			</a>
		</div>

		<div class="max-w-6xl mx-auto px-4 py-8">
			<input type="hidden" id="current-server-id" value={ serverID }/>

			if successMsg != "" {
				@ui.ToastOnLoad(successMsg, "success")
			}

			if errorMsg != "" {
				@ui.ToastOnLoad(errorMsg, "error")
			}

			<!-- Rules Summary -->
			<div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-6">
				<div class="bg-white dark:bg-slate-800 rounded-lg shadow p-4">
					<div class="flex items-center justify-between">
						<div>
							<p class="text-sm text-gray-600 dark:text-gray-400">Total Rules</p>
							<p id="total-rules" class="text-2xl font-bold text-gray-800 dark:text-gray-200">-</p>
						</div>
						<div class="p-3 bg-blue-100 dark:bg-blue-900/30 rounded-lg">
							<svg class="w-6 h-6 text-blue-600 dark:text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"></path>
							</svg>
						</div>
					</div>
				</div>
				<div class="bg-white dark:bg-slate-800 rounded-lg shadow p-4">
					<div class="flex items-center justify-between">
						<div>
							<p class="text-sm text-gray-600 dark:text-gray-400">Enabled</p>
							<p id="enabled-rules" class="text-2xl font-bold text-green-600 dark:text-green-400">-</p>
						</div>
						<div class="p-3 bg-green-100 dark:bg-green-900/30 rounded-lg">
							<svg class="w-6 h-6 text-green-600 dark:text-green-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
							</svg>
						</div>
					</div>
				</div>
				<div class="bg-white dark:bg-slate-800 rounded-lg shadow p-4">
					<div class="flex items-center justify-between">
						<div>
							<p class="text-sm text-gray-600 dark:text-gray-400">Disabled</p>
							<p id="disabled-rules" class="text-2xl font-bold text-gray-500 dark:text-gray-400">-</p>
						</div>
						<div class="p-3 bg-gray-100 dark:bg-gray-700 rounded-lg">
							<svg class="w-6 h-6 text-gray-500 dark:text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18.364 18.364A9 9 0 005.636 5.636m12.728 12.728A9 9 0 015.636 5.636m12.728 12.728L5.636 5.636"></path>
							</svg>
						</div>
					</div>
				</div>
			</div>

			<!-- Rules Table -->
			<div class="bg-white dark:bg-slate-800 rounded-lg shadow">
				<div class="p-4 border-b border-gray-200 dark:border-slate-700 flex items-center justify-between">
					<h3 class="text-lg font-semibold text-gray-800 dark:text-gray-200">Alert Rules</h3>
					<button
						onclick="showAddRuleModal()"
						class="px-4 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition-colors flex items-center gap-2"
					>
						<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
						</svg>
						Add Rule
					</button>
				</div>
				<div class="overflow-x-auto">
					<table class="w-full">
						<thead class="bg-gray-50 dark:bg-slate-700">
							<tr>
								<th class="px-4 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-400 uppercase tracking-wider">Name</th>
								<th class="px-4 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-400 uppercase tracking-wider">Type</th>
								<th class="px-4 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-400 uppercase tracking-wider">Condition</th>
								<th class="px-4 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-400 uppercase tracking-wider">Severity</th>
								<th class="px-4 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-400 uppercase tracking-wider">Status</th>
								<th class="px-4 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-400 uppercase tracking-wider">Actions</th>
							</tr>
						</thead>
						<tbody id="rules-table" class="divide-y divide-gray-200 dark:divide-slate-700">
							<tr>
								<td colspan="6" class="px-4 py-8 text-center text-gray-500 dark:text-gray-400">Loading rules...</td>
							</tr>
						</tbody>
					</table>
				</div>
			</div>
		</div>

		<!-- Add/Edit Rule Modal -->
		<div id="add-rule-modal" role="dialog" aria-modal="true" aria-labelledby="modal-title" class="hidden fixed inset-0 bg-black/50 flex items-center justify-center z-50">
			<div class="bg-white dark:bg-slate-800 rounded-lg shadow-xl max-w-lg w-full mx-4 max-h-[90vh] overflow-y-auto">
				<div class="p-4 border-b border-gray-200 dark:border-slate-700 flex items-center justify-between">
					<h3 id="modal-title" class="text-lg font-semibold text-gray-800 dark:text-gray-200">Add Alert Rule</h3>
					<button onclick="hideAddRuleModal()" aria-label="Close" class="text-gray-400 hover:text-gray-600 dark:hover:text-gray-300">
						<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
						</svg>
					</button>
				</div>
				<form id="rule-form" class="p-4 space-y-4">
					<input type="hidden" id="rule-id" value=""/>

					<div>
						<label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Rule Name</label>
						<input type="text" id="rule-name" required maxlength="100" data-charlimit="100" class="w-full px-3 py-2 border border-gray-300 dark:border-slate-600 rounded-lg bg-white dark:bg-slate-700 text-gray-900 dark:text-gray-100"/>
					</div>

					<div>
						<label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Description</label>
						<input type="text" id="rule-description" maxlength="255" data-charlimit="255" class="w-full px-3 py-2 border border-gray-300 dark:border-slate-600 rounded-lg bg-white dark:bg-slate-700 text-gray-900 dark:text-gray-100"/>
					</div>

					<div class="grid grid-cols-2 gap-4">
						<div>
							<label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Type</label>
							<select id="rule-type" onchange="updateConditionFields()" class="w-full px-3 py-2 border border-gray-300 dark:border-slate-600 rounded-lg bg-white dark:bg-slate-700 text-gray-900 dark:text-gray-100">
								<option value="metric">System Metric</option>
								<option value="backend_down">Backend Down</option>
								<option value="frontend_down">Frontend Down</option>
								<option value="service_down">Service Down</option>
								<option value="certificate">Certificate</option>
								<option value="traffic">Traffic</option>
								<option value="security">Security</option>
							</select>
						</div>
						<div>
							<label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Severity</label>
							<select id="rule-severity" class="w-full px-3 py-2 border border-gray-300 dark:border-slate-600 rounded-lg bg-white dark:bg-slate-700 text-gray-900 dark:text-gray-100">
								<option value="info">Info</option>
								<option value="warning">Warning</option>
								<option value="critical">Critical</option>
							</select>
						</div>
					</div>

					<!-- Condition fields (shown for metric-based rules) -->
					<div id="condition-fields" class="space-y-4">
						<div class="grid grid-cols-3 gap-4">
							<div>
								<label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Metric</label>
								<select id="rule-metric" class="w-full px-3 py-2 border border-gray-300 dark:border-slate-600 rounded-lg bg-white dark:bg-slate-700 text-gray-900 dark:text-gray-100">
									<option value="cpu_percent">CPU %</option>
									<option value="memory_percent">Memory %</option>
									<option value="disk_percent">Disk %</option>
								</select>
							</div>
							<div>
								<label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Operator</label>
								<select id="rule-operator" class="w-full px-3 py-2 border border-gray-300 dark:border-slate-600 rounded-lg bg-white dark:bg-slate-700 text-gray-900 dark:text-gray-100">
									<option value=">">&gt;</option>
									<option value=">=">&gt;=</option>
									<option value="<">&lt;</option>
									<option value="<=">&lt;=</option>
									<option value="==">==</option>
								</select>
							</div>
							<div>
								<label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Threshold</label>
								<input type="number" id="rule-threshold" step="0.1" class="w-full px-3 py-2 border border-gray-300 dark:border-slate-600 rounded-lg bg-white dark:bg-slate-700 text-gray-900 dark:text-gray-100"/>
							</div>
						</div>
					</div>

					<div class="grid grid-cols-2 gap-4">
						<div>
							<label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Duration (seconds)</label>
							<input type="number" id="rule-duration" value="60" min="0" class="w-full px-3 py-2 border border-gray-300 dark:border-slate-600 rounded-lg bg-white dark:bg-slate-700 text-gray-900 dark:text-gray-100"/>
							<p class="text-xs text-gray-500 dark:text-gray-400 mt-1">Condition must persist for this long</p>
						</div>
						<div>
							<label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Cooldown (minutes)</label>
							<input type="number" id="rule-cooldown" value="5" min="1" class="w-full px-3 py-2 border border-gray-300 dark:border-slate-600 rounded-lg bg-white dark:bg-slate-700 text-gray-900 dark:text-gray-100"/>
							<p class="text-xs text-gray-500 dark:text-gray-400 mt-1">Time before re-alerting</p>
						</div>
					</div>

					<div class="space-y-2">
						<label class="block text-sm font-medium text-gray-700 dark:text-gray-300">Notifications</label>
						<div class="flex flex-wrap gap-4">
							<label class="flex items-center">
								<input type="checkbox" id="rule-notify-ui" checked class="h-4 w-4 text-blue-600 rounded border-gray-300 dark:border-gray-600"/>
								<span class="ml-2 text-sm text-gray-700 dark:text-gray-300">UI Notification</span>
							</label>
							<label class="flex items-center">
								<input type="checkbox" id="rule-notify-email" class="h-4 w-4 text-blue-600 rounded border-gray-300 dark:border-gray-600"/>
								<span class="ml-2 text-sm text-gray-700 dark:text-gray-300">Email</span>
							</label>
						</div>
					</div>

					<div>
						<label class="flex items-center">
							<input type="checkbox" id="rule-enabled" checked class="h-4 w-4 text-blue-600 rounded border-gray-300 dark:border-gray-600"/>
							<span class="ml-2 text-sm text-gray-700 dark:text-gray-300">Rule Enabled</span>
						</label>
					</div>

					<div class="flex justify-end gap-2 pt-4 border-t border-gray-200 dark:border-slate-700">
						<button type="button" onclick="hideAddRuleModal()" class="px-4 py-2 text-gray-700 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-slate-700 rounded-lg transition-colors">Cancel</button>
						<button type="button" onclick="saveRule()" class="px-4 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition-colors">Save Rule</button>
					</div>
				</form>
			</div>
		</div>

		<script>
		let currentServerID = '';
		let rulesData = [];

		function switchServer(serverID) {
			window.location.href = '/settings/gears/alerts/rules?server=' + encodeURIComponent(serverID);
		}

		function setupPageHeader() {
			const source = document.getElementById('page-header-source');
			const target = document.getElementById('header-page-content');
			if (source && target) {
				while (source.firstChild) {
					target.appendChild(source.firstChild);
				}
				source.remove();
			}
		}

		document.addEventListener('DOMContentLoaded', function() {
			setupPageHeader();
			const serverInput = document.getElementById('current-server-id');
			if (serverInput) {
				currentServerID = serverInput.value;
				loadRules();
			}
		});

		async function loadRules() {
			try {
				const response = await fetch('/api/' + currentServerID + '/alerts/rules');
				if (!response.ok) throw new Error('Failed to load rules');
				const data = await response.json();

				rulesData = data.rules || [];
				const enabledCount = rulesData.filter(r => r.enabled).length;
				const disabledCount = rulesData.length - enabledCount;

				document.getElementById('total-rules').textContent = rulesData.length;
				document.getElementById('enabled-rules').textContent = enabledCount;
				document.getElementById('disabled-rules').textContent = disabledCount;

				renderRulesTable(rulesData);
			} catch (err) {
				console.error('Failed to load rules:', err);
				document.getElementById('rules-table').innerHTML = '<tr><td colspan="6" class="px-4 py-8 text-center text-red-500">Failed to load rules</td></tr>';
			}
		}

		function renderRulesTable(rules) {
			const tbody = document.getElementById('rules-table');
			if (!rules || rules.length === 0) {
				tbody.innerHTML = '<tr><td colspan="6" class="px-4 py-8 text-center text-gray-500 dark:text-gray-400">No alert rules configured</td></tr>';
				return;
			}

			const severityColors = {
				critical: 'text-red-500',
				warning: 'text-yellow-500',
				info: 'text-blue-500'
			};

			tbody.innerHTML = rules.map(rule => {
				const condition = rule.metric ? (rule.metric + ' ' + rule.operator + ' ' + rule.threshold) : rule.type;
				const sevColor = severityColors[rule.severity] || '';
				const enabledClass = rule.enabled ? 'bg-green-100 dark:bg-green-900/30 text-green-700 dark:text-green-400' : 'bg-gray-100 dark:bg-gray-700 text-gray-600 dark:text-gray-400';
				const enabledText = rule.enabled ? 'Enabled' : 'Disabled';
				const toggleText = rule.enabled ? 'Disable' : 'Enable';

				return '<tr class="hover:bg-gray-50 dark:hover:bg-slate-700">' +
					'<td class="px-4 py-3 text-gray-800 dark:text-gray-200 font-medium">' + escapeHtml(rule.name) + '</td>' +
					'<td class="px-4 py-3 text-gray-600 dark:text-gray-400">' + escapeHtml(rule.type) + '</td>' +
					'<td class="px-4 py-3 text-gray-600 dark:text-gray-400 font-mono text-xs">' + escapeHtml(condition) + '</td>' +
					'<td class="px-4 py-3 ' + sevColor + '">' + escapeHtml(rule.severity) + '</td>' +
					'<td class="px-4 py-3"><span class="px-2 py-1 text-xs rounded ' + enabledClass + '">' + enabledText + '</span></td>' +
					'<td class="px-4 py-3"><div class="flex gap-1">' +
						'<button onclick="editRule(' + rule.id + ')" class="px-2 py-1 text-xs bg-blue-100 dark:bg-blue-900/30 hover:bg-blue-200 dark:hover:bg-blue-900/50 text-blue-700 dark:text-blue-400 rounded transition-colors">Edit</button>' +
						'<button onclick="toggleRule(' + rule.id + ', ' + (!rule.enabled) + ')" class="px-2 py-1 text-xs bg-gray-100 dark:bg-gray-700 hover:bg-gray-200 dark:hover:bg-gray-600 text-gray-700 dark:text-gray-300 rounded transition-colors">' + toggleText + '</button>' +
						'<button onclick="deleteRule(' + rule.id + ')" class="px-2 py-1 text-xs bg-red-100 dark:bg-red-900/30 hover:bg-red-200 dark:hover:bg-red-900/50 text-red-700 dark:text-red-400 rounded transition-colors">Delete</button>' +
					'</div></td>' +
				'</tr>';
			}).join('');
		}

		function showAddRuleModal() {
			document.getElementById('add-rule-modal').classList.remove('hidden');
			document.getElementById('rule-form').reset();
			document.getElementById('rule-id').value = '';
			document.getElementById('modal-title').textContent = 'Add Alert Rule';
			updateConditionFields();
		}

		function hideAddRuleModal() {
			document.getElementById('add-rule-modal').classList.add('hidden');
		}

		function editRule(ruleID) {
			const rule = rulesData.find(r => r.id === ruleID);
			if (!rule) return;

			document.getElementById('rule-id').value = rule.id;
			document.getElementById('rule-name').value = rule.name;
			document.getElementById('rule-description').value = rule.description || '';
			document.getElementById('rule-type').value = rule.type;
			document.getElementById('rule-severity').value = rule.severity;
			document.getElementById('rule-duration').value = rule.duration || 0;
			document.getElementById('rule-cooldown').value = rule.cooldown_minutes || 5;
			document.getElementById('rule-notify-ui').checked = rule.notify_ui;
			document.getElementById('rule-notify-email').checked = rule.notify_email;
			document.getElementById('rule-enabled').checked = rule.enabled;

			updateConditionFields();

			if (rule.metric) {
				document.getElementById('rule-metric').value = rule.metric;
				document.getElementById('rule-operator').value = rule.operator;
				document.getElementById('rule-threshold').value = rule.threshold;
			}

			document.getElementById('modal-title').textContent = 'Edit Alert Rule';
			document.getElementById('add-rule-modal').classList.remove('hidden');
		}

		function updateConditionFields() {
			const ruleType = document.getElementById('rule-type').value;
			const conditionFields = document.getElementById('condition-fields');

			if (ruleType === 'metric' || ruleType === 'traffic' || ruleType === 'certificate') {
				conditionFields.classList.remove('hidden');
				const metricSelect = document.getElementById('rule-metric');
				metricSelect.innerHTML = '';

				let options = [];
				if (ruleType === 'metric') {
					options = [
						{ value: 'cpu_percent', label: 'CPU Usage %' },
						{ value: 'memory_percent', label: 'Memory Usage %' },
						{ value: 'disk_percent', label: 'Disk Usage %' },
						{ value: 'load_average_1', label: 'Load Average (1m)' },
						{ value: 'load_average_5', label: 'Load Average (5m)' },
						{ value: 'load_average_15', label: 'Load Average (15m)' }
					];
				} else if (ruleType === 'traffic') {
					options = [
						{ value: 'error_rate', label: 'Error Rate %' }
					];
				} else if (ruleType === 'certificate') {
					options = [
						{ value: 'days_until_expiry', label: 'Days Until Expiry' }
					];
				}

				options.forEach(opt => {
					const option = document.createElement('option');
					option.value = opt.value;
					option.textContent = opt.label;
					metricSelect.appendChild(option);
				});
			} else {
				conditionFields.classList.add('hidden');
			}
		}

		async function saveRule() {
			const ruleID = document.getElementById('rule-id').value;
			const rule = {
				name: document.getElementById('rule-name').value,
				description: document.getElementById('rule-description').value,
				type: document.getElementById('rule-type').value,
				severity: document.getElementById('rule-severity').value,
				enabled: document.getElementById('rule-enabled').checked,
				cooldown_minutes: parseInt(document.getElementById('rule-cooldown').value) || 5,
				duration: parseInt(document.getElementById('rule-duration').value) || 0,
				notify_ui: document.getElementById('rule-notify-ui').checked,
				notify_email: document.getElementById('rule-notify-email').checked
			};

			const ruleType = rule.type;
			if (ruleType === 'metric' || ruleType === 'traffic' || ruleType === 'certificate') {
				rule.metric = document.getElementById('rule-metric').value;
				rule.operator = document.getElementById('rule-operator').value;
				rule.threshold = parseFloat(document.getElementById('rule-threshold').value);
			}

			try {
				let response;
				if (ruleID) {
					response = await fetch('/api/alerts/rules/' + ruleID, {
						method: 'PUT',
						headers: { 'Content-Type': 'application/json' },
						body: JSON.stringify(rule)
					});
				} else {
					response = await fetch('/api/' + currentServerID + '/alerts/rules', {
						method: 'POST',
						headers: { 'Content-Type': 'application/json' },
						body: JSON.stringify(rule)
					});
				}

				if (!response.ok) throw new Error('Failed to save rule');

				hideAddRuleModal();
				await loadRules();
				showToast('Rule saved successfully', 'success');
			} catch (err) {
				showToast('Failed to save rule: ' + err.message, 'error');
			}
		}

		async function toggleRule(ruleID, enabled) {
			try {
				const rule = rulesData.find(r => r.id === ruleID);
				if (!rule) return;

				rule.enabled = enabled;
				const response = await fetch('/api/alerts/rules/' + ruleID, {
					method: 'PUT',
					headers: { 'Content-Type': 'application/json' },
					body: JSON.stringify(rule)
				});
				if (!response.ok) throw new Error('Failed to update rule');
				await loadRules();
				showToast('Rule ' + (enabled ? 'enabled' : 'disabled'), 'success');
			} catch (err) {
				showToast('Failed to toggle rule: ' + err.message, 'error');
			}
		}

		async function deleteRule(ruleID) {
			const confirmed = await showConfirmDialog({
				title: 'Delete Rule',
				message: 'Are you sure you want to delete this rule?',
				confirmText: 'Delete',
				type: 'danger'
			});
			if (!confirmed) return;

			try {
				const response = await fetch('/api/alerts/rules/' + ruleID, { method: 'DELETE' });
				if (!response.ok) throw new Error('Failed to delete rule');
				await loadRules();
				showToast('Rule deleted', 'success');
			} catch (err) {
				showToast('Failed to delete rule: ' + err.message, 'error');
			}
		}

		function escapeHtml(text) {
			if (!text) return '';
			const div = document.createElement('div');
			div.textContent = text;
			return div.innerHTML;
		}

		function showToast(message, type) {
			if (window.showToast) {
				window.showToast(message, type, 3000);
			} else {
				showAlertDialog({
					title: type === 'error' ? 'Error' : type === 'success' ? 'Success' : 'Info',
					message: message,
					type: type === 'error' ? 'error' : type === 'success' ? 'success' : 'info'
				});
			}
		}
		</script>
	}
}
