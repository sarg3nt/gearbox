package pages

import (
	"fmt"
	"github.com/sarg3nt/gearbox/internal/framework/models"
	"github.com/sarg3nt/gearbox/internal/framework/ui"
	"github.com/sarg3nt/gearbox/internal/framework/templates/layouts"
)

// isCustomPort returns true if the port is not one of the standard SMTP ports
func isCustomPort(port int) bool {
	return port != 0 && port != 25 && port != 465 && port != 587
}

// passwordPlaceholder returns a placeholder text for the password field
func passwordPlaceholder(currentPassword string) string {
	if currentPassword != "" {
		return "••••••••••••••••" // Show dots if password is set
	}
	return "Enter SMTP password"
}

// PasswordStrengthMeter renders the password strength meter component
// passwordFieldId should be the ID of the password input field to monitor
templ PasswordStrengthMeter(passwordFieldId string) {
	<div class="mt-2">
		<div class="flex items-center space-x-2">
			<div class="flex-1 h-2 bg-gray-200 dark:bg-slate-600 rounded-full overflow-hidden">
				<div id={ passwordFieldId + "_strength_bar" } class="h-full w-0 transition-all duration-300 rounded-full"></div>
			</div>
			<div class="flex items-center space-x-1 min-w-[100px]">
				<span id={ passwordFieldId + "_strength_text" } class="text-xs text-gray-500 dark:text-gray-400"></span>
				<svg id={ passwordFieldId + "_strength_check" } class="w-4 h-4 text-green-500 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
				</svg>
			</div>
		</div>
	</div>
}

// PasswordStrengthScript renders the JavaScript for password strength calculation
// This should be included once per page that uses password strength meters
templ PasswordStrengthScript() {
	<script src="/static/js/user-pages/password-strength.js"></script>
}

// RequestAccount page for users to request an account
templ RequestAccount(errorMessage string, csrfToken string, passwordRequirements []string) {
	<!DOCTYPE html>
	<html lang="en">
	<head>
		<meta charset="UTF-8"/>
		<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
		<title>Request Account - Gearbox</title>
		<script src="https://cdn.tailwindcss.com"></script>
		<script>
			tailwind.config = { darkMode: 'class' }
			function getThemePreference() {
				const stored = localStorage.getItem('theme');
				if (stored) return stored;
				return 'system';
			}
			function getEffectiveTheme() {
				const pref = getThemePreference();
				if (pref === 'system') {
					return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
				}
				return pref;
			}
			if (getEffectiveTheme() === 'dark') {
				document.documentElement.classList.add('dark');
			}
		</script>
	</head>
	<body class="bg-gray-100 dark:bg-slate-900">
		@ui.Toast()
		if errorMessage != "" {
			@ui.ToastOnLoad(errorMessage, "error")
		}
		<div class="min-h-screen flex items-center justify-center py-12 px-4">
			<div class="bg-white dark:bg-slate-800 p-8 rounded-lg shadow-lg w-full max-w-md">
				<div class="flex justify-center mb-6">
					<svg class="w-16 h-16 text-blue-600 dark:text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z"></path>
					</svg>
				</div>
				<h2 class="text-2xl font-bold text-center mb-6 text-gray-800 dark:text-gray-100">Request Account</h2>

				<form action="/request-account" method="POST" class="space-y-4">
					<input type="hidden" name="csrf_token" value={ csrfToken }/>

					<div class="grid grid-cols-2 gap-4">
						<div>
							<label for="first_name" class="block text-gray-700 dark:text-gray-300 font-medium mb-1 text-sm">First Name *</label>
							<input type="text" id="first_name" name="first_name" required class="w-full px-3 py-2 border border-gray-300 dark:border-slate-600 rounded bg-white dark:bg-slate-700 text-gray-800 dark:text-gray-200 focus:outline-none focus:ring-2 focus:ring-blue-500"/>
						</div>
						<div>
							<label for="last_name" class="block text-gray-700 dark:text-gray-300 font-medium mb-1 text-sm">Last Name *</label>
							<input type="text" id="last_name" name="last_name" required class="w-full px-3 py-2 border border-gray-300 dark:border-slate-600 rounded bg-white dark:bg-slate-700 text-gray-800 dark:text-gray-200 focus:outline-none focus:ring-2 focus:ring-blue-500"/>
						</div>
					</div>

					<div>
						<label for="email" class="block text-gray-700 dark:text-gray-300 font-medium mb-1 text-sm">Email Address *</label>
						<input type="email" id="email" name="email" required autocomplete="email" class="w-full px-3 py-2 border border-gray-300 dark:border-slate-600 rounded bg-white dark:bg-slate-700 text-gray-800 dark:text-gray-200 focus:outline-none focus:ring-2 focus:ring-blue-500" placeholder="user@example.com"/>
					</div>

					<div>
						<label for="phone_number" class="block text-gray-700 dark:text-gray-300 font-medium mb-1 text-sm">Phone Number</label>
						<input type="tel" id="phone_number" name="phone_number" class="w-full px-3 py-2 border border-gray-300 dark:border-slate-600 rounded bg-white dark:bg-slate-700 text-gray-800 dark:text-gray-200 focus:outline-none focus:ring-2 focus:ring-blue-500"/>
					</div>

					<div>
						<label for="password" class="block text-gray-700 dark:text-gray-300 font-medium mb-1 text-sm">Password *</label>
						<input type="password" id="password" name="password" required autocomplete="new-password" class="w-full px-3 py-2 border border-gray-300 dark:border-slate-600 rounded bg-white dark:bg-slate-700 text-gray-800 dark:text-gray-200 focus:outline-none focus:ring-2 focus:ring-blue-500"/>
						@PasswordStrengthMeter("password")
					</div>

					<div>
						<label for="confirm_password" class="block text-gray-700 dark:text-gray-300 font-medium mb-1 text-sm">Confirm Password *</label>
						<input type="password" id="confirm_password" name="confirm_password" required autocomplete="new-password" class="w-full px-3 py-2 border border-gray-300 dark:border-slate-600 rounded bg-white dark:bg-slate-700 text-gray-800 dark:text-gray-200 focus:outline-none focus:ring-2 focus:ring-blue-500"/>
					</div>

					<div>
						<label for="reason" class="block text-gray-700 dark:text-gray-300 font-medium mb-1 text-sm">Why do you need access?</label>
						<textarea id="reason" name="reason" rows="2" class="w-full px-3 py-2 border border-gray-300 dark:border-slate-600 rounded bg-white dark:bg-slate-700 text-gray-800 dark:text-gray-200 focus:outline-none focus:ring-2 focus:ring-blue-500"></textarea>
					</div>

					<button type="submit" class="w-full bg-blue-600 hover:bg-blue-700 text-white font-medium py-2 px-4 rounded focus:outline-none focus:ring-2 focus:ring-blue-500">
						Submit Request
					</button>
				</form>

				<p class="text-center text-gray-600 dark:text-gray-400 text-sm mt-6">
					Already have an account? <a href="/login" class="text-blue-600 dark:text-blue-400 hover:underline">Sign in</a>
				</p>
			</div>
		</div>
		@PasswordStrengthScript()
		<script src="/static/js/user-pages/request-account.js"></script>
	</body>
	</html>
}

// RequestAccountSuccess shown after account request submitted
templ RequestAccountSuccess() {
	<!DOCTYPE html>
	<html lang="en">
	<head>
		<meta charset="UTF-8"/>
		<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
		<title>Request Submitted - Gearbox</title>
		<script src="https://cdn.tailwindcss.com"></script>
		<script>
			tailwind.config = { darkMode: 'class' }
			if (localStorage.getItem('theme') === 'dark' || (!localStorage.getItem('theme') && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
				document.documentElement.classList.add('dark');
			}
		</script>
	</head>
	<body class="bg-gray-100 dark:bg-slate-900">
		<div class="min-h-screen flex items-center justify-center">
			<div class="bg-white dark:bg-slate-800 p-8 rounded-lg shadow-lg w-full max-w-md text-center">
				<div class="flex justify-center mb-6">
					<svg class="w-16 h-16 text-green-600 dark:text-green-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
					</svg>
				</div>
				<h2 class="text-2xl font-bold mb-4 text-gray-800 dark:text-gray-100">Request Submitted!</h2>
				<p class="text-gray-600 dark:text-gray-400 mb-6">
					Your account request has been submitted successfully. An administrator will review your request and you will receive an email once it's approved.
				</p>
				<a href="/login" class="inline-block bg-blue-600 hover:bg-blue-700 text-white font-medium py-2 px-6 rounded">
					Back to Login
				</a>
			</div>
		</div>
	</body>
	</html>
}

// ForgotPassword page
templ ForgotPassword(errorMessage string, successMessage string, csrfToken string) {
	<!DOCTYPE html>
	<html lang="en">
	<head>
		<meta charset="UTF-8"/>
		<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
		<title>Forgot Password - Gearbox</title>
		<script src="https://cdn.tailwindcss.com"></script>
		<script>
			tailwind.config = { darkMode: 'class' }
			if (localStorage.getItem('theme') === 'dark' || (!localStorage.getItem('theme') && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
				document.documentElement.classList.add('dark');
			}
		</script>
	</head>
	<body class="bg-gray-100 dark:bg-slate-900">
		@ui.Toast()
		if successMessage != "" {
			@ui.ToastOnLoad(successMessage, "success")
		}
		if errorMessage != "" {
			@ui.ToastOnLoad(errorMessage, "error")
		}
		<div class="min-h-screen flex items-center justify-center">
			<div class="bg-white dark:bg-slate-800 p-8 rounded-lg shadow-lg w-full max-w-md">
				<div class="flex justify-center mb-6">
					<svg class="w-16 h-16 text-blue-600 dark:text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z"></path>
					</svg>
				</div>
				<h2 class="text-2xl font-bold text-center mb-2 text-gray-800 dark:text-gray-100">Forgot Password</h2>
				<p class="text-center text-gray-600 dark:text-gray-400 mb-6 text-sm">
					Enter your email address and we'll send you a link to reset your password.
				</p>

				<form action="/forgot-password" method="POST">
					<input type="hidden" name="csrf_token" value={ csrfToken }/>

					<div class="mb-6">
						<label for="email" class="block text-gray-700 dark:text-gray-300 font-medium mb-2">Email Address</label>
						<input type="email" id="email" name="email" required autofocus autocomplete="email" class="w-full px-4 py-2 border border-gray-300 dark:border-slate-600 rounded bg-white dark:bg-slate-700 text-gray-800 dark:text-gray-200 focus:outline-none focus:ring-2 focus:ring-blue-500" placeholder="user@example.com"/>
					</div>

					<button type="submit" class="w-full bg-blue-600 hover:bg-blue-700 text-white font-medium py-2 px-4 rounded focus:outline-none focus:ring-2 focus:ring-blue-500">
						Send Reset Link
					</button>
				</form>

				<p class="text-center text-gray-600 dark:text-gray-400 text-sm mt-6">
					<a href="/login" class="text-blue-600 dark:text-blue-400 hover:underline">Back to Login</a>
				</p>
			</div>
		</div>
	</body>
	</html>
}

// ResetPassword page
templ ResetPassword(token string, errorMessage string, csrfToken string, passwordRequirements []string) {
	<!DOCTYPE html>
	<html lang="en">
	<head>
		<meta charset="UTF-8"/>
		<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
		<title>Reset Password - Gearbox</title>
		<script src="https://cdn.tailwindcss.com"></script>
		<script>
			tailwind.config = { darkMode: 'class' }
			if (localStorage.getItem('theme') === 'dark' || (!localStorage.getItem('theme') && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
				document.documentElement.classList.add('dark');
			}
		</script>
	</head>
	<body class="bg-gray-100 dark:bg-slate-900">
		@ui.Toast()
		if errorMessage != "" {
			@ui.ToastOnLoad(errorMessage, "error")
		}
		<div class="min-h-screen flex items-center justify-center">
			<div class="bg-white dark:bg-slate-800 p-8 rounded-lg shadow-lg w-full max-w-md">
				<h2 class="text-2xl font-bold text-center mb-6 text-gray-800 dark:text-gray-100">Reset Password</h2>

				<form action="/reset-password" method="POST" class="space-y-4">
					<input type="hidden" name="csrf_token" value={ csrfToken }/>
					<input type="hidden" name="token" value={ token }/>

					<div>
						<label for="password" class="block text-gray-700 dark:text-gray-300 font-medium mb-2">New Password</label>
						<input type="password" id="password" name="password" required autocomplete="new-password" class="w-full px-4 py-2 border border-gray-300 dark:border-slate-600 rounded bg-white dark:bg-slate-700 text-gray-800 dark:text-gray-200 focus:outline-none focus:ring-2 focus:ring-blue-500"/>
						@PasswordStrengthMeter("password")
					</div>

					<div>
						<label for="confirm_password" class="block text-gray-700 dark:text-gray-300 font-medium mb-2">Confirm Password</label>
						<input type="password" id="confirm_password" name="confirm_password" required autocomplete="new-password" class="w-full px-4 py-2 border border-gray-300 dark:border-slate-600 rounded bg-white dark:bg-slate-700 text-gray-800 dark:text-gray-200 focus:outline-none focus:ring-2 focus:ring-blue-500"/>
					</div>

					<button type="submit" class="w-full bg-blue-600 hover:bg-blue-700 text-white font-medium py-2 px-4 rounded focus:outline-none focus:ring-2 focus:ring-blue-500">
						Reset Password
					</button>
				</form>
			</div>
		</div>
		@PasswordStrengthScript()
		<script src="/static/js/user-pages/request-account.js"></script>
	</body>
	</html>
}

// CompleteAccountSetup page - shown on first login when user must change password
templ CompleteAccountSetup(user *models.User, errorMessage string, csrfToken string) {
	<!DOCTYPE html>
	<html lang="en">
	<head>
		<meta charset="UTF-8"/>
		<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
		<title>Complete Account Setup - Gearbox</title>
		<link rel="icon" type="image/svg+xml" href="/favicon.svg"/>
		<link rel="alternate icon" href="/favicon.ico"/>
		<!-- Use local Tailwind CSS for CSP compliance -->
		<script src="/static/js/vendor/tailwind.js"></script>
		<script>
			tailwind.config = { darkMode: 'class' }
			function getThemePreference() {
				const stored = localStorage.getItem('theme');
				if (stored) return stored;
				return 'system';
			}
			function getEffectiveTheme() {
				const pref = getThemePreference();
				if (pref === 'system') {
					return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
				}
				return pref;
			}
			if (getEffectiveTheme() === 'dark') {
				document.documentElement.classList.add('dark');
			}
		</script>
	</head>
	<body class="bg-gray-100 dark:bg-slate-900">
		<div class="min-h-screen flex items-center justify-center py-12 px-4">
			<div class="bg-white dark:bg-slate-800 p-8 rounded-lg shadow-lg w-full max-w-md">
				<div class="flex justify-center mb-6">
					<svg class="w-16 h-16 text-blue-600 dark:text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
					</svg>
				</div>
				<h2 class="text-2xl font-bold text-center mb-6 text-gray-800 dark:text-gray-100">Complete Account Setup</h2>
				<!-- Info message -->
				<div class="mb-6 p-4 bg-blue-50 dark:bg-blue-900/30 border border-blue-200 dark:border-blue-800 rounded-lg">
					<div class="flex items-start">
						<svg class="w-5 h-5 text-blue-600 dark:text-blue-400 mt-0.5 mr-3 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
						</svg>
						<p class="text-sm text-blue-800 dark:text-blue-200">
							You must complete initial account setup and change the admin password before continuing. The email you enter here will be used for login and replace the default "admin" username.
						</p>
					</div>
				</div>
				<!-- Error message -->
				if errorMessage != "" {
					<div class="mb-6 p-4 bg-red-50 dark:bg-red-900/30 border border-red-200 dark:border-red-800 rounded-lg">
						<div class="flex items-start">
							<svg class="w-5 h-5 text-red-600 dark:text-red-400 mt-0.5 mr-3 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
							</svg>
							<p class="text-sm text-red-800 dark:text-red-200">{ errorMessage }</p>
						</div>
					</div>
				}
				<form action="/settings/complete-account-setup" method="POST" class="space-y-4">
					<input type="hidden" name="csrf_token" value={ csrfToken }/>

					<div>
						<label for="email" class="block text-gray-700 dark:text-gray-300 font-medium mb-1 text-sm">Email Address *</label>
						<input type="email" id="email" name="email" required autocomplete="email" class="w-full px-3 py-2 border border-gray-300 dark:border-slate-600 rounded bg-white dark:bg-slate-700 text-gray-800 dark:text-gray-200 focus:outline-none focus:ring-2 focus:ring-blue-500" placeholder="you@example.com"/>
						<p class="text-xs text-gray-500 dark:text-gray-400 mt-1">Required for password reset and notifications</p>
					</div>

					<div class="grid grid-cols-2 gap-4">
						<div>
							<label for="first_name" class="block text-gray-700 dark:text-gray-300 font-medium mb-1 text-sm">First Name</label>
							<input type="text" id="first_name" name="first_name" value={ user.FirstName } class="w-full px-3 py-2 border border-gray-300 dark:border-slate-600 rounded bg-white dark:bg-slate-700 text-gray-800 dark:text-gray-200 focus:outline-none focus:ring-2 focus:ring-blue-500"/>
						</div>
						<div>
							<label for="last_name" class="block text-gray-700 dark:text-gray-300 font-medium mb-1 text-sm">Last Name</label>
							<input type="text" id="last_name" name="last_name" value={ user.LastName } class="w-full px-3 py-2 border border-gray-300 dark:border-slate-600 rounded bg-white dark:bg-slate-700 text-gray-800 dark:text-gray-200 focus:outline-none focus:ring-2 focus:ring-blue-500"/>
						</div>
					</div>

					<div>
						<label for="phone_number" class="block text-gray-700 dark:text-gray-300 font-medium mb-1 text-sm">Phone Number</label>
						<input type="tel" id="phone_number" name="phone_number" value={ user.PhoneNumber } class="w-full px-3 py-2 border border-gray-300 dark:border-slate-600 rounded bg-white dark:bg-slate-700 text-gray-800 dark:text-gray-200 focus:outline-none focus:ring-2 focus:ring-blue-500"/>
					</div>

					<div>
						<label for="new_password" class="block text-gray-700 dark:text-gray-300 font-medium mb-1 text-sm">New Password *</label>
						<input type="password" id="new_password" name="new_password" required autocomplete="new-password" class="w-full px-3 py-2 border border-gray-300 dark:border-slate-600 rounded bg-white dark:bg-slate-700 text-gray-800 dark:text-gray-200 focus:outline-none focus:ring-2 focus:ring-blue-500"/>
						@PasswordStrengthMeter("new_password")
					</div>

					<div>
						<label for="confirm_password" class="block text-gray-700 dark:text-gray-300 font-medium mb-1 text-sm">Confirm New Password *</label>
						<input type="password" id="confirm_password" name="confirm_password" required autocomplete="new-password" class="w-full px-3 py-2 border border-gray-300 dark:border-slate-600 rounded bg-white dark:bg-slate-700 text-gray-800 dark:text-gray-200 focus:outline-none focus:ring-2 focus:ring-blue-500"/>
					</div>

					<button type="submit" class="w-full bg-blue-600 hover:bg-blue-700 text-white font-medium py-2 px-4 rounded focus:outline-none focus:ring-2 focus:ring-blue-500">
						Complete Setup
					</button>
				</form>
			</div>
		</div>
		@PasswordStrengthScript()
		<script>
			document.addEventListener('DOMContentLoaded', function() {
				initPasswordStrengthMeter('new_password');
			});
		</script>
	</body>
	</html>
}

// ChangePassword page
templ ChangePassword(user *models.User, errorMessage string, csrfToken string) {
	@layouts.Base("Change Password", user, "/settings") {
		<div class="max-w-md mx-auto">
			<div class="bg-white dark:bg-slate-800 p-6 rounded-lg shadow">
				<h1 class="text-2xl font-bold mb-6 text-gray-800 dark:text-gray-100">Change Password</h1>

				if errorMessage != "" {
					@ui.ToastOnLoad(errorMessage, "error")
				}

				<form action="/settings/change-password" method="POST" class="space-y-4">
					<input type="hidden" name="csrf_token" value={ csrfToken }/>

					<div>
						<label for="current_password" class="block text-gray-700 dark:text-gray-300 font-medium mb-2">Current Password</label>
						<input type="password" id="current_password" name="current_password" required autocomplete="current-password" class="w-full px-4 py-2 border border-gray-300 dark:border-slate-600 rounded bg-white dark:bg-slate-700 text-gray-800 dark:text-gray-200 focus:outline-none focus:ring-2 focus:ring-blue-500"/>
					</div>

					<div>
						<label for="new_password" class="block text-gray-700 dark:text-gray-300 font-medium mb-2">New Password</label>
						<input type="password" id="new_password" name="new_password" required autocomplete="new-password" class="w-full px-4 py-2 border border-gray-300 dark:border-slate-600 rounded bg-white dark:bg-slate-700 text-gray-800 dark:text-gray-200 focus:outline-none focus:ring-2 focus:ring-blue-500"/>
						@PasswordStrengthMeter("new_password")
					</div>

					<div>
						<label for="confirm_password" class="block text-gray-700 dark:text-gray-300 font-medium mb-2">Confirm New Password</label>
						<input type="password" id="confirm_password" name="confirm_password" required autocomplete="new-password" class="w-full px-4 py-2 border border-gray-300 dark:border-slate-600 rounded bg-white dark:bg-slate-700 text-gray-800 dark:text-gray-200 focus:outline-none focus:ring-2 focus:ring-blue-500"/>
					</div>

					<button type="submit" class="w-full bg-blue-600 hover:bg-blue-700 text-white font-medium py-2 px-4 rounded">
						Change Password
					</button>
				</form>
			</div>
		</div>
		@PasswordStrengthScript()
		<script>
			document.addEventListener('DOMContentLoaded', function() {
				initPasswordStrengthMeter('new_password');
			});
		</script>
	}
}

// PasskeyRegistrationScript renders the JavaScript for passkey registration
templ PasskeyRegistrationScript() {
	<script>
		// Check if WebAuthn is supported
		function isWebAuthnSupported() {
			return window.PublicKeyCredential !== undefined &&
				typeof window.PublicKeyCredential === 'function';
		}

		// Convert base64url to ArrayBuffer
		function base64urlToArrayBuffer(base64url) {
			const base64 = base64url.replace(/-/g, '+').replace(/_/g, '/');
			const padding = '='.repeat((4 - base64.length % 4) % 4);
			const base64Padded = base64 + padding;
			const binary = atob(base64Padded);
			const bytes = new Uint8Array(binary.length);
			for (let i = 0; i < binary.length; i++) {
				bytes[i] = binary.charCodeAt(i);
			}
			return bytes.buffer;
		}

		// Convert ArrayBuffer to base64url
		function arrayBufferToBase64url(buffer) {
			const bytes = new Uint8Array(buffer);
			let binary = '';
			for (let i = 0; i < bytes.length; i++) {
				binary += String.fromCharCode(bytes[i]);
			}
			const base64 = btoa(binary);
			return base64.replace(/\+/g, '-').replace(/\//g, '_').replace(/=/g, '');
		}

		// Show status message
		function showStatus(message, isError) {
			const status = document.getElementById('passkey-status');
			status.textContent = message;
			status.classList.remove('hidden', 'bg-green-100', 'bg-red-100', 'text-green-800', 'text-red-800',
				'dark:bg-green-900/30', 'dark:bg-red-900/30', 'dark:text-green-200', 'dark:text-red-200');
			if (isError) {
				status.classList.add('bg-red-100', 'text-red-800', 'dark:bg-red-900/30', 'dark:text-red-200');
			} else {
				status.classList.add('bg-green-100', 'text-green-800', 'dark:bg-green-900/30', 'dark:text-green-200');
			}
		}

		// Register a new passkey
		async function registerPasskey() {
			const btn = document.getElementById('add-passkey-btn');
			const status = document.getElementById('passkey-status');

			btn.disabled = true;
			btn.textContent = 'Registering...';
			status.classList.add('hidden');

			try {
				// Step 1: Get registration options from server
				const beginResponse = await fetch('/api/passkey/register/begin');
				if (!beginResponse.ok) {
					throw new Error('Failed to start registration');
				}
				const beginData = await beginResponse.json();

				// Convert challenge and user ID from base64url to ArrayBuffer
				const options = beginData.options.publicKey;
				options.challenge = base64urlToArrayBuffer(options.challenge);
				options.user.id = base64urlToArrayBuffer(options.user.id);

				// Convert excludeCredentials if present
				if (options.excludeCredentials) {
					options.excludeCredentials = options.excludeCredentials.map(cred => ({
						...cred,
						id: base64urlToArrayBuffer(cred.id)
					}));
				}

				// Step 2: Create credential with the browser's authenticator
				const credential = await navigator.credentials.create({
					publicKey: options
				});

				// Step 3: Prepare credential for sending to server
				const credentialJSON = {
					id: credential.id,
					rawId: arrayBufferToBase64url(credential.rawId),
					type: credential.type,
					response: {
						attestationObject: arrayBufferToBase64url(credential.response.attestationObject),
						clientDataJSON: arrayBufferToBase64url(credential.response.clientDataJSON)
					}
				};

				// Add transports if available
				if (credential.response.getTransports) {
					credentialJSON.response.transports = credential.response.getTransports();
				}

				// Prompt for passkey name
				const passkeyName = await showPromptDialog({
					title: 'Name Your Passkey',
					message: 'Enter a name for this passkey (e.g., "MacBook Pro", "iPhone"):',
					defaultValue: 'Passkey',
					placeholder: 'My Device'
				});
				if (passkeyName === null) {
					throw new Error('Registration cancelled');
				}

				// Step 4: Send credential to server
				const finishResponse = await fetch('/api/passkey/register/finish', {
					method: 'POST',
					headers: {
						'Content-Type': 'application/json'
					},
					body: JSON.stringify({
						session_id: beginData.session_id,
						name: passkeyName || 'Passkey',
						credential: credentialJSON
					})
				});

				if (!finishResponse.ok) {
					const errorData = await finishResponse.text();
					throw new Error(errorData || 'Failed to complete registration');
				}

				showStatus('Passkey registered successfully! Refreshing...', false);

				// Reload the page to show the new passkey
				setTimeout(() => {
					window.location.reload();
				}, 1500);

			} catch (error) {
				console.error('Passkey registration error:', error);
				showStatus('Failed to register passkey: ' + error.message, true);
				btn.disabled = false;
				btn.textContent = 'Add Passkey';
			}
		}

		// Initialize on page load
		document.addEventListener('DOMContentLoaded', function() {
				// Check for pending user requests
				fetch("/api/user/pending-count")
					.then(response => {
						// If not authenticated (redirect response), silently ignore
						if (!response.ok || response.redirected || response.status === 303) {
							return null;
						}
						return response.json();
					})
					.then(data => {
						if (data && data.count > 0) {
							const link = document.querySelector('a[href="/settings/users"]');
							if (link) {
								// Add notification badge
								const badge = document.createElement("span");
								badge.className = "absolute -top-1 -right-1 w-6 h-6 bg-red-500 text-white text-xs font-bold rounded-full flex items-center justify-center";
								badge.textContent = data.count;
								// Find the icon container and add the badge
								const iconContainer = link.querySelector(".w-12.h-12");
								if (iconContainer) {
									iconContainer.classList.add("relative");
									iconContainer.appendChild(badge);
								}
								// Also add a text badge next to the title
								const title = link.querySelector("h2");
								if (title) {
									const textBadge = document.createElement("span");
									textBadge.className = "ml-2 px-2 py-0.5 text-xs bg-red-100 dark:bg-red-900 text-red-800 dark:text-red-200 rounded-full font-medium";
									textBadge.textContent = data.count + " pending";
									title.appendChild(textBadge);
								}
							}
						}
					})
					.catch(() => {
						// Silently ignore errors on public pages
						console.debug("Pending users count not available (not authenticated)");
					});

			const btn = document.getElementById('add-passkey-btn');
			const supportNote = document.getElementById('passkey-support-note');

			if (!isWebAuthnSupported()) {
				btn.disabled = true;
				btn.title = 'WebAuthn is not supported in this browser';
				supportNote.textContent = 'Passkeys are not supported in this browser.';
				supportNote.classList.add('text-yellow-600', 'dark:text-yellow-400');
				return;
			}

			btn.addEventListener('click', registerPasskey);
		});
	</script>
}

// Profile page
templ Profile(user *models.User, passkeys []*models.Passkey, errorMessage string, successMessage string, csrfToken string) {
	@layouts.Base("Profile", user, "/settings") {
		<div class="max-w-2xl mx-auto space-y-6">
			<h1 class="text-2xl font-bold text-gray-800 dark:text-gray-100">Profile Settings</h1>

			if successMessage != "" {
				@ui.ToastOnLoad(successMessage, "success")
			}

			if errorMessage != "" {
				@ui.ToastOnLoad(errorMessage, "error")
			}

			<!-- Profile Information -->
			<div class="bg-white dark:bg-slate-800 p-6 rounded-lg shadow">
				<h2 class="text-lg font-semibold mb-4 text-gray-800 dark:text-gray-100">Personal Information</h2>
				<form action="/settings/profile" method="POST" class="space-y-4">
					<input type="hidden" name="csrf_token" value={ csrfToken }/>

					<div class="grid grid-cols-2 gap-4">
						<div>
							<label for="first_name" class="block text-gray-700 dark:text-gray-300 font-medium mb-1 text-sm">First Name</label>
							<input type="text" id="first_name" name="first_name" value={ user.FirstName } class="w-full px-3 py-2 border border-gray-300 dark:border-slate-600 rounded bg-white dark:bg-slate-700 text-gray-800 dark:text-gray-200 focus:outline-none focus:ring-2 focus:ring-blue-500"/>
						</div>
						<div>
							<label for="last_name" class="block text-gray-700 dark:text-gray-300 font-medium mb-1 text-sm">Last Name</label>
							<input type="text" id="last_name" name="last_name" value={ user.LastName } class="w-full px-3 py-2 border border-gray-300 dark:border-slate-600 rounded bg-white dark:bg-slate-700 text-gray-800 dark:text-gray-200 focus:outline-none focus:ring-2 focus:ring-blue-500"/>
						</div>
					</div>

					<div>
						<label for="email" class="block text-gray-700 dark:text-gray-300 font-medium mb-1 text-sm">Email</label>
						<input type="email" id="email" name="email" value={ user.Email } required class="w-full px-3 py-2 border border-gray-300 dark:border-slate-600 rounded bg-white dark:bg-slate-700 text-gray-800 dark:text-gray-200 focus:outline-none focus:ring-2 focus:ring-blue-500"/>
						<p class="text-xs text-gray-500 dark:text-gray-400 mt-1">Used for password reset and notifications</p>
					</div>

					<div>
						<label for="phone_number" class="block text-gray-700 dark:text-gray-300 font-medium mb-1 text-sm">Phone Number</label>
						<input type="tel" id="phone_number" name="phone_number" value={ user.PhoneNumber } class="w-full px-3 py-2 border border-gray-300 dark:border-slate-600 rounded bg-white dark:bg-slate-700 text-gray-800 dark:text-gray-200 focus:outline-none focus:ring-2 focus:ring-blue-500"/>
					</div>

					<button type="submit" class="bg-blue-600 hover:bg-blue-700 text-white font-medium py-2 px-4 rounded">
						Save Changes
					</button>
				</form>
			</div>

			<!-- Passkeys Section -->
			<div class="bg-white dark:bg-slate-800 p-6 rounded-lg shadow">
				<h2 class="text-lg font-semibold mb-4 text-gray-800 dark:text-gray-100">Passkeys</h2>
				<p class="text-sm text-gray-600 dark:text-gray-400 mb-4">
					Passkeys provide a more secure way to sign in without needing to enter your password.
				</p>

				if len(passkeys) > 0 {
					<div class="space-y-2 mb-4">
						for _, pk := range passkeys {
							<div class="flex items-center justify-between p-3 bg-gray-50 dark:bg-slate-700 rounded">
								<div>
									<p class="font-medium text-gray-800 dark:text-gray-200">{ pk.Name }</p>
									<p class="text-xs text-gray-500 dark:text-gray-400">
										Added { pk.CreatedAt.Format("Jan 2, 2006") }
										if pk.LastUsedAt != nil {
											| Last used { pk.LastUsedAt.Format("Jan 2, 2006") }
										}
									</p>
								</div>
								<form action="/settings/profile/passkey/delete" method="POST" class="passkey-delete-form">
									<input type="hidden" name="csrf_token" value={ csrfToken }/>
									<input type="hidden" name="passkey_id" value={ fmt.Sprintf("%d", pk.ID) }/>
									<button type="submit" class="text-red-600 dark:text-red-400 hover:text-red-800 dark:hover:text-red-300 text-sm">
										Remove
									</button>
								</form>
							</div>
						}
					</div>
				} else {
					<p class="text-gray-500 dark:text-gray-400 text-sm mb-4" id="no-passkeys-msg">No passkeys registered yet.</p>
				}

				<div id="passkey-status" class="hidden mb-4 p-3 rounded text-sm"></div>

				<button type="button" id="add-passkey-btn" class="bg-green-600 hover:bg-green-700 text-white font-medium py-2 px-4 rounded text-sm disabled:opacity-50 disabled:cursor-not-allowed">
					Add Passkey
				</button>
				<p class="text-xs text-gray-500 dark:text-gray-400 mt-2" id="passkey-support-note">
					Passkey support requires a compatible browser and device.
				</p>
			</div>
			@PasskeyRegistrationScript()
		<script src="/static/js/user-pages/profile-management.js"></script>

			<!-- Account Info -->
			<div class="bg-white dark:bg-slate-800 p-6 rounded-lg shadow">
				<h2 class="text-lg font-semibold mb-4 text-gray-800 dark:text-gray-100">Account Information</h2>
				<dl class="space-y-2 text-sm">
					<div class="flex">
						<dt class="w-32 text-gray-500 dark:text-gray-400">Role:</dt>
						<dd class="text-gray-800 dark:text-gray-200 capitalize">{ string(user.Role) }</dd>
					</div>
					<div class="flex">
						<dt class="w-32 text-gray-500 dark:text-gray-400">Status:</dt>
						<dd class="text-gray-800 dark:text-gray-200 capitalize">{ string(user.Status) }</dd>
					</div>
					<div class="flex">
						<dt class="w-32 text-gray-500 dark:text-gray-400">Created:</dt>
						<dd class="text-gray-800 dark:text-gray-200">{ user.CreatedAt.Format("January 2, 2006") }</dd>
					</div>
					if user.LastLoginAt != nil {
						<div class="flex">
							<dt class="w-32 text-gray-500 dark:text-gray-400">Last Login:</dt>
							<dd class="text-gray-800 dark:text-gray-200">{ user.LastLoginAt.Format("January 2, 2006 3:04 PM") }</dd>
						</div>
					}
				</dl>
			</div>
		</div>
	}
}

// Settings main page
templ Settings(user *models.User, perms *models.UserPermissions) {
	@layouts.Base("Settings", user, "/settings") {
		<!-- Hidden container for page header content - will be moved to main header via JS -->
		<div id="page-header-source" class="hidden">
			<div class="flex items-center">
				<h2 class="text-xl font-bold text-gray-800 dark:text-gray-100">Settings</h2>
			</div>
		</div>

		<div class="max-w-4xl mx-auto">
			<div class="grid grid-cols-1 md:grid-cols-2 gap-6">
				<!-- Profile Settings -->
				<a href="/settings/profile" class="block bg-white dark:bg-slate-800 p-6 rounded-lg shadow hover:shadow-lg transition-shadow">
					<div class="flex items-center space-x-4">
						<div class="w-12 h-12 bg-blue-100 dark:bg-blue-900 rounded-lg flex items-center justify-center">
							<svg class="w-6 h-6 text-blue-600 dark:text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
							</svg>
						</div>
						<div>
							<h2 class="text-lg font-semibold text-gray-800 dark:text-gray-100">Profile</h2>
							<p class="text-sm text-gray-600 dark:text-gray-400">Update your personal information and passkeys</p>
						</div>
					</div>
				</a>

				<!-- Change Password -->
				<a href="/settings/change-password" class="block bg-white dark:bg-slate-800 p-6 rounded-lg shadow hover:shadow-lg transition-shadow">
					<div class="flex items-center space-x-4">
						<div class="w-12 h-12 bg-yellow-100 dark:bg-yellow-900 rounded-lg flex items-center justify-center">
							<svg class="w-6 h-6 text-yellow-600 dark:text-yellow-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z"></path>
							</svg>
						</div>
						<div>
							<h2 class="text-lg font-semibold text-gray-800 dark:text-gray-100">Change Password</h2>
							<p class="text-sm text-gray-600 dark:text-gray-400">Update your account password</p>
						</div>
					</div>
				</a>

			<!-- Dashboards -->
			<a href="/settings/dashboards" class="block bg-white dark:bg-slate-800 p-6 rounded-lg shadow hover:shadow-lg transition-shadow">
				<div class="flex items-center space-x-4">
					<div class="w-12 h-12 bg-indigo-100 dark:bg-indigo-900 rounded-lg flex items-center justify-center">
						<svg class="w-6 h-6 text-indigo-600 dark:text-indigo-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 17V7m0 10a2 2 0 01-2 2H5a2 2 0 01-2-2V7a2 2 0 012-2h2a2 2 0 012 2m0 10a2 2 0 002 2h2a2 2 0 002-2M9 7a2 2 0 012-2h2a2 2 0 012 2m0 10V7m0 10a2 2 0 002 2h2a2 2 0 002-2V7a2 2 0 00-2-2h-2a2 2 0 00-2 2"></path>
						</svg>
					</div>
					<div>
						<h2 class="text-lg font-semibold text-gray-800 dark:text-gray-100">Dashboards</h2>
						<p class="text-sm text-gray-600 dark:text-gray-400">Manage custom dashboards and widgets</p>
					</div>
				</div>
			</a>

			<!-- User Management - shown to admins or users with approve_users permission -->
			if user.IsAdmin() || perms.HasPermission(models.ComponentUsers, models.PermissionApproveUsers) {
				<a href="/settings/users" class="block bg-white dark:bg-slate-800 p-6 rounded-lg shadow hover:shadow-lg transition-shadow">
					<div class="flex items-center space-x-4">
						<div class="w-12 h-12 bg-green-100 dark:bg-green-900 rounded-lg flex items-center justify-center">
							<svg class="w-6 h-6 text-green-600 dark:text-green-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"></path>
							</svg>
						</div>
						<div>
							<h2 class="text-lg font-semibold text-gray-800 dark:text-gray-100">User Management</h2>
							<p class="text-sm text-gray-600 dark:text-gray-400">Manage users and account requests</p>
						</div>
					</div>
				</a>
			}

			<!-- HAProxy Servers - shown to admins or users with manage_servers permission -->
			if user.IsAdmin() || perms.HasPermission(models.ComponentSettings, models.PermissionManageBoxes) {
				<a href="/settings/boxes" class="block bg-white dark:bg-slate-800 p-6 rounded-lg shadow hover:shadow-lg transition-shadow">
					<div class="flex items-center space-x-4">
						<div class="w-12 h-12 bg-blue-100 dark:bg-blue-900 rounded-lg flex items-center justify-center">
							<svg class="w-6 h-6 text-blue-600 dark:text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 12h14M5 12a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v4a2 2 0 01-2 2M5 12a2 2 0 00-2 2v4a2 2 0 002 2h14a2 2 0 002-2v-4a2 2 0 00-2-2m-2-4h.01M17 16h.01"></path>
							</svg>
						</div>
						<div>
							<h2 class="text-lg font-semibold text-gray-800 dark:text-gray-100">HAProxy Servers</h2>
							<p class="text-sm text-gray-600 dark:text-gray-400">Manage monitored HAProxy instances</p>
						</div>
					</div>
				</a>
			}

			<!-- SMTP Settings - admin only -->
			if user.IsAdmin() {
				<a href="/settings/smtp" class="block bg-white dark:bg-slate-800 p-6 rounded-lg shadow hover:shadow-lg transition-shadow">
					<div class="flex items-center space-x-4">
						<div class="w-12 h-12 bg-purple-100 dark:bg-purple-900 rounded-lg flex items-center justify-center">
							<svg class="w-6 h-6 text-purple-600 dark:text-purple-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
							</svg>
						</div>
						<div>
							<h2 class="text-lg font-semibold text-gray-800 dark:text-gray-100">Email Settings</h2>
							<p class="text-sm text-gray-600 dark:text-gray-400">Configure SMTP server for email notifications</p>
						</div>
					</div>
				</a>
			}
			<!-- Database Backups - admin only -->
			<a href="/settings/backup" class="block bg-white dark:bg-slate-800 p-6 rounded-lg shadow hover:shadow-lg transition-shadow">
				<div class="flex items-center space-x-4">
					<div class="w-12 h-12 bg-teal-100 dark:bg-teal-900 rounded-lg flex items-center justify-center">
						<svg class="w-6 h-6 text-teal-600 dark:text-teal-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 7v10c0 2.21 3.582 4 8 4s8-1.79 8-4V7M4 7c0 2.21 3.582 4 8 4s8-1.79 8-4M4 7c0-2.21 3.582-4 8-4s8 1.79 8 4m0 5c0 2.21-3.582 4-8 4s-8-1.79-8-4"></path>
						</svg>
					</div>
					<div>
						<h2 class="text-lg font-semibold text-gray-800 dark:text-gray-100">Database Backups</h2>
						<p class="text-sm text-gray-600 dark:text-gray-400">Create and restore database backups</p>
					</div>
				</div>
			</a>


			<!-- Plugins - shown to admins or users with manage permission on plugins -->
			if user.IsAdmin() || perms.HasPermission(models.ComponentPlugins, models.PermissionManage) {
				<a href="/settings/plugins" class="block bg-white dark:bg-slate-800 p-6 rounded-lg shadow hover:shadow-lg transition-shadow">
					<div class="flex items-center space-x-4">
						<div class="w-12 h-12 bg-indigo-100 dark:bg-indigo-900 rounded-lg flex items-center justify-center">
							<svg class="w-6 h-6 text-indigo-600 dark:text-indigo-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 4a2 2 0 114 0v1a1 1 0 001 1h3a1 1 0 011 1v3a1 1 0 01-1 1h-1a2 2 0 100 4h1a1 1 0 011 1v3a1 1 0 01-1 1h-3a1 1 0 01-1-1v-1a2 2 0 10-4 0v1a1 1 0 01-1 1H7a1 1 0 01-1-1v-3a1 1 0 00-1-1H4a2 2 0 110-4h1a1 1 0 001-1V7a1 1 0 011-1h3a1 1 0 001-1V4z"></path>
							</svg>
						</div>
						<div>
							<h2 class="text-lg font-semibold text-gray-800 dark:text-gray-100">Plugins</h2>
							<p class="text-sm text-gray-600 dark:text-gray-400">Enable/disable features and configure plugins</p>
						</div>
					</div>
				</a>
			}

			<!-- Permissions Management - shown to admins only -->
			if user.IsAdmin() {
				<a href="/settings/permissions" class="block bg-white dark:bg-slate-800 p-6 rounded-lg shadow hover:shadow-lg transition-shadow">
					<div class="flex items-center space-x-4">
						<div class="w-12 h-12 bg-red-100 dark:bg-red-900 rounded-lg flex items-center justify-center">
							<svg class="w-6 h-6 text-red-600 dark:text-red-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"></path>
							</svg>
						</div>
						<div>
							<h2 class="text-lg font-semibold text-gray-800 dark:text-gray-100">Permission Management</h2>
							<p class="text-sm text-gray-600 dark:text-gray-400">Manage granular permissions for users</p>
						</div>
					</div>
				</a>
			}
			</div>
		</div>
		<script>
			function setupPageHeader() {
				const source = document.getElementById('page-header-source');
				const target = document.getElementById('header-page-content');
				if (source && target) {
					while (source.firstChild) {
						target.appendChild(source.firstChild);
					}
					source.remove();
				}
			}

			document.addEventListener('DOMContentLoaded', function() {
				// Check for pending user requests
				fetch("/api/user/pending-count")
					.then(response => response.json())
					.then(data => {
						if (data.count > 0) {
							const link = document.querySelector('a[href="/settings/users"]');
							if (link) {
								// Add notification badge
								const badge = document.createElement("span");
								badge.className = "absolute -top-1 -right-1 w-6 h-6 bg-red-500 text-white text-xs font-bold rounded-full flex items-center justify-center";
								badge.textContent = data.count;
								// Find the icon container and add the badge
								const iconContainer = link.querySelector(".w-12.h-12");
								if (iconContainer) {
									iconContainer.classList.add("relative");
									iconContainer.appendChild(badge);
								}
								// Also add a text badge next to the title
								const title = link.querySelector("h2");
								if (title) {
									const textBadge = document.createElement("span");
									textBadge.className = "ml-2 px-2 py-0.5 text-xs bg-red-100 dark:bg-red-900 text-red-800 dark:text-red-200 rounded-full font-medium";
									textBadge.textContent = data.count + " pending";
									title.appendChild(textBadge);
								}
							}
						}
					})
					.catch(error => console.error("Failed to fetch pending users count:", error));

				setupPageHeader();
			});
		</script>
	}
}

// AdminUsers page for user management
templ AdminUsers(admin *models.User, users []*models.User, pendingRequests []*models.AccountRequest, errorMessage string, successMessage string, csrfToken string) {
	@layouts.Base("User Management", admin, "/settings") {
		<div class="max-w-6xl mx-auto space-y-6">
			<h1 class="text-2xl font-bold text-gray-800 dark:text-gray-100">User Management</h1>

			if successMessage != "" {
				@ui.ToastOnLoad(successMessage, "success")
			}

			if errorMessage != "" {
				@ui.ToastOnLoad(errorMessage, "error")
			}

			<!-- Pending Requests -->
			if len(pendingRequests) > 0 {
				<div class="bg-white dark:bg-slate-800 p-6 rounded-lg shadow">
					<h2 class="text-lg font-semibold mb-4 text-gray-800 dark:text-gray-100">
						Pending Account Requests
						<span class="ml-2 px-2 py-1 text-xs bg-yellow-100 dark:bg-yellow-900 text-yellow-800 dark:text-yellow-200 rounded-full">{ fmt.Sprintf("%d", len(pendingRequests)) }</span>
					</h2>
					<div class="overflow-x-auto">
						<table class="w-full text-sm">
							<thead>
								<tr class="border-b dark:border-slate-700">
									<th class="text-left py-2 px-3 text-gray-600 dark:text-gray-400">Name</th>
									<th class="text-left py-2 px-3 text-gray-600 dark:text-gray-400">Email</th>
									<th class="text-left py-2 px-3 text-gray-600 dark:text-gray-400">Requested</th>
									<th class="text-left py-2 px-3 text-gray-600 dark:text-gray-400">Reason</th>
									<th class="text-right py-2 px-3 text-gray-600 dark:text-gray-400">Actions</th>
								</tr>
							</thead>
							<tbody>
								for _, req := range pendingRequests {
									<tr class="border-b dark:border-slate-700">
										<td class="py-2 px-3 text-gray-800 dark:text-gray-200">{ req.FirstName } { req.LastName }</td>
										<td class="py-2 px-3 text-gray-800 dark:text-gray-200">{ req.Email }</td>
										<td class="py-2 px-3 text-gray-500 dark:text-gray-400">{ req.CreatedAt.Format("Jan 2, 2006") }</td>
										<td class="py-2 px-3 text-gray-500 dark:text-gray-400 max-w-xs truncate">{ req.Reason }</td>
										<td class="py-2 px-3 text-right space-x-2">
											<form action="/settings/users/approve" method="POST" class="inline">
												<input type="hidden" name="csrf_token" value={ csrfToken }/>
												<input type="hidden" name="request_id" value={ fmt.Sprintf("%d", req.ID) }/>
												<button type="submit" class="text-green-600 dark:text-green-400 hover:underline">Approve</button>
											</form>
											<form action="/settings/users/deny" method="POST" class="inline">
												<input type="hidden" name="csrf_token" value={ csrfToken }/>
												<input type="hidden" name="request_id" value={ fmt.Sprintf("%d", req.ID) }/>
												<button type="submit" class="text-red-600 dark:text-red-400 hover:underline">Deny</button>
											</form>
										</td>
									</tr>
								}
							</tbody>
						</table>
					</div>
				</div>
			}

			<!-- All Users -->
			<div class="bg-white dark:bg-slate-800 p-6 rounded-lg shadow">
				<h2 class="text-lg font-semibold mb-4 text-gray-800 dark:text-gray-100">All Users</h2>
				<div class="overflow-x-auto">
					<table class="w-full text-sm">
						<thead>
							<tr class="border-b dark:border-slate-700">
								<th class="text-left py-2 px-3 text-gray-600 dark:text-gray-400">Name</th>
								<th class="text-left py-2 px-3 text-gray-600 dark:text-gray-400">Email</th>
								<th class="text-left py-2 px-3 text-gray-600 dark:text-gray-400">Role</th>
								<th class="text-left py-2 px-3 text-gray-600 dark:text-gray-400">Status</th>
								<th class="text-left py-2 px-3 text-gray-600 dark:text-gray-400">Last Login</th>
								<th class="text-right py-2 px-3 text-gray-600 dark:text-gray-400">Actions</th>
							</tr>
						</thead>
						<tbody>
							for _, u := range users {
								<tr class="border-b dark:border-slate-700">
									<td class="py-2 px-3 text-gray-800 dark:text-gray-200">{ u.DisplayName() }</td>
									<td class="py-2 px-3 text-gray-800 dark:text-gray-200">{ u.Email }</td>
									<td class="py-2 px-3">
										<span class={ "px-2 py-1 text-xs rounded-full", templ.KV("bg-purple-100 dark:bg-purple-900 text-purple-800 dark:text-purple-200", u.Role == "admin"), templ.KV("bg-gray-100 dark:bg-gray-700 text-gray-800 dark:text-gray-200", u.Role != "admin") }>
											{ string(u.Role) }
										</span>
									</td>
									<td class="py-2 px-3">
										<span class={ "px-2 py-1 text-xs rounded-full", templ.KV("bg-green-100 dark:bg-green-900 text-green-800 dark:text-green-200", u.Status == "active"), templ.KV("bg-red-100 dark:bg-red-900 text-red-800 dark:text-red-200", u.Status == "disabled"), templ.KV("bg-yellow-100 dark:bg-yellow-900 text-yellow-800 dark:text-yellow-200", u.Status == "pending") }>
											{ string(u.Status) }
										</span>
									</td>
									<td class="py-2 px-3 text-gray-500 dark:text-gray-400">
										if u.LastLoginAt != nil {
											{ u.LastLoginAt.Format("Jan 2, 2006") }
										} else {
											Never
										}
									</td>
									<td class="py-2 px-3 text-right space-x-2">
										<a href={ templ.SafeURL(fmt.Sprintf("/settings/users/%s", u.ID)) } class="text-blue-600 dark:text-blue-400 hover:underline">Edit</a>
										<a href={ templ.SafeURL(fmt.Sprintf("/settings/permissions/%s", u.ID)) } class="text-purple-600 dark:text-purple-400 hover:underline">Permissions</a>
										if u.ID != admin.ID {
											if u.Status == models.UserStatusActive {
												<form action="/settings/users/toggle" method="POST" class="inline">
													<input type="hidden" name="csrf_token" value={ csrfToken }/>
													<input type="hidden" name="user_id" value={ u.ID }/>
													<input type="hidden" name="action" value="disable"/>
													<button type="submit" class="text-red-600 dark:text-red-400 hover:underline">Disable</button>
												</form>
											} else {
												<form action="/settings/users/toggle" method="POST" class="inline">
													<input type="hidden" name="csrf_token" value={ csrfToken }/>
													<input type="hidden" name="user_id" value={ u.ID }/>
													<input type="hidden" name="action" value="enable"/>
													<button type="submit" class="text-green-600 dark:text-green-400 hover:underline">Enable</button>
												</form>
											}
										}
									</td>
								</tr>
							}
						</tbody>
					</table>
				</div>
			</div>
		</div>
	}
}

// AdminUserDetail page for editing a specific user
templ AdminUserDetail(admin *models.User, targetUser *models.User, errorMessage string, successMessage string, csrfToken string) {
	@layouts.Base("Edit User", admin, "/settings") {
		<div class="max-w-2xl mx-auto space-y-6">
			<div class="flex items-center justify-between">
				<div>
					<h1 class="text-2xl font-bold text-gray-800 dark:text-gray-100">Edit User</h1>
					<p class="text-sm text-gray-600 dark:text-gray-400 mt-1">{ targetUser.DisplayName() } ({ targetUser.Email })</p>
				</div>
				<div class="flex items-center space-x-3">
					<a
						href={ templ.SafeURL(fmt.Sprintf("/settings/permissions/%s", targetUser.ID)) }
						class="inline-flex items-center px-4 py-2 bg-purple-600 hover:bg-purple-700 text-white font-medium rounded-lg transition-colors"
					>
						<svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/>
						</svg>
						Manage Permissions
					</a>
					<a href="/settings/users" class="text-blue-600 dark:text-blue-400 hover:underline text-sm">
						&larr; Back to Users
					</a>
				</div>
			</div>

			if successMessage != "" {
				@ui.ToastOnLoad(successMessage, "success")
			}

			if errorMessage != "" {
				@ui.ToastOnLoad(errorMessage, "error")
			}

			<!-- User Information -->
			<div class="bg-white dark:bg-slate-800 p-6 rounded-lg shadow">
				<h2 class="text-lg font-semibold mb-4 text-gray-800 dark:text-gray-100">User Information</h2>
				<form action={ templ.SafeURL(fmt.Sprintf("/settings/users/%s", targetUser.ID)) } method="POST" class="space-y-4">
					<input type="hidden" name="csrf_token" value={ csrfToken }/>

					<div class="grid grid-cols-2 gap-4">
						<div>
							<label for="first_name" class="block text-gray-700 dark:text-gray-300 font-medium mb-1 text-sm">First Name</label>
							<input type="text" id="first_name" name="first_name" value={ targetUser.FirstName } class="w-full px-3 py-2 border border-gray-300 dark:border-slate-600 rounded bg-white dark:bg-slate-700 text-gray-800 dark:text-gray-200 focus:outline-none focus:ring-2 focus:ring-blue-500"/>
						</div>
						<div>
							<label for="last_name" class="block text-gray-700 dark:text-gray-300 font-medium mb-1 text-sm">Last Name</label>
							<input type="text" id="last_name" name="last_name" value={ targetUser.LastName } class="w-full px-3 py-2 border border-gray-300 dark:border-slate-600 rounded bg-white dark:bg-slate-700 text-gray-800 dark:text-gray-200 focus:outline-none focus:ring-2 focus:ring-blue-500"/>
						</div>
					</div>

					<div>
						<label for="email" class="block text-gray-700 dark:text-gray-300 font-medium mb-1 text-sm">Email</label>
						<input type="email" id="email" name="email" value={ targetUser.Email } required class="w-full px-3 py-2 border border-gray-300 dark:border-slate-600 rounded bg-white dark:bg-slate-700 text-gray-800 dark:text-gray-200 focus:outline-none focus:ring-2 focus:ring-blue-500"/>
					</div>

					<div>
						<label for="phone_number" class="block text-gray-700 dark:text-gray-300 font-medium mb-1 text-sm">Phone Number</label>
						<input type="tel" id="phone_number" name="phone_number" value={ targetUser.PhoneNumber } class="w-full px-3 py-2 border border-gray-300 dark:border-slate-600 rounded bg-white dark:bg-slate-700 text-gray-800 dark:text-gray-200 focus:outline-none focus:ring-2 focus:ring-blue-500"/>
					</div>

					<div class="grid grid-cols-2 gap-4">
						<div>
							<label for="role" class="block text-gray-700 dark:text-gray-300 font-medium mb-1 text-sm">Role</label>
							<select id="role" name="role" class="w-full h-[42px] px-3 py-2 border border-gray-300 dark:border-slate-600 rounded bg-white dark:bg-slate-700 text-gray-800 dark:text-gray-200 focus:outline-none focus:ring-2 focus:ring-blue-500 cursor-pointer">
								<option value="admin" selected?={ targetUser.Role == "admin" }>Admin (Full Access)</option>
								<option value="readonly" selected?={ targetUser.Role == "readonly" }>Read Only (Limited)</option>
							</select>
							<p class="text-xs text-gray-500 dark:text-gray-400 mt-1">
								For granular permissions, use
								<a href={ templ.SafeURL(fmt.Sprintf("/settings/permissions/%s", targetUser.ID)) } class="text-purple-600 dark:text-purple-400 hover:underline font-medium">
									Manage Permissions
								</a>
							</p>
						</div>
						<div>
							<label for="status" class="block text-gray-700 dark:text-gray-300 font-medium mb-1 text-sm">Status</label>
							<select id="status" name="status" class="w-full h-[42px] px-3 py-2 border border-gray-300 dark:border-slate-600 rounded bg-white dark:bg-slate-700 text-gray-800 dark:text-gray-200 focus:outline-none focus:ring-2 focus:ring-blue-500 cursor-pointer">
								<option value="active" selected?={ targetUser.Status == "active" }>Active</option>
								<option value="disabled" selected?={ targetUser.Status == "disabled" }>Disabled</option>
							</select>
						</div>
					</div>

					<div class="pt-2">
						<button type="submit" class="bg-blue-600 hover:bg-blue-700 text-white font-medium py-2 px-4 rounded">
							Save Changes
						</button>
					</div>
				</form>
			</div>

			<!-- Account Details (Read-only) -->
			<div class="bg-white dark:bg-slate-800 p-6 rounded-lg shadow">
				<h2 class="text-lg font-semibold mb-4 text-gray-800 dark:text-gray-100">Account Details</h2>
				<dl class="space-y-2 text-sm">
					<div class="flex">
						<dt class="w-36 text-gray-500 dark:text-gray-400">User ID:</dt>
						<dd class="text-gray-800 dark:text-gray-200">{ targetUser.ID }</dd>
					</div>
					<div class="flex">
						<dt class="w-36 text-gray-500 dark:text-gray-400">Created:</dt>
						<dd class="text-gray-800 dark:text-gray-200">{ targetUser.CreatedAt.Format("January 2, 2006 3:04 PM") }</dd>
					</div>
					if targetUser.LastLoginAt != nil {
						<div class="flex">
							<dt class="w-36 text-gray-500 dark:text-gray-400">Last Login:</dt>
							<dd class="text-gray-800 dark:text-gray-200">{ targetUser.LastLoginAt.Format("January 2, 2006 3:04 PM") }</dd>
						</div>
					} else {
						<div class="flex">
							<dt class="w-36 text-gray-500 dark:text-gray-400">Last Login:</dt>
							<dd class="text-gray-500 dark:text-gray-400 italic">Never</dd>
						</div>
					}
					if targetUser.PasswordChangedAt != nil {
						<div class="flex">
							<dt class="w-36 text-gray-500 dark:text-gray-400">Password Changed:</dt>
							<dd class="text-gray-800 dark:text-gray-200">{ targetUser.PasswordChangedAt.Format("January 2, 2006 3:04 PM") }</dd>
						</div>
					}
					<div class="flex">
						<dt class="w-36 text-gray-500 dark:text-gray-400">Must Change PW:</dt>
						<dd class="text-gray-800 dark:text-gray-200">
							if targetUser.MustChangePassword {
								<span class="text-yellow-600 dark:text-yellow-400">Yes</span>
							} else {
								No
							}
						</dd>
					</div>
				</dl>
			</div>

			<!-- Danger Zone -->
			if targetUser.ID != admin.ID {
				<div class="bg-white dark:bg-slate-800 p-6 rounded-lg shadow border border-red-200 dark:border-red-800">
					<h2 class="text-lg font-semibold mb-4 text-red-600 dark:text-red-400">Danger Zone</h2>
					<div class="space-y-4">
						<div class="flex items-center justify-between">
							<div>
								<p class="text-gray-700 dark:text-gray-300 font-medium">Force Password Reset</p>
								<p class="text-xs text-gray-500 dark:text-gray-400">User will be required to change password on next login</p>
							</div>
							<form action={ templ.SafeURL(fmt.Sprintf("/settings/users/%s/reset-password", targetUser.ID)) } method="POST">
								<input type="hidden" name="csrf_token" value={ csrfToken }/>
								<button type="submit" class="bg-yellow-600 hover:bg-yellow-700 text-white font-medium py-2 px-4 rounded text-sm">
									Force Reset
								</button>
							</form>
						</div>
						<div class="border-t border-red-200 dark:border-red-800 pt-4">
							<div class="flex items-center justify-between">
								<div>
									<p class="text-gray-700 dark:text-gray-300 font-medium">Delete User</p>
									<p class="text-xs text-gray-500 dark:text-gray-400">Permanently remove this user and all their data. This cannot be undone.</p>
								</div>
								<form action={ templ.SafeURL(fmt.Sprintf("/settings/users/%s/delete", targetUser.ID)) } method="POST" class="user-delete-form">
									<input type="hidden" name="csrf_token" value={ csrfToken }/>
									<button type="submit" class="bg-red-600 hover:bg-red-700 text-white font-medium py-2 px-4 rounded text-sm">
										Delete User
									</button>
								</form>
							</div>
						</div>
					</div>
				</div>
			}
		</div>
		<script>
		// Handle user delete form with custom confirmation dialog
		document.addEventListener('DOMContentLoaded', function() {
				// Check for pending user requests
				fetch("/api/user/pending-count")
					.then(response => response.json())
					.then(data => {
						if (data.count > 0) {
							const link = document.querySelector('a[href="/settings/users"]');
							if (link) {
								// Add notification badge
								const badge = document.createElement("span");
								badge.className = "absolute -top-1 -right-1 w-6 h-6 bg-red-500 text-white text-xs font-bold rounded-full flex items-center justify-center";
								badge.textContent = data.count;
								// Find the icon container and add the badge
								const iconContainer = link.querySelector(".w-12.h-12");
								if (iconContainer) {
									iconContainer.classList.add("relative");
									iconContainer.appendChild(badge);
								}
								// Also add a text badge next to the title
								const title = link.querySelector("h2");
								if (title) {
									const textBadge = document.createElement("span");
									textBadge.className = "ml-2 px-2 py-0.5 text-xs bg-red-100 dark:bg-red-900 text-red-800 dark:text-red-200 rounded-full font-medium";
									textBadge.textContent = data.count + " pending";
									title.appendChild(textBadge);
								}
							}
						}
					})
					.catch(error => console.error("Failed to fetch pending users count:", error));

			document.querySelectorAll('.user-delete-form').forEach(function(form) {
				form.addEventListener('submit', async function(e) {
					e.preventDefault();
					const confirmed = await showConfirmDialog({
						title: 'Delete User',
						message: 'Are you sure you want to delete this user?\n\nThis action cannot be undone. All user data will be permanently removed.',
						confirmText: 'Delete User',
						type: 'danger'
					});
					if (confirmed) {
						form.submit();
					}
				});
			});
		});
		</script>
	}
}

// AdminSMTPSettings page
templ AdminSMTPSettings(admin *models.User, settings *models.SMTPSettings, errorMessage string, successMessage string, csrfToken string) {
	@layouts.Base("Email Settings", admin, "/settings") {
		<div class="max-w-2xl mx-auto space-y-6">
			<h1 class="text-2xl font-bold text-gray-800 dark:text-gray-100">Email Settings (SMTP)</h1>

			if successMessage != "" {
				@ui.ToastOnLoad(successMessage, "success")
			}

			if errorMessage != "" {
				@ui.ToastOnLoad(errorMessage, "error")
			}

			<div class="bg-white dark:bg-slate-800 p-6 rounded-lg shadow">
				<form action="/settings/smtp" method="POST" class="space-y-4">
					<input type="hidden" name="csrf_token" value={ csrfToken }/>

					<div class="flex items-center space-x-3">
						<input type="checkbox" id="enabled" name="enabled" class="w-5 h-5 rounded border-gray-300 dark:border-slate-600 text-blue-600 focus:ring-blue-500 dark:bg-slate-700" checked?={ settings.Enabled }/>
						<label for="enabled" class="text-gray-700 dark:text-gray-300 font-medium">Enable Email Sending</label>
					</div>

					<div>
						<label for="host" class="block text-gray-700 dark:text-gray-300 font-medium mb-1 text-sm">SMTP Host</label>
						<input type="text" id="host" name="host" value={ settings.Host } placeholder="smtp.example.com" class="w-full px-3 py-2 border border-gray-300 dark:border-slate-600 rounded bg-white dark:bg-slate-700 text-gray-800 dark:text-gray-200 focus:outline-none focus:ring-2 focus:ring-blue-500"/>
					</div>

					<div class="grid grid-cols-2 gap-4">
						<div>
							<label for="username" class="block text-gray-700 dark:text-gray-300 font-medium mb-1 text-sm">Username</label>
							<input type="text" id="username" name="username" value={ settings.Username } autocomplete="off" class="w-full px-3 py-2 border border-gray-300 dark:border-slate-600 rounded bg-white dark:bg-slate-700 text-gray-800 dark:text-gray-200 focus:outline-none focus:ring-2 focus:ring-blue-500"/>
						</div>
						<div>
							<label for="password" class="block text-gray-700 dark:text-gray-300 font-medium mb-1 text-sm">Password</label>
							<input type="password" id="password" name="password" value="" placeholder={ passwordPlaceholder(settings.Password) } autocomplete="new-password" class="w-full px-3 py-2 border border-gray-300 dark:border-slate-600 rounded bg-white dark:bg-slate-700 text-gray-800 dark:text-gray-200 focus:outline-none focus:ring-2 focus:ring-blue-500"/>
							<p class="text-xs text-gray-500 dark:text-gray-400 mt-1">Leave blank to keep current password</p>
						</div>
					</div>

					<div class="grid grid-cols-2 gap-4">
						<div>
							<label for="from_address" class="block text-gray-700 dark:text-gray-300 font-medium mb-1 text-sm">From Address</label>
							<input type="email" id="from_address" name="from_address" value={ settings.FromAddress } placeholder="noreply@example.com" class="w-full px-3 py-2 border border-gray-300 dark:border-slate-600 rounded bg-white dark:bg-slate-700 text-gray-800 dark:text-gray-200 focus:outline-none focus:ring-2 focus:ring-blue-500"/>
						</div>
						<div>
							<label for="from_name" class="block text-gray-700 dark:text-gray-300 font-medium mb-1 text-sm">From Name</label>
							<input type="text" id="from_name" name="from_name" value={ settings.FromName } placeholder="Gearbox" class="w-full px-3 py-2 border border-gray-300 dark:border-slate-600 rounded bg-white dark:bg-slate-700 text-gray-800 dark:text-gray-200 focus:outline-none focus:ring-2 focus:ring-blue-500"/>
						</div>
					</div>

					<div class="grid grid-cols-2 gap-4">
						<div>
							<label for="encryption" class="block text-gray-700 dark:text-gray-300 font-medium mb-1 text-sm">Encryption / Port</label>
							<select id="encryption" name="encryption" class="w-full h-[42px] px-3 py-2 border border-gray-300 dark:border-slate-600 rounded bg-white dark:bg-slate-700 text-gray-800 dark:text-gray-200 focus:outline-none focus:ring-2 focus:ring-blue-500 cursor-pointer" onchange="toggleCustomPort(this)">
								<option value="starttls" selected?={ settings.UseStartTLS || (!settings.UseTLS && !settings.UseStartTLS && !isCustomPort(settings.Port)) }>STARTTLS (port 587)</option>
								<option value="tls" selected?={ settings.UseTLS && !isCustomPort(settings.Port) }>TLS (port 465)</option>
								<option value="none" selected?={ !settings.UseTLS && !settings.UseStartTLS && settings.Port == 25 }>None (port 25)</option>
								<option value="custom" selected?={ isCustomPort(settings.Port) }>Custom port...</option>
							</select>
						</div>
						<div id="custom_port_container" class={ templ.KV("hidden", !isCustomPort(settings.Port)) }>
							<label for="custom_port" class="block text-gray-700 dark:text-gray-300 font-medium mb-1 text-sm">Custom Port</label>
							<input type="number" id="custom_port" name="custom_port" value={ fmt.Sprintf("%d", settings.Port) } placeholder="587" class="w-full px-3 py-2 border border-gray-300 dark:border-slate-600 rounded bg-white dark:bg-slate-700 text-gray-800 dark:text-gray-200 focus:outline-none focus:ring-2 focus:ring-blue-500"/>
						</div>
					</div>
					<script>
						function toggleCustomPort(select) {
							const container = document.getElementById('custom_port_container');
							if (select.value === 'custom') {
								container.classList.remove('hidden');
							} else {
								container.classList.add('hidden');
							}
						}
					</script>

					<button type="submit" class="bg-blue-600 hover:bg-blue-700 text-white font-medium py-2 px-4 rounded">
						Save Settings
					</button>
				</form>
			</div>

			<!-- Test Email -->
			<div class="bg-white dark:bg-slate-800 p-6 rounded-lg shadow">
				<h2 class="text-lg font-semibold mb-4 text-gray-800 dark:text-gray-100">Send Test Email</h2>
				<form action="/settings/smtp/test" method="POST" class="flex items-end space-x-4">
					<input type="hidden" name="csrf_token" value={ csrfToken }/>
					<div class="flex-1">
						<label for="test_email" class="block text-gray-700 dark:text-gray-300 font-medium mb-1 text-sm">Recipient Email</label>
						<input type="email" id="test_email" name="test_email" value={ admin.Email } class="w-full px-3 py-2 border border-gray-300 dark:border-slate-600 rounded bg-white dark:bg-slate-700 text-gray-800 dark:text-gray-200 focus:outline-none focus:ring-2 focus:ring-blue-500"/>
					</div>
					<button type="submit" class="bg-green-600 hover:bg-green-700 text-white font-medium py-2 px-4 rounded">
						Send Test
					</button>
				</form>
				if settings.TestEmailSentAt != nil {
					<p class="text-xs text-gray-500 dark:text-gray-400 mt-2">
						Last test email sent: { settings.TestEmailSentAt.Format("Jan 2, 2006 3:04 PM") }
					</p>
				}
			</div>
		</div>
	}
}
