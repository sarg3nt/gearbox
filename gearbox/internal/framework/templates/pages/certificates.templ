package pages

import "github.com/sarg3nt/gearbox/internal/framework/models"
import "github.com/sarg3nt/gearbox/internal/framework/templates/layouts"
import "github.com/sarg3nt/gearbox/internal/framework/templates/components"

templ Certificates(user *models.User, servers []models.BoxConfig, perms *models.UserPermissions) {
	@layouts.Base("Certificates", user, "/certificates") {
		<!-- Hidden container for page header content. Title + box selector
		     live in the global header breadcrumb + chip. -->
		<div id="page-header-source" class="hidden">
			<div class="flex-1"></div>
			<div class="flex items-center space-x-3">
				@components.LiveRefreshButton()
			</div>
		</div>

		<!-- Permission flags for UI -->
		<input type="hidden" id="can-download-certs" value={ boolToString(perms.HasPermission(models.ComponentCertificates, models.PermissionDownload)) }/>
		<input type="hidden" id="can-refresh-certs" value={ boolToString(perms.HasPermission(models.ComponentCertificates, models.PermissionAction)) }/>

		<div id="certificates-page-container">
			if len(servers) == 0 {
				@components.InfoAlert("No servers configured.")
			} else {
				<div class="bg-white dark:bg-slate-800 rounded-lg shadow-lg p-4">

					<!-- Certificate Manager Status Section -->
					<div id="cert-manager-status" class="mb-4 p-3 bg-gray-50 dark:bg-slate-900 rounded-lg">
						<div class="flex items-center gap-2">
							<svg class="w-5 h-5 text-blue-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path>
							</svg>
							<span id="cert-manager-name" class="font-medium text-gray-800 dark:text-gray-200">Certificate Manager</span>
							<span id="cert-manager-version" class="text-sm text-gray-500 dark:text-gray-400"></span>
						</div>
						<div id="cert-manager-details" class="mt-2 text-sm text-gray-600 dark:text-gray-400">
							Loading...
						</div>
					</div>

					<!-- Certificate Summary -->
					<div id="cert-summary" class="mb-4 grid grid-cols-2 md:grid-cols-4 gap-3">
						<div class="p-3 bg-green-50 dark:bg-green-900/20 rounded-lg">
							<div class="text-2xl font-bold text-green-600 dark:text-green-400" id="healthy-count">-</div>
							<div class="text-sm text-green-700 dark:text-green-300">Healthy</div>
						</div>
						<div class="p-3 bg-yellow-50 dark:bg-yellow-900/20 rounded-lg">
							<div class="text-2xl font-bold text-yellow-600 dark:text-yellow-400" id="expiring-count">-</div>
							<div class="text-sm text-yellow-700 dark:text-yellow-300">Expiring Soon</div>
						</div>
						<div class="p-3 bg-orange-50 dark:bg-orange-900/20 rounded-lg">
							<div class="text-2xl font-bold text-orange-600 dark:text-orange-400" id="critical-count">-</div>
							<div class="text-sm text-orange-700 dark:text-orange-300">Critical (&lt;7 days)</div>
						</div>
						<div class="p-3 bg-red-50 dark:bg-red-900/20 rounded-lg">
							<div class="text-2xl font-bold text-red-600 dark:text-red-400" id="expired-count">-</div>
							<div class="text-sm text-red-700 dark:text-red-300">Expired</div>
						</div>
					</div>

					<!-- Certificates List -->
					<div id="certificates-list" class="space-y-3">
						@components.LoadingSpinner()
					</div>
				</div>
			}
		</div>

		@components.LiveRefreshButtonScript()

		<script>
		let eventSource = null;
		let certificatesData = null;

		function onServerChange() {
			loadCertificates();
			initSSE();
		}

		// Get current server ID - handles both multi-server (select) and single-server (hidden input) modes
		function getServerID() {
			const selector = document.getElementById('server-select');
			if (selector) return selector.value;
			const defaultServer = document.getElementById('default-server-id');
			if (defaultServer) return defaultServer.value;
			return '';
		}

		function initSSE() {
			if (eventSource) {
				eventSource.close();
			}

			const serverID = getServerID();

			updateSSEStatus('connecting');

			const sseUrl = serverID ? `/api/events?server=${serverID}` : '/api/events';
			eventSource = new EventSource(sseUrl);

			eventSource.onopen = function() {
				updateSSEStatus('connected');
			};

			eventSource.onerror = function(e) {
				updateSSEStatus('disconnected');
				setTimeout(() => {
					if (eventSource && eventSource.readyState === EventSource.CLOSED) {
						initSSE();
					}
				}, 3000);
			};

			eventSource.addEventListener('certificates.updated', function(e) {
				try {
					const data = JSON.parse(e.data);
					if (data.data) {
						certificatesData = data.data;
						renderCertificates(certificatesData);
					}
				} catch (err) {
					console.error('Failed to parse certificates event:', err);
				}
			});

			eventSource.addEventListener('heartbeat', function(e) {
				// Connection alive
			});
		}

		async function loadCertificates() {
			const serverID = getServerID();
			const container = document.getElementById('certificates-list');

			if (!serverID) {
				console.error('No server ID available');
				return;
			}

			try {
				const response = await fetch(`/api/${serverID}/certificates`);
				if (!response.ok) {
					throw new Error(`HTTP ${response.status}`);
				}
				certificatesData = await response.json();
				renderCertificates(certificatesData);
			} catch (error) {
				container.innerHTML = `
					<div class="p-4 bg-red-50 dark:bg-red-900/20 rounded-lg text-red-600 dark:text-red-400">
						<strong>Error loading certificates:</strong> ${escapeHtml(error.message)}
					</div>
				`;
			}
		}

		function renderCertificates(data) {
			// Update certificate manager status
			const certManagerName = document.getElementById('cert-manager-name');
			const certManagerVersion = document.getElementById('cert-manager-version');
			const certManagerDetails = document.getElementById('cert-manager-details');

			// Use new cert_manager field, fall back to legacy acmesh_installed for backwards compatibility
			const certManager = data.cert_manager || (data.acmesh_installed ? 'acme.sh' : 'none');
			const certManagerVersionStr = data.cert_manager_version || data.acmesh_version || '';
			const certManagerHome = data.cert_manager_home || data.acmesh_home || '';
			const autoRenewalEnabled = data.auto_renewal_enabled !== undefined ? data.auto_renewal_enabled : data.cron_enabled;
			const renewalMethod = data.renewal_method || 'none';
			const renewalService = data.renewal_service || '';

			if (certManager && certManager !== 'none') {
				const displayName = certManager === 'certbot' ? 'certbot' : 'acme.sh';
				certManagerName.textContent = displayName;
				certManagerVersion.textContent = certManagerVersionStr;
				const homeHtml = certManagerHome ? '<span class="mx-2">|</span><span>Home: ' + escapeHtml(certManagerHome) + '</span>' : '';

				// Build renewal status display using new fields
				let renewalStatusHtml = '';
				if (autoRenewalEnabled && renewalMethod !== 'none') {
					const methodLabel = renewalMethod === 'systemd' ? 'Systemd Timer' : 'Cron';
					const serviceLabel = renewalService ? ' (' + escapeHtml(renewalService) + ')' : '';
					renewalStatusHtml = '<span class="text-green-600 dark:text-green-400">Enabled via ' + methodLabel + serviceLabel + '</span>';
				} else {
					renewalStatusHtml = '<span class="text-yellow-600 dark:text-yellow-400">Not detected</span>';
				}

				certManagerDetails.innerHTML = '<span class="inline-flex items-center gap-1 text-green-600 dark:text-green-400">' +
					'<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">' +
					'<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>' +
					'</svg> Installed</span>' + homeHtml +
					'<span class="mx-2">|</span>' +
					'<span>Auto-renewal: ' + renewalStatusHtml + '</span>';
			} else {
				certManagerName.textContent = 'Certificate Manager';
				certManagerVersion.textContent = '';
				certManagerDetails.innerHTML = `
					<span class="inline-flex items-center gap-1 text-gray-500 dark:text-gray-400">
						<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 12H4"></path>
						</svg>
						Not installed
					</span>
				`;
			}

			// Update summary counts
			const certs = data.certificates || [];
			let healthy = 0, expiring = 0, critical = 0, expired = 0;

			for (const cert of certs) {
				if (cert.is_expired) {
					expired++;
				} else if (cert.days_until_expiry <= 7) {
					critical++;
				} else if (cert.days_until_expiry <= 30) {
					expiring++;
				} else {
					healthy++;
				}
			}

			document.getElementById('healthy-count').textContent = healthy;
			document.getElementById('expiring-count').textContent = expiring;
			document.getElementById('critical-count').textContent = critical;
			document.getElementById('expired-count').textContent = expired;

			// Render certificate cards
			const container = document.getElementById('certificates-list');

			if (certs.length === 0) {
				container.innerHTML = `
					<div class="p-4 bg-gray-50 dark:bg-slate-900 rounded-lg text-gray-600 dark:text-gray-400 text-center">
						No certificates found
					</div>
				`;
				return;
			}

			// Sort: expired first, then by days until expiry
			certs.sort((a, b) => {
				if (a.is_expired && !b.is_expired) return -1;
				if (!a.is_expired && b.is_expired) return 1;
				return a.days_until_expiry - b.days_until_expiry;
			});

			// Preserve expanded state before re-rendering
			const expandedDomains = new Set();
			document.querySelectorAll('[id^="details-"]').forEach(el => {
				if (!el.classList.contains('hidden')) {
					const domain = el.id.replace('details-', '');
					expandedDomains.add(domain);
				}
			});

			container.innerHTML = certs.map(cert => renderCertificateCard(cert, certManager)).join('');

			// Restore expanded state
			expandedDomains.forEach(domain => {
				const details = document.getElementById('details-' + domain);
				const chevron = document.getElementById('chevron-' + domain);
				if (details) {
					details.classList.remove('hidden');
				}
				if (chevron) {
					chevron.style.transform = 'rotate(180deg)';
				}
			});
		}

		// Check user permissions from hidden inputs
		function canDownloadCerts() {
			const input = document.getElementById('can-download-certs');
			return input && input.value === 'true';
		}

		function canRefreshCerts() {
			const input = document.getElementById('can-refresh-certs');
			return input && input.value === 'true';
		}

		function renderCertificateCard(cert, certManager) {
			let statusColor, statusText, statusBg;

			if (cert.is_expired) {
				statusColor = 'text-red-600 dark:text-red-400';
				statusBg = 'bg-red-100 dark:bg-red-900/30';
				statusText = 'EXPIRED';
			} else if (cert.days_until_expiry <= 7) {
				statusColor = 'text-orange-600 dark:text-orange-400';
				statusBg = 'bg-orange-100 dark:bg-orange-900/30';
				statusText = `${cert.days_until_expiry} days`;
			} else if (cert.days_until_expiry <= 30) {
				statusColor = 'text-yellow-600 dark:text-yellow-400';
				statusBg = 'bg-yellow-100 dark:bg-yellow-900/30';
				statusText = `${cert.days_until_expiry} days`;
			} else {
				statusColor = 'text-green-600 dark:text-green-400';
				statusBg = 'bg-green-100 dark:bg-green-900/30';
				statusText = `${cert.days_until_expiry} days`;
			}

			// Can refresh if user has permission AND cert manager matches the certificate source
			const certManagerMatches = (certManager === 'certbot' && cert.source === 'certbot') ||
			                           (certManager === 'acme.sh' && cert.source === 'acme.sh');
			const refreshButton = (canRefreshCerts() && certManagerMatches) ? `
				<button
					onclick="refreshCertificate('${escapeHtml(cert.domain)}')"
					class="px-3 py-1 text-sm bg-blue-500 hover:bg-blue-600 text-white rounded transition-colors"
					id="refresh-btn-${escapeHtml(cert.domain)}"
				>
					Refresh
				</button>
			` : '';

			// Download button - only if user has download permission
			const downloadButton = canDownloadCerts() ? `
				<button
					onclick="downloadCertificate('${escapeHtml(cert.domain)}')"
					class="px-3 py-1 text-sm bg-gray-500 hover:bg-gray-600 text-white rounded transition-colors flex items-center gap-1"
					title="Download certificate"
				>
					<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path>
					</svg>
					Download
				</button>
			` : '';

			const notAfter = new Date(cert.not_after);
			const notBefore = new Date(cert.not_before);
			const dateFormat = { year: 'numeric', month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit' };

			return `
				<div class="border border-gray-200 dark:border-slate-700 rounded-lg overflow-hidden">
					<!-- Card header -->
					<div class="p-4 flex items-center justify-between bg-gray-50 dark:bg-slate-900">
						<div class="flex items-center gap-3">
							<div class="${statusBg} ${statusColor} px-2 py-1 rounded text-sm font-medium">
								${statusText}
							</div>
							<div class="font-semibold text-gray-800 dark:text-gray-200">${escapeHtml(cert.domain)}</div>
							<div class="text-sm text-gray-500 dark:text-gray-400">${escapeHtml(cert.source)}</div>
						</div>
						<div class="flex items-center gap-2">
							${downloadButton}
							${refreshButton}
							<button
								onclick="toggleCertDetails('${escapeHtml(cert.domain)}')"
								class="p-1 text-gray-500 hover:text-gray-700 dark:text-gray-400 dark:hover:text-gray-200 transition-colors"
							>
								<svg id="chevron-${escapeHtml(cert.domain)}" class="w-5 h-5 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
								</svg>
							</button>
						</div>
					</div>

					<!-- Expandable details -->
					<div id="details-${escapeHtml(cert.domain)}" class="hidden p-4 border-t border-gray-200 dark:border-slate-700 bg-white dark:bg-slate-800">
						<div class="grid grid-cols-1 md:grid-cols-2 gap-4 text-sm">
							<div>
								<div class="text-gray-500 dark:text-gray-400">Common Name</div>
								<div class="text-gray-800 dark:text-gray-200">${escapeHtml(cert.common_name)}</div>
							</div>
							<div>
								<div class="text-gray-500 dark:text-gray-400">Issuer</div>
								<div class="text-gray-800 dark:text-gray-200">${escapeHtml(cert.issuer)}</div>
							</div>
							<div>
								<div class="text-gray-500 dark:text-gray-400">Valid From</div>
								<div class="text-gray-800 dark:text-gray-200">${notBefore.toLocaleString(undefined, dateFormat)}</div>
							</div>
							<div>
								<div class="text-gray-500 dark:text-gray-400">Valid Until</div>
								<div class="${statusColor} font-medium">${notAfter.toLocaleString(undefined, dateFormat)}</div>
							</div>
							<div>
								<div class="text-gray-500 dark:text-gray-400">Serial Number</div>
								<div class="text-gray-800 dark:text-gray-200 font-mono text-xs">${escapeHtml(cert.serial_number)}</div>
							</div>
							<div>
								<div class="text-gray-500 dark:text-gray-400">File Path</div>
								<div class="text-gray-800 dark:text-gray-200 font-mono text-xs">${escapeHtml(cert.file_path)}</div>
							</div>
							${renderSANs(cert.sans)}
							<div class="md:col-span-2">
								<div class="text-gray-500 dark:text-gray-400">Fingerprint (SHA256)</div>
								<div class="text-gray-800 dark:text-gray-200 font-mono text-xs break-all">${escapeHtml(cert.fingerprint)}</div>
							</div>
						</div>
					</div>
				</div>
			`;
		}

		function toggleCertDetails(domain) {
			const details = document.getElementById(`details-${domain}`);
			const chevron = document.getElementById(`chevron-${domain}`);

			if (details.classList.contains('hidden')) {
				details.classList.remove('hidden');
				chevron.classList.add('rotate-180');
			} else {
				details.classList.add('hidden');
				chevron.classList.remove('rotate-180');
			}
		}

		async function refreshCertificate(domain) {
			const serverID = getServerID();
			const btn = document.getElementById(`refresh-btn-${domain}`);

			if (!btn) return;

			const originalText = btn.textContent;
			btn.disabled = true;
			btn.textContent = 'Refreshing...';
			btn.className = btn.className.replace('bg-blue-500 hover:bg-blue-600', 'bg-gray-400 cursor-not-allowed');

			try {
				const response = await fetch(`/api/${serverID}/certificates/${encodeURIComponent(domain)}/refresh`, {
					method: 'POST'
				});

				const result = await response.json();

				if (result.success) {
					btn.textContent = 'Success!';
					btn.className = btn.className.replace('bg-gray-400 cursor-not-allowed', 'bg-green-500');
					if (window.showToast) {
						window.showToast('Certificate refreshed successfully', 'success', 3000);
					}
					// Reload certificates to show updated data
					setTimeout(() => loadCertificates(), 2000);
				} else {
					btn.textContent = 'Failed';
					btn.className = btn.className.replace('bg-gray-400 cursor-not-allowed', 'bg-red-500');
					if (window.showToast) {
						window.showToast('Refresh failed: ' + result.message, 'error', 5000);
					}
				}
			} catch (error) {
				btn.textContent = 'Error';
				btn.className = btn.className.replace('bg-gray-400 cursor-not-allowed', 'bg-red-500');
				if (window.showToast) {
					window.showToast('Error: ' + error.message, 'error', 5000);
				}
			}

			// Reset button after a delay
			setTimeout(() => {
				btn.disabled = false;
				btn.textContent = originalText;
				btn.className = btn.className.replace(/bg-(green|red|gray)-\d+/, 'bg-blue-500');
				btn.className = btn.className.replace('cursor-not-allowed', 'hover:bg-blue-600');
			}, 3000);
		}

		function manualRefresh() {
			const icon = document.getElementById('refresh-icon');
			icon.classList.add('animate-spin');
			loadCertificates();
			setTimeout(() => icon.classList.remove('animate-spin'), 1000);
		}

		async function downloadCertificate(domain) {
			const serverID = getServerID();

			try {
				const response = await fetch(`/api/${serverID}/certificates/${encodeURIComponent(domain)}/download`);

				if (!response.ok) {
					const text = await response.text();
					throw new Error(text || `HTTP ${response.status}`);
				}

				// Get filename from Content-Disposition header or use default
				const disposition = response.headers.get('Content-Disposition');
				let filename = domain + '.pem';
				if (disposition && disposition.includes('filename=')) {
					const match = disposition.match(/filename="?([^"]+)"?/);
					if (match) {
						filename = match[1];
					}
				}

				// Create blob and download
				const blob = await response.blob();
				const url = window.URL.createObjectURL(blob);
				const a = document.createElement('a');
				a.href = url;
				a.download = filename;
				document.body.appendChild(a);
				a.click();
				window.URL.revokeObjectURL(url);
				a.remove();
			} catch (error) {
				if (window.showToast) {
					window.showToast('Download failed: ' + error.message, 'error', 5000);
				}
			}
		}

		function escapeHtml(text) {
			if (!text) return '';
			const div = document.createElement('div');
			div.textContent = text;
			return div.innerHTML;
		}

		function renderSANs(sans) {
			if (!sans || sans.length === 0) return '';
			const sansHtml = sans.map(function(san) {
				return '<span class="px-2 py-0.5 bg-gray-100 dark:bg-slate-700 rounded text-xs">' + escapeHtml(san) + '</span>';
			}).join('');
			return '<div class="md:col-span-2"><div class="text-gray-500 dark:text-gray-400">Subject Alternative Names</div><div class="text-gray-800 dark:text-gray-200 flex flex-wrap gap-1 mt-1">' + sansHtml + '</div></div>';
		}

		function setupPageHeader() {
			const source = document.getElementById('page-header-source');
			const target = document.getElementById('header-page-content');
			if (source && target) {
				while (source.firstChild) {
					target.appendChild(source.firstChild);
				}
				source.remove();
			}
		}

		// Initialize
		document.addEventListener('DOMContentLoaded', function() {
			setupPageHeader();
			loadCertificates();
			initSSE();
		});

		// Cleanup on page unload
		window.addEventListener('beforeunload', function() {
			if (eventSource) {
				eventSource.close();
			}
		});
		</script>
	}
}
