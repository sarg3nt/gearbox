package pages

import (
	"fmt"
	"github.com/sarg3nt/gearbox/internal/framework/models"
	"github.com/sarg3nt/gearbox/internal/framework/ui"
	"github.com/sarg3nt/gearbox/internal/framework/templates/layouts"
)

templ AdminPermissions(
	currentUser *models.User,
	users []*models.User,
	allPerms map[string]*models.UserPermissions,
	templates []models.PermissionTemplate,
	errorMessage, successMessage, csrfToken string,
) {
	@layouts.Base("Permission Management", currentUser, "/settings") {
		<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
			<div class="mb-8">
				<h1 class="text-3xl font-bold text-gray-900 dark:text-white">Permission Management</h1>
				<p class="mt-2 text-sm text-gray-600 dark:text-gray-400">
					Manage granular permissions for users across all components
				</p>
			</div>

			if errorMessage != "" {
				@ui.ToastOnLoad(errorMessage, "error")
			}

			if successMessage != "" {
				@ui.ToastOnLoad(successMessage, "success")
			}

			<!-- Permission Templates Info -->
			<div class="mb-8 bg-blue-50 dark:bg-blue-900/20 border border-blue-200 dark:border-blue-800 rounded-lg p-4">
				<h3 class="text-sm font-semibold text-blue-900 dark:text-blue-100 mb-2">Quick Start Templates</h3>
				<p class="text-sm text-blue-800 dark:text-blue-200 mb-3">
					Apply pre-configured permission templates to quickly set up common access patterns:
				</p>
				<div class="grid grid-cols-1 md:grid-cols-2 gap-3">
					for _, template := range templates {
						<div class="bg-white dark:bg-gray-800 rounded p-3 border border-blue-200 dark:border-blue-700">
							<div class="font-medium text-sm text-gray-900 dark:text-white">{ template.Name }</div>
							<div class="text-xs text-gray-600 dark:text-gray-400 mt-1">{ template.Description }</div>
						</div>
					}
				</div>
			</div>

			<!-- Users List -->
			<div class="bg-white dark:bg-gray-800 rounded-lg shadow overflow-hidden">
				<div class="px-4 py-5 sm:px-6 border-b border-gray-200 dark:border-gray-700">
					<h3 class="text-lg leading-6 font-medium text-gray-900 dark:text-white">
						User Permissions
					</h3>
					<p class="mt-1 text-sm text-gray-500 dark:text-gray-400">
						Click on a user to manage their permissions
					</p>
				</div>
				<ul class="divide-y divide-gray-200 dark:divide-gray-700">
					for _, user := range users {
						@permissionUserRow(user, allPerms[user.ID])
					}
				</ul>
			</div>
		</div>
	}
}

templ permissionUserRow(user *models.User, perms *models.UserPermissions) {
	<li>
		<a
			href={ templ.URL(fmt.Sprintf("/settings/permissions/%s", user.ID)) }
			class="block hover:bg-gray-50 dark:hover:bg-gray-700 transition-colors"
		>
			<div class="px-4 py-4 sm:px-6">
				<div class="flex items-center justify-between">
					<div class="flex items-center">
						<div class="flex-shrink-0">
							<div class="h-10 w-10 rounded-full bg-blue-500 flex items-center justify-center text-white font-semibold">
								{ user.Initials() }
							</div>
						</div>
						<div class="ml-4">
							<div class="text-sm font-medium text-gray-900 dark:text-white">
								{ user.DisplayName() }
							</div>
							<div class="text-sm text-gray-500 dark:text-gray-400">
								{ user.Email }
							</div>
						</div>
					</div>
					<div class="flex items-center space-x-4">
						<div class="text-right">
							if user.IsAdmin() {
								<span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-purple-100 text-purple-800 dark:bg-purple-900 dark:text-purple-200">
									Admin (All Permissions)
								</span>
							} else if perms != nil {
								<div class="text-xs text-gray-500 dark:text-gray-400">
									{ fmt.Sprintf("%d permissions", countTotalPermissions(perms)) }
								</div>
								<div class="text-xs text-gray-400 dark:text-gray-500">
									{ fmt.Sprintf("%d components", len(perms.Permissions)) }
								</div>
							} else {
								<span class="text-xs text-gray-400 dark:text-gray-500">No permissions</span>
							}
						</div>
						<svg class="h-5 w-5 text-gray-400" viewBox="0 0 20 20" fill="currentColor">
							<path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd"/>
						</svg>
					</div>
				</div>
			</div>
		</a>
	</li>
}

func countTotalPermissions(perms *models.UserPermissions) int {
	count := 0
	for _, p := range perms.Permissions {
		count += len(p)
	}
	return count
}
