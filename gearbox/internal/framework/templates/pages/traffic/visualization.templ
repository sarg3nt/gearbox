package traffic

templ Visualization() {
	<!-- Full-width Interactive Network Visualization -->
	<div class="bg-slate-900 rounded-lg shadow-2xl overflow-hidden border border-slate-700">
		<div class="p-4 border-b border-slate-700 flex items-center justify-between">
			<div>
				<h3 class="text-lg font-semibold text-gray-100">Traffic Flow Visualization</h3>
				<p class="text-sm text-gray-400">Interactive network topology • Scroll to zoom • Drag to pan • Click nodes for details</p>
			</div>
			<div class="flex items-center gap-2">
				<!-- View filter dropdown -->
				<select
					id="viz-filter"
					class="h-[38px] px-3 py-1.5 text-sm border border-slate-600 rounded-lg bg-slate-800 text-gray-300 focus:outline-none focus:ring-2 focus:ring-blue-500"
				>
					<option value="active">Active Only</option>
					<option value="all">All Backends</option>
					<option value="errors">With Errors</option>
					<option value="high-traffic">High Traffic</option>
				</select>
				<button id="reset-viz-btn" class="px-3 py-2 text-sm bg-slate-700 hover:bg-slate-600 text-gray-300 rounded-lg transition-colors">
					Reset View
				</button>
				<button id="physics-toggle" class="px-3 py-2 text-sm bg-blue-600 hover:bg-blue-500 text-white rounded-lg transition-colors">
					Physics: ON
				</button>
			</div>
		</div>
		<div id="network-container" class="relative" style="height: 550px;">
			<svg id="network-svg" class="w-full h-full"></svg>
			<div id="network-loading" class="absolute inset-0 flex items-center justify-center bg-slate-900/80">
				<div class="flex flex-col items-center gap-3">
					<div class="animate-spin rounded-full h-10 w-10 border-2 border-blue-500 border-t-transparent"></div>
					<span class="text-gray-400 text-sm">Loading traffic data...</span>
				</div>
			</div>
			<!-- Node detail tooltip - clickable when pinned -->
			<div id="node-tooltip" class="absolute hidden bg-slate-800 border border-slate-600 rounded-lg shadow-2xl p-4 z-50 min-w-[280px]">
				<div id="tooltip-content"></div>
				<div id="tooltip-actions" class="hidden mt-3 pt-3 border-t border-slate-600">
					<button id="filter-btn" class="w-full px-3 py-2 bg-blue-600 hover:bg-blue-500 text-white text-sm rounded-lg transition-colors flex items-center justify-center gap-2">
						<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 4a1 1 0 011-1h16a1 1 0 011 1v2.586a1 1 0 01-.293.707l-6.414 6.414a1 1 0 00-.293.707V17l-4 4v-6.586a1 1 0 00-.293-.707L3.293 7.293A1 1 0 013 6.586V4z"></path></svg>
						Filter tables by this node
					</button>
					<button id="close-tooltip-btn" class="w-full mt-2 px-3 py-1.5 text-gray-400 hover:text-gray-200 text-sm transition-colors">
						Close
					</button>
				</div>
			</div>
			<!-- Filter indicator -->
			<div id="filter-indicator" class="absolute top-4 left-4 hidden bg-blue-600 text-white px-3 py-2 rounded-lg text-sm flex items-center gap-2 z-40">
				<span id="filter-text">Filtering by: </span>
				<button id="clear-filter-btn" class="ml-2 hover:bg-blue-500 rounded p-1" title="Clear filter">
					<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
				</button>
			</div>
			<!-- Legend -->
			<div class="absolute bottom-4 left-4 bg-slate-800/90 backdrop-blur-sm rounded-lg p-3 text-xs">
				<div class="text-gray-400 font-medium mb-2">Legend</div>
				<div class="flex flex-col gap-1.5">
					<div class="flex items-center gap-2">
						<div class="w-4 h-3 rounded-sm bg-violet-500"></div>
						<span class="text-gray-300">Source IP</span>
					</div>
					<div class="flex items-center gap-2">
						<div class="w-4 h-4 rounded-full bg-blue-500 border-2 border-blue-600"></div>
						<span class="text-gray-300">HAProxy (server)</span>
					</div>
					<div class="flex items-center gap-2">
						<div class="w-4 h-3 rounded-sm bg-emerald-500"></div>
						<span class="text-gray-300">Backend (hostname)</span>
					</div>
					<div class="flex items-center gap-2 pt-1.5 border-t border-slate-600 mt-1">
						<div class="w-6 h-0.5 bg-gradient-to-r from-violet-500 via-blue-500 to-emerald-500 rounded"></div>
						<span class="text-gray-300">Flow: Source → HAProxy → Backend</span>
					</div>
					<div class="text-gray-500 text-[10px] mt-1">Particle speed indicates traffic volume</div>
				</div>
			</div>
			<!-- Zoom controls -->
			<div class="absolute bottom-4 right-4 flex flex-col gap-1">
				<button id="zoom-in-btn" class="w-8 h-8 bg-slate-700 hover:bg-slate-600 text-gray-300 rounded flex items-center justify-center transition-colors">
					<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path></svg>
				</button>
				<button id="zoom-out-btn" class="w-8 h-8 bg-slate-700 hover:bg-slate-600 text-gray-300 rounded flex items-center justify-center transition-colors">
					<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 12H4"></path></svg>
				</button>
			</div>
		</div>
	</div>
}
