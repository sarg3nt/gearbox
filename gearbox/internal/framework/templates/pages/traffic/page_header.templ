package traffic

import (
	"github.com/sarg3nt/gearbox/internal/framework/models"
)

templ PageHeader(servers []models.BoxConfig) {
	<!-- Hidden container for page header content. Title + box selector
	     live in the global header breadcrumb + chip. -->
	<div id="page-header-source" class="hidden">
		<div class="flex-1"></div>
		<div class="flex items-center space-x-3">
			<!-- Time range selector -->
			<select
				id="time-range-selector"
				class="h-[38px] px-3 py-1.5 text-sm border border-gray-300 dark:border-slate-600 rounded-lg bg-white dark:bg-slate-800 text-gray-700 dark:text-gray-300 focus:outline-none focus:ring-2 focus:ring-blue-500"
			>
				<option value="1h">Last Hour</option>
				<option value="6h">Last 6 Hours</option>
				<option value="24h" selected>Last 24 Hours</option>
				<option value="7d">Last 7 Days</option>
				<option value="30d">Last 30 Days</option>
			</select>
			<!-- Refresh button with SSE status indicator -->
			<button
				id="refresh-btn"
				class="p-2 rounded-lg transition-colors text-gray-400"
				title="Connecting..."
			>
				<svg id="refresh-icon" class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path>
				</svg>
			</button>
		</div>
	</div>
}
