package traffic

templ SummaryCards() {
	<!-- Traffic Summary Cards - 5 columns including response codes -->
	<div id="traffic-summary" class="grid grid-cols-1 md:grid-cols-3 lg:grid-cols-5 gap-4">
		<div class="bg-white dark:bg-slate-800 rounded-lg shadow p-4">
			<div class="flex items-center justify-between">
				<span class="text-sm text-gray-500 dark:text-gray-400">Total Requests</span>
				<svg class="w-5 h-5 text-blue-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 12l3-3 3 3 4-4M8 21l4-4 4 4M3 4h18M4 4h16v12a1 1 0 01-1 1H5a1 1 0 01-1-1V4z"></path>
				</svg>
			</div>
			<p id="total-requests" class="text-2xl font-bold text-gray-800 dark:text-gray-100 mt-2">-</p>
			<p class="text-xs text-gray-400 mt-1"><span id="requests-per-sec">-</span> req/s</p>
		</div>
		<div class="bg-white dark:bg-slate-800 rounded-lg shadow p-4">
			<div class="flex items-center justify-between">
				<span class="text-sm text-gray-500 dark:text-gray-400">Bandwidth</span>
				<svg class="w-5 h-5 text-green-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
				</svg>
			</div>
			<p id="total-bandwidth" class="text-2xl font-bold text-gray-800 dark:text-gray-100 mt-2">-</p>
			<p class="text-xs text-gray-400 mt-1">In: <span id="bytes-in">-</span> / Out: <span id="bytes-out">-</span></p>
		</div>
		<div class="bg-white dark:bg-slate-800 rounded-lg shadow p-4">
			<div class="flex items-center justify-between">
				<span class="text-sm text-gray-500 dark:text-gray-400">Unique Sources</span>
				<svg class="w-5 h-5 text-purple-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"></path>
				</svg>
			</div>
			<p id="unique-ips" class="text-2xl font-bold text-gray-800 dark:text-gray-100 mt-2">-</p>
			<p class="text-xs text-gray-400 mt-1"><span id="unique-countries">-</span> countries</p>
		</div>
		<div class="bg-white dark:bg-slate-800 rounded-lg shadow p-4">
			<div class="flex items-center justify-between">
				<span class="text-sm text-gray-500 dark:text-gray-400">Error Rate</span>
				<svg class="w-5 h-5 text-red-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path>
				</svg>
			</div>
			<p id="error-rate" class="text-2xl font-bold text-gray-800 dark:text-gray-100 mt-2">-</p>
			<p class="text-xs text-gray-400 mt-1">Avg response: <span id="avg-response-time">-</span></p>
		</div>
		<!-- Combined Response Codes card -->
		<div class="bg-white dark:bg-slate-800 rounded-lg shadow p-4">
			<div class="flex items-center justify-between mb-2">
				<span class="text-sm text-gray-500 dark:text-gray-400">Response Codes</span>
				<svg class="w-5 h-5 text-cyan-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path>
				</svg>
			</div>
			<div class="flex items-center justify-between text-xs">
				<div class="text-center">
					<span class="block text-green-500 font-bold text-sm" id="status-2xx-count">-</span>
					<span class="text-gray-400">2xx</span>
				</div>
				<div class="text-center">
					<span class="block text-blue-500 font-bold text-sm" id="status-3xx-count">-</span>
					<span class="text-gray-400">3xx</span>
				</div>
				<div class="text-center">
					<span class="block text-yellow-500 font-bold text-sm" id="status-4xx-count">-</span>
					<span class="text-gray-400">4xx</span>
				</div>
				<div class="text-center">
					<span class="block text-red-500 font-bold text-sm" id="status-5xx-count">-</span>
					<span class="text-gray-400">5xx</span>
				</div>
			</div>
		</div>
	</div>
}
