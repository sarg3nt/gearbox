package pages

import (
	"github.com/sarg3nt/gearbox/internal/framework/models"
	"github.com/sarg3nt/gearbox/internal/framework/templates/layouts"
	"github.com/sarg3nt/gearbox/internal/framework/templates/components"
	"strings"
)

templ Services(user *models.User, servers []models.BoxConfig) {
	@layouts.Base("Services", user, "/services") {
		<!-- Hidden element to track admin status -->
		<div id="user-admin-status" data-is-admin={ isAdminString(user) } class="hidden"></div>

		<!-- Hidden container for page header content - will be moved to main header via JS -->
		<div id="page-header-source" class="hidden">
			<!-- Left side: Title with integrated server selector -->
			<div class="flex items-center">
				<h2 class="text-xl font-bold text-gray-800 dark:text-gray-100">
					Services
					if len(servers) > 1 {
						<span class="text-gray-400 dark:text-gray-500 mx-2">:</span>
						<span class="inline-block relative">
							<select
								id="server-selector"
								class="appearance-none bg-transparent text-xl font-bold text-gray-800 dark:text-gray-100 pr-7 cursor-pointer focus:outline-none hover:text-blue-600 dark:hover:text-blue-400 transition-colors"
								onchange="switchServer(this.value)"
							>
								for _, server := range servers {
									<option value={ server.ID } selected?={ server.ID == servers[0].ID }>{ server.Name }</option>
								}
							</select>
							<!-- Subtle dropdown indicator -->
							<svg class="absolute right-0 top-1/2 -translate-y-1/2 w-4 h-4 text-gray-400 dark:text-gray-500 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
							</svg>
						</span>
					} else if len(servers) == 1 {
						<span class="text-gray-400 dark:text-gray-500 mx-2">:</span>
						<span id="single-server-name">{ servers[0].Name }</span>
					}
				</h2>
			</div>
			<!-- Right side spacer -->
			<div class="flex-1"></div>
			<!-- Controls -->
			<div class="flex items-center space-x-3">
				<!-- Status filter dropdown -->
				<select
					id="status-filter"
					class="h-[38px] px-3 py-1.5 text-sm border border-gray-300 dark:border-slate-600 rounded-lg bg-white dark:bg-slate-800 text-gray-700 dark:text-gray-300 focus:outline-none focus:ring-2 focus:ring-blue-500"
					onchange="applyFilters()"
				>
					<option value="all">All Status</option>
					<option value="active">Active Only</option>
					<option value="inactive">Inactive Only</option>
				</select>
				<!-- Text filter -->
				<div class="relative">
					<input
						type="text"
						id="service-filter"
						placeholder="Filter services..."
						class="h-[38px] w-48 px-3 py-1.5 pr-8 text-sm border border-gray-300 dark:border-slate-600 rounded-lg bg-white dark:bg-slate-800 text-gray-700 dark:text-gray-300 focus:outline-none focus:ring-2 focus:ring-blue-500"
						oninput="applyFilters()"
					/>
					<button
						type="button"
						id="filter-clear"
						class="absolute right-2 top-1/2 -translate-y-1/2 text-gray-400 hover:text-gray-600 dark:hover:text-gray-300 hidden"
						onclick="clearFilter()"
					>
						<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
						</svg>
					</button>
				</div>
				<!-- Refresh button with SSE status indicator (color changes based on connection) -->
				<button
					id="refresh-btn"
					onclick="manualRefresh()"
					class="p-2 rounded-lg transition-colors text-gray-400"
					title="Connecting..."
				>
					<svg id="refresh-icon" class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path>
					</svg>
				</button>
			</div>
		</div>

		<!-- Hidden server ID for single-server mode -->
		if len(servers) > 0 {
			<input type="hidden" id="default-server-id" value={ servers[0].ID }/>
		}

		if len(servers) == 0 {
			@components.InfoAlert("No servers configured.")
		} else {
			<!-- Services grid container -->
			<div id="services-container" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-4">
				@components.LoadingSpinner()
			</div>
		}

		<script>
		let eventSource = null;
		let servicesCache = [];
		let monitoredServices = [];
		let enabledLogSources = []; // Services that have logs available
		let isInitialLoad = true; // Track if this is initial load vs SSE update
		const isAdmin = document.getElementById('user-admin-status').getAttribute('data-is-admin') === 'true';

		// Get current server ID - handles both multi-server (select) and single-server (hidden input) modes
		function getCurrentServerID() {
			const selector = document.getElementById('server-selector');
			if (selector) return selector.value;
			// Single server mode - get from hidden input
			const defaultServer = document.getElementById('default-server-id');
			if (defaultServer) return defaultServer.value;
			return '';
		}

		// Switch server
		function switchServer(serverID) {
			// Use global ServerSelector for tab isolation
			if (window.ServerSelector) {
				window.ServerSelector.setSelectedServer(serverID);
			}
			loadServices();
			initSSE();
		}

		// SSE connection status - update refresh button color (matches overview page pattern)
		function updateSSEStatus(status) {
			const btn = document.getElementById('refresh-btn');
			if (!btn) return;

			// Remove all status classes
			btn.classList.remove('text-green-500', 'text-red-500', 'text-yellow-500', 'text-gray-400');

			switch (status) {
				case 'connected':
					btn.classList.add('text-green-500');
					btn.title = 'Live - streaming data';
					break;
				case 'connecting':
					btn.classList.add('text-yellow-500');
					btn.title = 'Connecting...';
					break;
				case 'disconnected':
					btn.classList.add('text-red-500');
					btn.title = 'Disconnected - click to reconnect';
					break;
				default:
					btn.classList.add('text-gray-400');
					btn.title = 'Refresh';
			}
		}

		// Initialize SSE
		function initSSE() {
			if (eventSource) {
				eventSource.close();
			}

			const serverID = getCurrentServerID();
			updateSSEStatus('connecting');

			const sseUrl = serverID ? '/api/events?server=' + serverID : '/api/events';
			eventSource = new EventSource(sseUrl);

			eventSource.onopen = function() {
				console.log('SSE connected for services');
				updateSSEStatus('connected');
			};

			eventSource.onerror = function(e) {
				console.error('SSE error:', e);
				updateSSEStatus('disconnected');
				setTimeout(function() {
					if (eventSource && eventSource.readyState === EventSource.CLOSED) {
						initSSE();
					}
				}, 3000);
			};

			// Listen for metrics updates - refresh services data
			// The agent pushes metrics.updated events periodically (every 2 seconds by default)
			// We fetch updated data and only update cards that have changed
			eventSource.addEventListener('metrics.updated', function(e) {
				// Fetch fresh data and update only changed cards (no loading spinner)
				refreshServicesQuietly();
			});

			eventSource.addEventListener('heartbeat', function(e) {
				// Connection alive
			});
		}

		// Load services config for the current server
		async function loadServicesConfig(serverID) {
			try {
				const response = await fetch('/api/' + serverID + '/services-config');
				const data = await response.json();
				if (data.monitored_services) {
					monitoredServices = data.monitored_services;
				} else {
					// Fallback to defaults
					monitoredServices = ['haproxy', 'gearbox-agent', 'nftables', 'fail2ban'];
				}
			} catch (error) {
				console.error('Failed to load services config:', error);
				// Fallback to defaults
				monitoredServices = ['haproxy', 'gearbox-agent', 'nftables', 'fail2ban'];
			}
		}

		// Load enabled log sources for the current server
		async function loadLogSources(serverID) {
			try {
				const response = await fetch('/api/' + serverID + '/log-sources');
				const data = await response.json();
				if (data.sources) {
					enabledLogSources = data.sources.map(s => s.name);
				} else {
					// Fallback to defaults
					enabledLogSources = ['haproxy', 'system'];
				}
			} catch (error) {
				console.error('Failed to load log sources:', error);
				// Fallback to defaults
				enabledLogSources = ['haproxy', 'system'];
			}
		}

		// Check if a service has logs available
		function hasLogsAvailable(serviceName) {
			return enabledLogSources.includes(serviceName);
		}

		// Load services via REST API (initial load with spinner)
		async function loadServices() {
			const serverID = getCurrentServerID();
			if (!serverID) {
				document.getElementById('services-container').innerHTML = '<div class="col-span-full text-gray-500 dark:text-gray-400 text-center py-8">No server selected</div>';
				return;
			}

			const container = document.getElementById('services-container');

			// Only show loading spinner on initial load
			if (isInitialLoad) {
				container.innerHTML = '<div class="col-span-full flex justify-center py-8"><div class="animate-spin rounded-full h-8 w-8 border-b-2 border-blue-600"></div></div>';
			}

			// Load services config and log sources in parallel
			await Promise.all([
				loadServicesConfig(serverID),
				loadLogSources(serverID)
			]);

			fetch('/api/' + serverID + '/services?services=' + monitoredServices.join(','))
				.then(function(response) { return response.json(); })
				.then(function(data) {
					if (data.error) {
						container.innerHTML = '<div class="col-span-full text-red-500 dark:text-red-400 p-4 bg-red-50 dark:bg-red-900/20 rounded">' + escapeHtml(data.error) + '</div>';
						return;
					}
					servicesCache = data.services || [];
					displayServices(servicesCache);
					isInitialLoad = false; // Subsequent updates won't show spinner
				})
				.catch(function(error) {
					container.innerHTML = '<div class="col-span-full text-red-500 dark:text-red-400 p-4 bg-red-50 dark:bg-red-900/20 rounded">Error loading services: ' + escapeHtml(error.message) + '</div>';
				});
		}

		// Refresh services quietly (SSE update - no spinner, update cards in-place)
		async function refreshServicesQuietly() {
			const serverID = getCurrentServerID();
			if (!serverID) return;

			try {
				const response = await fetch('/api/' + serverID + '/services?services=' + monitoredServices.join(','));
				const data = await response.json();
				if (data.error || !data.services) return;

				// Update only cards that have changed
				const newServices = data.services;
				updateServiceCards(newServices);
				servicesCache = newServices;
			} catch (error) {
				console.error('Failed to refresh services:', error);
			}
		}

		// Update individual service cards in-place (no full re-render)
		function updateServiceCards(newServices) {
			const container = document.getElementById('services-container');
			if (!container) return;

			// Build a map of new services by name
			const newServiceMap = {};
			newServices.forEach(function(svc) {
				newServiceMap[svc.name] = svc;
			});

			// Build a map of old services by name
			const oldServiceMap = {};
			servicesCache.forEach(function(svc) {
				oldServiceMap[svc.name] = svc;
			});

			// Check if service list changed (added/removed services)
			const oldNames = Object.keys(oldServiceMap).sort().join(',');
			const newNames = Object.keys(newServiceMap).sort().join(',');
			if (oldNames !== newNames) {
				// Service list changed, do full re-render
				displayServices(newServices);
				return;
			}

			// Update each card in-place
			newServices.forEach(function(newSvc) {
				const oldSvc = oldServiceMap[newSvc.name];
				if (!oldSvc) return;

				// Check if anything changed that affects the display
				const oldActive = oldSvc.active === true || oldSvc.active === 'true' || oldSvc.status === 'active';
				const newActive = newSvc.active === true || newSvc.active === 'true' || newSvc.status === 'active';
				const uptimeChanged = oldSvc.uptime !== newSvc.uptime;
				const statusChanged = oldActive !== newActive;

				if (!statusChanged && !uptimeChanged) return; // No visible changes

				// Find and update the card
				const card = container.querySelector('[data-service-name="' + CSS.escape(newSvc.name) + '"]');
				if (!card) return;

				// Update status indicator dot
				const dot = card.querySelector('.w-3.h-3.rounded-full');
				if (dot) {
					dot.className = 'w-3 h-3 rounded-full ' + (newActive ? 'bg-green-500' : 'bg-red-500');
				}

				// Update status text
				const statusSpan = card.querySelector('.text-xs.font-medium');
				if (statusSpan) {
					statusSpan.textContent = newActive ? 'Active' : 'Inactive';
					statusSpan.className = 'text-xs font-medium ' + (newActive ? 'text-green-700 dark:text-green-400' : 'text-red-700 dark:text-red-400');
				}

				// Update card background color
				card.className = card.className
					.replace(/bg-(green|red)-100/g, newActive ? 'bg-green-100' : 'bg-red-100')
					.replace(/dark:bg-(green|red)-900\/30/g, newActive ? 'dark:bg-green-900/30' : 'dark:bg-red-900/30')
					.replace(/border-(green|red)-500/g, newActive ? 'border-green-500' : 'border-red-500');
				card.setAttribute('data-is-active', newActive.toString());

				// Update uptime display
				if (uptimeChanged) {
					const uptimeContainer = card.querySelector('.flex-grow');
					if (uptimeContainer && newActive && newSvc.uptime) {
						// Find or create uptime element
						let uptimeDiv = uptimeContainer.querySelector('.flex.justify-between');
						if (uptimeDiv) {
							// Update existing uptime
							const uptimeSpan = uptimeDiv.querySelector('.font-mono');
							if (uptimeSpan) {
								uptimeSpan.textContent = newSvc.uptime;
							}
						}
					}
				}
			});
		}

		// Format a date for display
		function formatStartedAt(isoDate) {
			if (!isoDate) return '';
			try {
				const date = new Date(isoDate);
				return date.toLocaleString(undefined, {
					month: 'short',
					day: 'numeric',
					hour: '2-digit',
					minute: '2-digit'
				});
			} catch (e) {
				return '';
			}
		}

		// Display services
		function displayServices(services) {
			const container = document.getElementById('services-container');

			if (!services || services.length === 0) {
				container.innerHTML = '<div class="col-span-full text-gray-500 dark:text-gray-400 text-center py-8">No services configured. Go to Settings → Gears to configure monitored services.</div>';
				return;
			}

			container.innerHTML = services.map(function(service) {
				const isActive = service.active === true || service.active === 'true' || service.status === 'active';
				const statusClass = isActive ? 'bg-green-100 dark:bg-green-900/30 border-green-500' : 'bg-red-100 dark:bg-red-900/30 border-red-500';
				const dotClass = isActive ? 'bg-green-500' : 'bg-red-500';
				const statusText = isActive ? 'Active' : 'Inactive';
				const statusTextClass = isActive ? 'text-green-700 dark:text-green-400' : 'text-red-700 dark:text-red-400';
				const hasLogs = hasLogsAvailable(service.name);

				// Build the uptime/start info row
				var uptimeHtml = '';
				if (isActive && (service.uptime || service.started_at)) {
					var uptimeInfo = [];
					if (service.started_at) {
						uptimeInfo.push('<span title="Started at ' + escapeHtml(service.started_at) + '">' + formatStartedAt(service.started_at) + '</span>');
					}
					if (service.uptime) {
						uptimeInfo.push('<span class="font-mono">' + escapeHtml(service.uptime) + '</span>');
					}
					if (uptimeInfo.length > 0) {
						uptimeHtml = '<div class="flex justify-between items-center">' +
							'<span>Uptime:</span>' +
							'<span class="text-right">' + uptimeInfo.join(' · ') + '</span>' +
						'</div>';
					}
				}

				// Description row
				const descriptionHtml = service.description ? '<div class="mt-1 text-xs text-gray-500 dark:text-gray-500 truncate" title="' + escapeHtml(service.description) + '">' + escapeHtml(service.description) + '</div>' : '';

				// Admin controls (stop/start/restart) and log icon - always render footer for consistent alignment
				var controlsHtml = '<div class="mt-auto pt-3 border-t border-gray-200 dark:border-slate-600 flex justify-between items-center">';

				// Log icon on the left (only if service has logs)
				if (hasLogs) {
					controlsHtml += '<button onclick="goToServiceLogs(\'' + escapeHtml(service.name) + '\', event)" class="p-1.5 rounded hover:bg-gray-200 dark:hover:bg-slate-600 transition-colors" title="View logs">' +
						'<svg class="w-4 h-4 text-gray-600 dark:text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path></svg>' +
					'</button>';
				} else {
					controlsHtml += '<div></div>'; // Empty spacer
				}

				// Admin controls on the right
				if (isAdmin) {
					controlsHtml += '<div class="flex gap-2">';
					controlsHtml += '<button onclick="controlService(event, \'' + escapeHtml(service.name) + '\', \'restart\')" class="p-1.5 rounded hover:bg-gray-200 dark:hover:bg-slate-600 transition-colors" title="Restart service">' +
						'<svg class="w-4 h-4 text-yellow-600 dark:text-yellow-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path></svg>' +
					'</button>';

					if (isActive) {
						controlsHtml += '<button onclick="controlService(event, \'' + escapeHtml(service.name) + '\', \'stop\')" class="p-1.5 rounded hover:bg-gray-200 dark:hover:bg-slate-600 transition-colors" title="Stop service">' +
							'<svg class="w-4 h-4 text-red-600 dark:text-red-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 10a1 1 0 011-1h4a1 1 0 011 1v4a1 1 0 01-1 1h-4a1 1 0 01-1-1v-4z"></path></svg>' +
						'</button>';
					} else {
						controlsHtml += '<button onclick="controlService(event, \'' + escapeHtml(service.name) + '\', \'start\')" class="p-1.5 rounded hover:bg-gray-200 dark:hover:bg-slate-600 transition-colors" title="Start service">' +
							'<svg class="w-4 h-4 text-green-600 dark:text-green-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>' +
						'</button>';
					}
					controlsHtml += '</div>';
				} else {
					controlsHtml += '<div></div>'; // Empty spacer when not admin
				}

				controlsHtml += '</div>';

				// Card is only clickable if it has logs
				const clickableClass = hasLogs ? 'cursor-pointer hover:shadow-md' : 'cursor-default';
				const onClickAttr = hasLogs ? 'onclick="goToServiceLogs(\'' + escapeHtml(service.name) + '\')"' : '';

				return '<div class="service-card p-4 rounded-lg border-l-4 transition-shadow flex flex-col ' + statusClass + ' ' + clickableClass + '" ' +
					'data-service-name="' + escapeHtml(service.name) + '" ' +
					'data-is-active="' + isActive + '" ' +
					'data-has-logs="' + hasLogs + '" ' +
					onClickAttr + '>' +
					'<div class="flex items-start justify-between">' +
						'<div class="flex items-center gap-2">' +
							'<span class="w-3 h-3 rounded-full ' + dotClass + '"></span>' +
							'<h3 class="font-semibold text-gray-800 dark:text-gray-100">' + escapeHtml(service.name) + '</h3>' +
						'</div>' +
						'<span class="text-xs font-medium ' + statusTextClass + '">' + statusText + '</span>' +
					'</div>' +
					'<div class="mt-2 mb-3 text-sm text-gray-600 dark:text-gray-400 flex-grow">' +
						uptimeHtml +
						descriptionHtml +
					'</div>' +
					controlsHtml +
				'</div>';
			}).join('');

			applyFilters();
		}

		// Navigate to logs page with service pre-selected
		function goToServiceLogs(serviceName, event) {
			// Prevent event bubbling if called from a button
			if (event) {
				event.stopPropagation();
			}
			// Only navigate if the service has logs
			if (!hasLogsAvailable(serviceName)) {
				return;
			}
			// Store the service name for the logs page to pick up
			sessionStorage.setItem('selected-log-source', serviceName);
			window.location.href = '/logs';
		}

		// Service control (start/stop/restart)
		async function controlService(event, serviceName, action) {
			event.stopPropagation(); // Prevent card click
			event.preventDefault();

			// Capture button reference before async operations
			const btn = event.currentTarget;
			const serverID = getCurrentServerID();

			// Determine dialog type based on action
			var dialogType = 'warning';
			var confirmText = action.charAt(0).toUpperCase() + action.slice(1);
			if (action === 'stop') {
				dialogType = 'danger';
			} else if (action === 'start') {
				dialogType = 'info';
			}

			const confirmed = await showConfirmDialog({
				title: confirmText + ' Service',
				message: 'Are you sure you want to ' + action + ' the "' + serviceName + '" service?',
				confirmText: confirmText,
				type: dialogType
			});

			if (!confirmed) return;

			// Visual feedback
			if (btn) {
				btn.disabled = true;
				btn.style.opacity = '0.5';
			}

			try {
				const response = await fetch('/api/' + serverID + '/service-control', {
					method: 'POST',
					headers: { 'Content-Type': 'application/json' },
					body: JSON.stringify({ service: serviceName, action: action })
				});

				if (!response.ok) {
					const text = await response.text();
					throw new Error(text || 'Failed to ' + action + ' service');
				}

				const data = await response.json();
				console.log('Service control response:', data);

				if (!data.success) {
					throw new Error(data.message || 'Service control failed');
				}

				// Refresh services after a short delay to see the change
				// Use displayServices directly to force button state update without flashing
				setTimeout(async function() {
					const response = await fetch('/api/' + serverID + '/services?services=' + monitoredServices.join(','));
					const data = await response.json();
					if (data.services) {
						servicesCache = data.services;
						displayServices(servicesCache);
					}
				}, 1500);
			} catch (error) {
				console.error('Service control error:', error);
				if (window.showToast) {
					window.showToast('Service control failed: ' + error.message, 'error', 5000);
				}
				if (btn) {
					btn.disabled = false;
					btn.style.opacity = '1';
				}
			}
		}

		// Apply filters
		function applyFilters() {
			const textFilter = document.getElementById('service-filter').value.toLowerCase();
			const statusFilter = document.getElementById('status-filter').value;
			const clearBtn = document.getElementById('filter-clear');

			// Show/hide clear button
			if (textFilter.length > 0) {
				clearBtn.classList.remove('hidden');
			} else {
				clearBtn.classList.add('hidden');
			}

			document.querySelectorAll('.service-card').forEach(function(card) {
				const name = card.getAttribute('data-service-name').toLowerCase();
				const isActive = card.getAttribute('data-is-active') === 'true';

				var showByText = textFilter === '' || name.includes(textFilter);
				var showByStatus = true;

				if (statusFilter === 'active') {
					showByStatus = isActive;
				} else if (statusFilter === 'inactive') {
					showByStatus = !isActive;
				}

				card.style.display = (showByText && showByStatus) ? '' : 'none';
			});
		}

		function clearFilter() {
			var input = document.getElementById('service-filter');
			input.value = '';
			document.getElementById('filter-clear').classList.add('hidden');
			applyFilters();
			input.focus();
		}

		function manualRefresh() {
			const icon = document.getElementById('refresh-icon');
			icon.classList.add('animate-spin');

			// Reinitialize SSE to ensure connection is working
			initSSE();

			// Trigger data refresh
			loadServices();

			setTimeout(function() { icon.classList.remove('animate-spin'); }, 1000);
		}

		function escapeHtml(text) {
			if (!text) return '';
			var div = document.createElement('div');
			div.textContent = text;
			return div.innerHTML;
		}

		// Move page header content to main header
		function setupPageHeader() {
			const source = document.getElementById('page-header-source');
			const target = document.getElementById('header-page-content');
			if (source && target) {
				// Move all children from source to target
				while (source.firstChild) {
					target.appendChild(source.firstChild);
				}
				// Remove the hidden source container
				source.remove();
			}
		}

		// Initialize
		document.addEventListener('DOMContentLoaded', function() {
			setupPageHeader();

			// Restore server selection using global ServerSelector (sessionStorage for tab isolation)
			const serverSelector = document.getElementById('server-selector');
			if (serverSelector && window.ServerSelector) {
				window.ServerSelector.initFromSelect(serverSelector);
			}

			loadServices();
			initSSE();
		});

		// Clean up SSE on page unload
		window.addEventListener('beforeunload', function() {
			if (eventSource) {
				eventSource.close();
			}
		});
		</script>
	}
}

func servicesJSON(services []string) string {
	if len(services) == 0 {
		return "[]"
	}
	escaped := make([]string, len(services))
	for i, s := range services {
		escaped[i] = `"` + strings.ReplaceAll(s, `"`, `\"`) + `"`
	}
	return "[" + strings.Join(escaped, ",") + "]"
}

func isAdminString(user *models.User) string {
	if user != nil && user.IsAdmin() {
		return "true"
	}
	return "false"
}
