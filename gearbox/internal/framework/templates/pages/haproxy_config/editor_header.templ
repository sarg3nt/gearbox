package haproxy_config

import (
	"github.com/sarg3nt/gearbox/internal/framework/agent"
	"github.com/sarg3nt/gearbox/internal/framework/database"
)

templ EditorHeader(server *database.BoxDB, config *agent.HAProxyConfigResponse, canEdit bool) {
	<!-- Hidden container for page header content -->
	<div id="page-header-source" class="hidden">
		<div class="flex items-center">
			<h2 class="text-xl font-bold text-gray-800 dark:text-gray-100">HAProxy Configuration</h2>
			<span class="ml-3 text-sm text-gray-500 dark:text-gray-400">{ server.Name }</span>
		</div>
		<div class="flex-1"></div>
		<!-- Controls -->
		<div class="flex items-center space-x-3">
			<!-- Info icon with tooltip -->
			<div class="group relative">
				<button
					type="button"
					class="p-2 text-gray-400 hover:text-gray-600 dark:hover:text-gray-300 rounded transition-colors"
				>
					<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
					</svg>
				</button>
				<div class="absolute right-0 top-full mt-2 w-80 p-3 bg-gray-900 dark:bg-gray-700 text-white text-xs rounded-lg shadow-lg opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all z-50">
					<p class="mb-2">Auto-generated sections (frontends/backends) are hidden and will be preserved on save.</p>
					<p class="mb-2 text-yellow-300">New frontends and backends should be configured in the git repo, not edited here.</p>
					if config != nil {
						<p class="text-gray-300">Last modified: { config.LastModified.Format("2006-01-02 15:04:05") }</p>
						<p class="text-gray-300 font-mono">SHA: { config.SHA256[:12] }...</p>
					}
					<div class="absolute -top-1 right-4 w-2 h-2 bg-gray-900 dark:bg-gray-700 rotate-45"></div>
				</div>
			</div>
			<!-- Config Help button -->
			<a
				href="https://www.haproxy.com/documentation/haproxy-configuration-tutorials/"
				target="_blank"
				rel="noopener noreferrer"
				class="h-[38px] px-4 py-1.5 bg-blue-600 text-white text-sm font-medium rounded-lg hover:bg-blue-700 flex items-center gap-2"
			>
				<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"></path>
				</svg>
				Config Help
			</a>
			<!-- Insert Snippets button -->
			<button
				id="snippets-btn"
				class="h-[38px] px-4 py-1.5 bg-purple-600 text-white text-sm font-medium rounded-lg hover:bg-purple-700 flex items-center gap-2"
			>
				<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v3m0 0v3m0-3h3m-3 0H9m12 0a9 9 0 11-18 0 9 9 0 0118 0z"></path>
				</svg>
				Insert
			</button>
			<!-- Backups button -->
			<button
				id="backup-btn"
				class="h-[38px] px-4 py-1.5 bg-gray-600 text-white text-sm font-medium rounded-lg hover:bg-gray-700 flex items-center gap-2"
			>
				<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path>
				</svg>
				Backups
			</button>
			if canEdit {
				<button
					id="validate-btn"
					class="h-[38px] px-4 py-1.5 bg-yellow-600 text-white text-sm font-medium rounded-lg hover:bg-yellow-700 flex items-center gap-2"
				>
					<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
					</svg>
					Validate
				</button>
				<button
					id="save-btn"
					class="h-[38px] px-4 py-1.5 bg-green-600 text-white text-sm font-medium rounded-lg hover:bg-green-700 flex items-center gap-2"
				>
					<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
					</svg>
					Save & Apply
				</button>
			}
			<!-- Font size slider -->
			<div class="flex items-center gap-2">
				<label class="text-sm font-medium text-gray-700 dark:text-gray-300">Font:</label>
				<input
					type="range"
					id="font-size-slider"
					min="10"
					max="24"
					value="14"
					class="w-20 h-2 bg-gray-200 dark:bg-slate-600 rounded-lg appearance-none cursor-pointer"
				/>
				<span id="font-size-value" class="text-sm text-gray-600 dark:text-gray-400 w-10">14px</span>
			</div>
			<!-- Word wrap toggle -->
			<div class="flex items-center gap-2">
				<span class="text-sm font-medium text-gray-700 dark:text-gray-300">Wrap</span>
				<button
					type="button"
					id="word-wrap-toggle"
					class="relative inline-flex h-6 w-11 flex-shrink-0 cursor-pointer rounded-full border-2 border-transparent bg-gray-200 dark:bg-gray-600 transition-colors duration-200 ease-in-out focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2"
					role="switch"
					aria-checked="false"
				>
					<span
						id="word-wrap-toggle-dot"
						class="pointer-events-none inline-block h-5 w-5 transform rounded-full bg-white shadow ring-0 transition duration-200 ease-in-out translate-x-0"
					></span>
				</button>
			</div>
			<!-- Copy button -->
			<button
				id="copy-config-btn"
				class="p-2 text-gray-600 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-slate-600 rounded transition-colors border border-gray-300 dark:border-slate-600"
				title="Copy to Clipboard"
			>
				<svg id="copy-icon" class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"></path>
				</svg>
			</button>
			<!-- Download button -->
			<button
				id="download-config-btn"
				class="p-2 text-gray-600 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-slate-600 rounded transition-colors border border-gray-300 dark:border-slate-600"
				title="Download Config"
			>
				<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path>
				</svg>
			</button>
			<!-- Fullscreen button -->
			<button
				id="fullscreen-button"
				class="p-2 text-gray-600 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-slate-600 rounded transition-colors border border-gray-300 dark:border-slate-600"
				title="Browser Fullscreen"
			>
				<svg id="fullscreen-icon-normal" class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 8V4m0 0h4M4 4l5 5m11-1V4m0 0h-4m4 0l-5 5M4 16v4m0 0h4m-4 0l5-5m11 5l-5-5m5 5v-4m0 4h-4"></path>
				</svg>
				<svg id="fullscreen-icon-browser" class="w-5 h-5 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 8V4m0 0h4M4 4l5 5m11-1V4m0 0h-4m4 0l-5 5M4 16v4m0 0h4m-4 0l5-5m11 5l-5-5m5 5v-4m0 4h-4"></path>
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7l2 2m6-2l-2 2m-4 4l-2 2m8-2l2 2" opacity="0.5"></path>
				</svg>
				<svg id="fullscreen-icon-true" class="w-5 h-5 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4l4 4M8 4H4v4"></path>
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 4l-4 4M16 4h4v4"></path>
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 20l4-4M8 20H4v-4"></path>
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 20l-4-4M16 20h4v-4"></path>
				</svg>
			</button>
		</div>
	</div>
}
