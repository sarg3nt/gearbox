package pages

import (
	"github.com/sarg3nt/gearbox/internal/framework/models"
	"github.com/sarg3nt/gearbox/internal/framework/templates/layouts"
)

templ SecurityPage(user *models.User, servers []models.BoxConfig, perms *models.UserPermissions) {
	@layouts.Base("Security", user, "/security") {
		<!-- Hidden container for page header content. Title + box selector
		     live in the global header breadcrumb + chip. -->
		<div id="page-header-source" class="hidden">
			<div class="flex-1"></div>
			<div class="flex items-center space-x-3">
				<!-- Refresh button -->
				<button
					id="refresh-btn"
					onclick="refreshSecurityData()"
					class="p-2 rounded-lg transition-colors text-gray-400 hover:text-gray-600 dark:hover:text-gray-300"
					title="Refresh"
				>
					<svg id="refresh-icon" class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path>
					</svg>
				</button>
			</div>
		</div>

		if len(servers) == 0 {
			<div class="bg-yellow-50 dark:bg-yellow-900/20 border border-yellow-200 dark:border-yellow-800 rounded-lg p-4">
				<p class="text-yellow-700 dark:text-yellow-300">No servers configured. Please add a server in settings.</p>
			</div>
		} else {
			<!-- Main content area -->
			<div class="space-y-6">
				<!-- Security Summary Cards -->
				<div id="security-summary" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
					<div class="bg-white dark:bg-slate-800 rounded-lg shadow p-4">
						<div class="flex items-center justify-between">
							<span class="text-sm text-gray-500 dark:text-gray-400">Blocked IPs</span>
							<svg class="w-5 h-5 text-red-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18.364 18.364A9 9 0 005.636 5.636m12.728 12.728A9 9 0 015.636 5.636m12.728 12.728L5.636 5.636"></path>
							</svg>
						</div>
						<p id="blocked-ip-count" class="text-2xl font-bold text-gray-800 dark:text-gray-100 mt-2">-</p>
						<p class="text-xs text-gray-400 mt-1">Currently blocked</p>
					</div>
					<div class="bg-white dark:bg-slate-800 rounded-lg shadow p-4">
						<div class="flex items-center justify-between">
							<span class="text-sm text-gray-500 dark:text-gray-400">Fail2Ban Jails</span>
							<svg class="w-5 h-5 text-orange-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"></path>
							</svg>
						</div>
						<p id="fail2ban-jails" class="text-2xl font-bold text-gray-800 dark:text-gray-100 mt-2">-</p>
						<p class="text-xs text-gray-400 mt-1"><span id="fail2ban-banned">-</span> currently banned</p>
					</div>
					<div class="bg-white dark:bg-slate-800 rounded-lg shadow p-4">
						<div class="flex items-center justify-between">
							<span class="text-sm text-gray-500 dark:text-gray-400">Firewall Status</span>
							<svg class="w-5 h-5 text-green-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path>
							</svg>
						</div>
						<p id="firewall-status" class="text-2xl font-bold text-gray-800 dark:text-gray-100 mt-2">-</p>
						<p class="text-xs text-gray-400 mt-1"><span id="firewall-rules">-</span> rules active</p>
					</div>
					<div class="bg-white dark:bg-slate-800 rounded-lg shadow p-4">
						<div class="flex items-center justify-between">
							<span class="text-sm text-gray-500 dark:text-gray-400">Threats Blocked</span>
							<svg class="w-5 h-5 text-purple-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path>
							</svg>
						</div>
						<p id="threats-blocked" class="text-2xl font-bold text-gray-800 dark:text-gray-100 mt-2">-</p>
						<p class="text-xs text-gray-400 mt-1">Last 24 hours</p>
					</div>
				</div>

				<!-- Block IP Form (only show if user has action permission) -->
				if perms != nil && perms.HasPermission(models.ComponentSecurity, models.PermissionAction) {
					<div class="bg-white dark:bg-slate-800 rounded-lg shadow">
						<div class="p-4 border-b border-gray-200 dark:border-slate-700">
							<h3 class="text-lg font-semibold text-gray-800 dark:text-gray-100">Block IP Address</h3>
							<p class="text-sm text-gray-500 dark:text-gray-400">Manually block an IP address from accessing the server</p>
						</div>
						<div class="p-4">
							<form id="block-ip-form" onsubmit="blockIP(event)" class="flex flex-wrap gap-3 items-end">
								<div class="flex-1 min-w-[200px]">
									<label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">IP Address</label>
									<input
										type="text"
										id="block-ip-address"
										placeholder="192.168.1.100"
										pattern="^(\d{1,3}\.){3}\d{1,3}$"
										required
										class="w-full px-3 py-2 border border-gray-300 dark:border-slate-600 rounded-lg bg-white dark:bg-slate-700 text-gray-700 dark:text-gray-300 focus:outline-none focus:ring-2 focus:ring-blue-500"
									/>
								</div>
								<div class="flex-1 min-w-[200px]">
									<label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Reason</label>
									<input
										type="text"
										id="block-ip-reason"
										placeholder="Suspicious activity"
										required
										class="w-full px-3 py-2 border border-gray-300 dark:border-slate-600 rounded-lg bg-white dark:bg-slate-700 text-gray-700 dark:text-gray-300 focus:outline-none focus:ring-2 focus:ring-blue-500"
									/>
								</div>
								<div class="w-auto">
									<button
										type="submit"
										class="px-4 py-2 bg-red-600 hover:bg-red-700 text-white rounded-lg transition-colors flex items-center gap-2"
									>
										<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
											<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18.364 18.364A9 9 0 005.636 5.636m12.728 12.728A9 9 0 015.636 5.636m12.728 12.728L5.636 5.636"></path>
										</svg>
										Block IP
									</button>
								</div>
							</form>
						</div>
					</div>
				}

				<!-- Blocked IPs Table -->
				<div class="bg-white dark:bg-slate-800 rounded-lg shadow">
					<div class="p-4 border-b border-gray-200 dark:border-slate-700 flex justify-between items-center">
						<div>
							<h3 class="text-lg font-semibold text-gray-800 dark:text-gray-100">Blocked IP Addresses</h3>
							<p class="text-sm text-gray-500 dark:text-gray-400">Currently blocked IPs from the firewall</p>
						</div>
						<div class="flex items-center gap-2">
							<input
								type="text"
								id="blocked-ip-search"
								placeholder="Search IPs..."
								oninput="filterBlockedIPs(this.value)"
								class="w-48 px-3 py-1.5 text-sm border border-gray-300 dark:border-slate-600 rounded-lg bg-white dark:bg-slate-800 text-gray-700 dark:text-gray-300 focus:outline-none focus:ring-2 focus:ring-blue-500"
							/>
						</div>
					</div>
					<div class="overflow-x-auto">
						<table class="w-full text-sm">
							<thead class="bg-gray-50 dark:bg-slate-700">
								<tr>
									<th class="px-4 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-400 uppercase">IP Address</th>
									<th class="px-4 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-400 uppercase">Reason</th>
									<th class="px-4 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-400 uppercase">Blocked At</th>
									<th class="px-4 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-400 uppercase">Blocked By</th>
									<th class="px-4 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-400 uppercase">Expires</th>
									if perms != nil && perms.HasPermission(models.ComponentSecurity, models.PermissionAction) {
										<th class="px-4 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-400 uppercase">Actions</th>
									}
								</tr>
							</thead>
							<tbody id="blocked-ips-table" class="divide-y divide-gray-200 dark:divide-slate-600">
								<tr>
									<td colspan="6" class="px-4 py-8 text-center text-gray-500 dark:text-gray-400">
										Loading...
									</td>
								</tr>
							</tbody>
						</table>
					</div>
				</div>

				<!-- Fail2Ban Jails -->
				<div class="bg-white dark:bg-slate-800 rounded-lg shadow">
					<div class="p-4 border-b border-gray-200 dark:border-slate-700">
						<h3 class="text-lg font-semibold text-gray-800 dark:text-gray-100">Fail2Ban Jails</h3>
						<p class="text-sm text-gray-500 dark:text-gray-400">Active intrusion detection jails and their status</p>
					</div>
					<div class="overflow-x-auto">
						<table class="w-full text-sm">
							<thead class="bg-gray-50 dark:bg-slate-700">
								<tr>
									<th class="px-4 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-400 uppercase">Jail Name</th>
									<th class="px-4 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-400 uppercase">Status</th>
									<th class="px-4 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-400 uppercase">Currently Banned</th>
									<th class="px-4 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-400 uppercase">Total Banned</th>
									<th class="px-4 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-400 uppercase">Total Failed</th>
								</tr>
							</thead>
							<tbody id="fail2ban-jails-table" class="divide-y divide-gray-200 dark:divide-slate-600">
								<tr>
									<td colspan="5" class="px-4 py-8 text-center text-gray-500 dark:text-gray-400">
										Loading...
									</td>
								</tr>
							</tbody>
						</table>
					</div>
				</div>
			</div>
		}

		<script>
		let currentServerID = '';
		let blockedIPsData = [];
		const canAction = { if perms != nil && perms.HasPermission(models.ComponentSecurity, models.PermissionAction) { "true" } else { "false" } } === 'true';

		// extractErrorMessage normalizes the body of a non-2xx fetch response
		// into a user-facing string. errors.WriteHTTPError now returns a JSON
		// envelope `{success:false, message:...}`; older `http.Error` paths
		// still return text/plain. Try JSON first so the toast surfaces
		// .message instead of the raw envelope, then fall back to text.
		async function extractErrorMessage(response) {
			const ct = response.headers.get('content-type') || '';
			if (ct.includes('application/json')) {
				try {
					const body = await response.json();
					return (body && (body.message || body.error)) || JSON.stringify(body);
				} catch (_) {
					return await response.text();
				}
			}
			return await response.text();
		}

		document.addEventListener('DOMContentLoaded', function() {
			const serverInput = document.getElementById('default-server-id');
			if (serverInput) {
				currentServerID = serverInput.value;
				refreshSecurityData();
			}
		});

		function switchServer(serverID) {
			currentServerID = serverID;
			refreshSecurityData();
		}

		async function refreshSecurityData() {
			if (!currentServerID) return;

			const refreshIcon = document.getElementById('refresh-icon');
			if (refreshIcon) refreshIcon.classList.add('animate-spin');

			try {
				await Promise.all([
					loadSecuritySummary(),
					loadBlockedIPs(),
					loadFail2BanStats()
				]);
			} catch (err) {
				console.error('Failed to refresh security data:', err);
			} finally {
				if (refreshIcon) refreshIcon.classList.remove('animate-spin');
			}
		}

		async function loadSecuritySummary() {
			try {
				const response = await fetch('/api/' + currentServerID + '/security/summary');
				if (!response.ok) throw new Error('Failed to load security summary');
				const data = await response.json();

				// Update summary cards
				document.getElementById('firewall-status').textContent = data.firewall_active ? 'Active' : 'Inactive';
				document.getElementById('firewall-rules').textContent = data.firewall_rules || '-';
				document.getElementById('threats-blocked').textContent = data.threats_blocked_24h || 0;
			} catch (err) {
				console.error('Failed to load security summary:', err);
			}
		}

		async function loadBlockedIPs() {
			try {
				var response = await fetch('/api/' + currentServerID + '/security/blocked');
				if (!response.ok) throw new Error('Failed to load blocked IPs');
				var data = await response.json();

				blockedIPsData = data.blocked_ips || [];
				document.getElementById('blocked-ip-count').textContent = data.count || 0;

				renderBlockedIPsTable(blockedIPsData);
			} catch (err) {
				console.error('Failed to load blocked IPs:', err);
				document.getElementById('blocked-ips-table').innerHTML = '<tr><td colspan="6" class="px-4 py-8 text-center text-gray-500 dark:text-gray-400">Failed to load blocked IPs</td></tr>';
			}
		}

		function getUnblockButton(ipAddress) {
			if (!canAction) return '';
			return '<td class="px-4 py-3">' +
				'<button onclick="unblockIP(\'' + escapeHtml(ipAddress) + '\')" class="px-2 py-1 text-xs bg-green-100 dark:bg-green-900/30 hover:bg-green-200 dark:hover:bg-green-900/50 text-green-700 dark:text-green-400 rounded transition-colors">Unblock</button>' +
				'</td>';
		}

		function renderBlockedIPsTable(ips) {
			var tbody = document.getElementById('blocked-ips-table');
			if (!ips || ips.length === 0) {
				tbody.innerHTML = '<tr><td colspan="6" class="px-4 py-8 text-center text-gray-500 dark:text-gray-400">No blocked IPs</td></tr>';
				return;
			}

			tbody.innerHTML = ips.map(function(ip) {
				var blockedAt = ip.blocked_at ? formatDate(ip.blocked_at) : '-';
				var blockedBy = ip.auto_blocked ? '<span class="text-orange-500">Auto</span>' : escapeHtml(ip.blocked_by_username || 'Manual');
				var expires = ip.expires_at ? formatDate(ip.expires_at) : '<span class="text-red-500">Permanent</span>';

				return '<tr class="hover:bg-gray-50 dark:hover:bg-slate-700">' +
					'<td class="px-4 py-3 text-gray-800 dark:text-gray-200 font-mono">' + escapeHtml(ip.ip_address) + '</td>' +
					'<td class="px-4 py-3 text-gray-600 dark:text-gray-400">' + escapeHtml(ip.reason || '-') + '</td>' +
					'<td class="px-4 py-3 text-gray-600 dark:text-gray-400">' + blockedAt + '</td>' +
					'<td class="px-4 py-3 text-gray-600 dark:text-gray-400">' + blockedBy + '</td>' +
					'<td class="px-4 py-3 text-gray-600 dark:text-gray-400">' + expires + '</td>' +
					getUnblockButton(ip.ip_address) +
					'</tr>';
			}).join('');
		}

		function filterBlockedIPs(query) {
			const filtered = blockedIPsData.filter(ip =>
				ip.ip_address.toLowerCase().includes(query.toLowerCase()) ||
				(ip.reason && ip.reason.toLowerCase().includes(query.toLowerCase()))
			);
			renderBlockedIPsTable(filtered);
		}

		async function loadFail2BanStats() {
			try {
				var response = await fetch('/api/' + currentServerID + '/security/fail2ban');
				if (!response.ok) throw new Error('Failed to load fail2ban stats');
				var data = await response.json();

				var jails = data.jails || [];
				document.getElementById('fail2ban-jails').textContent = jails.length;

				var totalBanned = jails.reduce(function(sum, j) { return sum + (j.currently_banned || 0); }, 0);
				document.getElementById('fail2ban-banned').textContent = totalBanned;

				renderFail2BanTable(jails);
			} catch (err) {
				console.error('Failed to load fail2ban stats:', err);
				document.getElementById('fail2ban-jails').textContent = '-';
				document.getElementById('fail2ban-jails-table').innerHTML = '<tr><td colspan="5" class="px-4 py-8 text-center text-gray-500 dark:text-gray-400">Fail2Ban not available</td></tr>';
			}
		}

		function renderFail2BanTable(jails) {
			var tbody = document.getElementById('fail2ban-jails-table');
			if (!jails || jails.length === 0) {
				tbody.innerHTML = '<tr><td colspan="5" class="px-4 py-8 text-center text-gray-500 dark:text-gray-400">No Fail2Ban jails configured</td></tr>';
				return;
			}

			tbody.innerHTML = jails.map(function(jail) {
				var statusClass = jail.active ? 'bg-green-100 dark:bg-green-900/30 text-green-700 dark:text-green-400' : 'bg-gray-100 dark:bg-gray-700 text-gray-600 dark:text-gray-400';
				var statusText = jail.active ? 'Active' : 'Inactive';

				return '<tr class="hover:bg-gray-50 dark:hover:bg-slate-700">' +
					'<td class="px-4 py-3 text-gray-800 dark:text-gray-200 font-medium">' + escapeHtml(jail.name) + '</td>' +
					'<td class="px-4 py-3"><span class="px-2 py-1 text-xs rounded ' + statusClass + '">' + statusText + '</span></td>' +
					'<td class="px-4 py-3 text-gray-600 dark:text-gray-400">' + (jail.currently_banned || 0) + '</td>' +
					'<td class="px-4 py-3 text-gray-600 dark:text-gray-400">' + (jail.total_banned || 0) + '</td>' +
					'<td class="px-4 py-3 text-gray-600 dark:text-gray-400">' + (jail.total_failed || 0) + '</td>' +
					'</tr>';
			}).join('');
		}

		async function blockIP(event) {
			event.preventDefault();

			const ipInput = document.getElementById('block-ip-address');
			const reasonInput = document.getElementById('block-ip-reason');
			const ip = ipInput.value.trim();
			const reason = reasonInput.value.trim();

			if (!ip || !reason) {
				showAlertDialog({ title: 'Missing Information', message: 'Please fill in both IP address and reason', type: 'info' });
				return;
			}

			try {
				const response = await fetch('/api/' + currentServerID + '/security/block', {
					method: 'POST',
					headers: { 'Content-Type': 'application/json' },
					body: JSON.stringify({ ip_address: ip, reason: reason })
				});

				if (!response.ok) {
					throw new Error(await extractErrorMessage(response));
				}

				// Clear form and refresh
				ipInput.value = '';
				reasonInput.value = '';
				await loadBlockedIPs();
			} catch (err) {
				showAlertDialog({ title: 'Error', message: 'Failed to block IP: ' + err.message, type: 'error' });
			}
		}

		async function unblockIP(ip) {
			const confirmed = await showConfirmDialog({
				title: 'Unblock IP',
				message: 'Are you sure you want to unblock ' + ip + '?',
				confirmText: 'Unblock',
				type: 'warning'
			});
			if (!confirmed) return;

			try {
				const response = await fetch('/api/' + currentServerID + '/security/blocked/' + encodeURIComponent(ip), {
					method: 'DELETE'
				});

				if (!response.ok) {
					throw new Error(await extractErrorMessage(response));
				}

				await loadBlockedIPs();
			} catch (err) {
				await showAlertDialog({
					title: 'Error',
					message: 'Failed to unblock IP: ' + err.message,
					type: 'error'
				});
			}
		}

		function formatDate(dateStr) {
			if (!dateStr) return '-';
			const date = new Date(dateStr);
			return date.toLocaleString();
		}

		function escapeHtml(text) {
			if (!text) return '';
			const div = document.createElement('div');
			div.textContent = text;
			return div.innerHTML;
		}
		</script>
	}
}
