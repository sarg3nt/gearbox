							backgroundColor: 'transparent',
							borderWidth: 1.5,
							pointRadius: 0,
							pointHoverRadius: 3,
							tension: 0.4
						},
						{
							label: '5 min',
							data: sampledData.map(d => d.load_average_5),
							borderColor: colors.secondary,
							backgroundColor: 'transparent',
							borderWidth: 1.5,
							pointRadius: 0,
							pointHoverRadius: 3,
							tension: 0.4
						},
						{
							label: '15 min',
							data: sampledData.map(d => d.load_average_15),
							borderColor: colors.purple,
							backgroundColor: 'transparent',
							borderWidth: 1.5,
							pointRadius: 0,
							pointHoverRadius: 3,
