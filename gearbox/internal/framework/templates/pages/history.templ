		function renderMemoryChart(data) {
			const ctx = document.getElementById('memory-chart');
			if (!ctx) return;

			const factor = getDownsampleFactor();
			const sampledData = downsampleData(data, factor);
			const colors = getChartColors();

			charts.memory = new Chart(ctx.getContext('2d'), {
				type: 'line',
				data: {
					labels: sampledData.map(d => formatTime(d.collected_at)),
					datasets: [
						{
							label: 'Memory %',
							data: sampledData.map(d => d.memory_usage_percent),
							borderColor: colors.warning,
							backgroundColor: 'transparent',
							borderWidth: 1.5,
							pointRadius: 0,
							pointHoverRadius: 3,
							tension: 0.4
						}
					]
				},
				options: {
					...createChartOptions(0),
					scales: {
						...createChartOptions(0).scales,
						y: {
							min: 0,
							max: 100,
							ticks: { color: getChartColors().text },
							grid: { color: getChartColors().grid }
						}
					}
				}
			});
		}

		function renderNetworkChart(data) {
			const ctx = document.getElementById('network-chart');
			if (!ctx) return;

			const factor = getDownsampleFactor();
			const sampledData = downsampleData(data, factor);
			const colors = getChartColors();

			// Calculate throughput (delta between consecutive points) in Mbps
			const rxRate = [];
			const txRate = [];
			const labels = [];

			for (let i = 1; i < sampledData.length; i++) {
				const prev = sampledData[i - 1];
				const curr = sampledData[i];

				// Calculate time difference in seconds
				const timeDiff = (new Date(curr.collected_at) - new Date(prev.collected_at)) / 1000;
				if (timeDiff <= 0) continue;

				// Calculate byte difference and convert to Mbps (megabits per second)
				const rxDiff = curr.network_rx_bytes - prev.network_rx_bytes;
				const txDiff = curr.network_tx_bytes - prev.network_tx_bytes;

				// Handle counter resets (when diff is negative)
				// Convert bytes/s to megabits/s: bytes * 8 / 1,000,000
				const rxMbps = rxDiff >= 0 ? (rxDiff * 8 / 1000000) / timeDiff : 0;
				const txMbps = txDiff >= 0 ? (txDiff * 8 / 1000000) / timeDiff : 0;

				rxRate.push(rxMbps);
				txRate.push(txMbps);
				labels.push(formatTime(curr.collected_at));
			}

			charts.network = new Chart(ctx.getContext('2d'), {
				type: 'line',
				data: {
					labels: labels,
					datasets: [
						{
							label: 'RX (Mbps)',
							data: rxRate,
							borderColor: colors.primary,
							backgroundColor: 'transparent',
							borderWidth: 1.5,
							pointRadius: 0,
							pointHoverRadius: 3,
							tension: 0.4
						},
						{
							label: 'TX (Mbps)',
							data: txRate,
							borderColor: colors.purple,
							backgroundColor: 'transparent',
							borderWidth: 1.5,
							pointRadius: 0,
							pointHoverRadius: 3,
							tension: 0.4
						}
					]
				},
				options: createChartOptions(0)
			});
		}

