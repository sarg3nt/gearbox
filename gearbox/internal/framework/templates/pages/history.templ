package pages

import "github.com/sarg3nt/gearbox/internal/framework/models"
import "github.com/sarg3nt/gearbox/internal/framework/templates/layouts"
import "github.com/sarg3nt/gearbox/internal/framework/templates/components"

templ History(user *models.User, servers []models.BoxConfig) {
	@layouts.Base("Metrics", user, "/history") {
		<!-- Hidden container for page header content - will be moved to main header via JS -->
		<div id="page-header-source" class="hidden">
			<!-- Left side: Title with integrated server selector -->
			<div class="flex items-center">
				<h2 class="text-xl font-bold text-gray-800 dark:text-gray-100">
					Metrics
					if len(servers) > 1 {
						<span class="text-gray-400 dark:text-gray-500 mx-2">:</span>
						<span class="inline-block relative">
							<select
								id="server-select"
								class="appearance-none bg-transparent text-xl font-bold text-gray-800 dark:text-gray-100 pr-7 cursor-pointer focus:outline-none hover:text-blue-600 dark:hover:text-blue-400 transition-colors"
								onchange="loadHistoryData()"
							>
								for _, server := range servers {
									<option value={ server.ID }>{ server.Name }</option>
								}
							</select>
							<!-- Subtle dropdown indicator -->
							<svg class="absolute right-0 top-1/2 -translate-y-1/2 w-4 h-4 text-gray-400 dark:text-gray-500 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
							</svg>
						</span>
					} else if len(servers) == 1 {
						<span class="text-gray-400 dark:text-gray-500 mx-2">:</span>
						<span id="single-server-name">{ servers[0].Name }</span>
					}
				</h2>
			</div>
			<!-- Right side spacer -->
			<div class="flex-1"></div>
			<!-- Controls -->
			<div class="flex items-center space-x-3">
				<!-- Time Range -->
				<select
					id="hours-select"
					class="h-[38px] px-3 py-1.5 text-sm border border-gray-300 dark:border-slate-600 rounded-lg bg-white dark:bg-slate-800 text-gray-700 dark:text-gray-300 focus:outline-none focus:ring-2 focus:ring-blue-500"
					onchange="loadHistoryData()"
				>
					<option value="0.083">Last 5 min</option>
					<option value="0.5">Last 30 min</option>
					<option value="1">Last 1 hour</option>
					<option value="6">Last 6 hours</option>
					<option value="24" selected>Last 24 hours</option>
					<option value="72">Last 3 days</option>
					<option value="168">Last 7 days</option>
				</select>

				<!-- Resolution slider -->
				<div class="flex items-center gap-2">
					<label class="text-sm font-medium text-gray-700 dark:text-gray-300">Resolution:</label>
					<input
						type="range"
						id="resolution-slider"
						min="1"
						max="10"
						value="5"
						class="w-20 h-2 bg-gray-200 dark:bg-slate-600 rounded-lg appearance-none cursor-pointer"
						onchange="loadHistoryData()"
					/>
					<span id="resolution-label" class="text-sm text-gray-600 dark:text-gray-400 w-14">Medium</span>
				</div>

				<!-- Reset Zoom button (hidden by default) -->
				<button
					id="reset-zoom-btn"
					onclick="resetAllZoom()"
					class="hidden h-[38px] px-3 py-1.5 text-sm bg-gray-200 dark:bg-slate-600 text-gray-700 dark:text-gray-200 rounded-lg hover:bg-gray-300 dark:hover:bg-slate-500 transition-colors font-medium"
				>
					Reset Zoom
				</button>

				<!-- Manual Refresh button with SSE status indicator -->
				<button
					id="refresh-btn"
					onclick="manualRefresh()"
					class="p-2 rounded-lg transition-colors text-gray-400"
					title="Connecting..."
				>
					<svg id="refresh-icon" class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path>
					</svg>
				</button>
			</div>
		</div>

		<!-- Hidden server ID for single-server mode -->
		if len(servers) > 0 {
			<input type="hidden" id="default-server-id" value={ servers[0].ID }/>
		}

		if len(servers) == 0 {
			@components.InfoAlert("No servers configured.")
		} else {
			<div class="bg-white dark:bg-slate-800 rounded-lg shadow-lg p-6 mb-6">

				<!-- Charts Grid - 4 columns on 2xl, 3 on xl, 2 on lg, 1 on smaller -->
				<div id="charts-grid" class="grid grid-cols-1 lg:grid-cols-2 xl:grid-cols-3 2xl:grid-cols-4 gap-4">
					<!-- Sessions & Requests -->
					<div id="card-sessions" class="chart-card bg-gray-50 dark:bg-slate-700 rounded-lg p-4 relative">
						<div class="flex justify-between items-center mb-2">
							<h4 class="text-lg font-medium text-gray-700 dark:text-gray-300">Sessions & Requests</h4>
							<button onclick="toggleFullscreen('card-sessions')" class="fullscreen-btn p-1 hover:bg-gray-200 dark:hover:bg-slate-600 rounded transition-colors" title="Toggle fullscreen">
								<svg class="w-5 h-5 text-gray-500 dark:text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 8V4m0 0h4M4 4l5 5m11-1V4m0 0h-4m4 0l-5 5M4 16v4m0 0h4m-4 0l5-5m11 5l-5-5m5 5v-4m0 4h-4"></path>
								</svg>
							</button>
						</div>
						<div class="chart-aspect-container">
							<canvas id="sessions-chart"></canvas>
						</div>
					</div>

					<!-- Server Health -->
					<div id="card-health" class="chart-card bg-gray-50 dark:bg-slate-700 rounded-lg p-4 relative">
						<div class="flex justify-between items-center mb-2">
							<h4 class="text-lg font-medium text-gray-700 dark:text-gray-300">Server Health</h4>
							<button onclick="toggleFullscreen('card-health')" class="fullscreen-btn p-1 hover:bg-gray-200 dark:hover:bg-slate-600 rounded transition-colors" title="Toggle fullscreen">
								<svg class="w-5 h-5 text-gray-500 dark:text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 8V4m0 0h4M4 4l5 5m11-1V4m0 0h-4m4 0l-5 5M4 16v4m0 0h4m-4 0l5-5m11 5l-5-5m5 5v-4m0 4h-4"></path>
								</svg>
							</button>
						</div>
						<div class="chart-aspect-container">
							<canvas id="health-chart"></canvas>
						</div>
					</div>

					<!-- CPU Load -->
					<div id="card-cpu" class="chart-card bg-gray-50 dark:bg-slate-700 rounded-lg p-4 relative">
						<div class="flex justify-between items-center mb-2">
							<h4 class="text-lg font-medium text-gray-700 dark:text-gray-300">CPU Load</h4>
							<button onclick="toggleFullscreen('card-cpu')" class="fullscreen-btn p-1 hover:bg-gray-200 dark:hover:bg-slate-600 rounded transition-colors" title="Toggle fullscreen">
								<svg class="w-5 h-5 text-gray-500 dark:text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 8V4m0 0h4M4 4l5 5m11-1V4m0 0h-4m4 0l-5 5M4 16v4m0 0h4m-4 0l5-5m11 5l-5-5m5 5v-4m0 4h-4"></path>
								</svg>
							</button>
						</div>
						<div class="chart-aspect-container">
							<canvas id="cpu-chart"></canvas>
						</div>
					</div>

					<!-- Memory Usage -->
					<div id="card-memory" class="chart-card bg-gray-50 dark:bg-slate-700 rounded-lg p-4 relative">
						<div class="flex justify-between items-center mb-2">
							<h4 class="text-lg font-medium text-gray-700 dark:text-gray-300">Memory Usage</h4>
							<button onclick="toggleFullscreen('card-memory')" class="fullscreen-btn p-1 hover:bg-gray-200 dark:hover:bg-slate-600 rounded transition-colors" title="Toggle fullscreen">
								<svg class="w-5 h-5 text-gray-500 dark:text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 8V4m0 0h4M4 4l5 5m11-1V4m0 0h-4m4 0l-5 5M4 16v4m0 0h4m-4 0l5-5m11 5l-5-5m5 5v-4m0 4h-4"></path>
								</svg>
							</button>
						</div>
						<div class="chart-aspect-container">
							<canvas id="memory-chart"></canvas>
						</div>
					</div>

					<!-- Network Traffic -->
					<div id="card-network" class="chart-card bg-gray-50 dark:bg-slate-700 rounded-lg p-4 relative">
						<div class="flex justify-between items-center mb-2">
							<h4 class="text-lg font-medium text-gray-700 dark:text-gray-300">Network Throughput</h4>
							<button onclick="toggleFullscreen('card-network')" class="fullscreen-btn p-1 hover:bg-gray-200 dark:hover:bg-slate-600 rounded transition-colors" title="Toggle fullscreen">
								<svg class="w-5 h-5 text-gray-500 dark:text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 8V4m0 0h4M4 4l5 5m11-1V4m0 0h-4m4 0l-5 5M4 16v4m0 0h4m-4 0l5-5m11 5l-5-5m5 5v-4m0 4h-4"></path>
								</svg>
							</button>
						</div>
						<div class="chart-aspect-container">
							<canvas id="network-chart"></canvas>
						</div>
					</div>

					<!-- Response Times -->
					<div id="card-response-time" class="chart-card bg-gray-50 dark:bg-slate-700 rounded-lg p-4 relative">
						<div class="flex justify-between items-center mb-2">
							<h4 class="text-lg font-medium text-gray-700 dark:text-gray-300">Response Times</h4>
							<button onclick="toggleFullscreen('card-response-time')" class="fullscreen-btn p-1 hover:bg-gray-200 dark:hover:bg-slate-600 rounded transition-colors" title="Toggle fullscreen">
								<svg class="w-5 h-5 text-gray-500 dark:text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 8V4m0 0h4M4 4l5 5m11-1V4m0 0h-4m4 0l-5 5M4 16v4m0 0h4m-4 0l5-5m11 5l-5-5m5 5v-4m0 4h-4"></path>
								</svg>
							</button>
						</div>
						<div class="chart-aspect-container">
							<canvas id="response-time-chart"></canvas>
						</div>
					</div>

					<!-- Error Rates -->
					<div id="card-errors" class="chart-card bg-gray-50 dark:bg-slate-700 rounded-lg p-4 relative">
						<div class="flex justify-between items-center mb-2">
							<h4 class="text-lg font-medium text-gray-700 dark:text-gray-300">Error Rates (5xx)</h4>
							<button onclick="toggleFullscreen('card-errors')" class="fullscreen-btn p-1 hover:bg-gray-200 dark:hover:bg-slate-600 rounded transition-colors" title="Toggle fullscreen">
								<svg class="w-5 h-5 text-gray-500 dark:text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 8V4m0 0h4M4 4l5 5m11-1V4m0 0h-4m4 0l-5 5M4 16v4m0 0h4m-4 0l5-5m11 5l-5-5m5 5v-4m0 4h-4"></path>
								</svg>
							</button>
						</div>
						<div class="chart-aspect-container">
							<canvas id="errors-chart"></canvas>
						</div>
					</div>
				</div>
			</div>

			<!-- Recent Incidents -->
			<div class="bg-white dark:bg-slate-800 rounded-lg shadow-lg p-6">
				<h3 class="text-xl font-semibold text-gray-800 dark:text-gray-100 mb-4">Recent Incidents</h3>
				<div id="incidents-container">
					<p class="text-gray-500 dark:text-gray-400">Loading incidents...</p>
				</div>
			</div>
		}

		<style>
		.chart-aspect-container {
			position: relative;
			width: 100%;
			height: 0;
			padding-bottom: 72%; /* taller aspect ratio */
		}
		.chart-aspect-container canvas {
			position: absolute;
			top: 0;
			left: 0;
			width: 100% !important;
			height: 100% !important;
		}
		.chart-card.fullscreen {
			position: fixed !important;
			top: 0 !important;
			left: 0 !important;
			right: 0 !important;
			bottom: 0 !important;
			width: 100vw !important;
			height: 100vh !important;
			z-index: 9999 !important;
			border-radius: 0 !important;
			margin: 0 !important;
			padding: 2rem !important;
			display: flex !important;
			flex-direction: column !important;
		}
		.chart-card.fullscreen .chart-aspect-container {
			padding-bottom: 0 !important;
			height: 100% !important;
			flex: 1 !important;
		}
		</style>

		<script>
		let charts = {};
		let currentFullscreenCard = null;
		let cachedStatsData = [];
		let cachedMetricsData = [];
		let eventSource = null;

		function getChartColors() {
			const isDark = document.documentElement.classList.contains('dark');
			return {
				text: isDark ? '#e2e8f0' : '#374151',
				grid: isDark ? '#475569' : '#e5e7eb',
				primary: '#3b82f6',
				secondary: '#10b981',
				warning: '#f59e0b',
				danger: '#ef4444',
				purple: '#8b5cf6',
				cyan: '#06b6d4'
			};
		}

		function getZoomOptions() {
			return {
				zoom: {
					drag: {
						enabled: true,
						backgroundColor: 'rgba(59, 130, 246, 0.1)',
						borderColor: 'rgba(59, 130, 246, 0.5)',
						borderWidth: 1
					},
					mode: 'x',
					onZoomComplete: function() {
						showResetZoomButton();
					}
				},
				pan: {
					enabled: true,
					mode: 'x',
					modifierKey: 'shift'
				}
			};
		}

		function createChartOptions(minY = undefined) {
			const colors = getChartColors();
			return {
				responsive: true,
				maintainAspectRatio: false,
				plugins: {
					legend: {
						labels: { color: colors.text }
					},
					zoom: getZoomOptions()
				},
				scales: {
					x: {
						ticks: {
							color: colors.text,
							maxTicksLimit: 8
						},
						grid: { color: colors.grid }
					},
					y: {
						min: minY,
						ticks: { color: colors.text },
						grid: { color: colors.grid }
					}
				}
			};
		}

		function createIntegerYAxisOptions() {
			const colors = getChartColors();
			return {
				responsive: true,
				maintainAspectRatio: false,
				plugins: {
					legend: {
						labels: { color: colors.text }
					},
					zoom: getZoomOptions()
				},
				scales: {
					x: {
						ticks: {
							color: colors.text,
							maxTicksLimit: 8
						},
						grid: { color: colors.grid }
					},
					y: {
						min: 0,
						ticks: {
							color: colors.text,
							stepSize: 1,
							callback: function(value) {
								if (Math.floor(value) === value) {
									return value;
								}
							}
						},
						grid: { color: colors.grid }
					}
				}
			};
		}

		function destroyCharts() {
			Object.values(charts).forEach(chart => chart.destroy());
			charts = {};
		}

		function showResetZoomButton() {
			const btn = document.getElementById('reset-zoom-btn');
			if (btn) btn.classList.remove('hidden');
		}

		function hideResetZoomButton() {
			const btn = document.getElementById('reset-zoom-btn');
			if (btn) btn.classList.add('hidden');
		}

		function resetAllZoom() {
			Object.values(charts).forEach(chart => {
				if (chart.resetZoom) {
					chart.resetZoom();
				}
			});
			hideResetZoomButton();
		}

		function formatTime(timestamp) {
			const date = new Date(timestamp);
			return date.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
		}

		function formatBytes(bytes) {
			if (bytes === 0) return '0 B';
			const k = 1024;
			const sizes = ['B', 'KB', 'MB', 'GB', 'TB'];
			const i = Math.floor(Math.log(Math.abs(bytes)) / Math.log(k));
			return parseFloat((bytes / Math.pow(k, i)).toFixed(2)) + ' ' + sizes[i];
		}

		function getResolutionLabel(value) {
			// Slider is inverted: 1 = lowest resolution, 10 = highest resolution
			const labels = {
				1: 'Lowest',
				2: 'Lowest',
				3: 'Low',
				4: 'Low',
				5: 'Medium',
				6: 'Medium',
				7: 'High',
				8: 'High',
				9: 'Highest',
				10: 'Highest'
			};
			return labels[value] || 'Medium';
		}

		function updateResolutionLabel() {
			const slider = document.getElementById('resolution-slider');
			const label = document.getElementById('resolution-label');
			if (slider && label) {
				label.textContent = getResolutionLabel(parseInt(slider.value));
			}
		}

		function downsampleData(data, factor) {
			if (factor <= 1 || data.length <= 20) return data;
			const result = [];
			for (let i = 0; i < data.length; i += factor) {
				result.push(data[i]);
			}
			// Always include the last point
			if (result[result.length - 1] !== data[data.length - 1]) {
				result.push(data[data.length - 1]);
			}
			return result;
		}

		function toggleFullscreen(cardId) {
			const card = document.getElementById(cardId);
			const chartsGrid = document.getElementById('charts-grid');
			const chartKey = getChartKey(cardId);

			if (card.classList.contains('fullscreen')) {
				// Exit fullscreen
				card.classList.remove('fullscreen');
				// Show all other cards
				chartsGrid.querySelectorAll('.chart-card').forEach(c => {
					if (c.id !== cardId) {
						c.classList.remove('hidden');
					}
				});
				currentFullscreenCard = null;

				// Recreate all charts to fix sizing issues
				setTimeout(() => {
					destroyCharts();
					renderAllCharts();
				}, 50);
			} else {
				// Enter fullscreen
				card.classList.add('fullscreen');
				// Hide all other cards
				chartsGrid.querySelectorAll('.chart-card').forEach(c => {
					if (c.id !== cardId) {
						c.classList.add('hidden');
					}
				});
				currentFullscreenCard = cardId;

				// Resize chart to fit new container size
				if (charts[chartKey]) {
					setTimeout(() => charts[chartKey].resize(), 100);
				}
			}
		}

		function getChartKey(cardId) {
			const mapping = {
				'card-sessions': 'sessions',
				'card-health': 'health',
				'card-cpu': 'cpu',
				'card-memory': 'memory',
				'card-network': 'network',
				'card-response-time': 'responseTime',
				'card-errors': 'errors'
			};
			return mapping[cardId];
		}

		// Handle Escape key to exit fullscreen
		document.addEventListener('keydown', function(e) {
			if (e.key === 'Escape' && currentFullscreenCard) {
				toggleFullscreen(currentFullscreenCard);
			}
		});

		function renderAllCharts() {
			hideResetZoomButton();
			renderSessionsChart(cachedStatsData);
			renderHealthChart(cachedStatsData);
			renderCpuChart(cachedMetricsData);
			renderMemoryChart(cachedMetricsData);
			renderNetworkChart(cachedMetricsData);
			renderResponseTimeChart(cachedStatsData);
			renderErrorsChart(cachedStatsData);
		}

		// Get current server ID - handles both multi-server (select) and single-server (hidden input) modes
		function getServerID() {
			const selector = document.getElementById('server-select');
			if (selector) return selector.value;
			const defaultServer = document.getElementById('default-server-id');
			if (defaultServer) return defaultServer.value;
			return '';
		}

		async function loadHistoryData() {
			updateResolutionLabel();
			const serverID = getServerID();
			const hours = document.getElementById('hours-select').value;

			if (!serverID) {
				console.error('No server ID available');
				return;
			}

			try {
				// Fetch stats history
				const statsResponse = await fetch(`/api/${serverID}/history/stats?hours=${hours}`);
				const statsData = await statsResponse.json();

				// Fetch system metrics history
				const metricsResponse = await fetch(`/api/${serverID}/history/metrics?hours=${hours}`);
				const metricsData = await metricsResponse.json();

				// Fetch incidents
				const incidentsResponse = await fetch(`/api/${serverID}/incidents?limit=20`);
				const incidentsData = await incidentsResponse.json();

				// Cache the data for fullscreen toggle
				cachedStatsData = statsData.data || [];
				cachedMetricsData = metricsData.data || [];

				// Render charts
				destroyCharts();
				renderAllCharts();
				renderIncidents(incidentsData.incidents || []);

				// Setup SSE connection for real-time updates
				setupSSE(serverID);

			} catch (error) {
				console.error('Failed to load history data:', error);
			}
		}

		function setupSSE(serverID) {
			// Close existing connection
			if (eventSource) {
				eventSource.close();
			}

			eventSource = new EventSource(`/api/events?server=${serverID}`);

			eventSource.onopen = function() {
				updateConnectionStatus(true);
			};

			eventSource.onerror = function() {
				updateConnectionStatus(false);
			};

			eventSource.addEventListener('stats.updated', function(e) {
				try {
					const data = JSON.parse(e.data);
					console.log('stats.updated event:', data);
					if (data.server_id === serverID) {
						// Add new data point to cache and re-render
						appendStatsData(data);
					}
				} catch (err) {
					console.error('Failed to parse stats event:', err);
				}
			});

			eventSource.addEventListener('metrics.updated', function(e) {
				try {
					const data = JSON.parse(e.data);
					console.log('metrics.updated event:', data);
					if (data.server_id === serverID) {
						// Add new data point to cache and re-render
						appendMetricsData(data);
					}
				} catch (err) {
					console.error('Failed to parse metrics event:', err);
				}
			});
		}

		function updateConnectionStatus(connected) {
			const btn = document.getElementById('refresh-btn');
			if (!btn) return;

			// Remove all status classes
			btn.classList.remove('text-green-500', 'text-red-500', 'text-yellow-500', 'text-gray-400');

			if (connected) {
				btn.classList.add('text-green-500');
				btn.title = 'Live - streaming data';
			} else {
				btn.classList.add('text-red-500');
				btn.title = 'Disconnected - click to reconnect';
			}
		}

		function manualRefresh() {
			const icon = document.getElementById('refresh-icon');
			if (icon) {
				icon.classList.add('animate-spin');
				setTimeout(() => icon.classList.remove('animate-spin'), 1000);
			}
			loadHistoryData();
		}

		function appendStatsData(newData) {
			// The SSE event structure is: { type, server_id, timestamp, data: { stats: {...} } }
			// We need to aggregate them to match the historical data format
			const eventData = newData.data || {};
			const stats = eventData.stats || {};
			const frontends = stats.frontends || [];
			const backends = stats.backends || [];

			console.log('appendStatsData - eventData:', eventData);
			console.log('appendStatsData - frontends:', frontends.length, 'backends:', backends.length);

			// Aggregate stats from frontends and backends
			let totalSessions = 0;
			let totalRequests = 0;
			let total5xxErrors = 0;
			let totalResponseTime = 0;
			let responseTimeCount = 0;
			let totalServers = 0;
			let healthyServers = 0;

			// Sum up frontend stats
			frontends.forEach(f => {
				totalSessions += f.scur || 0;
				totalRequests += f.req_tot || 0;
				total5xxErrors += f.hrsp_5xx || 0;
			});

			// Sum up backend stats
			backends.forEach(b => {
				totalSessions += b.scur || 0;
				totalRequests += b.req_tot || 0;
				total5xxErrors += b.hrsp_5xx || 0;
				if (b.rtime > 0) {
					totalResponseTime += b.rtime;
					responseTimeCount++;
				}
				// Count servers from backends
				totalServers += b.total_servers || 0;
				healthyServers += (b.total_servers || 0) - (b.down_servers || 0);
			});

			const avgResponseTime = responseTimeCount > 0 ? totalResponseTime / responseTimeCount : 0;

			const point = {
				collected_at: new Date().toISOString(),
				total_sessions: totalSessions,
				total_requests: totalRequests,
				total_servers: totalServers,
				healthy_servers: healthyServers,
				avg_response_time: avgResponseTime,
				total_5xx_errors: total5xxErrors
			};

			// Skip if no backends/frontends were found (empty stats)
			if (frontends.length === 0 && backends.length === 0) {
				console.log('Skipping empty stats data point');
				return;
			}

			cachedStatsData.push(point);

			// Keep data within time window
			const hours = parseFloat(document.getElementById('hours-select').value);
			const cutoff = new Date(Date.now() - hours * 60 * 60 * 1000);
			cachedStatsData = cachedStatsData.filter(d => new Date(d.collected_at) > cutoff);

			// Update charts in place (no animation)
			const factor = getDownsampleFactor();
			const sampledData = downsampleData(cachedStatsData, factor);

			if (charts.sessions) {
				updateChartData(charts.sessions, sampledData, [
					sampledData.map(d => d.total_sessions),
					sampledData.map(d => Math.round(d.total_requests / 1000))
				]);
			}
			if (charts.health) {
				updateChartData(charts.health, sampledData, [
					sampledData.map(d => d.healthy_servers),
					sampledData.map(d => d.total_servers)
				]);
			}
			if (charts.responseTime) {
				updateChartData(charts.responseTime, sampledData, [
					sampledData.map(d => d.avg_response_time)
				]);
			}
			if (charts.errors) {
				updateChartData(charts.errors, sampledData, [
					sampledData.map(d => d.total_5xx_errors)
				]);
			}
		}

		function appendMetricsData(newData) {
			// The SSE event structure is: { type, server_id, timestamp, data: { metrics: {...} } }
			const eventData = newData.data || {};
			const metrics = eventData.metrics || {};

			console.log('appendMetricsData - eventData:', eventData);
			console.log('appendMetricsData - metrics:', metrics);
			const point = {
				collected_at: new Date().toISOString(),
				// Database uses snake_case, match that format
				load_average_1: metrics.load_average_1 || 0,
				load_average_5: metrics.load_average_5 || 0,
				load_average_15: metrics.load_average_15 || 0,
				memory_usage_percent: metrics.memory_usage_percent || 0,
				network_rx_bytes: metrics.network_rx_bytes || 0,
				network_tx_bytes: metrics.network_tx_bytes || 0
			};

			// Skip if all values are zero (no real data)
			if (point.load_average_1 === 0 && point.load_average_5 === 0 &&
				point.memory_usage_percent === 0 && point.network_rx_bytes === 0) {
				console.log('Skipping empty metrics data point');
				return;
			}

			cachedMetricsData.push(point);

			// Keep data within time window
			const hours = parseFloat(document.getElementById('hours-select').value);
			const cutoff = new Date(Date.now() - hours * 60 * 60 * 1000);
			cachedMetricsData = cachedMetricsData.filter(d => new Date(d.collected_at) > cutoff);

			// Update charts in place (no animation)
			const factor = getDownsampleFactor();
			const sampledData = downsampleData(cachedMetricsData, factor);

			if (charts.cpu) {
				updateChartData(charts.cpu, sampledData, [
					sampledData.map(d => d.load_average_1),
					sampledData.map(d => d.load_average_5),
					sampledData.map(d => d.load_average_15)
				]);
			}
			if (charts.memory) {
				updateChartData(charts.memory, sampledData, [
					sampledData.map(d => d.memory_usage_percent)
				]);
			}
			if (charts.network) {
				// Network needs special handling for rate calculation
				updateNetworkChart(sampledData);
			}
		}

		function getDownsampleFactor() {
			const slider = document.getElementById('resolution-slider');
			// Invert: slider 10 (highest res) = factor 1 (no downsampling)
			//         slider 1 (lowest res) = factor 10 (max downsampling)
			const sliderValue = slider ? parseInt(slider.value) : 5;
			return 11 - sliderValue;
		}

		// Update chart data in place without animation
		function updateChartData(chart, sampledData, datasets) {
			chart.data.labels = sampledData.map(d => formatTime(d.collected_at));
			datasets.forEach((data, index) => {
				if (chart.data.datasets[index]) {
					chart.data.datasets[index].data = data;
				}
			});
			chart.update('none'); // 'none' disables animation
		}

		// Special update for network chart (rate calculation)
		function updateNetworkChart(sampledData) {
			const rxRate = [];
			const txRate = [];
			const labels = [];

			for (let i = 1; i < sampledData.length; i++) {
				const prev = sampledData[i - 1];
				const curr = sampledData[i];
				const timeDiff = (new Date(curr.collected_at) - new Date(prev.collected_at)) / 1000;
				if (timeDiff <= 0) continue;

				const rxDiff = curr.network_rx_bytes - prev.network_rx_bytes;
				const txDiff = curr.network_tx_bytes - prev.network_tx_bytes;
				// Convert bytes/s to megabits/s: bytes * 8 / 1,000,000
				const rxMbps = rxDiff >= 0 ? (rxDiff * 8 / 1000000) / timeDiff : 0;
				const txMbps = txDiff >= 0 ? (txDiff * 8 / 1000000) / timeDiff : 0;

				rxRate.push(rxMbps);
				txRate.push(txMbps);
				labels.push(formatTime(curr.collected_at));
			}

			charts.network.data.labels = labels;
			charts.network.data.datasets[0].data = rxRate;
			charts.network.data.datasets[1].data = txRate;
			charts.network.update('none');
		}

		function renderSessionsChart(data) {
			const ctx = document.getElementById('sessions-chart');
			if (!ctx) return;

			const factor = getDownsampleFactor();
			const sampledData = downsampleData(data, factor);
			const colors = getChartColors();

			charts.sessions = new Chart(ctx.getContext('2d'), {
				type: 'line',
				data: {
					labels: sampledData.map(d => formatTime(d.collected_at)),
					datasets: [
						{
							label: 'Sessions',
							data: sampledData.map(d => d.total_sessions),
							borderColor: colors.primary,
							backgroundColor: 'transparent',
							borderWidth: 1.5,
							pointRadius: 0,
							pointHoverRadius: 3,
							tension: 0.4
						},
						{
							label: 'Requests (÷1000)',
							data: sampledData.map(d => Math.round(d.total_requests / 1000)),
							borderColor: colors.secondary,
							backgroundColor: 'transparent',
							borderWidth: 1.5,
							pointRadius: 0,
							pointHoverRadius: 3,
							tension: 0.4
						}
					]
				},
				options: createChartOptions(0)
			});
		}

