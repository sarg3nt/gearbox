package pages

import (
	"github.com/sarg3nt/gearbox/internal/framework/agent"
	"github.com/sarg3nt/gearbox/internal/framework/database"
	"github.com/sarg3nt/gearbox/internal/framework/models"
	"github.com/sarg3nt/gearbox/internal/framework/templates/layouts"
)

// FirewallConfigPage renders the firewall configuration editor page.
templ FirewallConfigPage(user *models.User, server *database.BoxDB, config *agent.FirewallConfigResponse, gitConfig *database.BoxGitConfig, changes []database.ConfigChange, canEdit bool) {
	@layouts.Base("Firewall Configuration", user, "/config/firewall") {
		<!-- Action toolbar hoisted to the global page header (right of the
		     breadcrumb). Buttons are sized to match the 38px row the rest of
		     our gear toolbars use. -->
		<div id="page-header-source" class="hidden">
			<div class="flex-1"></div>
			<div class="flex items-center space-x-3">
				if config != nil {
					<div class="hidden xl:flex items-center gap-3 text-xs text-gray-500 dark:text-gray-400 mr-2">
						<span title="File last modified">{ config.LastModified.Format("2006-01-02 15:04:05") }</span>
						<span class="font-mono">SHA { config.SHA256[:12] }</span>
					</div>
				}
				if canEdit {
					<button id="firewall-validate-btn" class="h-[38px] px-4 py-1.5 bg-yellow-600 text-white text-sm font-medium rounded-lg hover:bg-yellow-700 flex items-center gap-2">
						<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
						</svg>
						Validate
					</button>
					<button id="firewall-save-btn" class="h-[38px] px-4 py-1.5 bg-green-600 text-white text-sm font-medium rounded-lg hover:bg-green-700 flex items-center gap-2">
						<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
						</svg>
						Save &amp; Apply
					</button>
				}
				<button id="firewall-backups-btn" class="h-[38px] px-4 py-1.5 bg-gray-600 text-white text-sm font-medium rounded-lg hover:bg-gray-700 flex items-center gap-2">
					<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path>
					</svg>
					Backups
				</button>
				<a href="https://wiki.nftables.org/wiki-nftables/index.php/Main_Page" target="_blank" rel="noopener noreferrer" class="h-[38px] px-4 py-1.5 bg-blue-600 text-white text-sm font-medium rounded-lg hover:bg-blue-700 flex items-center gap-2">
					<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"></path>
					</svg>
					nftables Wiki
				</a>
				<button id="firewall-wrap-btn" type="button" class="h-[38px] px-3 py-1.5 text-sm border border-gray-300 dark:border-slate-600 rounded-lg bg-white dark:bg-slate-800 text-gray-700 dark:text-gray-300 hover:bg-gray-50 dark:hover:bg-slate-700 flex items-center gap-2" title="Toggle line wrap" aria-pressed="false">
					<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 6h18M3 12h15a3 3 0 010 6h-4m0 0l3-3m-3 3l3 3"></path>
					</svg>
					Wrap
				</button>
			</div>
		</div>

		<!-- Hidden inputs ferry Go values to the JS below. templ does NOT
		     interpolate `{ ... }` inside <script> blocks (they render as
		     literal text), so we read these from the DOM instead. -->
		<input type="hidden" id="firewall-server-id" value={ server.BoxID }/>
		<input type="hidden" id="firewall-config-sha" value={ config.SHA256 }/>
		<input type="hidden" id="firewall-can-edit" value={ canEditValue(canEdit) }/>
		<textarea id="firewall-config-source" class="hidden">{ config.Content }</textarea>
		<!-- Section nav data ferried as a textarea (NOT a <script type="application/json">)
		     because templ doesn't interpolate `{ ... }` inside <script> blocks. -->
		<textarea id="firewall-sections-data" class="hidden">{ sectionsJSON(config.Sections) }</textarea>

		<!-- Full-bleed editor surface that breaks out of the base padding
		     and runs flush to the edges (same pattern as the log viewer). -->
		<div id="firewall-editor-shell" class="-mx-6 -mt-6 bg-[#0d0d0d] flex flex-col" style="min-height: calc(100vh - 55px);">
			<div class="flex flex-1 min-h-0">
				<!-- Left rail: section nav + error panel -->
				<aside class="w-64 flex-shrink-0 border-r border-gray-800 bg-[#0f0f0f] flex flex-col overflow-hidden">
					<div class="px-4 py-3 border-b border-gray-800">
						<h3 class="text-xs font-semibold uppercase tracking-wider text-gray-400">Tables &amp; Chains</h3>
					</div>
					<nav id="firewall-section-nav" class="flex-1 overflow-y-auto px-2 py-2 space-y-0.5 text-sm"></nav>
					<!-- Error panel — populated by the editor JS when validation fails. -->
					<section id="firewall-error-panel" class="hidden border-t border-red-900/60 bg-red-950/30 max-h-72 overflow-y-auto">
						<header class="px-4 py-2 flex items-center justify-between sticky top-0 bg-red-950/80 backdrop-blur">
							<h3 class="text-xs font-semibold uppercase tracking-wider text-red-300 flex items-center gap-1.5">
								<svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
								</svg>
								<span>Validation</span>
							</h3>
							<button id="firewall-error-close" type="button" class="text-red-300/60 hover:text-red-200" title="Dismiss">
								<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
								</svg>
							</button>
						</header>
						<pre id="firewall-error-text" class="px-4 py-2 text-xs font-mono whitespace-pre-wrap text-red-200 leading-relaxed"></pre>
					</section>
				</aside>

				<!-- Editor pane. CodeMirror mounts inside #firewall-editor. -->
				<main class="flex-1 min-w-0 flex flex-col">
					<div id="firewall-editor" class="flex-1 min-h-0"></div>
				</main>
			</div>

			<!-- Recent changes strip across the bottom -->
			if len(changes) > 0 {
				<div class="border-t border-gray-800 bg-[#0a0a0a] px-4 py-2 text-xs text-gray-400 overflow-x-auto flex items-center gap-4">
					<span class="font-semibold uppercase tracking-wider text-gray-500">Recent</span>
					for _, change := range changes {
						<span class="inline-flex items-center gap-1.5 whitespace-nowrap">
							<span class={ "px-1.5 py-0.5 rounded text-[10px] font-medium",
								templ.KV("bg-blue-900/60 text-blue-200", change.ChangeType == "manual"),
								templ.KV("bg-green-900/60 text-green-200", change.ChangeType == "git_sync"),
								templ.KV("bg-orange-900/60 text-orange-200", change.ChangeType == "restore") }>
								{ string(change.ChangeType) }
							</span>
							if change.ChangedByName != "" {
								<span class="text-gray-300">{ change.ChangedByName }</span>
							}
							if change.ChangeReason != "" {
								<span class="text-gray-500">· { change.ChangeReason }</span>
							}
							<span class="text-gray-600">· { change.CreatedAt.Format("Jan 2 15:04") }</span>
						</span>
					}
				</div>
			}
		</div>

		<!-- Backups Modal (kept simple; matches the existing site pattern) -->
		<div id="firewall-backups-modal" class="hidden fixed inset-0 z-50 overflow-y-auto">
			<div class="flex items-center justify-center min-h-screen px-4">
				<div class="fixed inset-0 bg-black bg-opacity-50" data-firewall-modal-dismiss></div>
				<div class="relative bg-white dark:bg-slate-800 rounded-lg shadow-xl max-w-2xl w-full p-6">
					<h3 class="text-lg font-semibold text-gray-900 dark:text-gray-100 mb-4">Configuration Backups</h3>
					<div id="firewall-backups-list" class="space-y-2 max-h-[60vh] overflow-y-auto">
						<p class="text-gray-500">Loading...</p>
					</div>
					<div class="mt-4 flex justify-end">
						<button data-firewall-modal-dismiss type="button" class="px-4 py-2 text-gray-600 dark:text-gray-400 hover:text-gray-800 dark:hover:text-gray-200">
							Close
						</button>
					</div>
				</div>
			</div>
		</div>

		<!-- CodeMirror 5 from unpkg (CSP allows scripts from unpkg + jsdelivr,
		     styles from unpkg only — pin a specific version for cache stability). -->
		<link rel="stylesheet" href="https://unpkg.com/codemirror@5.65.18/lib/codemirror.css"/>
		<link rel="stylesheet" href="https://unpkg.com/codemirror@5.65.18/theme/material-darker.css"/>
		<link rel="stylesheet" href="https://unpkg.com/codemirror@5.65.18/addon/hint/show-hint.css"/>
		<link rel="stylesheet" href="https://unpkg.com/codemirror@5.65.18/addon/lint/lint.css"/>
		<link rel="stylesheet" href="https://unpkg.com/codemirror@5.65.18/addon/dialog/dialog.css"/>
		<link rel="stylesheet" href="/static/css/firewall_config_editor.css"/>
		<script src="https://unpkg.com/codemirror@5.65.18/lib/codemirror.js"></script>
		<script src="https://unpkg.com/codemirror@5.65.18/addon/edit/matchbrackets.js"></script>
		<script src="https://unpkg.com/codemirror@5.65.18/addon/edit/closebrackets.js"></script>
		<script src="https://unpkg.com/codemirror@5.65.18/addon/selection/active-line.js"></script>
		<script src="https://unpkg.com/codemirror@5.65.18/addon/comment/comment.js"></script>
		<script src="https://unpkg.com/codemirror@5.65.18/addon/hint/show-hint.js"></script>
		<script src="https://unpkg.com/codemirror@5.65.18/addon/hint/anyword-hint.js"></script>
		<script src="https://unpkg.com/codemirror@5.65.18/addon/lint/lint.js"></script>
		<script src="https://unpkg.com/codemirror@5.65.18/addon/dialog/dialog.js"></script>
		<script src="https://unpkg.com/codemirror@5.65.18/addon/search/searchcursor.js"></script>
		<script src="https://unpkg.com/codemirror@5.65.18/addon/search/search.js"></script>
		<script src="/static/js/firewall_config/nftables-mode.js"></script>
		<script src="/static/js/firewall_config/editor.js"></script>
	}
}

// FirewallConfigPageWithError renders the config page with an error message.
templ FirewallConfigPageWithError(user *models.User, server *database.BoxDB, errorMsg string, canEdit bool) {
	@layouts.Base("Firewall Configuration", user, "/config/firewall") {
		<div class="max-w-4xl mx-auto px-4 py-8">
			<div class="bg-red-50 dark:bg-red-900/20 border border-red-200 dark:border-red-800 rounded-lg p-4">
				<div class="flex items-center gap-3">
					<svg class="w-6 h-6 text-red-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
					</svg>
					<div>
						<h3 class="font-semibold text-red-700 dark:text-red-300">Error Loading Configuration</h3>
						<p class="text-sm text-red-600 dark:text-red-400">{ errorMsg }</p>
					</div>
				</div>
			</div>
		</div>
	}
}
