package pages

import (
	"fmt"
	"github.com/sarg3nt/gearbox/internal/framework/agent"
	"github.com/sarg3nt/gearbox/internal/framework/database"
	"github.com/sarg3nt/gearbox/internal/framework/models"
	"github.com/sarg3nt/gearbox/internal/framework/templates/layouts"
)

// FirewallConfigPage renders the firewall configuration editor page.
templ FirewallConfigPage(user *models.User, server *database.BoxDB, config *agent.FirewallConfigResponse, gitConfig *database.BoxGitConfig, changes []database.ConfigChange, canEdit bool) {
	@layouts.Base("Firewall Configuration", user, "/config/firewall") {

		<div class="max-w-7xl mx-auto px-4 py-6">
			<!-- Toolbar -->
			<div class="bg-white dark:bg-slate-800 rounded-lg shadow p-4 mb-4 flex items-center justify-between">
				<div class="flex items-center gap-4">
					if canEdit {
						<button
							id="validate-btn"
							onclick="validateConfig()"
							class="px-4 py-2 bg-yellow-600 text-white rounded-lg hover:bg-yellow-700 flex items-center gap-2"
						>
							<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
							</svg>
							Validate
						</button>
						<button
							id="save-btn"
							onclick="saveConfig()"
							class="px-4 py-2 bg-green-600 text-white rounded-lg hover:bg-green-700 flex items-center gap-2"
						>
							<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
							</svg>
							Save & Apply
						</button>
					}
					<button
						id="backup-btn"
						onclick="showBackups()"
						class="px-4 py-2 bg-gray-600 text-white rounded-lg hover:bg-gray-700 flex items-center gap-2"
					>
						<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path>
						</svg>
						Backups
					</button>
				</div>
				<div class="flex items-center gap-4 text-sm text-gray-600 dark:text-gray-400">
					if config != nil {
						<span>
							Last modified: { config.LastModified.Format("2006-01-02 15:04:05") }
						</span>
						<span class="font-mono text-xs">
							SHA: { config.SHA256[:12] }...
						</span>
					}
				</div>
			</div>

			<!-- Info box -->
			<div class="bg-blue-50 dark:bg-blue-900/20 border border-blue-200 dark:border-blue-800 rounded-lg p-3 mb-4">
				<div class="flex items-center gap-2 text-sm text-blue-700 dark:text-blue-300">
					<svg class="w-5 h-5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
					</svg>
					<span>This is the nftables firewall configuration. Changes will be validated with <code class="bg-blue-100 dark:bg-blue-900 px-1 rounded">nft -c -f</code> before applying.</span>
				</div>
			</div>

			<!-- Main content area -->
			<div class="flex gap-4">
				<!-- Section Navigator -->
				<div class="w-48 flex-shrink-0">
					<div class="bg-white dark:bg-slate-800 rounded-lg shadow p-4 sticky top-4">
						<h3 class="text-sm font-semibold text-gray-700 dark:text-gray-300 mb-3">Tables</h3>
						<nav class="space-y-1" id="section-nav">
							if config != nil {
								for _, section := range config.Sections {
									<button
										onclick={ templ.ComponentScript{Call: fmt.Sprintf("scrollToLine(%d)", section.StartLine)} }
										class="w-full text-left px-3 py-2 text-sm rounded-lg transition-colors hover:bg-gray-100 dark:hover:bg-slate-700 text-gray-700 dark:text-gray-300"
									>
										<div class="flex items-center justify-between">
											<span>{ section.Type }</span>
											if section.Name != "" {
												<span class="text-xs text-gray-500">{ section.Name }</span>
											}
										</div>
									</button>
								}
							}
						</nav>
					</div>
				</div>

				<!-- Editor -->
				<div class="flex-1">
					<div class="bg-white dark:bg-slate-800 rounded-lg shadow overflow-hidden">
						<div id="editor-container" class="h-[600px]">
							<textarea
								id="config-editor"
								class="w-full h-full p-4 font-mono text-sm bg-gray-50 dark:bg-slate-900 text-gray-900 dark:text-gray-100 resize-none"
								if !canEdit {
									readonly
								}
							>{ config.Content }</textarea>
						</div>
					</div>
				</div>
			</div>

			<!-- Validation output -->
			<div id="validation-output" class="hidden mt-4 bg-white dark:bg-slate-800 rounded-lg shadow p-4">
				<h3 class="text-sm font-semibold text-gray-700 dark:text-gray-300 mb-2">Validation Output</h3>
				<pre id="validation-text" class="font-mono text-sm whitespace-pre-wrap"></pre>
			</div>

			<!-- Recent Changes -->
			if len(changes) > 0 {
				<div class="mt-6 bg-white dark:bg-slate-800 rounded-lg shadow p-4">
					<h3 class="text-sm font-semibold text-gray-700 dark:text-gray-300 mb-3">Recent Changes</h3>
					<div class="space-y-2">
						for _, change := range changes {
							<div class="flex items-center justify-between text-sm py-2 border-b border-gray-100 dark:border-slate-700 last:border-0">
								<div class="flex items-center gap-3">
									<span class={ "px-2 py-1 rounded text-xs font-medium",
										templ.KV("bg-blue-100 text-blue-700 dark:bg-blue-900 dark:text-blue-300", change.ChangeType == "manual"),
										templ.KV("bg-green-100 text-green-700 dark:bg-green-900 dark:text-green-300", change.ChangeType == "git_sync"),
										templ.KV("bg-orange-100 text-orange-700 dark:bg-orange-900 dark:text-orange-300", change.ChangeType == "restore") }>
										{ string(change.ChangeType) }
									</span>
									if change.ChangedByName != "" {
										<span class="text-gray-600 dark:text-gray-400">by { change.ChangedByName }</span>
									}
									if change.ChangeReason != "" {
										<span class="text-gray-500 dark:text-gray-500">- { change.ChangeReason }</span>
									}
								</div>
								<span class="text-gray-500 dark:text-gray-500">{ change.CreatedAt.Format("Jan 2 15:04") }</span>
							</div>
						}
					</div>
				</div>
			}
		</div>

		<!-- Backups Modal -->
		<div id="backups-modal" class="hidden fixed inset-0 z-50 overflow-y-auto">
			<div class="flex items-center justify-center min-h-screen px-4">
				<div class="fixed inset-0 bg-black bg-opacity-50" onclick="hideBackups()"></div>
				<div class="relative bg-white dark:bg-slate-800 rounded-lg shadow-xl max-w-2xl w-full p-6">
					<h3 class="text-lg font-semibold text-gray-900 dark:text-gray-100 mb-4">Configuration Backups</h3>
					<div id="backups-list" class="space-y-2">
						<p class="text-gray-500">Loading...</p>
					</div>
					<div class="mt-4 flex justify-end">
						<button onclick="hideBackups()" class="px-4 py-2 text-gray-600 dark:text-gray-400 hover:text-gray-800 dark:hover:text-gray-200">
							Close
						</button>
					</div>
				</div>
			</div>
		</div>

		<script>
		const serverID = "{ server.BoxID }";
		let currentSHA = "{ config.SHA256 }";

		async function validateConfig() {
			const content = document.getElementById('config-editor').value;
			const output = document.getElementById('validation-output');
			const text = document.getElementById('validation-text');

			try {
				const response = await fetch(`/api/${serverID}/firewall/config/validate`, {
					method: 'POST',
					headers: { 'Content-Type': 'application/json' },
					body: JSON.stringify({ content: content, dry_run: true })
				});

				const data = await response.json();
				output.classList.remove('hidden');

				if (data.success) {
					text.className = 'font-mono text-sm whitespace-pre-wrap text-green-600 dark:text-green-400';
					text.textContent = 'Configuration is valid.\n\n' + (data.validation_output || '');
				} else {
					text.className = 'font-mono text-sm whitespace-pre-wrap text-red-600 dark:text-red-400';
					text.textContent = 'Configuration is invalid:\n\n' + (data.validation_output || data.message);
				}
			} catch (error) {
				console.error('Validation failed:', error);
				output.classList.remove('hidden');
				text.className = 'font-mono text-sm whitespace-pre-wrap text-red-600 dark:text-red-400';
				text.textContent = 'Validation request failed: ' + error.message;
			}
		}

		async function saveConfig() {
			const content = document.getElementById('config-editor').value;
			const reason = await showPromptDialog({
			title: 'Save Configuration',
			message: 'Enter a reason for this change (optional):',
			defaultValue: 'Manual edit via web UI',
			placeholder: 'Reason for change'
		});

			if (reason === null) {
				return; // User cancelled
			}

			try {
				const response = await fetch(`/api/${serverID}/firewall/config`, {
					method: 'POST',
					headers: { 'Content-Type': 'application/json' },
					body: JSON.stringify({
						content: content,
						expected_sha: currentSHA,
						backup_reason: reason || 'Manual edit via web UI',
						dry_run: false
					})
				});

				const data = await response.json();

				if (data.success) {
					currentSHA = data.new_sha256 || currentSHA;
					if (window.showToast) {
						window.showToast('Configuration saved and applied successfully', 'success', 3000);
					} else {
						showAlertDialog({ title: 'Success', message: 'Configuration saved successfully!', type: 'success' });
					}
					// Hide validation output
					document.getElementById('validation-output').classList.add('hidden');
				} else {
					const output = document.getElementById('validation-output');
					const text = document.getElementById('validation-text');
					output.classList.remove('hidden');
					text.className = 'font-mono text-sm whitespace-pre-wrap text-red-600 dark:text-red-400';
					text.textContent = 'Save failed:\n\n' + (data.validation_output || data.message);
				}
			} catch (error) {
				console.error('Save failed:', error);
				if (window.showToast) {
					window.showToast('Failed to save configuration: ' + error.message, 'error', 5000);
				} else {
					showAlertDialog({ title: 'Error', message: 'Failed to save configuration', type: 'error' });
				}
			}
		}

		async function showBackups() {
			const modal = document.getElementById('backups-modal');
			const list = document.getElementById('backups-list');
			modal.classList.remove('hidden');

			try {
				const response = await fetch(`/api/${serverID}/firewall/config/backups`);
				const data = await response.json();

				if (data.backups && data.backups.length > 0) {
					list.innerHTML = data.backups.map(b => `
						<div class="flex items-center justify-between p-3 bg-gray-50 dark:bg-slate-700 rounded-lg">
							<div>
								<div class="font-medium text-gray-900 dark:text-gray-100">${b.reason || 'Unknown'}</div>
								<div class="text-sm text-gray-500 dark:text-gray-400">${new Date(b.created_at).toLocaleString()}</div>
							</div>
							<button onclick="restoreBackup('${b.id}')" class="px-3 py-1 bg-blue-600 text-white rounded hover:bg-blue-700 text-sm">
								Restore
							</button>
						</div>
					`).join('');
				} else {
					list.innerHTML = '<p class="text-gray-500 dark:text-gray-400">No backups available.</p>';
				}
			} catch (error) {
				list.innerHTML = '<p class="text-red-500">Failed to load backups.</p>';
			}
		}

		function hideBackups() {
			document.getElementById('backups-modal').classList.add('hidden');
		}

		async function restoreBackup(backupID) {
			const confirmed = await showConfirmDialog({
				title: 'Restore Backup',
				message: 'Are you sure you want to restore from this backup? The current configuration will be replaced.',
				confirmText: 'Restore',
				type: 'danger'
			});

			if (!confirmed) {
				return;
			}

			try {
				const response = await fetch(`/api/${serverID}/firewall/config/restore`, {
					method: 'POST',
					headers: { 'Content-Type': 'application/json' },
					body: JSON.stringify({ backup_id: backupID })
				});

				const data = await response.json();

				if (data.success) {
					if (window.showToast) {
						window.showToast('Configuration restored successfully', 'success', 3000);
					}
					setTimeout(() => window.location.reload(), 1000);
				} else {
					if (window.showToast) {
						window.showToast('Restore failed: ' + data.message, 'error', 5000);
					} else {
						await showAlertDialog({
							title: 'Restore Failed',
							message: 'Restore failed: ' + data.message,
							type: 'error'
						});
					}
				}
			} catch (error) {
				console.error('Restore failed:', error);
				if (window.showToast) {
					window.showToast('Restore failed', 'error', 5000);
				}
			}
		}

		function scrollToLine(line) {
			const editor = document.getElementById('config-editor');
			const lines = editor.value.split('\n');
			let charIndex = 0;
			for (let i = 0; i < line - 1 && i < lines.length; i++) {
				charIndex += lines[i].length + 1;
			}
			editor.focus();
			editor.setSelectionRange(charIndex, charIndex);
			// Scroll to make the line visible
			const lineHeight = parseFloat(getComputedStyle(editor).lineHeight) || 20;
			editor.scrollTop = (line - 1) * lineHeight;
		}
		</script>
	}
}

// FirewallConfigPageWithError renders the config page with an error message.
templ FirewallConfigPageWithError(user *models.User, server *database.BoxDB, errorMsg string, canEdit bool) {
	@layouts.Base("Firewall Configuration", user, "/config/firewall") {
		<div class="max-w-4xl mx-auto px-4 py-8">
			<div class="bg-red-50 dark:bg-red-900/20 border border-red-200 dark:border-red-800 rounded-lg p-4">
				<div class="flex items-center gap-3">
					<svg class="w-6 h-6 text-red-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
					</svg>
					<div>
						<h3 class="font-semibold text-red-700 dark:text-red-300">Error Loading Configuration</h3>
						<p class="text-sm text-red-600 dark:text-red-400">{ errorMsg }</p>
					</div>
				</div>
			</div>
		</div>
	}
}
