package pages

import (
	"encoding/json"
	"fmt"
	"strings"

	"github.com/sarg3nt/gearbox/internal/framework/agent"
	"github.com/sarg3nt/gearbox/internal/framework/database"
	"github.com/sarg3nt/gearbox/internal/framework/models"
	"github.com/sarg3nt/gearbox/internal/framework/templates/components"
	"github.com/sarg3nt/gearbox/internal/framework/templates/layouts"
)

// jsonScriptBody marshals v to JSON and escapes any "</" so it can safely sit
// inside a <script type="application/json"> tag without prematurely closing
// the script element. Returns "null" on marshal failure rather than blowing
// up the page render.
func jsonScriptBody(v any) string {
	b, err := json.Marshal(v)
	if err != nil {
		return "null"
	}
	return strings.ReplaceAll(string(b), "</", `<\/`)
}

// OSUpdatesPageData contains all data needed for the OS updates page.
type OSUpdatesPageData struct {
	User             *models.User
	BoxID            string
	Servers          []models.BoxConfig
	Config           *database.OSUpdatesConfig
	UpdateStatus     *agent.UpdateStatusResponse
	Packages         []agent.Package
	RebootStatus     *agent.RebootRequiredResponse
	UnattendedConfig *agent.UnattendedConfigResponse
	PythonToolsStatus *agent.PythonToolsStatusResponse
	Snapshots        *agent.SnapshotsResponse
	History          *agent.UpdateHistoryResponse
	CanConfigure     bool
	CanAction        bool
}

templ OSUpdatesPage(data OSUpdatesPageData) {
	@layouts.Base("OS Updates", data.User, "/os-updates") {
		<!-- Hidden container for page header content. Title + box selector
		     live in the global header breadcrumb + chip. -->
		<div id="page-header-source" class="hidden">
			<div class="flex-1"></div>
			<div class="flex items-center space-x-3">
				<!-- LiveRefreshButton serves dual purpose here: its color reflects
				     the SSE connection (green = live apt-event stream), and clicking
				     it triggers checkForUpdates() — which queries apt for new
				     versions and refreshes the cards + grid in place. SSE itself
				     does NOT poll for new updates; manual click (or page reload) is
				     the only way to refresh that state. -->
				@components.LiveRefreshButton()
			</div>
		</div>

		<!-- Store server ID for JavaScript -->
		<input type="hidden" id="current-server-id" value={ data.BoxID }/>
		<input type="hidden" id="can-action" value={ boolToString(data.CanAction) }/>
		<input type="hidden" id="can-configure" value={ boolToString(data.CanConfigure) }/>

		if len(data.Servers) == 0 {
			<div class="bg-yellow-50 dark:bg-yellow-900/20 border border-yellow-200 dark:border-yellow-800 rounded-lg p-4">
				<p class="text-yellow-700 dark:text-yellow-300">No servers configured. Please add a server in settings.</p>
			</div>
		} else {
			<!-- Main content area -->
			<div class="space-y-6">
				<!-- Status Summary Cards -->
				<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
					<!-- Total Updates Card -->
					<div class="bg-white dark:bg-slate-800 rounded-lg shadow p-4">
						<div class="flex items-center justify-between">
							<span class="text-sm text-gray-500 dark:text-gray-400">Available Updates</span>
							<svg class="w-5 h-5 text-blue-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path>
							</svg>
						</div>
						<p id="total-updates" class="text-2xl font-bold text-gray-800 dark:text-gray-100 mt-2">
							{ fmt.Sprintf("%d", data.UpdateStatus.TotalUpdates) }
						</p>
						<p class="text-xs text-gray-400 mt-1">Package updates available</p>
					</div>

					<!-- Security Updates Card -->
					<div class="bg-white dark:bg-slate-800 rounded-lg shadow p-4">
						<div class="flex items-center justify-between">
							<span class="text-sm text-gray-500 dark:text-gray-400">Security Updates</span>
							<svg class="w-5 h-5 text-red-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"></path>
							</svg>
						</div>
						<p id="security-updates" class={ "text-2xl font-bold mt-2", templ.KV("text-red-600 dark:text-red-400", data.UpdateStatus.SecurityUpdates > 0), templ.KV("text-gray-800 dark:text-gray-100", data.UpdateStatus.SecurityUpdates == 0) }>
							{ fmt.Sprintf("%d", data.UpdateStatus.SecurityUpdates) }
						</p>
						<p class="text-xs text-gray-400 mt-1">Critical security fixes</p>
					</div>

					<!-- Reboot Required Card -->
					<div id="reboot-status-card" class="bg-white dark:bg-slate-800 rounded-lg shadow p-4">
						<div class="flex items-center justify-between">
							<span class="text-sm text-gray-500 dark:text-gray-400">Reboot Status</span>
							<span id="reboot-status-icon">
								if data.UpdateStatus.RebootRequired {
									<svg class="w-5 h-5 text-yellow-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
										<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path>
									</svg>
								} else {
									<svg class="w-5 h-5 text-green-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
										<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
									</svg>
								}
							</span>
						</div>
						<p id="reboot-status" class={ "text-2xl font-bold mt-2", templ.KV("text-yellow-600 dark:text-yellow-400", data.UpdateStatus.RebootRequired), templ.KV("text-green-600 dark:text-green-400", !data.UpdateStatus.RebootRequired) }>
							if data.UpdateStatus.RebootRequired {
								Required
							} else {
								Not Required
							}
						</p>
						<p id="reboot-status-subtitle" class="text-xs text-gray-400 mt-1">System reboot status</p>
						if data.UpdateStatus.RebootRequired && data.CanAction {
							<div id="reboot-actions" class="flex gap-2 mt-3">
								<button
									onclick="scheduleReboot()"
									class="px-3 py-1 text-xs bg-yellow-600 hover:bg-yellow-700 text-white rounded transition-colors"
								>
									Schedule Reboot
								</button>
								<button
									onclick="rebootNow()"
									class="px-3 py-1 text-xs bg-red-600 hover:bg-red-700 text-white rounded transition-colors"
								>
									Reboot Now
								</button>
							</div>
						}
					</div>

					<!-- Auto Updates Card -->
					<div class="bg-white dark:bg-slate-800 rounded-lg shadow p-4">
						<div class="flex items-center justify-between">
							<span class="text-sm text-gray-500 dark:text-gray-400">Auto Updates</span>
							if data.UnattendedConfig != nil && data.UnattendedConfig.Enabled {
								<svg class="w-5 h-5 text-green-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path>
								</svg>
							} else {
								<svg class="w-5 h-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.618 5.984A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path>
								</svg>
							}
						</div>
						<p id="auto-updates-status" class={ "text-2xl font-bold mt-2", templ.KV("text-green-600 dark:text-green-400", data.UnattendedConfig != nil && data.UnattendedConfig.Enabled), templ.KV("text-gray-500 dark:text-gray-400", data.UnattendedConfig == nil || !data.UnattendedConfig.Enabled) }>
							if data.UnattendedConfig != nil && data.UnattendedConfig.Enabled {
								Enabled
							} else {
								Disabled
							}
						</p>
						<p class="text-xs text-gray-400 mt-1">unattended-upgrades</p>
					</div>
				</div>

				<!-- OS Packages -->
				<div class="bg-white dark:bg-slate-800 rounded-lg shadow">
					<div class="p-4 border-b border-gray-200 dark:border-slate-700">
						<div class="flex justify-between items-center gap-3 flex-wrap">
							<div>
								<h3 class="text-lg font-semibold text-gray-800 dark:text-gray-100">OS Packages</h3>
								<p class="text-sm text-gray-500 dark:text-gray-400">System package management</p>
							</div>
							<div class="flex items-center gap-2 flex-wrap">
								if data.CanAction {
									<button
										id="pkg-update-all-btn"
										onclick="installAllUpdates()"
										class="hidden px-3 py-2 text-sm bg-blue-600 hover:bg-blue-700 text-white rounded-lg transition-colors flex items-center gap-1.5"
									>
										<svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
											<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path>
										</svg>
										<span id="pkg-update-all-label">Update All</span>
									</button>
									if data.UpdateStatus.SecurityUpdates > 0 {
										<button
											id="pkg-update-security-btn"
											onclick="installSecurityUpdates()"
											class="hidden px-3 py-2 text-sm bg-red-600 hover:bg-red-700 text-white rounded-lg transition-colors flex items-center gap-1.5"
										>
											<svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
												<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"></path>
											</svg>
											Security ({ fmt.Sprintf("%d", data.UpdateStatus.SecurityUpdates) })
										</button>
									}
								}
								<!-- #pkg-search moved to the global HeaderSearch
								     (issue #92). The element is kept here as a
								     hidden input so the Tabulator-backed
								     datagrid (createDataGrid({searchInput:
								     '#pkg-search'})) can still latch onto it;
								     a window.gearbox.filter registration in
								     os-updates-page.js writes to .value and
								     dispatches 'input' on every keystroke. -->
								<input type="search" id="pkg-search" class="hidden" autocomplete="off"/>
								<select
									id="pkg-view-filter"
									onchange="onPkgViewFilterChange(this.value)"
									class="h-[38px] px-3 py-1.5 text-sm border border-gray-300 dark:border-slate-600 rounded-lg bg-white dark:bg-slate-800 text-gray-700 dark:text-gray-300 focus:outline-none focus:ring-2 focus:ring-blue-500"
								>
									<option value="updates">Updates</option>
									<option value="held">Held</option>
									<option value="all">All Packages</option>
								</select>
								if data.CanAction {
									<button
										onclick="showAptInstallModal()"
										class="px-3 py-2 text-sm bg-green-600 hover:bg-green-700 text-white rounded-lg transition-colors"
									>
										Install Package
									</button>
								}
							</div>
						</div>
						<!-- Install progress bar (hidden by default) -->
						<div id="install-progress-container" class="hidden mt-2 h-1 bg-gray-200 dark:bg-slate-700 rounded-full">
							<div id="install-progress-bar" class="h-full bg-green-500 rounded-full transition-all duration-300 ease-out" style="width: 0%"></div>
						</div>
					</div>
					<div class="p-4">
						<!-- Fixed height (474px) matches the gridHeight computed in
						     os-updates-page.js (ROW_HEIGHT 36 × 12 visible rows + 42px
						     header). Pre-sizing the container avoids a layout shift
						     when Tabulator replaces the loading state with the grid. -->
						<div id="installed-packages-table" class="rounded-lg border border-gray-200 dark:border-slate-600 overflow-hidden" style="height: 474px">
							<div id="installed-packages-loading" class="h-full flex items-center justify-center gap-2 text-sm text-gray-500 dark:text-gray-400">
								<svg class="w-4 h-4 animate-spin" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path></svg>
								Loading packages...
							</div>
						</div>
						<input type="hidden" id="can-action-installed" value={ boolToString(data.CanAction) }/>
						<input type="hidden" id="total-updates-count" value={ fmt.Sprintf("%d", data.UpdateStatus.TotalUpdates) }/>
					</div>
				</div>

				<!-- Snapshots Section: collapsible, lazy-loaded on first expand.
				     Live updates: whenever an apt operation completes (SSE event)
				     and this section is open, the grid is refetched. -->
				<details class="datagrid-card bg-white dark:bg-slate-800 rounded-lg shadow" data-section="snapshots">
					<summary class="p-4 border-b border-gray-200 dark:border-slate-700 flex justify-between items-center gap-3">
						<div class="flex items-center gap-3">
							<svg class="datagrid-chevron w-4 h-4 text-gray-400 dark:text-gray-500 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
							</svg>
							<div>
								<h3 class="text-lg font-semibold text-gray-800 dark:text-gray-100">Package Snapshots</h3>
								<p class="text-sm text-gray-500 dark:text-gray-400">Restore to a previous package state</p>
							</div>
						</div>
						if data.CanAction {
							<div class="flex gap-2 items-center">
								<button
									id="bulk-delete-snapshots-btn"
									onclick="bulkDeleteSnapshots()"
									class="hidden px-3 py-1.5 text-sm bg-red-600 hover:bg-red-700 text-white rounded-lg transition-colors"
								>
									Delete Selected
								</button>
								<button
									onclick="createManualSnapshot()"
									class="px-3 py-1.5 text-sm bg-gray-600 hover:bg-gray-700 text-white rounded-lg transition-colors"
								>
									Create Snapshot
								</button>
							</div>
						}
					</summary>
					<div class="p-4">
						<div id="snapshots-grid" class="rounded-lg border border-gray-200 dark:border-slate-600 overflow-hidden"></div>
					</div>
				</details>

				<!-- Python CLI Tools Section.
				     Only rendered when at least one of pipx/pip is available on the
				     target system, so empty subsections don't waste screen space. -->
				if data.Config != nil && data.Config.ShowPythonTools && data.PythonToolsStatus != nil && (data.PythonToolsStatus.Pipx.Available || data.PythonToolsStatus.Pip.Available) {
					<div class="bg-white dark:bg-slate-800 rounded-lg shadow">
						<div class="p-4 border-b border-gray-200 dark:border-slate-700">
							<h3 class="text-lg font-semibold text-gray-800 dark:text-gray-100">Python CLI Tools</h3>
							<p class="text-sm text-gray-500 dark:text-gray-400">Manage Python packages and applications</p>
						</div>

						if data.PythonToolsStatus.Pipx.Available {
						<!-- pipx subsection -->
						<div class="p-4 border-b border-gray-200 dark:border-slate-700">
							<div class="flex justify-between items-center mb-3">
								<div>
									<h4 class="font-semibold text-gray-800 dark:text-gray-200">pipx Applications</h4>
									<p class="text-xs text-gray-500 dark:text-gray-400">Isolated Python CLI applications</p>
								</div>
								<div class="flex gap-2">
									if data.CanAction {
										<button
											onclick="showPipxInstallModal()"
											class="px-3 py-1.5 text-sm bg-blue-600 hover:bg-blue-700 text-white rounded-lg transition-colors"
										>
											Install Package
										</button>
										<button
											id="pipx-upgrade-all-btn"
											onclick="upgradeAllPipx(this)"
											class="px-3 py-1.5 text-sm bg-gray-600 hover:bg-gray-700 text-white rounded-lg transition-colors flex items-center gap-1.5"
										>
											Upgrade All
										</button>
									}
								</div>
							</div>
							<!-- pipx bulk action bar (hidden until selection) -->
							<div id="pipx-bulk-bar" class="hidden mb-2 flex items-center gap-3 px-3 py-2 bg-blue-50 dark:bg-blue-900/20 rounded-lg border border-blue-200 dark:border-blue-800">
								<span id="pipx-selected-count" class="text-sm font-medium text-blue-700 dark:text-blue-300">0 selected</span>
								<button id="pipx-bulk-upgrade-btn" onclick="bulkUpgradePipx()" class="px-3 py-1 text-xs bg-blue-600 hover:bg-blue-700 text-white rounded-lg transition-colors flex items-center gap-1.5">
									Upgrade Selected
								</button>
								<button onclick="bulkUninstallPipx()" class="px-3 py-1 text-xs bg-red-600 hover:bg-red-700 text-white rounded-lg transition-colors">
									Uninstall Selected
								</button>
								<button onclick="clearPipxSelection()" class="px-3 py-1 text-xs text-gray-500 dark:text-gray-400 hover:text-gray-700 dark:hover:text-gray-200 transition-colors">
									Clear
								</button>
							</div>
							<!-- Initial package data embedded as JSON for the datagrid.
							     PyPI latest-version lookups happen async via
							     loadPythonVersions() once the grid is built. -->
							@templ.Raw("<script type=\"application/json\" id=\"pipx-data\">" + jsonScriptBody(data.PythonToolsStatus.Pipx.Packages) + "</script>")
							<div id="pipx-grid" class="rounded-lg border border-gray-200 dark:border-slate-600 overflow-hidden"></div>
						</div>
						}

						if data.PythonToolsStatus.Pip.Available {
						<!-- pip subsection -->
						<div class="p-4">
							<div class="flex justify-between items-center mb-3">
								<div>
									<h4 class="font-semibold text-gray-800 dark:text-gray-200">pip Packages</h4>
									<p class="text-xs text-gray-500 dark:text-gray-400">User-installed Python packages</p>
								</div>
								<div class="flex gap-2">
									if data.CanAction {
										<button
											onclick="showPipInstallModal()"
											class="px-3 py-1.5 text-sm bg-blue-600 hover:bg-blue-700 text-white rounded-lg transition-colors"
										>
											Install Package
										</button>
										<button
											id="pip-upgrade-all-btn"
											onclick="upgradeAllPip(this)"
											class="px-3 py-1.5 text-sm bg-gray-600 hover:bg-gray-700 text-white rounded-lg transition-colors flex items-center gap-1.5"
										>
											Upgrade All
										</button>
									}
								</div>
							</div>
							<!-- pip bulk action bar (hidden until selection) -->
							<div id="pip-bulk-bar" class="hidden mb-2 flex items-center gap-3 px-3 py-2 bg-blue-50 dark:bg-blue-900/20 rounded-lg border border-blue-200 dark:border-blue-800">
								<span id="pip-selected-count" class="text-sm font-medium text-blue-700 dark:text-blue-300">0 selected</span>
								<button id="pip-bulk-upgrade-btn" onclick="bulkUpgradePip()" class="px-3 py-1 text-xs bg-blue-600 hover:bg-blue-700 text-white rounded-lg transition-colors flex items-center gap-1.5">
									Upgrade Selected
								</button>
								<button onclick="bulkUninstallPip()" class="px-3 py-1 text-xs bg-red-600 hover:bg-red-700 text-white rounded-lg transition-colors">
									Uninstall Selected
								</button>
								<button onclick="clearPipSelection()" class="px-3 py-1 text-xs text-gray-500 dark:text-gray-400 hover:text-gray-700 dark:hover:text-gray-200 transition-colors">
									Clear
								</button>
							</div>
							@templ.Raw("<script type=\"application/json\" id=\"pip-data\">" + jsonScriptBody(data.PythonToolsStatus.Pip.Packages) + "</script>")
							<div id="pip-grid" class="rounded-lg border border-gray-200 dark:border-slate-600 overflow-hidden"></div>
						</div>
						}
					</div>
				}

				<!-- Update History: collapsible, lazy-loaded on first expand. -->
				<details class="datagrid-card bg-white dark:bg-slate-800 rounded-lg shadow" data-section="history">
					<summary class="p-4 border-b border-gray-200 dark:border-slate-700 flex items-center gap-3">
						<svg class="datagrid-chevron w-4 h-4 text-gray-400 dark:text-gray-500 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
						</svg>
						<div>
							<h3 class="text-lg font-semibold text-gray-800 dark:text-gray-100">Update History</h3>
							<p class="text-sm text-gray-500 dark:text-gray-400">Recent package changes</p>
						</div>
					</summary>
					<div class="p-4">
						<div id="history-grid" class="rounded-lg border border-gray-200 dark:border-slate-600 overflow-hidden"></div>
					</div>
				</details>
				<!-- Update Logs: collapsible, lazy-loaded on first expand.
				     Replaces the previous "Load Logs" button — opening the section
				     fetches the logs. -->
				<details class="datagrid-card bg-white dark:bg-slate-800 rounded-lg shadow" data-section="logs">
					<summary class="p-4 border-b border-gray-200 dark:border-slate-700 flex items-center gap-3">
						<svg class="datagrid-chevron w-4 h-4 text-gray-400 dark:text-gray-500 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
						</svg>
						<div>
							<h3 class="text-lg font-semibold text-gray-800 dark:text-gray-100">Update Logs</h3>
							<p class="text-sm text-gray-500 dark:text-gray-400">Logs from apt operations run through Gearbox</p>
						</div>
					</summary>
					<div class="p-4">
						<div id="logs-grid" class="rounded-lg border border-gray-200 dark:border-slate-600 overflow-hidden"></div>
					</div>
				</details>
			</div>

			<!-- Update Log Detail Modal -->
			<div id="update-log-modal" class="hidden fixed inset-0 bg-black/50 flex items-center justify-center z-50 p-4 md:p-8">
				<div class="bg-slate-900 rounded-lg shadow-xl w-full max-w-4xl h-[80vh] flex flex-col">
					<div class="flex items-center justify-between px-4 py-3 border-b border-slate-700">
						<div class="flex items-center gap-3">
							<div id="log-status-indicator" class="w-3 h-3 rounded-full"></div>
							<h3 id="log-detail-title" class="text-sm font-medium text-gray-200">Update Log</h3>
						</div>
						<div class="flex items-center gap-2">
							<button
								onclick="copyLogOutput()"
								class="p-1.5 rounded hover:bg-slate-700 text-gray-400 hover:text-gray-200 transition-colors"
								title="Copy output"
							>
								<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"></path>
								</svg>
							</button>
							<button
								id="update-log-close-btn"
								onclick="hideUpdateLogModal()"
								class="p-1.5 rounded hover:bg-slate-700 text-gray-400 hover:text-gray-200 transition-colors"
								title="Close"
							>
								<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
								</svg>
							</button>
						</div>
					</div>
					<!-- Log metadata -->
					<div class="px-4 py-2 border-b border-slate-700 bg-slate-800 flex flex-wrap gap-4 text-xs text-gray-400">
						<span>Type: <span id="log-detail-type" class="text-gray-200">-</span></span>
						<span>Status: <span id="log-detail-status" class="text-gray-200">-</span></span>
						<span>Started: <span id="log-detail-started" class="text-gray-200">-</span></span>
						<span>Duration: <span id="log-detail-duration" class="text-gray-200">-</span></span>
						<span>Exit Code: <span id="log-detail-exit-code" class="text-gray-200">-</span></span>
					</div>
					<!-- Log Output Area -->
					<div class="flex-1 overflow-y-auto p-4 font-mono text-sm text-green-400 bg-black">
						<pre id="log-detail-output" class="whitespace-pre-wrap"></pre>
					</div>
				</div>
			</div>

			<!-- Reboot Modal -->
			<div id="reboot-modal" class="hidden fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center z-50">
				<div class="bg-white dark:bg-slate-800 rounded-lg shadow-xl max-w-md w-full mx-4">
					<div class="p-4 border-b border-gray-200 dark:border-slate-700">
						<h3 class="text-lg font-semibold text-gray-800 dark:text-gray-100">Schedule Reboot</h3>
					</div>
					<div class="p-4 space-y-4">
						<p class="text-gray-600 dark:text-gray-400">When should the system reboot?</p>
						<div class="space-y-2">
							<label class="flex items-center gap-2">
								<input type="radio" name="reboot-time" value="now" class="text-blue-600"/>
								<span class="text-gray-700 dark:text-gray-300">Immediately</span>
							</label>
							<label class="flex items-center gap-2">
								<input type="radio" name="reboot-time" value="+5" class="text-blue-600"/>
								<span class="text-gray-700 dark:text-gray-300">In 5 minutes</span>
							</label>
							<label class="flex items-center gap-2">
								<input type="radio" name="reboot-time" value="+15" class="text-blue-600"/>
								<span class="text-gray-700 dark:text-gray-300">In 15 minutes</span>
							</label>
							<label class="flex items-center gap-2">
								<input type="radio" name="reboot-time" value="+60" class="text-blue-600"/>
								<span class="text-gray-700 dark:text-gray-300">In 1 hour</span>
							</label>
							<label class="flex items-center gap-2">
								<input type="radio" name="reboot-time" value="custom" class="text-blue-600"/>
								<span class="text-gray-700 dark:text-gray-300">Custom time:</span>
								<input type="text" id="custom-reboot-time" placeholder="HH:MM or +minutes" maxlength="20" class="px-2 py-1 border border-gray-300 dark:border-slate-600 rounded bg-white dark:bg-slate-700 text-gray-700 dark:text-gray-300"/>
							</label>
						</div>
					</div>
					<div class="p-4 border-t border-gray-200 dark:border-slate-700 flex justify-end gap-3">
						<button id="reboot-cancel-btn" onclick="hideRebootModal()" class="px-4 py-2 text-gray-600 dark:text-gray-400 hover:text-gray-800 dark:hover:text-gray-200">
							Cancel
						</button>
						<button id="reboot-confirm-btn" onclick="confirmReboot()" class="px-4 py-2 bg-red-600 hover:bg-red-700 text-white rounded-lg transition-colors">
							Schedule Reboot
						</button>
					</div>
				</div>
			</div>

			<!-- Revert Package Modal -->
			<!-- Apt Install Modal -->
			<div id="apt-install-modal" class="hidden fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center z-50">
				<div class="bg-white dark:bg-slate-800 rounded-lg shadow-xl max-w-lg w-full mx-4">
					<div class="p-4 border-b border-gray-200 dark:border-slate-700">
						<h3 class="text-lg font-semibold text-gray-800 dark:text-gray-100">Install System Package</h3>
					</div>
					<div class="p-4 space-y-3">
						<p class="text-sm text-gray-600 dark:text-gray-400">Search for a package to install via apt.</p>
						<div class="relative">
							<input
								type="text"
								id="apt-package-name"
								placeholder="e.g., nginx, htop, git"
								maxlength="200"
								data-charlimit="200"
								autocomplete="off"
								oninput="onAptSearchInput(this.value)"
								class="w-full px-3 py-2 border border-gray-300 dark:border-slate-600 rounded-lg bg-white dark:bg-slate-700 text-gray-700 dark:text-gray-300 focus:outline-none focus:ring-2 focus:ring-blue-500"
							/>
							<div id="apt-search-spinner" class="hidden absolute right-3 top-2.5">
								<svg class="w-4 h-4 animate-spin text-gray-400" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path></svg>
							</div>
						</div>
						<!-- Search results dropdown -->
						<div id="apt-search-results" class="hidden max-h-64 overflow-y-auto rounded-lg border border-gray-200 dark:border-slate-600 divide-y divide-gray-100 dark:divide-slate-700">
						</div>
						<!-- Selected package info -->
						<div id="apt-selected-info" class="hidden rounded-lg border border-blue-200 dark:border-blue-700 p-3 bg-blue-50 dark:bg-blue-900/20">
							<div class="flex items-center justify-between">
								<span id="apt-selected-name" class="font-semibold text-gray-800 dark:text-gray-100 text-sm"></span>
								<span class="px-2 py-0.5 text-xs bg-green-100 dark:bg-green-900/30 text-green-700 dark:text-green-400 rounded">Selected</span>
							</div>
							<p id="apt-selected-desc" class="text-xs text-gray-600 dark:text-gray-400 mt-1"></p>
						</div>
						<div id="apt-no-results" class="hidden rounded-lg border border-gray-200 dark:border-slate-600 p-3 text-center text-sm text-gray-500 dark:text-gray-400">
							No packages found. Try a different search term.
						</div>
					</div>
					<div class="p-4 border-t border-gray-200 dark:border-slate-700 flex justify-end gap-3">
						<button onclick="hideAptInstallModal()" class="px-4 py-2 text-gray-600 dark:text-gray-400 hover:text-gray-800 dark:hover:text-gray-200">
							Cancel
						</button>
						<button id="apt-install-confirm-btn" onclick="confirmAptInstall()" disabled class="px-4 py-2 bg-blue-600 hover:bg-blue-700 disabled:opacity-40 disabled:cursor-not-allowed text-white rounded-lg transition-colors flex items-center gap-2">
							Install
						</button>
					</div>
				</div>
			</div>

			<!-- Pipx Install Modal -->
			<div id="pipx-install-modal" class="hidden fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center z-50">
				<div class="bg-white dark:bg-slate-800 rounded-lg shadow-xl max-w-lg w-full mx-4">
					<div class="p-4 border-b border-gray-200 dark:border-slate-700">
						<h3 class="text-lg font-semibold text-gray-800 dark:text-gray-100">Install pipx Package</h3>
					</div>
					<div class="p-4 space-y-3">
						<p class="text-sm text-gray-600 dark:text-gray-400">Type a package name to look it up on PyPI, then click Install.</p>
						<div class="relative">
							<input
								type="text"
								id="pipx-package-name"
								placeholder="e.g., black, ruff, httpie"
								maxlength="200"
								data-charlimit="200"
								autocomplete="off"
								oninput="onPipxSearchInput(this.value)"
								class="w-full px-3 py-2 border border-gray-300 dark:border-slate-600 rounded-lg bg-white dark:bg-slate-700 text-gray-700 dark:text-gray-300 focus:outline-none focus:ring-2 focus:ring-blue-500"
							/>
							<div id="pipx-search-spinner" class="hidden absolute right-3 top-2.5">
								<svg class="w-4 h-4 animate-spin text-gray-400" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path></svg>
							</div>
						</div>
						<div id="pipx-package-info" class="hidden rounded-lg border border-gray-200 dark:border-slate-600 p-3 bg-gray-50 dark:bg-slate-700 space-y-1">
							<div class="flex items-center justify-between">
								<span id="pipx-pkg-name" class="font-semibold text-gray-800 dark:text-gray-100 text-sm"></span>
								<span id="pipx-pkg-version" class="font-mono text-xs text-blue-600 dark:text-blue-400 bg-blue-50 dark:bg-blue-900/30 px-2 py-0.5 rounded"></span>
							</div>
							<p id="pipx-pkg-summary" class="text-xs text-gray-600 dark:text-gray-400"></p>
							<a id="pipx-pkg-link" href="#" target="_blank" rel="noopener" class="text-xs text-blue-500 hover:text-blue-700 dark:text-blue-400 dark:hover:text-blue-300">View on PyPI →</a>
						</div>
						<div id="pipx-package-not-found" class="hidden rounded-lg border border-red-200 dark:border-red-800 p-3 bg-red-50 dark:bg-red-900/20">
							<p class="text-xs text-red-600 dark:text-red-400">Package not found on PyPI. Check the name and try again.</p>
						</div>
					</div>
					<div class="p-4 border-t border-gray-200 dark:border-slate-700 flex justify-end gap-3">
						<button onclick="hidePipxInstallModal()" class="px-4 py-2 text-gray-600 dark:text-gray-400 hover:text-gray-800 dark:hover:text-gray-200">
							Cancel
						</button>
						<button id="pipx-install-confirm-btn" onclick="confirmPipxInstall()" class="px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white rounded-lg transition-colors flex items-center gap-2">
							Install
						</button>
					</div>
				</div>
			</div>

			<!-- Pip Install Modal -->
			<div id="pip-install-modal" class="hidden fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center z-50">
				<div class="bg-white dark:bg-slate-800 rounded-lg shadow-xl max-w-lg w-full mx-4">
					<div class="p-4 border-b border-gray-200 dark:border-slate-700">
						<h3 class="text-lg font-semibold text-gray-800 dark:text-gray-100">Install pip Package</h3>
					</div>
					<div class="p-4 space-y-3">
						<p class="text-sm text-gray-600 dark:text-gray-400">Type a package name to look it up on PyPI, then click Install.</p>
						<div class="relative">
							<input
								type="text"
								id="pip-package-name"
								placeholder="e.g., requests, flask, numpy"
								maxlength="200"
								data-charlimit="200"
								autocomplete="off"
								oninput="onPipSearchInput(this.value)"
								class="w-full px-3 py-2 border border-gray-300 dark:border-slate-600 rounded-lg bg-white dark:bg-slate-700 text-gray-700 dark:text-gray-300 focus:outline-none focus:ring-2 focus:ring-blue-500"
							/>
							<div id="pip-search-spinner" class="hidden absolute right-3 top-2.5">
								<svg class="w-4 h-4 animate-spin text-gray-400" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path></svg>
							</div>
						</div>
						<div id="pip-package-info" class="hidden rounded-lg border border-gray-200 dark:border-slate-600 p-3 bg-gray-50 dark:bg-slate-700 space-y-1">
							<div class="flex items-center justify-between">
								<span id="pip-pkg-name" class="font-semibold text-gray-800 dark:text-gray-100 text-sm"></span>
								<span id="pip-pkg-version" class="font-mono text-xs text-blue-600 dark:text-blue-400 bg-blue-50 dark:bg-blue-900/30 px-2 py-0.5 rounded"></span>
							</div>
							<p id="pip-pkg-summary" class="text-xs text-gray-600 dark:text-gray-400"></p>
							<a id="pip-pkg-link" href="#" target="_blank" rel="noopener" class="text-xs text-blue-500 hover:text-blue-700 dark:text-blue-400 dark:hover:text-blue-300">View on PyPI →</a>
						</div>
						<div id="pip-package-not-found" class="hidden rounded-lg border border-red-200 dark:border-red-800 p-3 bg-red-50 dark:bg-red-900/20">
							<p class="text-xs text-red-600 dark:text-red-400">Package not found on PyPI. Check the name and try again.</p>
						</div>
					</div>
					<div class="p-4 border-t border-gray-200 dark:border-slate-700 flex justify-end gap-3">
						<button onclick="hidePipInstallModal()" class="px-4 py-2 text-gray-600 dark:text-gray-400 hover:text-gray-800 dark:hover:text-gray-200">
							Cancel
						</button>
						<button id="pip-install-confirm-btn" onclick="confirmPipInstall()" class="px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white rounded-lg transition-colors flex items-center gap-2">
							Install
						</button>
					</div>
				</div>
			</div>

			<!-- Package Info Modal -->
			<div id="package-info-modal" class="hidden fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center z-50">
				<div class="bg-white dark:bg-slate-800 rounded-lg shadow-xl max-w-lg w-full mx-4">
					<div class="p-4 border-b border-gray-200 dark:border-slate-700 flex justify-between items-center">
						<h3 id="package-info-title" class="text-lg font-semibold text-gray-800 dark:text-gray-100">Package Info</h3>
						<button onclick="hidePackageInfoModal()" class="text-gray-400 hover:text-gray-600 dark:hover:text-gray-300">
							<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
							</svg>
						</button>
					</div>
					<div class="p-4 space-y-4">
						<div class="grid grid-cols-2 gap-4">
							<div>
								<p class="text-xs text-gray-500 dark:text-gray-400 uppercase font-medium">Current Version</p>
								<p id="pkg-current-version" class="text-sm text-gray-700 dark:text-gray-300 font-mono mt-1">-</p>
							</div>
							<div>
								<p class="text-xs text-gray-500 dark:text-gray-400 uppercase font-medium">Available Version</p>
								<p id="pkg-available-version" class="text-sm text-gray-700 dark:text-gray-300 font-mono mt-1">-</p>
							</div>
							<div>
								<p class="text-xs text-gray-500 dark:text-gray-400 uppercase font-medium">Architecture</p>
								<p id="pkg-architecture" class="text-sm text-gray-700 dark:text-gray-300 mt-1">-</p>
							</div>
							<div>
								<p class="text-xs text-gray-500 dark:text-gray-400 uppercase font-medium">Download Size</p>
								<p id="pkg-size" class="text-sm text-gray-700 dark:text-gray-300 mt-1">-</p>
							</div>
							<div>
								<p class="text-xs text-gray-500 dark:text-gray-400 uppercase font-medium">Repository</p>
								<p id="pkg-repository" class="text-sm text-gray-700 dark:text-gray-300 mt-1">-</p>
							</div>
							<div>
								<p class="text-xs text-gray-500 dark:text-gray-400 uppercase font-medium">Update Type</p>
								<p id="pkg-type" class="text-sm mt-1">-</p>
							</div>
						</div>
						<div id="pkg-changelog-section" class="pt-4 border-t border-gray-200 dark:border-slate-700">
							<p class="text-xs text-gray-500 dark:text-gray-400 uppercase font-medium mb-2">Changelog</p>
							<a
								id="pkg-changelog-link"
								href="#"
								target="_blank"
								rel="noopener noreferrer"
								class="inline-flex items-center gap-2 px-3 py-2 bg-blue-100 dark:bg-blue-900/30 hover:bg-blue-200 dark:hover:bg-blue-900/50 text-blue-700 dark:text-blue-400 rounded-lg transition-colors text-sm"
							>
								<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path>
								</svg>
								View Changelog on Launchpad
							</a>
						</div>
					</div>
					<div class="p-4 border-t border-gray-200 dark:border-slate-700 flex justify-end">
						<button id="package-info-close-btn" onclick="hidePackageInfoModal()" class="px-4 py-2 text-gray-600 dark:text-gray-400 hover:text-gray-800 dark:hover:text-gray-200">
							Close
						</button>
					</div>
				</div>
			</div>

			<!-- Generic Confirmation Modal -->
			<div id="confirm-modal" class="hidden fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center z-50">
				<div class="bg-white dark:bg-slate-800 rounded-lg shadow-xl max-w-md w-full mx-4">
					<div class="p-4 border-b border-gray-200 dark:border-slate-700 flex items-center gap-3">
						<div id="confirm-icon" class="flex-shrink-0 w-10 h-10 rounded-full flex items-center justify-center">
							<!-- Icon will be set dynamically -->
						</div>
						<h3 id="confirm-title" class="text-lg font-semibold text-gray-800 dark:text-gray-100">Confirm</h3>
					</div>
					<div class="p-4">
						<p id="confirm-message" class="text-gray-600 dark:text-gray-400">Are you sure?</p>
						<input id="confirm-input" type="text" class="hidden mt-3 w-full px-3 py-2 bg-gray-50 dark:bg-slate-700 border border-gray-300 dark:border-slate-600 rounded-lg text-gray-800 dark:text-gray-200 placeholder-gray-400 dark:placeholder-gray-500 focus:outline-none focus:ring-2 focus:ring-blue-500" placeholder=""/>
						<span id="confirm-input-counter" class="char-limit-counter text-xs text-gray-400 dark:text-gray-500 hidden mt-1 block text-right"></span>
					</div>
					<div class="p-4 border-t border-gray-200 dark:border-slate-700 flex justify-end gap-3">
						<button id="confirm-cancel-btn" onclick="hideConfirmModal()" class="px-4 py-2 text-gray-600 dark:text-gray-400 hover:text-gray-800 dark:hover:text-gray-200">
							Cancel
						</button>
						<button id="confirm-action-btn" class="px-4 py-2 rounded-lg transition-colors">
							Confirm
						</button>
					</div>
				</div>
			</div>

			<!-- Terminal Output Modal -->
			<div id="terminal-modal" class="hidden fixed inset-0 bg-black/50 flex items-center justify-center z-50 p-4 md:p-8">
				<div class="bg-slate-900 rounded-lg shadow-xl w-full max-w-4xl h-[80vh] flex flex-col">
					<!-- Terminal Header -->
					<div class="flex items-center justify-between px-4 py-3 border-b border-slate-700">
						<div class="flex items-center gap-3">
							<div id="terminal-status-indicator" class="w-3 h-3 rounded-full bg-yellow-500 animate-pulse"></div>
							<h3 id="terminal-title" class="text-sm font-medium text-gray-200">Terminal Output</h3>
						</div>
						<div class="flex items-center gap-2">
							<span id="terminal-line-count" class="text-xs text-gray-500">0 lines</span>
							<button
								id="terminal-copy-btn"
								onclick="copyTerminalOutput()"
								class="p-1.5 rounded hover:bg-slate-700 text-gray-400 hover:text-gray-200 transition-colors"
								title="Copy output"
							>
								<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"></path>
								</svg>
							</button>
							<button
								onclick="closeTerminalModal()"
								class="p-1.5 rounded hover:bg-slate-700 text-gray-400 hover:text-gray-200 transition-colors"
								title="Close (operation continues in background)"
							>
								<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
								</svg>
							</button>
						</div>
					</div>
					<!-- Terminal Output Area -->
					<div id="terminal-output" class="flex-1 overflow-y-auto p-4 font-mono text-sm text-green-400 bg-black">
						<pre id="terminal-content" class="whitespace-pre-wrap"></pre>
					</div>
					<!-- Terminal Footer -->
					<div class="flex items-center justify-between px-4 py-2 border-t border-slate-700 bg-slate-800">
						<div class="flex items-center gap-2">
							<label class="flex items-center gap-2 text-xs text-gray-400 cursor-pointer">
								<input type="checkbox" id="terminal-auto-scroll" checked class="w-3 h-3 rounded border-slate-600 bg-slate-700 text-blue-500"/>
								Auto-scroll
							</label>
						</div>
						<div id="terminal-status-text" class="text-xs text-gray-400">Running...</div>
					</div>
				</div>
			</div>

			<!-- Snapshot Preview Modal -->
			<div id="preview-modal" class="hidden fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center z-50 p-4">
				<div class="bg-white dark:bg-slate-800 rounded-lg shadow-xl max-w-2xl w-full mx-4 max-h-[80vh] flex flex-col">
					<div class="p-4 border-b border-gray-200 dark:border-slate-700 flex items-center justify-between">
						<h3 id="preview-title" class="text-lg font-semibold text-gray-800 dark:text-gray-100">Snapshot Preview</h3>
						<button onclick="hidePreviewModal()" class="p-1 rounded hover:bg-gray-100 dark:hover:bg-slate-700 text-gray-400 hover:text-gray-600 dark:hover:text-gray-200">
							<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
						</button>
					</div>
					<div id="preview-content" class="p-4 overflow-y-auto flex-1">
						<div class="flex items-center justify-center py-8">
							<svg class="animate-spin h-6 w-6 text-blue-500" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path></svg>
							<span class="ml-2 text-gray-500 dark:text-gray-400">Loading preview...</span>
						</div>
					</div>
					<div class="p-4 border-t border-gray-200 dark:border-slate-700 flex justify-end">
						<button id="preview-close-btn" onclick="hidePreviewModal()" class="px-4 py-2 text-gray-600 dark:text-gray-400 hover:text-gray-800 dark:hover:text-gray-200">
							Close
						</button>
					</div>
				</div>
			</div>

			<!-- Toast notifications handled by global toast system (ui.Toast in base layout) -->
		}

		@components.LiveRefreshButtonScript()
		<script src="/static/js/os-updates/os-updates-page.js"></script>
	}
}

func formatBytesOSUpdates(bytes int64) string {
	if bytes == 0 {
		return "-"
	}
	const unit = 1024
	if bytes < unit {
		return fmt.Sprintf("%d B", bytes)
	}
	div, exp := int64(unit), 0
	for n := bytes / unit; n >= unit; n /= unit {
		div *= unit
		exp++
	}
	return fmt.Sprintf("%.1f %cB", float64(bytes)/float64(div), "KMGTPE"[exp])
}

func getActionColor(action string) string {
	switch action {
	case "install":
		return "bg-green-100 dark:bg-green-900/30 text-green-700 dark:text-green-400"
	case "upgrade":
		return "bg-blue-100 dark:bg-blue-900/30 text-blue-700 dark:text-blue-400"
	case "remove", "purge":
		return "bg-red-100 dark:bg-red-900/30 text-red-700 dark:text-red-400"
	default:
		return "bg-gray-100 dark:bg-gray-700 text-gray-600 dark:text-gray-400"
	}
}

func joinStrings(strs []string, sep string) string {
	if len(strs) == 0 {
		return ""
	}
	result := strs[0]
	for i := 1; i < len(strs); i++ {
		result += sep + strs[i]
	}
	return result
}

// snapshotDescription returns a display description for a snapshot reason.
func snapshotDescription(reason string) string {
	if reason == "" || reason == "manual" {
		return ""
	}
	if strings.HasPrefix(reason, "auto: ") {
		return strings.TrimPrefix(reason, "auto: ")
	}
	return reason
}

// isAutoSnapshot returns true if the snapshot was created automatically.
func isAutoSnapshot(reason string) bool {
	return strings.HasPrefix(reason, "auto:")
}
