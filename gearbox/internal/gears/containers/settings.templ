package containers

import "github.com/sarg3nt/gearbox/internal/framework/gear"

// ContainersSettings renders the containers gear settings page.
templ ContainersSettings(config map[string]any) {
	{{ statsInterval := gear.ConfigInt(config, "stats_interval", 10) }}
	<div class="bg-white dark:bg-slate-800 rounded-lg shadow p-6">
		<h3 class="text-lg font-semibold text-gray-800 dark:text-gray-100 mb-4">Containers Settings</h3>
		<p class="text-sm text-gray-600 dark:text-gray-400 mb-4">
			Configure Docker container monitoring. Requires Docker to be installed and running on the monitored server.
		</p>
		<div class="space-y-4">
			<div>
				<label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">
					Stats collection interval (seconds)
				</label>
				<select
					name="stats_interval"
					class="w-full px-3 py-2 border border-gray-300 dark:border-slate-600 rounded-lg bg-white dark:bg-slate-800 text-gray-700 dark:text-gray-300"
				>
					<option value="5" selected?={ statsInterval == 5 }>5 seconds</option>
					<option value="10" selected?={ statsInterval == 10 }>10 seconds (default)</option>
					<option value="30" selected?={ statsInterval == 30 }>30 seconds</option>
					<option value="60" selected?={ statsInterval == 60 }>60 seconds</option>
				</select>
				<p class="text-xs text-gray-500 dark:text-gray-400 mt-1">
					How often to collect CPU, memory, and network stats from running containers.
				</p>
			</div>
		</div>
		<div class="mt-6">
			<button class="px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white rounded-lg transition-colors text-sm">
				Save Settings
			</button>
		</div>
	</div>
}
