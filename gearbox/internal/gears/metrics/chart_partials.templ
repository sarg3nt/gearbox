package metrics

import (
	"fmt"
)

// SessionsRequestsChartPartial renders a Chart.js time-series chart for sessions and requests.
templ SessionsRequestsChartPartial(boxID string, hours int, limit int) {
	<div id={ fmt.Sprintf("card-sessions-requests-%s", boxID) } class="chart-card bg-gray-50 dark:bg-slate-700 rounded-lg p-4 relative">
		<div class="flex justify-between items-center mb-2">
			<h4 class="text-lg font-medium text-gray-700 dark:text-gray-300">Sessions &amp; Requests</h4>
			<button onclick={ toggleChartFullscreen(fmt.Sprintf("card-sessions-requests-%s", boxID), fmt.Sprintf("chart-sessions-requests-%s", boxID)) } class="p-1 hover:bg-gray-200 dark:hover:bg-slate-600 rounded transition-colors" title="Toggle fullscreen">
				<svg class="w-5 h-5 text-gray-500 dark:text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 8V4m0 0h4M4 4l5 5m11-1V4m0 0h-4m4 0l-5 5M4 16v4m0 0h4m-4 0l5-5m11 5l-5-5m5 5v-4m0 4h-4"></path>
				</svg>
			</button>
		</div>
		<div class="chart-aspect-container">
			<canvas id={ fmt.Sprintf("chart-sessions-requests-%s", boxID) }></canvas>
		</div>
	</div>
	@initSessionsRequestsChart(boxID, hours, limit)
}

script initSessionsRequestsChart(boxID string, hours int, limit int) {
	(function() {
		var GC = window.GearboxCharts;
		var canvasId = 'chart-sessions-requests-' + boxID;

		function loadChart() {
			fetch('/api/' + boxID + '/metrics/stats?hours=' + hours + '&limit=' + limit)
				.then(function(r) { return r.json(); })
				.then(function(json) {
					var data = json.data || [];
					var colors = GC.getChartColors();
					var ctx = document.getElementById(canvasId);
					if (!ctx) return;

					if (window.chartInstances[canvasId]) {
						window.chartInstances[canvasId].destroy();
					}

					window.chartInstances[canvasId] = new Chart(ctx.getContext('2d'), {
						type: 'line',
						data: {
							labels: data.map(function(d) { return GC.formatTime(d.collected_at); }),
							datasets: [
								GC.createLineDataset('Sessions', data.map(function(d) { return d.total_sessions; }), colors.primary),
								GC.createLineDataset('Requests (/1000)', data.map(function(d) { return Math.round(d.total_requests / 1000); }), colors.secondary)
							]
						},
						options: GC.createChartOptions(0)
					});
				})
				.catch(function(err) { console.error('Failed to load sessions/requests chart:', err); });
		}

		loadChart();
		document.body.addEventListener('dashboard:settings-changed', loadChart);
	})();
}

