// NetworkThroughputChartPartial renders a Chart.js time-series chart for network throughput (RX/TX rates).
templ NetworkThroughputChartPartial(boxID string, hours int, limit int) {
	<div id={ fmt.Sprintf("card-network-throughput-%s", boxID) } class="chart-card bg-gray-50 dark:bg-slate-700 rounded-lg p-4 relative">
		<div class="flex justify-between items-center mb-2">
			<h4 class="text-lg font-medium text-gray-700 dark:text-gray-300">Network Throughput</h4>
			<button onclick={ toggleChartFullscreen(fmt.Sprintf("card-network-throughput-%s", boxID), fmt.Sprintf("chart-network-throughput-%s", boxID)) } class="p-1 hover:bg-gray-200 dark:hover:bg-slate-600 rounded transition-colors" title="Toggle fullscreen">
				<svg class="w-5 h-5 text-gray-500 dark:text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 8V4m0 0h4M4 4l5 5m11-1V4m0 0h-4m4 0l-5 5M4 16v4m0 0h4m-4 0l5-5m11 5l-5-5m5 5v-4m0 4h-4"></path>
				</svg>
			</button>
		</div>
		<div class="chart-aspect-container">
			<canvas id={ fmt.Sprintf("chart-network-throughput-%s", boxID) }></canvas>
		</div>
	</div>
	@initNetworkThroughputChart(boxID, hours, limit)
}

script initNetworkThroughputChart(boxID string, hours int, limit int) {
	(function() {
		var GC = window.GearboxCharts;
		var canvasId = 'chart-network-throughput-' + boxID;

		function loadChart() {
			fetch('/api/' + boxID + '/metrics/system?hours=' + hours + '&limit=' + limit)
				.then(function(r) { return r.json(); })
				.then(function(json) {
					var data = json.data || [];
					var colors = GC.getChartColors();
					var ctx = document.getElementById(canvasId);
					if (!ctx) return;

					var rxRate = [];
					var txRate = [];
					var labels = [];

					for (var i = 1; i < data.length; i++) {
						var prev = data[i - 1];
						var curr = data[i];
						var timeDiff = (new Date(curr.collected_at) - new Date(prev.collected_at)) / 1000;
						if (timeDiff <= 0) continue;

						var rxDiff = curr.network_rx_bytes - prev.network_rx_bytes;
						var txDiff = curr.network_tx_bytes - prev.network_tx_bytes;
						var rxMbps = rxDiff >= 0 ? (rxDiff * 8 / 1000000) / timeDiff : 0;
						var txMbps = txDiff >= 0 ? (txDiff * 8 / 1000000) / timeDiff : 0;

						rxRate.push(rxMbps);
						txRate.push(txMbps);
						labels.push(GC.formatTime(curr.collected_at));
					}

					if (window.chartInstances[canvasId]) {
						window.chartInstances[canvasId].destroy();
					}

					window.chartInstances[canvasId] = new Chart(ctx.getContext('2d'), {
						type: 'line',
						data: {
							labels: labels,
							datasets: [
								GC.createLineDataset('RX (Mbps)', rxRate, colors.primary),
								GC.createLineDataset('TX (Mbps)', txRate, colors.purple)
							]
						},
						options: GC.createChartOptions(0)
					});
				})
				.catch(function(err) { console.error('Failed to load network throughput chart:', err); });
		}

		loadChart();
		document.body.addEventListener('dashboard:settings-changed', loadChart);
	})();
}

