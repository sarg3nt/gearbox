// toggleChartFullscreen is a templ script handler for fullscreen button clicks.
script toggleChartFullscreen(cardId string, canvasId string) {
	window.GearboxCharts.toggleFullscreen(cardId, function() {
		if (window.chartInstances && window.chartInstances[canvasId]) {
			setTimeout(function() { window.chartInstances[canvasId].resize(); }, 100);
		}
	});
}
