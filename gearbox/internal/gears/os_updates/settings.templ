package os_updates

// OSUpdatesSettings renders the OS updates gear settings page.
templ OSUpdatesSettings(config map[string]any) {
	<div class="bg-white dark:bg-slate-800 rounded-lg shadow p-6">
		<h3 class="text-lg font-semibold text-gray-800 dark:text-gray-100 mb-4">OS Updates Settings</h3>
		<p class="text-sm text-gray-600 dark:text-gray-400 mb-4">
			Configure automatic update checking and notification preferences.
		</p>
		<div class="space-y-4">
			<div>
				<label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">
					Auto-check for updates
				</label>
				<select class="w-full px-3 py-2 border border-gray-300 dark:border-slate-600 rounded-lg bg-white dark:bg-slate-800 text-gray-700 dark:text-gray-300">
					<option value="daily">Daily</option>
					<option value="weekly">Weekly</option>
					<option value="manual">Manual only</option>
				</select>
			</div>
			<div>
				<label class="flex items-center">
					<input type="checkbox" class="rounded border-gray-300 text-blue-600 focus:ring-blue-500"/>
					<span class="ml-2 text-sm text-gray-700 dark:text-gray-300">
						Notify about security updates
					</span>
				</label>
			</div>
			<div>
				<label class="flex items-center">
					<input type="checkbox" class="rounded border-gray-300 text-blue-600 focus:ring-blue-500"/>
					<span class="ml-2 text-sm text-gray-700 dark:text-gray-300">
						Auto-install security updates
					</span>
				</label>
			</div>
		</div>
		<div class="mt-6">
			<button class="px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white rounded-lg transition-colors">
				Save Settings
			</button>
		</div>
	</div>
}
