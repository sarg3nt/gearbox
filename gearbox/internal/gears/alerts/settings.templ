package alerts

import "github.com/sarg3nt/gearbox/internal/framework/templates/components"

// alertsSettingsComponent renders the alerts gear settings page.
templ alertsSettingsComponent(config map[string]any) {
	{{ enableNotifications := getConfigBool(config, "enable_notifications", true) }}
	{{ retentionDays := getConfigInt(config, "retention_days", 30) }}
	@components.SettingsSection("Alert Settings", "Configure alert behavior and notifications.") {
		@components.SettingsCheckbox(
			"enable_notifications",
			"Enable email notifications",
			"When enabled, alert notifications will be sent via email (requires SMTP configuration).",
			enableNotifications,
		)
		@components.SettingsSelect(
			"retention_days",
			"Alert Retention (days)",
			"How long to keep resolved alerts in history.",
			[]components.SelectOption{
				{Value: "7", Label: "7 days", Selected: retentionDays == 7},
				{Value: "30", Label: "30 days", Selected: retentionDays == 30},
				{Value: "90", Label: "90 days", Selected: retentionDays == 90},
				{Value: "365", Label: "365 days", Selected: retentionDays == 365},
			},
		)
	}
}
