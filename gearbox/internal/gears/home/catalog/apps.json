  {
    "slug": "plex",
    "name": "Plex",
    "category": "media",
    "icon_url": "https://cdn.jsdelivr.net/gh/selfhst/icons/svg/plex.svg",
    "default_ports": [32400],
    "fingerprint": {
      "path": "/identity",
      "type": "body_contains",
      "value": "machineIdentifier"
    },
    "auth": "apikey",
    "widget_fields": [
      { "key": "streams",    "label": "Streams",    "default": true },
      { "key": "transcodes", "label": "Transcodes", "default": true },
      { "key": "bandwidth",  "label": "Bandwidth",  "default": true },
      { "key": "movies",     "label": "Movies",     "default": true },
      { "key": "tv",         "label": "Shows",      "default": false },
      { "key": "episodes",   "label": "Episodes",   "default": false },
      { "key": "libraries",  "label": "Libraries",  "default": false }
    ],
    "api_help": {
      "title": "Find your Plex token (X-Plex-Token)",
      "steps": [
        "Plex doesn't show its API token in any settings page — you have to extract it from a request the web app already makes. The easiest way:",
        "Sign in to Plex Web at `app.plex.tv` (or your local Plex web URL) with the same account that owns this server.",
        "Open any item in your library (a movie, episode, or anything).",
        "Click the `...` (three-dot) menu on the item → `Get Info` → in the bottom-left of the info dialog, click `View XML`.",
        "A new browser tab opens with raw XML. Look at that tab's URL — it contains `X-Plex-Token=` followed by a long string. Copy just the token (everything after the `=` and before the next `&`, if any).",
        "Paste the token into the API Key field on this dialog and click Save.",
        "Alternative method: open Plex Web, press `F12` to open DevTools, switch to the `Network` tab, click anything in the UI, find any request to `/library/...` and look at the `X-Plex-Token` request header — copy that value."
      ],
      "note": "The token grants the same access as your Plex account, so guard it like a password. To revoke it, sign out of all devices at `https://app.plex.tv/desktop/#!/settings/account` — Plex will issue a new token on next sign-in."
    }
  },
